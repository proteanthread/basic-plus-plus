5 REM =============================================
6 REM  VIC FORTH for BASIC++ v1.0 (GWBS LOAD-safe)
7 REM  Colon definitions, variables, constants,
8 REM  IF/THEN/ELSE, BEGIN/UNTIL, DO/LOOP
9 REM =============================================
100 DIM DS(64)
101 LET SP = 0
102 DIM RS(32)
103 LET RP = 0
104 DIM DL(64)
105 DIM DT(64)
106 DIM DA(64)
107 LET DP = 1
108 LET LATEST = 0
109 LET N$ = ""
110 LET F = 8
111 DIM BD(256)
112 LET BP = 1
113 DIM UM(128)
114 LET UP = 1
115 LET STATE = 0
116 LET RUNNING = 1
117 LET IPOS = 0
118 LET ILEN = 0
119 DIM CS(16)
120 LET CSP = 0
200 RESTORE
201 DO
202   READ R$
203   IF R$ = "***" THEN GOTO 220
204   READ PT
205   N$ = N$ + LEFT$(R$ + "        ", F)
206   DL(DP) = LATEST
207   DT(DP) = PT
208   DA(DP) = 0
209   LATEST = DP
210   DP = DP + 1
211 LOOP
220 PRINT ""
221 PRINT "VIC FORTH for BASIC++ v1.0"
222 PRINT "Type WORDS for list, BYE to exit."
223 PRINT ""
224 LET BATCH = 0
225 ON ERROR GOTO 228
226 OPEN "forth_input.txt" FOR INPUT AS #1
227 BATCH = 1 : PRINT "(batch mode)" : ON ERROR GOTO 0 : GOTO 230
228 ON ERROR GOTO 0
230 IF RUNNING = 0 THEN GOTO 299
231 IF STATE = 0 AND BATCH = 0 THEN PRINT "ok ";
232 IF BATCH = 1 THEN IF EOF(1) THEN CLOSE #1 : BATCH = 0 : GOTO 299
233 IF BATCH = 1 THEN LINE INPUT #1, L$ : PRINT "> "; L$ ELSE LINE INPUT L$
234 IF LEN(L$) = 0 THEN GOTO 230
235 LET IPOS = 1
236 LET ILEN = LEN(L$)
237 GOSUB 5000
238 IF RUNNING = 0 THEN GOTO 299
239 GOTO 230
299 PRINT "Goodbye."
300 END
1000 REM === Parse next word ===
1001 LET W$ = ""
1002 IF IPOS > ILEN THEN RETURN
1003 IF MID$(L$, IPOS, 1) = " " THEN IPOS = IPOS + 1 : GOTO 1002
1004 IF IPOS > ILEN THEN RETURN
1005 LET J = IPOS
1006 IF IPOS > ILEN THEN GOTO 1010
1007 IF MID$(L$, IPOS, 1) <> " " THEN IPOS = IPOS + 1 : GOTO 1006
1010 W$ = MID$(L$, J, IPOS - J)
1012 LET U$ = ""
1013 LET WL = LEN(W$)
1014 LET WI = 1
1015 IF WI > WL THEN GOTO 1020
1016 LET C = ASC(MID$(W$, WI, 1))
1017 IF C >= 97 AND C <= 122 THEN C = C - 32
1018 U$ = U$ + CHR$(C)
1019 WI = WI + 1 : GOTO 1015
1020 W$ = U$
1021 RETURN
1100 REM === Number parser ===
1101 LET NV = 0 : LET NS = 1 : LET NI = 1
1102 LET NL = LEN(W$) : LET NF = 0
1103 IF NL = 0 THEN RETURN
1104 IF MID$(W$, 1, 1) = "-" AND NL > 1 THEN NS = -1 : NI = 2
1110 IF NI > NL THEN GOTO 1120
1111 LET NC = ASC(MID$(W$, NI, 1))
1112 IF NC >= 48 AND NC <= 57 THEN NV = NV * 10 + (NC - 48) : NF = 1 : NI = NI + 1 : GOTO 1110
1113 NF = 0 : RETURN
1120 NV = NV * NS
1121 RETURN
1200 REM === Dictionary lookup ===
1201 LET Q$ = LEFT$(W$ + "        ", F)
1202 LET FI = LATEST
1203 IF FI = 0 THEN RETURN
1204 IF MID$(N$, (FI-1)*F+1, F) = Q$ THEN RETURN
1205 FI = DL(FI) : GOTO 1203
3000 REM === Execute primitive by FI ===
3001 LET P$ = MID$(N$, (FI-1)*F+1, F)
3002 IF RIGHT$(P$, 1) <> " " THEN GOTO 3005
3003 P$ = LEFT$(P$, LEN(P$)-1) : GOTO 3002
3005 IF P$ <> "DUP" THEN GOTO 3008
3006 DS(SP+1) = DS(SP) : SP = SP+1
3007 RETURN
3008 IF P$ <> "DROP" THEN GOTO 3011
3009 SP = SP-1
3010 RETURN
3011 IF P$ <> "SWAP" THEN GOTO 3015
3012 LET V = DS(SP) : DS(SP) = DS(SP-1) : DS(SP-1) = V
3013 RETURN
3015 IF P$ <> "OVER" THEN GOTO 3019
3016 SP = SP+1 : DS(SP) = DS(SP-2)
3017 RETURN
3019 IF P$ <> "ROT" THEN GOTO 3023
3020 LET V = DS(SP-2) : DS(SP-2) = DS(SP-1) : DS(SP-1) = DS(SP) : DS(SP) = V
3021 RETURN
3023 IF P$ <> "+" THEN GOTO 3026
3024 DS(SP-1) = DS(SP-1) + DS(SP) : SP = SP-1
3025 RETURN
3026 IF P$ <> "-" THEN GOTO 3029
3027 DS(SP-1) = DS(SP-1) - DS(SP) : SP = SP-1
3028 RETURN
3029 IF P$ <> "*" THEN GOTO 3032
3030 DS(SP-1) = DS(SP-1) * DS(SP) : SP = SP-1
3031 RETURN
3032 IF P$ <> "/" THEN GOTO 3035
3033 DS(SP-1) = INT(DS(SP-1) / DS(SP)) : SP = SP-1
3034 RETURN
3035 IF P$ <> "MOD" THEN GOTO 3038
3036 DS(SP-1) = DS(SP-1) MOD DS(SP) : SP = SP-1
3037 RETURN
3038 IF P$ <> "NEGATE" THEN GOTO 3041
3039 DS(SP) = -DS(SP)
3040 RETURN
3041 IF P$ <> "1+" THEN GOTO 3044
3042 DS(SP) = DS(SP)+1
3043 RETURN
3044 IF P$ <> "1-" THEN GOTO 3050
3045 DS(SP) = DS(SP)-1
3046 RETURN
3050 IF P$ <> "=" THEN GOTO 3054
3051 IF DS(SP-1) = DS(SP) THEN DS(SP-1) = -1 ELSE DS(SP-1) = 0
3052 SP = SP-1
3053 RETURN
3054 IF P$ <> "<" THEN GOTO 3058
3055 IF DS(SP-1) < DS(SP) THEN DS(SP-1) = -1 ELSE DS(SP-1) = 0
3056 SP = SP-1
3057 RETURN
3058 IF P$ <> ">" THEN GOTO 3062
3059 IF DS(SP-1) > DS(SP) THEN DS(SP-1) = -1 ELSE DS(SP-1) = 0
3060 SP = SP-1
3061 RETURN
3062 IF P$ <> "0=" THEN GOTO 3066
3063 IF DS(SP) = 0 THEN DS(SP) = -1 ELSE DS(SP) = 0
3064 RETURN
3066 IF P$ <> "0<" THEN GOTO 3069
3067 IF DS(SP) < 0 THEN DS(SP) = -1 ELSE DS(SP) = 0
3068 RETURN
3069 IF P$ <> "AND" THEN GOTO 3072
3070 DS(SP-1) = INT(DS(SP-1)) AND INT(DS(SP)) : SP = SP-1
3071 RETURN
3072 IF P$ <> "OR" THEN GOTO 3075
3073 DS(SP-1) = INT(DS(SP-1)) OR INT(DS(SP)) : SP = SP-1
3074 RETURN
3075 IF P$ <> "NOT" THEN GOTO 3100
3076 IF DS(SP) = 0 THEN DS(SP) = -1 ELSE DS(SP) = 0
3077 RETURN
3100 IF P$ <> "." THEN GOTO 3104
3101 PRINT DS(SP); " ";
3102 SP = SP-1
3103 RETURN
3104 IF P$ <> "CR" THEN GOTO 3107
3105 PRINT ""
3106 RETURN
3107 IF P$ <> "EMIT" THEN GOTO 3111
3108 PRINT CHR$(INT(DS(SP)));
3109 SP = SP-1
3110 RETURN
3111 IF P$ <> ".S" THEN GOTO 3120
3112 PRINT "<"; SP; "> ";
3113 IF SP = 0 THEN GOTO 3118
3114 LET SI = 1
3115 IF SI > SP THEN GOTO 3118
3116 PRINT DS(SI); " ";
3117 SI = SI + 1 : GOTO 3115
3118 RETURN
3120 IF P$ <> "SPACE" THEN GOTO 3130
3121 PRINT " ";
3122 RETURN
3130 IF P$ <> "FETCH" THEN GOTO 3133
3131 LET T = DS(SP) : DS(SP) = UM(T)
3132 RETURN
3133 IF P$ <> "STORE" THEN GOTO 3136
3134 LET T = DS(SP) : UM(T) = DS(SP-1) : SP = SP-2
3135 RETURN
3136 IF P$ <> "+STORE" THEN GOTO 3200
3137 LET T = DS(SP) : UM(T) = UM(T) + DS(SP-1) : SP = SP-2
3138 RETURN
3200 IF P$ <> "BYE" THEN GOTO 3210
3201 RUNNING = 0
3202 RETURN
3210 IF P$ <> "WORDS" THEN GOTO 3250
3211 GOSUB 3220
3212 RETURN
3220 LET K = LATEST
3221 LET M = 0
3222 IF K = 0 THEN PRINT "" : RETURN
3223 LET G$ = MID$(N$, (K-1)*F+1, F)
3224 IF LEN(G$) = 0 THEN GOTO 3228
3225 IF RIGHT$(G$, 1) <> " " THEN GOTO 3228
3226 G$ = LEFT$(G$, LEN(G$)-1) : GOTO 3224
3228 PRINT G$; " ";
3229 M = M + 1
3230 IF M MOD 8 = 0 THEN PRINT ""
3231 K = DL(K) : GOTO 3222
3250 RETURN
4000 REM === Inner interpreter ===
4005 LET XT = BD(XA)
4006 IF XT = 0 THEN GOTO 4090
4010 IF XT <> -1 THEN GOTO 4020
4011 SP = SP+1 : DS(SP) = BD(XA+1) : XA = XA+2 : GOTO 4005
4020 IF XT <> -3 THEN GOTO 4030
4021 XA = BD(XA+1) : GOTO 4005
4030 IF XT <> -4 THEN GOTO 4040
4031 IF DS(SP) = 0 THEN XA = BD(XA+1) ELSE XA = XA+2
4032 SP = SP-1 : GOTO 4005
4040 IF XT <> -5 THEN GOTO 4050
4041 RP = RP+1 : RS(RP) = DS(SP)
4042 RP = RP+1 : RS(RP) = DS(SP-1)
4043 SP = SP-2 : XA = XA+1 : GOTO 4005
4050 IF XT <> -6 THEN GOTO 4060
4051 RS(RP-1) = RS(RP-1) + 1
4052 IF RS(RP-1) < RS(RP) THEN XA = BD(XA+1) : GOTO 4005
4053 RP = RP-2 : XA = XA+2 : GOTO 4005
4060 IF XT <> -8 THEN GOTO 4070
4061 SP = SP+1 : DS(SP) = RS(RP-1) : XA = XA+1 : GOTO 4005
4070 IF XT < 1 THEN GOTO 4085
4071 IF XT >= DP THEN GOTO 4085
4072 IF DT(XT) = 1 THEN GOTO 4080
4073 IF DT(XT) = 2 THEN SP = SP+1 : DS(SP) = DA(XT) : XA = XA+1 : GOTO 4005
4074 IF DT(XT) = 3 THEN SP = SP+1 : DS(SP) = DA(XT) : XA = XA+1 : GOTO 4005
4075 LET FI = XT : GOSUB 3000
4076 XA = XA+1 : GOTO 4005
4080 RP = RP+1 : RS(RP) = XA+1
4081 XA = DA(XT) : GOTO 4005
4085 XA = XA+1 : GOTO 4005
4090 IF RP = 0 THEN RETURN
4091 XA = RS(RP) : RP = RP-1 : GOTO 4005
5000 REM === Outer interpreter ===
5010 GOSUB 1000
5011 IF W$ = "" THEN RETURN
5020 IF W$ <> ":" THEN GOTO 5030
5021 GOSUB 1000
5022 N$ = N$ + LEFT$(W$ + "        ", F)
5023 DL(DP) = LATEST : DT(DP) = 1 : DA(DP) = BP
5024 LATEST = DP : DP = DP+1
5025 STATE = 1 : GOTO 5010
5030 IF W$ <> ";" THEN GOTO 5040
5031 IF STATE <> 1 THEN GOTO 5040
5032 BD(BP) = 0 : BP = BP+1
5033 STATE = 0 : GOTO 5010
5040 IF W$ <> "VARIABLE" THEN GOTO 5050
5041 GOSUB 1000
5042 N$ = N$ + LEFT$(W$ + "        ", F)
5043 DL(DP) = LATEST : DT(DP) = 2 : DA(DP) = UP
5044 LATEST = DP : DP = DP+1
5045 UM(UP) = 0 : UP = UP+1
5046 GOTO 5010
5050 IF W$ <> "CONSTANT" THEN GOTO 5060
5051 GOSUB 1000
5052 N$ = N$ + LEFT$(W$ + "        ", F)
5053 DL(DP) = LATEST : DT(DP) = 3 : DA(DP) = DS(SP) : SP = SP-1
5054 LATEST = DP : DP = DP+1
5055 GOTO 5010
5060 IF W$ <> "(" THEN GOTO 5065
5061 IF IPOS > ILEN THEN GOTO 5010
5062 IF MID$(L$, IPOS, 1) = ")" THEN IPOS = IPOS+1 : GOTO 5010
5063 IPOS = IPOS+1 : GOTO 5061
5065 IF W$ <> "\" THEN GOTO 5070
5066 IPOS = ILEN+1 : GOTO 5010
5070 REM === Compile-mode words ===
5071 IF STATE <> 1 THEN GOTO 5200
5072 IF W$ <> "IF" THEN GOTO 5080
5073 BD(BP) = -4 : BP = BP+1
5074 CSP = CSP+1 : CS(CSP) = BP
5075 BD(BP) = 0 : BP = BP+1 : GOTO 5010
5080 IF W$ <> "ELSE" THEN GOTO 5085
5081 BD(BP) = -3 : BP = BP+1
5082 LET A = BP : BD(BP) = 0 : BP = BP+1
5083 LET T = CS(CSP) : BD(T) = BP : CS(CSP) = A : GOTO 5010
5085 IF W$ <> "THEN" THEN GOTO 5090
5086 LET T = CS(CSP) : BD(T) = BP : CSP = CSP-1 : GOTO 5010
5090 IF W$ <> "BEGIN" THEN GOTO 5095
5091 CSP = CSP+1 : CS(CSP) = BP : GOTO 5010
5095 IF W$ <> "UNTIL" THEN GOTO 5098
5096 BD(BP) = -4 : BP = BP+1
5097 LET T = CS(CSP) : BD(BP) = T : BP = BP+1 : CSP = CSP-1 : GOTO 5010
5098 IF W$ <> "AGAIN" THEN GOTO 5102
5099 BD(BP) = -3 : BP = BP+1
5100 LET T = CS(CSP) : BD(BP) = T : BP = BP+1 : CSP = CSP-1 : GOTO 5010
5102 IF W$ <> "DO" THEN GOTO 5106
5103 BD(BP) = -5 : BP = BP+1
5104 CSP = CSP+1 : CS(CSP) = BP : GOTO 5010
5106 IF W$ <> "LOOP" THEN GOTO 5110
5107 BD(BP) = -6 : BP = BP+1
5108 LET T = CS(CSP) : BD(BP) = T : BP = BP+1 : CSP = CSP-1 : GOTO 5010
5110 IF W$ = "I" THEN BD(BP) = -8 : BP = BP+1 : GOTO 5010
5111 IF W$ = "RECURSE" THEN BD(BP) = LATEST : BP = BP+1 : GOTO 5010
5112 IF W$ = "EXIT" THEN BD(BP) = 0 : BP = BP+1 : GOTO 5010
5200 REM === Dictionary lookup ===
5201 GOSUB 1200
5202 IF FI = 0 THEN GOTO 5300
5203 IF STATE = 0 OR DT(FI) = 4 THEN GOTO 5210
5204 BD(BP) = FI : BP = BP+1 : GOTO 5010
5210 IF DT(FI) = 1 THEN GOTO 5220
5211 IF DT(FI) = 2 THEN SP = SP+1 : DS(SP) = DA(FI) : GOTO 5010
5212 IF DT(FI) = 3 THEN SP = SP+1 : DS(SP) = DA(FI) : GOTO 5010
5213 GOSUB 3000
5214 GOTO 5010
5220 LET XA = DA(FI) : GOSUB 4000
5221 GOTO 5010
5300 REM === Number parsing ===
5301 GOSUB 1100
5302 IF NF = 0 THEN GOTO 5390
5303 IF STATE = 0 THEN SP = SP+1 : DS(SP) = NV : GOTO 5010
5304 BD(BP) = -1 : BP = BP+1
5305 BD(BP) = NV : BP = BP+1 : GOTO 5010
5390 PRINT W$; " ?"
5391 IF STATE = 1 THEN DP = DP-1 : LATEST = DL(DP) : STATE = 0
5392 RETURN
9000 REM === Primitives (30 words) ===
9010 DATA "DUP", 0, "DROP", 0, "SWAP", 0, "OVER", 0, "ROT", 0
9020 DATA "+", 0, "-", 0, "*", 0, "/", 0, "MOD", 0
9021 DATA "NEGATE", 0, "1+", 0, "1-", 0
9030 DATA "=", 0, "<", 0, ">", 0, "0=", 0, "0<", 0
9031 DATA "AND", 0, "OR", 0, "NOT", 0
9040 DATA ".", 0, ".S", 0, "CR", 0, "EMIT", 0, "SPACE", 0
9050 DATA "FETCH", 0, "STORE", 0, "+STORE", 0
9060 DATA "BYE", 0, "WORDS", 0
9099 DATA "***", 0
