5 REM === VIC FORTH for BASIC++ ===
10 REM =============================================
11 REM  VIC FORTH -- A Forth Interpreter
12 REM  Written in BASIC++ (GWBS dialect)
13 REM  Inspired by HES VIC Forth / Fig-Forth
14 REM =============================================
30 REM
100 REM --- Data Stack ---
111 DIM DS(128)
112 LET SP = 0
120 REM --- Return Stack ---
121 DIM RS(64)
122 LET RP = 0
130 REM --- Dictionary ---
131 REM DW$(i)=name DL(i)=link DT(i)=type DA(i)=body
139 DIM DL(256)
140 DIM DT(256)
141 DIM DA(256)
142 LET DP = 1
143 LET LATEST = 0
150 REM --- Body storage ---
153 DIM BD(2048)
154 LET BP = 1
160 REM --- User memory ---
161 DIM UM(1024)
162 LET UP = 1
170 REM --- Interpreter state ---
171 LET STATE = 0
172 LET FBASE = 10
173 LET RUNNING = 1
175 LET IPOS = 0
176 LET ILEN = 0
180 REM --- Compilation helpers ---
181 DIM CS(64)
182 LET CSP = 0
190 REM --- String literal storage ---
194 LET SLP = 1
195 REM
210 REM =============================================
211 REM  INSTALL PRIMITIVES INTO DICTIONARY
212 REM =============================================
213 GOSUB 8000
220 REM =============================================
221 REM  MAIN INTERPRETER LOOP
222 REM =============================================
223 PRINT ""
224 PRINT "VIC FORTH for BASIC++"
225 PRINT "Inspired by HES VIC Forth / Fig-Forth"
226 PRINT "Type WORDS for dictionary. BYE to exit."
228 PRINT ""
230 REM --- Outer Interpreter ---
231 IF STATE = 0 THEN PRINT "ok ";
232 DO
234   LINE INPUT L$
235   IF LEN(L$) = 0 THEN GOTO 231
237   LET IPOS = 1
238   LET ILEN = LEN(L$)
239   GOSUB 5000
240   IF RUNNING = 0 THEN GOTO 299
241   IF STATE = 0 THEN PRINT " ok"
242 LOOP
243 GOTO 231
299 PRINT "Goodbye."
300 END
1000 REM =============================================
1001 REM  PARSE NEXT WORD FROM INPUT
1002 REM  Returns W$ = word, or W$ = "" if EOL
1003 REM =============================================
1004 LET W$ = ""
1010 REM --- Skip whitespace ---
1011 IF IPOS > ILEN THEN RETURN
1012 IF MID$(L$, IPOS, 1) = " " THEN IPOS = IPOS + 1 : GOTO 1011
1013 IF IPOS > ILEN THEN RETURN
1020 REM --- Collect word ---
1021 LET J = IPOS
1022 IF IPOS > ILEN THEN GOTO 1030
1023 IF MID$(L$, IPOS, 1) <> " " THEN IPOS = IPOS + 1 : GOTO 1022
1030 LET W$ = MID$(L$, J, IPOS - J)
1040 REM --- Uppercase ---
1041 LET U$ = ""
1042 FOR I = 1 TO LEN(W$)
1043   LET C = ASC(MID$(W$, I, 1))
1044   IF C >= 97 AND C <= 122 THEN C = C - 32
1045   LET U$ = U$ + CHR$(C)
1046 NEXT I
1047 LET W$ = U$
1050 RETURN
2000 REM =============================================
2001 REM  DICTIONARY LOOKUP
2002 REM  Input: W$  Output: FI (0=not found)
2003 REM =============================================
2005 LET FI = LATEST
2010 IF FI = 0 THEN RETURN
2011 IF DW$(FI) = W$ THEN RETURN
2012 LET FI = DL(FI)
2013 GOTO 2010
3000 REM =============================================
3001 REM  EXECUTE A PRIMITIVE BY INDEX (FI)
3002 REM =============================================
3004 LET P$ = DW$(FI)
3010 REM --- Stack operations ---
3011 IF P$ = "DUP" THEN DS(SP + 1) = DS(SP) : SP = SP + 1 : RETURN
3012 IF P$ = "DROP" THEN SP = SP - 1 : RETURN
3013 IF P$ = "SWAP" THEN LET V = DS(SP) : DS(SP) = DS(SP-1) : DS(SP-1) = V : RETURN
3014 IF P$ = "OVER" THEN SP = SP + 1 : DS(SP) = DS(SP-2) : RETURN
3015 IF P$ = "ROT" THEN LET V = DS(SP-2) : DS(SP-2) = DS(SP-1) : DS(SP-1) = DS(SP) : DS(SP) = V : RETURN
3016 IF P$ = "-ROT" THEN LET V = DS(SP) : DS(SP) = DS(SP-1) : DS(SP-1) = DS(SP-2) : DS(SP-2) = V : RETURN
3017 IF P$ = "2DUP" THEN DS(SP+1) = DS(SP-1) : DS(SP+2) = DS(SP) : SP = SP + 2 : RETURN
3018 IF P$ = "2DROP" THEN SP = SP - 2 : RETURN
3021 IF P$ = "?DUP" THEN IF DS(SP) <> 0 THEN DS(SP+1) = DS(SP) : SP = SP + 1
3022 IF P$ = "?DUP" THEN RETURN
3023 IF P$ = "NIP" THEN DS(SP-1) = DS(SP) : SP = SP - 1 : RETURN
3025 IF P$ = "DEPTH" THEN SP = SP + 1 : DS(SP) = SP - 1 : RETURN
3026 IF P$ = ">R" THEN RP = RP + 1 : RS(RP) = DS(SP) : SP = SP - 1 : RETURN
3027 IF P$ = "R>" THEN SP = SP + 1 : DS(SP) = RS(RP) : RP = RP - 1 : RETURN
3028 IF P$ = "R@" THEN SP = SP + 1 : DS(SP) = RS(RP) : RETURN
3100 REM --- Arithmetic ---
3101 IF P$ = "+" THEN DS(SP-1) = DS(SP-1) + DS(SP) : SP = SP - 1 : RETURN
3102 IF P$ = "-" THEN DS(SP-1) = DS(SP-1) - DS(SP) : SP = SP - 1 : RETURN
3103 IF P$ = "*" THEN DS(SP-1) = DS(SP-1) * DS(SP) : SP = SP - 1 : RETURN
3104 IF P$ = "/" THEN DS(SP-1) = INT(DS(SP-1) / DS(SP)) : SP = SP - 1 : RETURN
3105 IF P$ = "MOD" THEN DS(SP-1) = DS(SP-1) MOD DS(SP) : SP = SP - 1 : RETURN
3106 IF P$ = "/MOD" THEN LET V = DS(SP-1) : LET V2 = DS(SP) : DS(SP-1) = V MOD V2 : DS(SP) = INT(V / V2) : RETURN
3109 IF P$ = "1+" THEN DS(SP) = DS(SP) + 1 : RETURN
3110 IF P$ = "1-" THEN DS(SP) = DS(SP) - 1 : RETURN
3113 IF P$ = "2*" THEN DS(SP) = DS(SP) * 2 : RETURN
3114 IF P$ = "2/" THEN DS(SP) = INT(DS(SP) / 2) : RETURN
3115 IF P$ = "NEGATE" THEN DS(SP) = -DS(SP) : RETURN
3116 IF P$ = "ABS" THEN DS(SP) = ABS(DS(SP)) : RETURN
3117 IF P$ = "MIN" THEN IF DS(SP) < DS(SP-1) THEN DS(SP-1) = DS(SP)
3118 IF P$ = "MIN" THEN SP = SP - 1 : RETURN
3119 IF P$ = "MAX" THEN IF DS(SP) > DS(SP-1) THEN DS(SP-1) = DS(SP)
3120 IF P$ = "MAX" THEN SP = SP - 1 : RETURN
3200 REM --- Comparisons ---
3201 IF P$ = "=" THEN IF DS(SP-1) = DS(SP) THEN DS(SP-1) = -1 ELSE DS(SP-1) = 0
3202 IF P$ = "=" THEN SP = SP - 1 : RETURN
3203 IF P$ = "<>" THEN IF DS(SP-1) <> DS(SP) THEN DS(SP-1) = -1 ELSE DS(SP-1) = 0
3204 IF P$ = "<>" THEN SP = SP - 1 : RETURN
3205 IF P$ = "<" THEN IF DS(SP-1) < DS(SP) THEN DS(SP-1) = -1 ELSE DS(SP-1) = 0
3206 IF P$ = "<" THEN SP = SP - 1 : RETURN
3207 IF P$ = ">" THEN IF DS(SP-1) > DS(SP) THEN DS(SP-1) = -1 ELSE DS(SP-1) = 0
3208 IF P$ = ">" THEN SP = SP - 1 : RETURN
3213 IF P$ = "0=" THEN IF DS(SP) = 0 THEN DS(SP) = -1 ELSE DS(SP) = 0
3214 IF P$ = "0=" THEN RETURN
3215 IF P$ = "0<" THEN IF DS(SP) < 0 THEN DS(SP) = -1 ELSE DS(SP) = 0
3216 IF P$ = "0<" THEN RETURN
3217 IF P$ = "0>" THEN IF DS(SP) > 0 THEN DS(SP) = -1 ELSE DS(SP) = 0
3218 IF P$ = "0>" THEN RETURN
3300 REM --- Logical ---
3301 IF P$ = "AND" THEN DS(SP-1) = INT(DS(SP-1)) AND INT(DS(SP)) : SP = SP - 1 : RETURN
3302 IF P$ = "OR" THEN DS(SP-1) = INT(DS(SP-1)) OR INT(DS(SP)) : SP = SP - 1 : RETURN
3303 IF P$ = "XOR" THEN DS(SP-1) = INT(DS(SP-1)) XOR INT(DS(SP)) : SP = SP - 1 : RETURN
3304 IF P$ = "NOT" THEN IF DS(SP) = 0 THEN DS(SP) = -1 ELSE DS(SP) = 0
3305 IF P$ = "NOT" THEN RETURN
3306 IF P$ = "INVERT" THEN DS(SP) = NOT INT(DS(SP)) : RETURN
3307 IF P$ = "TRUE" THEN SP = SP + 1 : DS(SP) = -1 : RETURN
3308 IF P$ = "FALSE" THEN SP = SP + 1 : DS(SP) = 0 : RETURN
3400 REM --- Output ---
3401 IF P$ = "." THEN PRINT STR$(DS(SP)); " "; : SP = SP - 1 : RETURN
3402 IF P$ = ".S" THEN GOSUB 3450 : RETURN
3403 IF P$ = "CR" THEN PRINT "" : RETURN
3404 IF P$ = "EMIT" THEN PRINT CHR$(INT(DS(SP))); : SP = SP - 1 : RETURN
3405 IF P$ = "SPACE" THEN PRINT " "; : RETURN
3406 IF P$ = "SPACES" THEN FOR I = 1 TO DS(SP) : PRINT " "; : NEXT I : SP = SP - 1 : RETURN
3407 IF P$ = "BL" THEN SP = SP + 1 : DS(SP) = 32 : RETURN
3450 REM --- .S ---
3451 PRINT "<"; SP; "> ";
3452 IF SP > 0 THEN FOR I = 1 TO SP : PRINT DS(I); " "; : NEXT I
3453 RETURN
3500 REM --- Memory ---
3501 IF P$ = "@" THEN DS(SP) = UM(DS(SP)) : RETURN
3502 IF P$ = "!" THEN UM(DS(SP)) = DS(SP-1) : SP = SP - 2 : RETURN
3503 IF P$ = "+!" THEN UM(DS(SP)) = UM(DS(SP)) + DS(SP-1) : SP = SP - 2 : RETURN
3506 IF P$ = "HERE" THEN SP = SP + 1 : DS(SP) = UP : RETURN
3507 IF P$ = "ALLOT" THEN UP = UP + DS(SP) : SP = SP - 1 : RETURN
3508 IF P$ = "," THEN UM(UP) = DS(SP) : UP = UP + 1 : SP = SP - 1 : RETURN
3509 IF P$ = "CELLS" THEN RETURN
3600 REM --- Base ---
3601 IF P$ = "DECIMAL" THEN FBASE = 10 : RETURN
3602 IF P$ = "HEX" THEN FBASE = 16 : RETURN
3700 REM --- Misc ---
3701 IF P$ = "BYE" THEN RUNNING = 0 : RETURN
3702 IF P$ = "WORDS" THEN GOSUB 3750 : RETURN
3703 IF P$ = "SEE" THEN GOSUB 3800 : RETURN
3750 REM --- WORDS ---
3751 LET K = LATEST
3752 LET N = 0
3753 IF K = 0 THEN PRINT "" : RETURN
3754 PRINT DW$(K); " ";
3755 N = N + 1
3756 IF N MOD 8 = 0 THEN PRINT ""
3757 LET K = DL(K)
3758 GOTO 3753
3800 REM --- SEE ---
3801 GOSUB 1000
3802 IF W$ = "" THEN PRINT "?" : RETURN
3803 GOSUB 2000
3804 IF FI = 0 THEN PRINT W$; " ?" : RETURN
3805 IF DT(FI) = 0 OR DT(FI) = 4 THEN PRINT ": "; DW$(FI); " <primitive> ;" : RETURN
3806 IF DT(FI) = 2 THEN PRINT "VARIABLE "; DW$(FI) : RETURN
3807 IF DT(FI) = 3 THEN PRINT "CONSTANT "; DW$(FI) : RETURN
3808 IF DT(FI) = 1 THEN PRINT ": "; DW$(FI); " ";
3809 LET A = DA(FI)
3810 IF BD(A) = -1 THEN PRINT BD(A+1); " "; : A = A + 2 : GOTO 3810
3811 IF BD(A) = -2 THEN PRINT CHR$(34); SL$(BD(A+1)); CHR$(34); " "; : A = A + 2 : GOTO 3810
3812 IF BD(A) = -4 THEN PRINT "IF "; : A = A + 2 : GOTO 3810
3813 IF BD(A) = -3 THEN PRINT "ELSE "; : A = A + 2 : GOTO 3810
3814 IF BD(A) = -5 THEN PRINT "DO "; : A = A + 1 : GOTO 3810
3815 IF BD(A) = -6 THEN PRINT "LOOP "; : A = A + 2 : GOTO 3810
3817 IF BD(A) = -8 THEN PRINT "I "; : A = A + 1 : GOTO 3810
3819 IF BD(A) = 0 THEN PRINT ";" : RETURN
3820 IF BD(A) > 0 AND BD(A) < DP THEN PRINT DW$(BD(A)); " "; : A = A + 1 : GOTO 3810
3821 PRINT BD(A); " "; : A = A + 1 : GOTO 3810
4000 REM =============================================
4001 REM  EXECUTE COMPILED COLON DEFINITION
4002 REM  Input: XA = starting body address
4003 REM =============================================
4004 DO
4005   LET XT = BD(XA)
4006   IF XT = 0 THEN RETURN
4011   IF XT = -1 THEN SP = SP + 1 : DS(SP) = BD(XA+1) : XA = XA + 2 : GOTO 4200
4016   IF XT = -2 THEN PRINT SL$(BD(XA+1)); : XA = XA + 2 : GOTO 4200
4021   IF XT = -3 THEN XA = BD(XA+1) : GOTO 4200
4031   IF XT = -4 THEN IF DS(SP) = 0 THEN SP = SP-1 : XA = BD(XA+1) : GOTO 4200 ELSE SP = SP-1 : XA = XA+2 : GOTO 4200
4041   IF XT = -5 THEN RP = RP+1 : RS(RP) = DS(SP-1) : RP = RP+1 : RS(RP) = DS(SP) : SP = SP-2 : XA = XA+1 : GOTO 4200
4051   IF XT = -6 THEN RS(RP-1) = RS(RP-1) + 1 : IF RS(RP-1) < RS(RP) THEN XA = BD(XA+1) ELSE RP = RP-2 : XA = XA+2
4052   IF XT = -6 THEN GOTO 4200
4061   IF XT = -7 THEN RS(RP-1) = RS(RP-1) + DS(SP) : SP = SP-1 : IF RS(RP-1) < RS(RP) THEN XA = BD(XA+1) ELSE RP = RP-2 : XA = XA+2
4063   IF XT = -7 THEN GOTO 4200
4071   IF XT = -8 THEN SP = SP + 1 : DS(SP) = RS(RP-1) : XA = XA+1 : GOTO 4200
4076   IF XT = -9 THEN SP = SP + 1 : DS(SP) = RS(RP-3) : XA = XA+1 : GOTO 4200
4081   IF XT = -10 THEN RS(RP-1) = RS(RP) : XA = XA+1 : GOTO 4200
4100   REM --- Word reference ---
4101   IF XT > 0 AND XT < DP THEN
4102     IF DT(XT) = 0 OR DT(XT) = 4 THEN
4103       LET FI = XT
4104       GOSUB 3000
4105     ELSEIF DT(XT) = 1 THEN
4107       RP = RP + 1 : RS(RP) = XA + 1
4108       LET XA = DA(XT)
4109       GOTO 4200
4110     ELSEIF DT(XT) = 2 THEN
4112       SP = SP + 1 : DS(SP) = DA(XT)
4113     ELSEIF DT(XT) = 3 THEN
4115       SP = SP + 1 : DS(SP) = DA(XT)
4116     END IF
4117     XA = XA + 1
4118     GOTO 4200
4119   END IF
4131   PRINT "?TOKEN "; XT
4132   XA = XA + 1
4200   REM --- Check for nested return ---
4201   IF BD(XA) = 0 AND RP > 0 THEN
4203     XA = RS(RP) : RP = RP - 1
4204   END IF
4205 LOOP
4206 RETURN
5000 REM =============================================
5001 REM  INTERPRET A LINE
5002 REM =============================================
5010 GOSUB 1000
5011 IF W$ = "" THEN RETURN
5021 IF W$ = ":" AND STATE = 0 THEN
5022   GOSUB 1000
5023   IF W$ = "" THEN PRINT "? Name expected" : RETURN
5025   DW$(DP) = W$
5026   DL(DP) = LATEST
5027   DT(DP) = 1
5028   DA(DP) = BP
5029   LATEST = DP
5030   DP = DP + 1
5031   STATE = 1
5032   GOTO 5010
5033 END IF
5041 IF W$ = ";" AND STATE = 1 THEN
5042   BD(BP) = 0
5043   BP = BP + 1
5044   STATE = 0
5045   GOTO 5010
5046 END IF
5051 IF W$ = "VARIABLE" AND STATE = 0 THEN
5052   GOSUB 1000
5053   DW$(DP) = W$
5054   DL(DP) = LATEST
5055   DT(DP) = 2
5056   DA(DP) = UP
5057   LATEST = DP
5058   DP = DP + 1
5059   UM(UP) = 0
5060   UP = UP + 1
5061   GOTO 5010
5062 END IF
5071 IF W$ = "CONSTANT" AND STATE = 0 THEN
5072   GOSUB 1000
5073   DW$(DP) = W$
5074   DL(DP) = LATEST
5075   DT(DP) = 3
5076   DA(DP) = DS(SP)
5077   SP = SP - 1
5078   LATEST = DP
5079   DP = DP + 1
5080   GOTO 5010
5081 END IF
5091 IF W$ = "."+CHR$(34) AND STATE = 1 THEN
5093   LET Q$ = ""
5094   IF IPOS > ILEN THEN GOTO 5098
5095   LET T$ = MID$(L$, IPOS, 1)
5096   IPOS = IPOS + 1
5097   IF T$ = CHR$(34) THEN GOTO 5098
5098   IF T$ <> CHR$(34) AND IPOS <= ILEN + 1 THEN Q$ = Q$ + T$ : GOTO 5094
5099   SL$(SLP) = Q$
5100   BD(BP) = -2 : BP = BP + 1
5101   BD(BP) = SLP : BP = BP + 1
5102   SLP = SLP + 1
5103   GOTO 5010
5104 END IF
5107 IF W$ = "."+CHR$(34) AND STATE = 0 THEN
5108   LET Q$ = ""
5109   IF IPOS > ILEN THEN GOTO 5113
5110   LET T$ = MID$(L$, IPOS, 1)
5111   IPOS = IPOS + 1
5112   IF T$ = CHR$(34) THEN GOTO 5113
5113   IF T$ <> CHR$(34) AND IPOS <= ILEN + 1 THEN Q$ = Q$ + T$ : GOTO 5109
5114   PRINT Q$;
5115   GOTO 5010
5116 END IF
5121 IF W$ = "(" THEN
5122   IF IPOS > ILEN THEN GOTO 5010
5123   IF MID$(L$, IPOS, 1) = ")" THEN IPOS = IPOS + 1 : GOTO 5010
5124   IPOS = IPOS + 1 : GOTO 5122
5125 END IF
5129 IF W$ = "\" THEN IPOS = ILEN + 1 : GOTO 5010
5141 IF STATE = 1 THEN
5142   IF W$ = "IF" THEN BD(BP) = -4 : BP = BP+1 : CSP = CSP+1 : CS(CSP) = BP : BD(BP) = 0 : BP = BP+1 : GOTO 5010
5143   IF W$ = "ELSE" THEN BD(BP) = -3 : BP = BP+1 : LET A = BP : BD(BP) = 0 : BP = BP+1 : BD(CS(CSP)) = BP : CS(CSP) = A : GOTO 5010
5144   IF W$ = "THEN" THEN BD(CS(CSP)) = BP : CSP = CSP-1 : GOTO 5010
5146   IF W$ = "BEGIN" THEN CSP = CSP+1 : CS(CSP) = BP : GOTO 5010
5147   IF W$ = "UNTIL" THEN BD(BP) = -4 : BP = BP+1 : BD(BP) = CS(CSP) : BP = BP+1 : CSP = CSP-1 : GOTO 5010
5148   IF W$ = "AGAIN" THEN BD(BP) = -3 : BP = BP+1 : BD(BP) = CS(CSP) : BP = BP+1 : CSP = CSP-1 : GOTO 5010
5149   IF W$ = "WHILE" THEN BD(BP) = -4 : BP = BP+1 : CSP = CSP+1 : CS(CSP) = BP : BD(BP) = 0 : BP = BP+1 : GOTO 5010
5150   IF W$ = "REPEAT" THEN BD(BP) = -3 : BP = BP+1 : BD(BP) = CS(CSP-1) : BP = BP+1 : BD(CS(CSP)) = BP : CSP = CSP-2 : GOTO 5010
5151   IF W$ = "DO" THEN BD(BP) = -5 : BP = BP+1 : CSP = CSP+1 : CS(CSP) = BP : GOTO 5010
5152   IF W$ = "LOOP" THEN BD(BP) = -6 : BP = BP+1 : BD(BP) = CS(CSP) : BP = BP+1 : CSP = CSP-1 : GOTO 5010
5153   IF W$ = "+LOOP" THEN BD(BP) = -7 : BP = BP+1 : BD(BP) = CS(CSP) : BP = BP+1 : CSP = CSP-1 : GOTO 5010
5154   IF W$ = "I" THEN BD(BP) = -8 : BP = BP + 1 : GOTO 5010
5155   IF W$ = "J" THEN BD(BP) = -9 : BP = BP + 1 : GOTO 5010
5156   IF W$ = "LEAVE" THEN BD(BP) = -10 : BP = BP + 1 : GOTO 5010
5157   IF W$ = "RECURSE" THEN BD(BP) = LATEST : BP = BP + 1 : GOTO 5010
5160 END IF
5200 REM --- Dictionary lookup ---
5201 GOSUB 2000
5202 IF FI > 0 THEN
5203   IF STATE = 0 OR DT(FI) = 4 THEN
5205     IF DT(FI) = 0 OR DT(FI) = 4 THEN GOSUB 3000 : GOTO 5010
5206     IF DT(FI) = 1 THEN LET XA = DA(FI) : GOSUB 4000 : GOTO 5010
5207     IF DT(FI) = 2 THEN SP = SP + 1 : DS(SP) = DA(FI) : GOTO 5010
5208     IF DT(FI) = 3 THEN SP = SP + 1 : DS(SP) = DA(FI) : GOTO 5010
5209   ELSE
5211     BD(BP) = FI : BP = BP + 1
5212     GOTO 5010
5213   END IF
5214 END IF
5300 REM --- Try to parse as number ---
5301 LET NV = 0
5302 LET NS = 1
5303 LET NI = 1
5304 LET NL = LEN(W$)
5305 LET NF = 0
5306 IF NL = 0 THEN GOTO 5390
5308 IF MID$(W$, 1, 1) = "-" AND NL > 1 THEN NS = -1 : NI = 2
5310 IF NI > NL THEN GOTO 5340
5311 LET NC = ASC(MID$(W$, NI, 1))
5312 IF NC >= 48 AND NC <= 57 THEN NV = NV * FBASE + (NC - 48) : NF = 1 : NI = NI + 1 : GOTO 5310
5313 IF FBASE = 16 AND NC >= 65 AND NC <= 70 THEN NV = NV * 16 + (NC - 55) : NF = 1 : NI = NI + 1 : GOTO 5310
5315 NF = 0
5316 GOTO 5390
5340 IF NF = 0 THEN GOTO 5390
5342 NV = NV * NS
5343 IF STATE = 0 THEN SP = SP + 1 : DS(SP) = NV : GOTO 5010
5345 BD(BP) = -1 : BP = BP + 1
5346 BD(BP) = NV : BP = BP + 1
5347 GOTO 5010
5390 REM --- Word not found ---
5391 PRINT W$; " ?"
5392 IF STATE = 1 THEN
5394   DP = DP - 1
5395   LATEST = DL(DP)
5396   STATE = 0
5397 END IF
5398 RETURN
8000 REM =============================================
8001 REM  INSTALL PRIMITIVES
8002 REM =============================================
8011 RESTORE
8012 DO
8013   READ R$
8014   IF R$ = "***" THEN GOTO 8030
8015   READ PT
8016   DW$(DP) = R$
8017   DL(DP) = LATEST
8018   DT(DP) = PT
8019   DA(DP) = 0
8020   LATEST = DP
8021   DP = DP + 1
8022 LOOP
8030 RETURN
8100 REM --- Primitive word data ---
8102 DATA "DUP", 0, "DROP", 0, "SWAP", 0, "OVER", 0
8103 DATA "ROT", 0, "-ROT", 0, "2DUP", 0, "2DROP", 0
8104 DATA "?DUP", 0, "NIP", 0, "DEPTH", 0
8106 DATA ">R", 0, "R>", 0, "R@", 0
8110 DATA "+", 0, "-", 0, "*", 0, "/", 0
8111 DATA "MOD", 0, "/MOD", 0
8112 DATA "1+", 0, "1-", 0, "2*", 0, "2/", 0
8113 DATA "NEGATE", 0, "ABS", 0, "MIN", 0, "MAX", 0
8120 DATA "=", 0, "<>", 0, "<", 0, ">", 0
8121 DATA "0=", 0, "0<", 0, "0>", 0
8130 DATA "AND", 0, "OR", 0, "XOR", 0, "NOT", 0
8131 DATA "INVERT", 0, "TRUE", 0, "FALSE", 0
8140 DATA ".", 0, ".S", 0, "CR", 0, "EMIT", 0
8141 DATA "SPACE", 0, "SPACES", 0, "BL", 0
8150 DATA "@", 0, "!", 0, "+!", 0
8151 DATA "HERE", 0, "ALLOT", 0, ",", 0, "CELLS", 0
8160 DATA "DECIMAL", 0, "HEX", 0
8170 DATA "BYE", 0, "WORDS", 0, "SEE", 0
8199 DATA "***", 0
