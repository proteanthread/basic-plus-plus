10 REM GRAPHICS.BAS - simple text-mode graphics demo
20 CLS
30 PRINT "Text-mode box and diagonal (suitable for GW-BASIC/BASICA):"
40 FOR R=1 TO 12
50 FOR C=1 TO 40
60 IF R=1 OR R=12 OR C=1 OR C=40 OR R=C/3 THEN PRINT "*"; ELSE PRINT " ";
70 NEXT C
80 PRINT
90 NEXT R
100 PRINT
110 PRINT "Press any key to show animated diagonal..."
120 A$=INKEY$
130 IF A$="" THEN GOTO 120
140 CLS
150 FOR P=1 TO 40
160 FOR R=1 TO 12
170 FOR C=1 TO 40
180 IF C=INT((P/40)*40) AND R=INT((P/40)*12) THEN PRINT "*"; ELSE PRINT " ";
190 NEXT C
200 PRINT
210 NEXT R
220 FOR DEL=1 TO 200:NEXT DEL
230 NEXT P
240 PRINT "Done.":END
