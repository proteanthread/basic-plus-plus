10 REM MENU.BAS - simple menu with subroutines
20 DEFINT A-Z
30 CLS
40 GOSUB 200
50 INPUT "Choose (1) Hello (2) FileIO (3) Graphics (Q) Quit: ";C$
60 IF UCASE$(C$)="Q" THEN END
70 IF C$="1" THEN GOSUB 100:GOTO 40
80 IF C$="2" THEN GOSUB 110:GOTO 40
90 IF C$="3" THEN GOSUB 120:GOTO 40
95 PRINT "Invalid choice.":GOTO 40
100 REM HELLO
110 RETURN
100 REM HELLO
100 PRINT "Hello! This is a menu demo.":PRINT: RETURN
110 REM FILEIO SUB
110 PRINT "This would run file IO demo (not chained).":PRINT: RETURN
120 REM GRAPHICS SUB
120 PRINT "Graphics demo will run...":GOSUB 300:RETURN
200 REM DRAW HEADER
200 CLS
210 PRINT "=== BASIC SAMPLE MENU ===":PRINT
220 RETURN
300 REM SIMPLE GRAPHICS (uses SCREEN coords if supported)
310 CLS
320 FOR Y=1 TO 20
330 FOR X=1 TO 40
340 IF RND(1)<0.05 THEN PRINT "*"; ELSE PRINT " ";
350 NEXT X
360 PRINT
370 NEXT Y
380 PRINT: RETURN
