10 REM DEMOS.BAS - BASICA/GW-BASIC compatible single-file demo suite
20 REM Menu, Print test, File I/O, Text graphics, Simple sprite mover
30 REM Written to be compatible with BASICA/GW-BASIC (no ANSI/extended)
40 DEFINT A-Z
50 RANDOMIZE TIMER
60 GOSUB 1000
70 GOSUB 2000
80 GOSUB 3000
90 END

1000 REM --- INITIALIZE / VARIABLES ---
1010 MENU$="COMBINED DEMO MENU"
1020 PRFILE$="BASICTST.TXT"
1030 RETURN

2000 REM --- MAIN MENU LOOP ---
2010 CLS
2020 PRINT MENU$
2030 PRINT
2040 PRINT "1. Print test"
2050 PRINT "2. File I/O demo"
2060 PRINT "3. Text graphics demo"
2070 PRINT "4. Sprite mover (WASD)"
2080 PRINT "Q. Quit"
2090 PRINT
2100 INPUT "Choose option (1-4 or Q): "; CH$
2110 CH$ = LEFT$(UCASE$(CH$),1)
2120 IF CH$="Q" THEN RETURN
2130 IF CH$="1" THEN GOSUB 4000:GOTO 2010
2140 IF CH$="2" THEN GOSUB 5000:GOTO 2010
2150 IF CH$="3" THEN GOSUB 6000:GOTO 2010
2160 IF CH$="4" THEN GOSUB 7000:GOTO 2010
2170 PRINT "Invalid choice.": GOTO 2010

3000 REM --- RETURN POINT AFTER QUIT ---
3010 PRINT "Exiting demo. Goodbye!"
3020 RETURN

4000 REM --- PRINT TEST ---
4010 CLS
4020 PRINT "PRINT TEST"
4030 PRINT
4040 PRINT "This will display 10 lines on screen."
4050 PRINT "Press ENTER to also write one test line to LPT1 (if available)."
4060 INPUT A$
4070 IF A$="" THEN
4080   ON ERROR GOTO 4150
4090   OPEN "LPT1:" FOR OUTPUT AS #1
4100   PRINT #1, "Printer test line from BASICA demo."
4110   CLOSE #1
4120   PRINT "Attempted to send test line to LPT1."
4130   ON ERROR GOTO 0
4140 END IF
4150 PRINT "Printing 10 lines to screen..."
4160 FOR I=1 TO 10
4170   PRINT "Screen line ";I;" - Hello from BASIC"
4180 NEXT I
4190 PRINT
4200 PRINT "Press any key to return to menu."
4210 WHILE INKEY$="":WEND
4220 RETURN
4230 REM 4150 HANDLER
4240 PRINT "Printer I/O failed or not present. Continuing..."
4250 RESUME 4150

5000 REM --- FILE I/O DEMO ---
5010 CLS
5020 PRINT "FILE I/O DEMO"
5030 PRINT
5040 PRINT "This demo writes 5 lines to file ";PRFILE$
5050 ON ERROR GOTO 5090
5060 OPEN PRFILE$ FOR OUTPUT AS #2
5070 FOR I=1 TO 5
5080   PRINT #2, "Line ";I;" written on ";DATE$;" at ";TIME$
5090 NEXT I
5100 CLOSE #2
5110 PRINT "File written."
5120 PRINT
5130 PRINT "Now reading back the file:"
5140 OPEN PRFILE$ FOR INPUT AS #3
5150 L=0
5160 WHILE NOT EOF(3)
5170   L=L+1
5180   INPUT #3, T$
5190   PRINT L;": ";T$
5200 WEND
5210 CLOSE #3
5220 PRINT
5230 PRINT "Press any key to return to menu."
5240 WHILE INKEY$="":WEND
5250 RETURN
5260 REM 5090 FILE ERROR
5270 PRINT "File I/O error. Ensure disk is writable.": RESUME 5110

6000 REM --- TEXT GRAPHICS DEMO ---
6010 CLS
6020 PRINT "TEXT GRAPHICS DEMO"
6030 PRINT
6040 PRINT "Drawing boxed area with diagonal pattern..."
6050 PRINT
6060 TOPR=1: BOTR=12: LEFTC=1: RIGHTC=40
6070 FOR R=TOPR TO BOTR
6080   LINE$=""
6090   FOR C=LEFTC TO RIGHTC
6100     IF R=TOPR OR R=BOTR OR C=LEFTC OR C=RIGHTC OR C-LEFTC=R-TOPR THEN
6110       LINE$ = LINE$ + "*"
6120     ELSE
6130       LINE$ = LINE$ + " "
6140     END IF
6150   NEXT C
6160   PRINT LINE$
6170 NEXT R
6180 PRINT
6190 PRINT "Simple random scatter (text):"
6200 FOR R=1 TO 12
6210   LINE$=""
6220   FOR C=1 TO 40
6230     IF RND(1) < 0.06 THEN LINE$ = LINE$ + "*" ELSE LINE$ = LINE$ + " "
6240   NEXT C
6250   PRINT LINE$
6260 NEXT R
6270 PRINT
6280 PRINT "Press any key to return to menu."
6290 WHILE INKEY$="":WEND
6300 RETURN

7000 REM --- SPRITE MOVER (WASD) ---
7010 CLS
7020 PRINT "SPRITE MOVER - use W A S D to move, X to exit"
7030 PRINT
7040 MAXX = 40
7050 MAXY = 20
7060 X = INT(MAXX/2): Y = INT(MAXY/2)
7070 GOSUB 7025
7075 REM MAIN LOOP
7080 K$ = INKEY$
7090 IF K$ <> "" THEN GOSUB 7100
7100 GOTO 7080

7025 REM DRAW SCREEN ROUTINE
7026 CLS
7027 FOR R=1 TO MAXY
7028   LINE$ = ""
7029   FOR C=1 TO MAXX
7030     IF R=Y AND C=X THEN LINE$ = LINE$ + "@" ELSE LINE$ = LINE$ + " "
7031   NEXT C
7032   PRINT LINE$
7033 NEXT R
7034 PRINT
7035 RETURN

7100 REM HANDLE KEYS
7110 IF K$="W" OR K$="w" THEN Y = Y - 1: GOSUB 7025: RETURN
7120 IF K$="S" OR K$="s" THEN Y = Y + 1: GOSUB 7025: RETURN
7130 IF K$="A" OR K$="a" THEN X = X - 1: GOSUB 7025: RETURN
7140 IF K$="D" OR K$="d" THEN X = X + 1: GOSUB 7025: RETURN
7150 IF K$="X" OR K$="x" THEN CLS: PRINT "Exiting sprite demo...": RETURN
7160 REM BOUNDS
7170 IF X < 1 THEN X = 1
7180 IF X > MAXX THEN X = MAXX
7190 IF Y < 1 THEN Y = 1
7200 IF Y > MAXY THEN Y = MAXY
7210 RETURN

9990 REM --- END OF FILE MARKER ---
9991 REM (no operations below)
9999 END