1 REM === t43_dialect_mbasic.bas ===
2 REM Tests: Microsoft MBASIC (CP/M)
3 DIALECT "MBAS"
10 TEST "MBASIC arithmetic"
20 ASSERT 2+3=5
30 ASSERT 3.14>3.0
40 ENDTEST
100 TEST "MBASIC strings"
110 LET A$="MBASIC"
120 ASSERT LEN(A$)=6
130 ASSERT LEFT$(A$,1)="M"
140 ENDTEST
200 TEST "MBASIC FOR/NEXT"
210 LET S=0
220 FOR I=1 TO 5
230 LET S=S+I
240 NEXT I
250 ASSERT S=15
260 ENDTEST
300 TEST "MBASIC GOSUB"
310 LET R=0
320 GOSUB 360
330 ASSERT R=1
340 ENDTEST
350 GOTO 400
360 LET R=1
370 RETURN
400 TEST "MBASIC DATA/READ"
410 READ A,B
420 ASSERT A=10
430 ASSERT B=20
440 ENDTEST
450 DATA 10,20
999 END
