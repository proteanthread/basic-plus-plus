10 REM Part 4: File I/O & File Management
20 PRINT "Testing File I/O..."
30 MKDIR "TESTDIR"
40 CHDIR "TESTDIR"
50 OPEN "O", #1, "TEST.TXT"
60 PRINT #1, "HELLO IO"
70 CLOSE #1
80 OPEN "I", #1, "TEST.TXT"
90 INPUT #1, L$
100 CLOSE #1
110 IF L$ <> "HELLO IO" THEN PRINT "FILE READ/WRITE ERROR" : END
120 RENAME "TEST.TXT" AS "TEST2.TXT"
130 KILL "TEST2.TXT"
140 CHDIR ".."
150 RMDIR "TESTDIR"
160 PRINT "File I/O tests completed."
170 END
