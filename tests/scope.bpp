1 REM === t25_scope.bpp ===
2 REM Tests: SCOPE DISABLE/ENABLE, BEFORE/AFTER hooks, LIST, CLEAR
3 DIALECT "GWBS"
10 TEST "SCOPE DISABLE/ENABLE"
20 SCOPE DISABLE BEEP
30 SCOPE ENABLE BEEP
40 REM No crash = pass
50 ENDTEST
100 TEST "SCOPE BEFORE hook"
110 LET G=0
120 SCOPE BEFORE PRINT GOSUB 180
130 PRINT "TRIGGER"
140 ASSERT G=1
150 SCOPE CLEAR
160 ENDTEST
170 GOTO 200
180 LET G=1
190 RETURN
200 TEST "SCOPE AFTER hook"
210 LET G=0
220 SCOPE AFTER PRINT GOSUB 280
230 PRINT "TRIGGER"
240 ASSERT G=1
250 SCOPE CLEAR
260 ENDTEST
270 GOTO 300
280 LET G=1
290 RETURN
300 TEST "SCOPE CLEAR"
310 SCOPE CLEAR
320 REM Should work without crash
330 ENDTEST
999 END
