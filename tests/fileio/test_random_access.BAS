
10 REM Test Random Access
20 OPEN "tests/fileio/t_rnd.dat" FOR RANDOM AS #1 LEN = 12
30 FIELD #1, 4 AS A$, 8 AS B$
40 LSET A$ = "1234"
50 RSET B$ = "5678    "
60 PUT #1, 1
70 LSET A$ = "ABCD"
80 RSET B$ = "EFGH    "
90 PUT #1, 2
100 CLOSE #1
110 OPEN "tests/fileio/t_rnd.dat" FOR RANDOM AS #1 LEN = 12
120 FIELD #1, 4 AS X$, 8 AS Y$
130 GET #1, 2
140 IF X$ <> "ABCD" THEN PRINT "FAIL RANDOM 1": END
150 GET #1, 1
160 IF X$ <> "1234" THEN PRINT "FAIL RANDOM 2": END
170 CLOSE #1
180 PRINT "PASS RANDOM ACCESS"
190 END
