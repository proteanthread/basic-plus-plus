
10 REM Test EOF, LOF, LOC
20 OPEN "tests/fileio/t_stat.txt" FOR OUTPUT AS #1
30 PRINT #1, "1234567890"
40 CLOSE #1
50 OPEN "tests/fileio/t_stat.txt" FOR INPUT AS #1
60 IF EOF(1) THEN PRINT "FAIL EOF 1": END
70 A$ = INPUT$(5, #1)
80 IF LOC(1) <> 5 THEN PRINT "FAIL LOC 1": END
90 IF LOF(1) < 10 THEN PRINT "FAIL LOF 1": END
100 A$ = INPUT$(6, #1)
110 IF NOT EOF(1) THEN PRINT "FAIL EOF 2": END
120 CLOSE #1
130 PRINT "PASS FILE STATUS"
140 END
