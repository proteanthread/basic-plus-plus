1 REM === t33_dialect_patb.bas ===
2 REM Tests: PATB (Palo Alto Tiny BASIC) - default dialect
3 REM Integer-only, @() array, SIZE
4 DIALECT "PATB"
10 TEST "PATB integer math"
20 ASSERT 2+3=5
30 ASSERT 10*10=100
40 ASSERT 100/3=33
50 ENDTEST
100 TEST "PATB variables"
110 LET A=42
120 ASSERT A=42
130 LET B=A+8
140 ASSERT B=50
150 ENDTEST
200 TEST "PATB GOTO/GOSUB"
210 LET X=0
220 GOSUB 260
230 ASSERT X=1
240 ENDTEST
250 GOTO 300
260 LET X=1
270 RETURN
300 TEST "PATB FOR"
310 LET S=0
320 FOR I=1 TO 5
330 LET S=S+I
340 NEXT I
350 ASSERT S=15
360 ENDTEST
400 TEST "PATB SIZE"
410 LET S=SIZE
420 ASSERT S>0
430 ENDTEST
500 TEST "PATB RND"
510 LET R=RND(100)
520 ASSERT R>=1
530 ASSERT R<=100
540 ENDTEST
999 END
