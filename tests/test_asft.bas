1 REM =====================================================
2 REM  TEST_ASFT.BAS - AppleSoft BASIC Dialect Test
3 REM =====================================================
4 REM  Dialect: ASFT (AppleSoft BASIC, Microsoft 1977)
5 REM  Features: Float, strings, DIM, DATA/READ, extended
6 REM            vars, ON ERROR, no WHILE, no DO/LOOP,
7 REM            no CLS, no TRON
8 REM  Prompt: "]"
9 REM =====================================================
10 REM  Usage: DIALECT "ASFT" : LOAD "tests/test_asft.bas" : RUN
11 REM =====================================================
12 LET P=0
13 LET F=0

100 TEST "Arithmetic"
110 ASSERT 2+3=5
120 ASSERT 10-7=3
130 ASSERT 6*7=42
140 ASSERT 100/10=10
150 ASSERT -(-5)=5
160 ENDTEST

200 TEST "Floating Point"
210 A=3.14
220 ASSERT A>3.0
230 ASSERT A<4.0
240 B=SQR(16)
250 ASSERT B=4
260 C=INT(9.9)
270 ASSERT C=9
280 ENDTEST

300 TEST "String Operations"
310 A$="APPLE"
320 ASSERT LEN(A$)=5
330 B$=LEFT$(A$,3)
340 ASSERT B$="APP"
350 C$=RIGHT$(A$,3)
360 ASSERT C$="PLE"
370 D$=MID$(A$,3,2)
380 ASSERT D$="PL"
390 ASSERT CHR$(65)="A"
395 ASSERT ASC("Z")=90
396 ENDTEST

400 TEST "Named Variables"
410 SCORE=100
420 HISCORE=999
430 ASSERT SCORE=100
440 ASSERT HISCORE=999
450 ENDTEST

500 TEST "DIM Arrays"
510 DIM A(10)
520 FOR I=0 TO 10
530 A(I)=I*3
540 NEXT I
550 ASSERT A(0)=0
560 ASSERT A(5)=15
570 ASSERT A(10)=30
580 DIM S$(3)
590 S$(0)="APPLE"
600 ASSERT S$(0)="APPLE"
610 ENDTEST

700 TEST "FOR/NEXT"
710 S=0
720 FOR I=1 TO 5
730 S=S+I
740 NEXT I
750 ASSERT S=15
760 S=0
770 FOR I=10 TO 1 STEP -1
780 S=S+1
790 NEXT I
800 ASSERT S=10
810 ENDTEST

900 TEST "IF/THEN/ELSE"
910 X=0
920 IF 1>0 THEN X=1
930 ASSERT X=1
940 IF 0>1 THEN X=99 ELSE X=42
950 ASSERT X=42
960 ENDTEST

1000 TEST "GOSUB/RETURN"
1010 R=0
1020 GOSUB 1060
1030 ASSERT R=88
1040 ENDTEST
1050 GOTO 1100
1060 R=88
1070 RETURN

1100 TEST "DATA/READ/RESTORE"
1110 READ A, B, C
1120 ASSERT A=1
1130 ASSERT B=2
1140 ASSERT C=3
1150 READ D$
1160 ASSERT D$="APPLE"
1170 RESTORE
1180 READ X
1190 ASSERT X=1
1200 ENDTEST
1210 DATA 1, 2, 3, "APPLE"

1300 TEST "Math Functions"
1310 ASSERT ABS(-7)=7
1320 ASSERT SGN(-1)=-1
1330 ASSERT SGN(0)=0
1340 ASSERT SGN(1)=1
1350 ENDTEST

1400 TEST "ON GOTO"
1410 X=1
1420 ON X GOTO 1440, 1450, 1460
1430 GOTO 1470
1440 Y=1: GOTO 1470
1450 Y=2: GOTO 1470
1460 Y=3: GOTO 1470
1470 ASSERT Y=1
1480 ENDTEST

9000 PRINT ""
9010 PRINT "=== APPLESOFT BASIC TESTS COMPLETE ==="
9020 END
