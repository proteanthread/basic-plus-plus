' test_network_io.bas
' Tests Network I/O functions

10 PRINT "=== NETWORK IO TEST ==="
20 ' Verify that the network functions return 0 or empty string when no channel is open or disconnected
30 IF NSTATUS(1) <> 0 THEN PRINT "FAIL NSTATUS": END
40 IF NHTTPSTATUS(1) <> 0 THEN PRINT "FAIL NHTTPSTATUS": END
50 IF NEOF(1) <> 1 THEN PRINT "FAIL NEOF": END
60 IF NBYTESWAITING(1) <> 0 THEN PRINT "FAIL NBYTESWAITING": END
70 IF NCONNECTED(1) <> 0 THEN PRINT "FAIL NCONNECTED": END
80 IF NERROR(1) <> 0 THEN PRINT "FAIL NERROR": END
90 IF NINFO$("MAC") = "INVALID" THEN PRINT "FAIL NINFO$"
100 IF NJSONQUERY$(1, "$") <> "" THEN PRINT "FAIL NJSONQUERY$"
110 IF NWRITE(1, "TEST") <> 0 THEN PRINT "FAIL NWRITE"
120 IF NREAD$(1, 100) <> "" THEN PRINT "FAIL NREAD$"

200 PRINT "PASS NETWORK IO"
210 END
