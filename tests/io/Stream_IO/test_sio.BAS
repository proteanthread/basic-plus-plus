10 REM --- Stream I/O Tests ---
20 OPEN "siotest.txt" FOR OUTPUT AS #1
30 PRINT "Testing SIOWRITE..."
40 W = SIOWRITE(1, "TEST1234567890")
50 IF W <= 0 THEN PRINT "SIOWRITE FAILED": END
60 PRINT "Testing SIOFLUSH..."
70 F = SIOFLUSH(1)
80 CLOSE #1
90 OPEN "siotest.txt" FOR INPUT AS #1
100 PRINT "Testing SIOAVAIL..."
110 A = SIOAVAIL(1)
120 IF A <= 0 THEN PRINT "SIOAVAIL FAILED": END
130 PRINT "Testing SIOREAD$..."
140 R$ = SIOREAD$(1, 4)
150 IF R$ <> "TEST" THEN PRINT "SIOREAD$ FAILED": END
160 PRINT "Testing SIOSTATUS..."
170 ST = SIOSTATUS(1)
180 IF (ST AND 1) = 0 THEN PRINT "SIOSTATUS FAILED": END
190 CLOSE #1
200 KILL "siotest.txt"
210 PRINT "STREAM I/O PASSED"
220 END
