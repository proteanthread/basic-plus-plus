' test_stream_io.bas
' Tests Stream I/O functions

10 PRINT "=== STREAM IO TEST ==="
20 ' Verify that stream functions return 0 or empty string when channel isn't open
30 IF SIOAVAIL(1) <> 0 THEN PRINT "FAIL SIOAVAIL": END
40 IF SIOFLUSH(1) <> 0 THEN PRINT "FAIL SIOFLUSH": END
50 IF SIOREADLN$(1) <> "" THEN PRINT "FAIL SIOREADLN$": END
60 IF SIOREAD$(1, 10) <> "" THEN PRINT "FAIL SIOREAD$": END
70 IF SIOSEEK(1, 0) <> 0 THEN PRINT "FAIL SIOSEEK": END
80 IF SIOSTATUS(1) <> 0 THEN PRINT "FAIL SIOSTATUS": END
90 IF SIOWRITE(1, "TEST") <> 0 THEN PRINT "FAIL SIOWRITE": END

200 PRINT "PASS STREAM IO"
210 END
