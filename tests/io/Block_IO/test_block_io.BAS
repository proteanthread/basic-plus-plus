' test_block_io.bas
' Tests Block I/O functions

10 PRINT "=== BLOCK IO TEST ==="
20 ' Without an open file, most block IO returns errors or defaults
30 IF BIOSIZE(1) <> 0 THEN PRINT "FAIL BIOSIZE": END
40 IF BIOSTATUS(1) <> 0 THEN PRINT "FAIL BIOSTATUS": END
50 IF BIOREAD$(1, 10) <> "" THEN PRINT "FAIL BIOREAD$": END
60 IF BIOWRITE(1, "TEST") <> 0 THEN PRINT "FAIL BIOWRITE": END
70 IF BIOFILL(1, 0, 10, 255) <> 0 THEN PRINT "FAIL BIOFILL": END
80 IF BIOCOPY(1, 0, 1, 10, 10) <> 0 THEN PRINT "FAIL BIOCOPY": END
90 IF BIOCOMPARE(1, 0, 1, 10, 10) <> 0 THEN PRINT "FAIL BIOCOMPARE": END

200 PRINT "PASS BLOCK IO"
210 END
