10 REM --- Block I/O Tests ---
20 OPEN "biotest.bin" FOR BINARY AS #1
30 PRINT "Testing BIOFILL..."
40 W = BIOFILL(1, 0, 100, 65)
50 IF W <> 100 THEN PRINT "BIOFILL FAILED": END
60 PRINT "Testing BIOWRITE..."
70 W2 = BIOWRITE(1, 10, "HELLO")
80 IF W2 <> 5 THEN PRINT "BIOWRITE FAILED": END
90 PRINT "Testing BIOSIZE..."
100 S = BIOSIZE(1)
110 IF S <> 100 THEN PRINT "BIOSIZE FAILED": END
120 PRINT "Testing BIOREAD$..."
130 R$ = BIOREAD$(1, 10, 5)
140 IF R$ <> "HELLO" THEN PRINT "BIOREAD$ FAILED": END
150 PRINT "Testing BIOCOMPARE..."
160 C = BIOCOMPARE(1, 10, "HELLO")
170 IF C <> 0 THEN PRINT "BIOCOMPARE FAILED": END
180 PRINT "Testing BIOCOPY..."
190 W3 = BIOCOPY(1, 10, 50, 5)
200 IF W3 <> 5 THEN PRINT "BIOCOPY FAILED": END
210 R2$ = BIOREAD$(1, 50, 5)
220 IF R2$ <> "HELLO" THEN PRINT "BIOCOPY VERIFY FAILED": END
230 PRINT "Testing BIOSTATUS..."
240 ST = BIOSTATUS(1)
250 IF (ST AND 1) = 0 THEN PRINT "BIOSTATUS FAILED": END
260 CLOSE #1
270 KILL "biotest.bin"
280 PRINT "BLOCK I/O PASSED"
290 END
