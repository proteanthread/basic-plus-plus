1 REM === t10_strings.bas ===
2 REM Tests: All string functions
3 DIALECT "GWBS"
10 TEST "LEN"
20 ASSERT LEN("HELLO")=5
30 ASSERT LEN("")=0
40 ASSERT LEN("A")=1
50 ENDTEST
100 TEST "LEFT$ RIGHT$"
110 ASSERT LEFT$("HELLO",3)="HEL"
120 ASSERT RIGHT$("HELLO",3)="LLO"
130 ASSERT LEFT$("HELLO",0)=""
140 ASSERT RIGHT$("HELLO",5)="HELLO"
150 ENDTEST
200 TEST "MID$"
210 ASSERT MID$("HELLO",2,3)="ELL"
220 ASSERT MID$("HELLO",1,5)="HELLO"
230 ASSERT MID$("HELLO",4,2)="LO"
240 ENDTEST
300 TEST "ASC CHR$"
310 ASSERT ASC("A")=65
320 ASSERT ASC("Z")=90
330 ASSERT CHR$(65)="A"
340 ASSERT CHR$(48)="0"
350 ENDTEST
400 TEST "STR$ VAL"
410 ASSERT VAL("42")=42
420 ASSERT VAL("0")=0
430 ASSERT VAL("3.14")>3.0
440 LET A$=STR$(42)
450 ASSERT VAL(A$)=42
460 ENDTEST
500 TEST "INSTR"
510 ASSERT INSTR("HELLO","LL")=3
520 ASSERT INSTR("HELLO","XY")=0
530 ASSERT INSTR("HELLO","H")=1
540 ENDTEST
600 TEST "SPACE$ STRING$"
610 ASSERT LEN(SPACE$(5))=5
620 ASSERT LEN(STRING$(3,"*"))=3
630 ASSERT STRING$(3,"*")="***"
640 ENDTEST
700 TEST "HEX$ OCT$ BIN$"
710 ASSERT HEX$(255)="FF"
720 ASSERT HEX$(16)="10"
730 ASSERT OCT$(8)="10"
740 ASSERT OCT$(7)="7"
750 ENDTEST
800 TEST "LCASE$ UCASE$"
810 ASSERT LCASE$("HELLO")="hello"
820 ASSERT UCASE$("hello")="HELLO"
830 ASSERT LCASE$("MiXeD")="mixed"
840 ENDTEST
850 TEST "LTRIM$ RTRIM$ TRIM$"
860 ASSERT LTRIM$("  HI")="HI"
870 ASSERT RTRIM$("HI  ")="HI"
880 ASSERT TRIM$("  HI  ")="HI"
890 ENDTEST
900 TEST "TCASE$"
910 ASSERT TCASE$("hello world")="Hello World"
920 ENDTEST
950 TEST "String Concatenation"
960 LET A$="HELLO"
970 LET B$=" WORLD"
980 LET C$=A$+B$
990 ASSERT C$="HELLO WORLD"
995 ENDTEST
998 END
