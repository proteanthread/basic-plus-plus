' --- VARIABLES CONVERSION TEST ---
' Tests: CDBL, CINT, CSNG

A = 3.9
B = CINT(A)
C = CSNG(A)
D = CDBL(A)

IF B <> 4 AND B <> 3 THEN PRINT "CINT FAILED": GOTO 9999
IF C < 3.8 OR C > 4.0 THEN PRINT "CSNG FAILED": GOTO 9999
IF D < 3.8 OR D > 4.0 THEN PRINT "CDBL FAILED": GOTO 9999

PRINT "ALL TESTS PASSED"
END
9999 PRINT "TEST SUITE FAILED"
