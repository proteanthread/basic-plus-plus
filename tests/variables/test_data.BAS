' --- VARIABLES DATA TEST ---
' Tests: READ, DATA, RESTORE

DATA 10, 20, 30
DATA "HELLO", "WORLD"

READ A, B, C
READ S1$, S2$

IF A <> 10 OR B <> 20 OR C <> 30 THEN PRINT "READ NUMBERS FAILED": GOTO 9999
IF S1$ <> "HELLO" OR S2$ <> "WORLD" THEN PRINT "READ STRINGS FAILED": GOTO 9999

RESTORE
READ X
IF X <> 10 THEN PRINT "RESTORE FAILED": GOTO 9999

PRINT "ALL TESTS PASSED"
END
9999 PRINT "TEST SUITE FAILED"
