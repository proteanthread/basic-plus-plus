10 PRINT "--- VARIABLES & DATA TYPES TEST ---"
20 OPTION STRICT OFF
30 A% = 32767
40 B% = -32768
50 C! = 3.14159
60 D# = 1.234567890123456
70 E$ = "STRING POOL TEST"
80 IF A% <> 32767 THEN PRINT "INT LIMIT MAX FAILED": GOTO 9999
90 IF B% <> -32768 THEN PRINT "INT LIMIT MIN FAILED": GOTO 9999
100 IF INT(C! * 100) <> 314 THEN PRINT "SINGLE FAILED": GOTO 9999
110 IF E$ <> "STRING POOL TEST" THEN PRINT "STRING VAR FAILED": GOTO 9999
120 PRINT "ALL TESTS PASSED"
130 END
9999 PRINT "TEST SUITE FAILED"

' --- ADDED FOR VARIABLES & MEMORY AUDIT ---
