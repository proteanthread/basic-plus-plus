10 PRINT "==== BIOS & MEMMAP TEST ===="
20 X$ = MEMMAP$()
30 PRINT "Initial MEMMAP$: " + X$
40 BIOS "PCJR"
50 Y$ = MEMMAP$()
60 PRINT "MEMMAP$ after BIOS PCJR: " + Y$
70 IF Y$ = "PCJR" THEN PRINT "SUCCESS: BIOS PCJR loaded." ELSE PRINT "FAIL: BIOS PCJR not loaded."
80 BIOS "MSDOS"
90 Z$ = MEMMAP$()
100 PRINT "MEMMAP$ after BIOS MSDOS: " + Z$
110 IF Z$ = "MSDOS" THEN PRINT "SUCCESS: BIOS MSDOS loaded." ELSE PRINT "FAIL: BIOS MSDOS not loaded."
120 BIOS "PCAT"
130 W$ = MEMMAP$()
140 PRINT "MEMMAP$ after BIOS PCAT: " + W$
150 IF W$ = "PCAT" THEN PRINT "SUCCESS: BIOS PCAT loaded." ELSE PRINT "FAIL: BIOS PCAT not loaded."
160 ON ERROR GOTO 1000
170 BIOS "INVALID"
180 PRINT "FAIL: Should have thrown an error."
190 END
1000 PRINT "SUCCESS: Invalid BIOS threw error:", ERR, ERR_WHAT$
1010 END
