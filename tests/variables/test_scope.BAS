' --- VARIABLES SCOPE TEST ---
' Tests: COMMON, SHARED, STATIC, LOCAL, CONST

' 1. CONST
CONST PI = 3.14159
IF PI < 3.0 THEN PRINT "CONST FAILED": GOTO 9999

' 2. COMMON / SHARED / LOCAL / STATIC
' We are just testing parsing and execution without crashing for now, 
' since scoping rules require SUB/FUNCTION testing which is in flow.
COMMON G1
SHARED G2
G1 = 10
G2 = 20

' Create a test procedure
PROCEDURE TESTSCOPE
  STATIC ST1
  LOCAL L1
  ST1 = ST1 + 1
  L1 = L1 + 1
  IF ST1 < 1 THEN PRINT "STATIC FAILED": GOTO 9999
END PROCEDURE

CALL TESTSCOPE
CALL TESTSCOPE

PRINT "ALL TESTS PASSED"
END
9999 PRINT "TEST SUITE FAILED"
