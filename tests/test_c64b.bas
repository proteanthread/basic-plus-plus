1 REM =====================================================
2 REM  TEST_C64B.BAS - Commodore BASIC v2 Dialect Test
3 REM =====================================================
4 REM  Dialect: C64B (Commodore BASIC v2, Microsoft 1982)
5 REM  Features: Float, strings, DIM, DATA/READ, extended
6 REM            vars, no WHILE, no DO/LOOP, no ON ERROR,
7 REM            no CLS, no TRON/TROFF
8 REM  Prompt: "READY."
9 REM =====================================================
10 REM  Usage: DIALECT "C64B" : LOAD "tests/test_c64b.bas" : RUN
11 REM =====================================================
12 LET P=0
13 LET F=0

100 TEST "Arithmetic"
110 ASSERT 2+3=5
120 ASSERT 10-7=3
130 ASSERT 6*7=42
140 ASSERT 100/10=10
150 ASSERT -(-5)=5
160 ENDTEST

200 TEST "Floating Point"
210 A=3.14
220 ASSERT A>3.0
230 ASSERT A<4.0
240 B=SQR(144)
250 ASSERT B=12
260 C=INT(3.7)
270 ASSERT C=3
280 ENDTEST

300 TEST "String Operations"
310 A$="COMMODORE"
320 ASSERT LEN(A$)=9
330 B$=LEFT$(A$,4)
340 ASSERT B$="COMM"
350 C$=RIGHT$(A$,4)
360 ASSERT C$="DORE"
370 D$=MID$(A$,4,3)
380 ASSERT D$="MOD"
390 ASSERT CHR$(65)="A"
395 ASSERT ASC("A")=65
396 ASSERT VAL("42")=42
397 ENDTEST

400 TEST "Named Variables"
410 SCORE=1000
420 LIVES=3
430 ASSERT SCORE=1000
440 ASSERT LIVES=3
450 ENDTEST

500 TEST "DIM Arrays"
510 DIM A(10), B$(5)
520 FOR I=0 TO 10
530 A(I)=I*I
540 NEXT I
550 ASSERT A(3)=9
560 ASSERT A(10)=100
570 B$(0)="READY."
580 ASSERT B$(0)="READY."
590 ENDTEST

600 TEST "FOR/NEXT"
610 S=0
620 FOR I=1 TO 5
630 S=S+I
640 NEXT I
650 ASSERT S=15
660 S=0
670 FOR I=10 TO 1 STEP -1
680 S=S+1
690 NEXT I
700 ASSERT S=10
710 ENDTEST

800 TEST "IF/THEN/ELSE"
810 X=0
820 IF 1>0 THEN X=1
830 ASSERT X=1
840 IF 0>1 THEN X=99 ELSE X=64
850 ASSERT X=64
860 ENDTEST

900 TEST "GOSUB/RETURN"
910 R=0
920 GOSUB 960
930 ASSERT R=64
940 ENDTEST
950 GOTO 1000
960 R=64
970 RETURN

1000 TEST "DATA/READ/RESTORE"
1010 READ A, B, C
1020 ASSERT A=64
1030 ASSERT B=128
1040 ASSERT C=255
1050 RESTORE
1060 READ X
1070 ASSERT X=64
1080 ENDTEST
1090 DATA 64, 128, 255

1100 TEST "Math Functions"
1110 ASSERT ABS(-42)=42
1120 ASSERT SGN(-1)=-1
1130 ASSERT SGN(0)=0
1140 ASSERT SGN(1)=1
1150 ASSERT INT(7.9)=7
1160 ASSERT SQR(25)=5
1170 ENDTEST

1200 TEST "RND (Float 0..1)"
1210 R=RND(1)
1220 ASSERT R>=0
1230 ASSERT R<1
1240 ENDTEST

1300 TEST "ON GOTO"
1310 X=2
1320 ON X GOTO 1340, 1350, 1360
1330 GOTO 1370
1340 Y=1: GOTO 1370
1350 Y=2: GOTO 1370
1360 Y=3: GOTO 1370
1370 ASSERT Y=2
1380 ENDTEST

9000 PRINT ""
9010 PRINT "=== COMMODORE BASIC v2 TESTS COMPLETE ==="
9020 END
