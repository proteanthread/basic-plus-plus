1 REM === t09_dim_arrays.bas ===
2 REM Tests: DIM 1D/2D, OPTION BASE, ERASE
3 DIALECT "GWBS"
10 TEST "DIM 1D"
20 DIM A(10)
30 LET A(0)=100
40 LET A(5)=500
50 LET A(10)=1000
60 ASSERT A(0)=100
70 ASSERT A(5)=500
80 ASSERT A(10)=1000
90 ENDTEST
100 TEST "DIM 2D"
110 DIM B(3,3)
120 LET B(1,1)=11
130 LET B(2,3)=23
140 LET B(0,0)=99
150 ASSERT B(1,1)=11
160 ASSERT B(2,3)=23
170 ASSERT B(0,0)=99
180 ENDTEST
200 TEST "String Array"
210 DIM C$(5)
220 LET C$(0)="ZERO"
230 LET C$(3)="THREE"
240 ASSERT C$(0)="ZERO"
250 ASSERT C$(3)="THREE"
260 ASSERT C$(1)=""
270 ENDTEST
300 TEST "OPTION BASE 1"
310 OPTION BASE 1
320 DIM D(5)
330 LET D(1)=10
340 LET D(5)=50
350 ASSERT D(1)=10
360 ASSERT D(5)=50
370 ENDTEST
400 TEST "ERASE"
410 ERASE D
420 REM After ERASE, array D is gone
430 REM We just test no crash
440 ENDTEST
500 TEST "DIM 3D Numeric"
510 OPTION BASE 0
520 DIM E(3,3,3)
530 LET E(0,0,0) = 1
540 LET E(1,2,3) = 123
550 LET E(3,3,3) = 999
560 LET E(2,1,0) = 210
570 ASSERT E(0,0,0) = 1
580 ASSERT E(1,2,3) = 123
590 ASSERT E(3,3,3) = 999
600 ASSERT E(2,1,0) = 210
610 ASSERT E(0,0,1) = 0
620 ENDTEST
700 TEST "DIM 3D String"
710 DIM F$(2,2,2)
720 LET F$(0,0,0) = "ORIGIN"
730 LET F$(1,1,1) = "CENTER"
740 LET F$(2,2,2) = "CORNER"
750 ASSERT F$(0,0,0) = "ORIGIN"
760 ASSERT F$(1,1,1) = "CENTER"
770 ASSERT F$(2,2,2) = "CORNER"
780 ASSERT F$(0,1,0) = ""
790 ENDTEST
800 TEST "SWAP 3D"
810 DIM G(2,2,2)
820 G(0,0,0) = 42
830 G(1,1,1) = 99
840 SWAP G(0,0,0), G(1,1,1)
850 ASSERT G(0,0,0) = 99
860 ASSERT G(1,1,1) = 42
870 ENDTEST
999 END
