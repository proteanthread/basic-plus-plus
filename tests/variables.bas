1 REM === t03_variables.bas ===
2 REM Tests: LET A-Z, string vars A$-Z$, named vars, SWAP
3 DIALECT "GWBS"
10 TEST "Single Letter Vars"
20 LET A=10
30 LET B=20
40 LET C=A+B
50 ASSERT A=10
60 ASSERT B=20
70 ASSERT C=30
80 ENDTEST
100 TEST "String Variables"
110 LET A$="HELLO"
120 LET B$="WORLD"
130 ASSERT LEN(A$)=5
140 ASSERT LEN(B$)=5
150 LET C$=A$+" "+B$
160 ASSERT LEN(C$)=11
170 ENDTEST
200 TEST "Named Variables"
210 LET COUNT=100
220 LET TOTAL=250
230 ASSERT COUNT=100
240 ASSERT TOTAL=250
250 LET RESULT=COUNT+TOTAL
260 ASSERT RESULT=350
270 ENDTEST
300 TEST "Variable Assignment"
310 LET X=5
320 LET X=X+1
330 ASSERT X=6
340 LET X=X*2
350 ASSERT X=12
360 ENDTEST
400 TEST "SWAP"
410 LET A=10
420 LET B=20
430 SWAP A, B
440 ASSERT A=20
450 ASSERT B=10
460 ENDTEST
500 TEST "String SWAP"
510 LET A$="FIRST"
520 LET B$="SECOND"
530 SWAP A$, B$
540 ASSERT A$="SECOND"
550 ASSERT B$="FIRST"
560 ENDTEST
600 TEST "Named Var SWAP"
610 LET Score=100
620 LET Total=200
630 SWAP Score, Total
640 ASSERT Score=200
650 ASSERT Total=100
660 ENDTEST
700 TEST "Array SWAP"
710 DIM M(5)
720 M(1)=10
730 M(2)=20
740 SWAP M(1), M(2)
750 ASSERT M(1)=20
760 ASSERT M(2)=10
770 ENDTEST
800 TEST "String Array SWAP"
810 DIM N$(3)
820 N$(1)="AAA"
830 N$(2)="ZZZ"
840 SWAP N$(1), N$(2)
850 ASSERT N$(1)="ZZZ"
860 ASSERT N$(2)="AAA"
870 ENDTEST
999 END
