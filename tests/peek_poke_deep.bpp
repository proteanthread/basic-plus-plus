1 REM ============================================================
2 REM  t65_peek_poke_deep.bpp
3 REM  BASIC++ PEEK/POKE & Memory Map Deep Tutorial
4 REM ============================================================
5 REM
6 REM  BASIC++ provides a 64K virtual memory segment that can
7 REM  be accessed with PEEK and POKE, just like on real 8-bit
8 REM  computers. The MEMMAP command pre-fills this memory with
9 REM  platform-specific default values.
10 REM
11 REM  KEY COMMANDS:
12 REM    DEF SEG = n    - Set the active segment (0-15)
13 REM    PEEK(addr)     - Read byte at address (0-65535)
14 REM    POKE addr, val - Write byte (0-255) at address
15 REM    MEMMAP "name"  - Load a platform memory preset
16 REM    MEMMAP LIST    - Show all available memory maps
17 REM
18 REM  SUPPORTED MEMORY MAPS:
19 REM    NONE     - Bare 64K, all zeros
20 REM    MSDOS    - MS-DOS BIOS Data Area, IVT stubs
21 REM    C64      - Commodore 64 (VIC-II, SID, CIA)
22 REM    C128     - Commodore 128 (C64 + MMU)
23 REM    VIC20    - Commodore VIC-20
24 REM    PLUS4    - Commodore Plus/4 (TED)
25 REM    PET      - Commodore PET 2001/4032
26 REM    ATARI8   - Atari 400/800/XL/XE (ANTIC, POKEY, GTIA)
27 REM    APPLE2   - Apple II / IIe
28 REM    TRS80    - TRS-80 Model I/III
29 REM    SPECTRUM  - ZX Spectrum 48K
30 REM    QL       - Sinclair QL (QDOS, 68008)
31 REM
32 DIALECT "GWBS"
33 REM
100 REM === PEEK/POKE round-trip ===
101 REM POKE writes a byte value (0-255) to a memory address.
102 REM PEEK reads the byte back. They should always match.
110 TEST "PEEK/POKE round-trip"
120 POKE 1000, 42
130 ASSERT PEEK(1000)=42
140 POKE 1000, 255
150 ASSERT PEEK(1000)=255
160 POKE 1000, 0
170 ASSERT PEEK(1000)=0
180 ENDTEST
200 REM === Writing multiple bytes ===
201 REM You can write a sequence of bytes to consecutive addresses.
202 REM This is how sprite data, character sets, and tables
203 REM are poked into memory on retro computers.
210 TEST "Multi-byte POKE"
220 FOR I=0 TO 7
230 POKE 2000+I, I*10
240 NEXT I
250 ASSERT PEEK(2000)=0
260 ASSERT PEEK(2001)=10
270 ASSERT PEEK(2007)=70
280 ENDTEST
300 REM === DEF SEG ===
301 REM DEF SEG selects the active memory segment.
302 REM Segment 0 is the default 64K segment.
303 REM On real x86 hardware, segments are 64K windows
304 REM into the 1MB address space: real_addr = seg*16 + offset
310 TEST "DEF SEG"
320 DEF SEG = 0
330 POKE 500, 77
340 ASSERT PEEK(500)=77
350 ENDTEST
400 REM === MEMMAP "C64" - Commodore 64 ===
401 REM The C64 memory map fills in VIC-II registers, SID,
402 REM CIA ports, BASIC ROM signature, and screen memory.
403 REM
404 REM Key C64 addresses:
405 REM   $0001 (1)     = CPU port: $37 (55) = all ROMs visible
406 REM   $A004 (40964) = 'C' from "CBMBASIC" ROM signature
407 REM   $D020 (53280) = Border color register (14=light blue)
408 REM   $D021 (53281) = Background color (6=blue)
409 REM   $0286 (646)   = Current text color (14=light blue)
410 TEST "MEMMAP C64 key addresses"
420 MEMMAP "C64"
430 ASSERT PEEK(1)=55
440 REM CPU port = $37 (BASIC+KERNAL+I/O visible)
450 ASSERT PEEK(40964)=67
460 REM $A004 = 'C' (ASCII 67) from CBMBASIC
470 ASSERT PEEK(53280)=14
480 REM $D020 = border color = 14 (light blue)
490 ASSERT PEEK(53281)=6
500 REM $D021 = background = 6 (blue)
510 ASSERT PEEK(646)=14
520 REM $0286 = current text color = light blue
530 ENDTEST
600 REM === MEMMAP "MSDOS" - MS-DOS ===
601 REM The MSDOS map fills in the BIOS Data Area at $0400.
602 REM
603 REM Key MSDOS addresses:
604 REM   $0449 (1097) = Video mode (3 = 80x25 color text)
605 REM   $044A (1098) = Columns per line (80)
606 REM   $0413 (1043) = Conv. memory size: $0280 (640K)
610 TEST "MEMMAP MSDOS key addresses"
620 MEMMAP "MSDOS"
630 ASSERT PEEK(1097)=3
640 REM Video mode 3 = 80x25 color text
650 ASSERT PEEK(1098)=80
660 REM 80 columns per line (low byte of word)
670 ENDTEST
700 REM === MEMMAP "ATARI8" ===
701 REM Key Atari addresses:
702 REM   $D400 (54272) = DMACTL ($22 = normal playfield)
703 REM   $FFF7 (65527) = OS version (2 = XL/XE)
710 TEST "MEMMAP ATARI8 key addresses"
720 MEMMAP "ATARI8"
730 ASSERT PEEK(65527)=2
740 REM OS version 2 = XL/XE
750 ASSERT PEEK(54272)=34
760 REM $D400 = DMACTL = $22 = 34 decimal
770 ENDTEST
800 REM === MEMMAP "NONE" - Bare memory ===
810 TEST "MEMMAP NONE"
820 MEMMAP "NONE"
830 ASSERT PEEK(0)=0
840 ASSERT PEEK(1000)=0
850 ASSERT PEEK(65535)=0
860 REM All zeros after loading NONE
870 ENDTEST
9999 END
