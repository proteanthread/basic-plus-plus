1 REM === t13_def_fn.bas ===
2 REM Tests: DEF FN single/multi param
3 DIALECT "GWBS"
10 TEST "DEF FN single param"
20 DEF FNA(X) = X*X+1
30 ASSERT FNA(5)=26
40 ASSERT FNA(0)=1
50 ASSERT FNA(3)=10
60 ENDTEST
100 TEST "DEF FN multi param"
110 DEF FNB(X,Y) = X*Y+1
120 ASSERT FNB(3,4)=13
130 ASSERT FNB(0,5)=1
140 ASSERT FNB(10,10)=101
150 ENDTEST
200 TEST "DEF FN preserves vars"
210 LET X=99
220 DEF FNC(X) = X*2
230 LET R=FNC(5)
240 ASSERT R=10
250 ASSERT X=99
260 ENDTEST
300 TEST "DEF FN with float"
310 DEF FND(X) = SQR(X)
320 ASSERT ABS(FND(144)-12)<0.001
330 ENDTEST
999 END
