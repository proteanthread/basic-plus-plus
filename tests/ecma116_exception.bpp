1 REM ============================================================
2 REM  t64_ecma116_exception.bpp
3 REM  BASIC++ ECMA-116 Exception Handling Test & Tutorial
4 REM ============================================================
5 REM
6 REM  ECMA-116 Full BASIC provides structured exception handling
7 REM  as an alternative to ON ERROR GOTO. This is more modern
8 REM  and avoids spaghetti GOTO chains for error recovery.
9 REM
10 REM  SYNTAX:
11 REM    WHEN EXCEPTION IN
12 REM      ... protected code ...
13 REM    USE
14 REM      ... error handler code ...
15 REM    END WHEN
16 REM
17 REM  If any error occurs in the protected block, execution
18 REM  jumps to the USE section. If no error occurs, the USE
19 REM  section is skipped entirely.
20 REM
21 REM  CAUSE EXCEPTION n
22 REM    Raises exception number n (like THROW in modern languages).
23 REM
24 REM  RETRY
25 REM    In the USE block, RETRY re-executes the protected block.
26 REM
27 REM  CONTINUE
28 REM    In the USE block, CONTINUE skips the rest of the
29 REM    protected block and resumes after END WHEN.
30 REM
31 DIALECT "E116"
32 REM
100 REM === Basic WHEN EXCEPTION ===
110 TEST "WHEN no error"
120 LET E=0
130 WHEN EXCEPTION IN
140 REM Protected block - no error here
150 LET X=42
160 USE
170 REM Error handler - should NOT execute
180 LET E=1
190 END WHEN
200 ASSERT E=0
210 ASSERT X=42
220 ENDTEST
300 REM === CAUSE EXCEPTION ===
301 REM CAUSE EXCEPTION n triggers exception number n.
302 REM Control transfers to the USE block.
310 TEST "CAUSE EXCEPTION"
320 LET E=0
330 WHEN EXCEPTION IN
340 CAUSE EXCEPTION 1
350 REM This line should NOT execute
360 LET E=99
370 USE
380 LET E=1
390 END WHEN
400 ASSERT E=1
410 ENDTEST
500 REM === Nested WHEN EXCEPTION ===
501 REM WHEN blocks can be nested. The innermost USE
502 REM handler catches the exception first.
510 TEST "Nested exception"
520 LET E1=0
530 LET E2=0
540 WHEN EXCEPTION IN
550 WHEN EXCEPTION IN
560 CAUSE EXCEPTION 2
570 USE
580 LET E2=1
590 END WHEN
600 USE
610 LET E1=1
620 END WHEN
630 ASSERT E2=1
640 ASSERT E1=0
645 REM Inner handler caught it, outer didn't fire
650 ENDTEST
9999 END
