10 REM ==========================================================
20 REM BASIC++ PROGRESSIVE TEST SUITE - CONTROL FLOW
30 REM ==========================================================
40 PRINT "--- RUNNING CONTROL FLOW TESTS ---"
50 GOSUB 1000 : REM Test FOR/NEXT
60 GOSUB 2000 : REM Test WHILE/WEND
70 GOSUB 3000 : REM Test DO/LOOP
80 GOSUB 4000 : REM Test REPEAT/UNTIL
90 GOSUB 5000 : REM Test IF/THEN/ELSE
100 GOSUB 6000 : REM Test SELECT CASE
110 GOSUB 7000 : REM Test DATA/READ/RESTORE
120 GOSUB 8000 : REM Test ON ERROR/CAUSE/RESUME
130 GOSUB 9000 : REM Test ON ... GOTO
140 GOSUB 10000 : REM Test DEF FN
150 GOSUB 11000 : REM Test DEFINE PROCEDURES
160 GOSUB 12000 : REM Test EVENT TRIGGERS
170 PRINT "ALL TESTS PASSED"
180 END

1000 REM --- FOR/NEXT ---
1010 PRINT "Testing FOR/NEXT..."
1020 X = 0
1030 FOR I = 1 TO 5
1040   X = X + I
1050 NEXT I
1060 IF X <> 15 THEN ERROR 901
1070 X = 0
1080 FOR I = 5 TO 1 STEP -1 : X = X + I : NEXT
1090 IF X <> 15 THEN ERROR 902
1100 X = 0
1110 FOR I = 1 TO 0 : X = X + 1 : NEXT I
1120 IF X <> 0 THEN ERROR 903 : REM Pre-check skip
1125 X = 0
1126 FOR I = 1 BY 2 TO 5 : X = X + I : ENDFOR
1127 IF X <> 9 THEN ERROR 904 : REM 1+3+5
1130 RETURN

2000 REM --- WHILE/WEND ---
2010 PRINT "Testing WHILE/WEND..."
2020 X = 0 : I = 1
2030 WHILE I <= 5
2040   X = X + I
2050   I = I + 1
2060 WEND
2070 IF X <> 15 THEN ERROR 911
2080 RETURN

3000 REM --- DO/LOOP ---
3010 PRINT "Testing DO/LOOP..."
3020 X = 0 : I = 1
3030 DO WHILE I <= 3
3040   X = X + I
3050   I = I + 1
3060 LOOP
3070 IF X <> 6 THEN ERROR 921
3080 X = 0 : I = 1
3090 DO UNTIL I > 3
3100   X = X + I
3110   I = I + 1
3120 LOOP
3130 IF X <> 6 THEN ERROR 922
3140 X = 0 : I = 1
3150 DO
3160   X = X + I
3170   I = I + 1
3180 LOOP WHILE I <= 3
3190 IF X <> 6 THEN ERROR 923
3200 X = 0 : I = 1
3210 DO
3220   X = X + I
3230   I = I + 1
3240 LOOP UNTIL I > 3
3250 IF X <> 6 THEN ERROR 924
3260 RETURN

4000 REM --- REPEAT/UNTIL ---
4010 PRINT "Testing REPEAT/UNTIL..."
4020 X = 0 : I = 1
4030 REPEAT L
4040   X = X + I
4050   I = I + 1
4060   IF I > 3 THEN EXIT L
4070 ENDREPEAT L
4080 IF X <> 6 THEN ERROR 931
4090 RETURN

5000 REM --- IF/THEN/ELSE ---
5010 PRINT "Testing IF/THEN/ELSE..."
5020 X = 0
5030 IF 1=1 THEN X = 1 ELSE X = 2
5040 IF X <> 1 THEN ERROR 941
5050 IF 1=0 THEN X = 1 ELSE X = 2
5060 IF X <> 2 THEN ERROR 942
5070 IF 1=0 THEN
5080   X = 3
5090 ELSEIF 1=1 THEN
5100   X = 4
5110 ELSE
5120   X = 5
5130 ENDIF
5140 IF X <> 4 THEN ERROR 943
5150 RETURN

6000 REM --- SELECT CASE ---
6010 PRINT "Testing SELECT CASE..."
6020 X = 2 : Y = 0
6030 SELECT CASE X
6040   CASE 1
6045     Y = 1
6050   CASE 2
6055     Y = 2
6060   CASE 3 TO 5
6065     Y = 3
6070   CASE IS > 5
6075     Y = 4
6080   CASE ELSE
6085     Y = 5
6090 END SELECT
6100 IF Y <> 2 THEN ERROR 951
6110 X = 4 : Y = 0
6120 SELECT CASE X
6130   CASE 1
6135     Y = 1
6140   CASE 3 TO 5
6145     Y = 3
6150   CASE ELSE
6155     Y = 5
6160 END SELECT
6170 IF Y <> 3 THEN ERROR 952
6180 X = 10 : Y = 0
6190 SELECT CASE X
6200   CASE 1
6205     Y = 1
6210   CASE IS > 5
6215     Y = 4
6220 END SELECT
6230 IF Y <> 4 THEN ERROR 953
6240 X = -1 : Y = 0
6250 SELECT CASE X
6260   CASE 1
6265     Y = 1
6270 END SELECT
6280 IF Y <> 0 THEN ERROR 954 : REM Silent fallthrough check
6290 RETURN

7000 REM --- DATA/READ/RESTORE ---
7010 PRINT "Testing DATA/READ/RESTORE..."
7020 READ A, B, C
7030 IF A <> 10 OR B <> 20 OR C <> 30 THEN ERROR 961
7040 RESTORE
7050 READ D
7060 IF D <> 10 THEN ERROR 962
7070 RETURN
7080 DATA 10, 20, 30
7090 DATA 40, 50, 60

8000 REM --- ON ERROR / CAUSE ---
8010 PRINT "Testing ON ERROR / CAUSE..."
8020 ON ERROR GOTO 8100
8030 X = 0
8040 CAUSE EXCEPTION 123
8050 IF X <> 1 THEN ERROR 971
8060 ON ERROR GOTO 0
8070 RETURN
8100 X = 1
8110 IF ERR <> 123 THEN PRINT "ERR FAILED": STOP
8120 RESUME NEXT

9000 REM --- ON ... GOTO ---
9010 PRINT "Testing ON ... GOTO..."
9020 X = 2 : Y = 0
9030 ON X GOTO 9060, 9070, 9080
9040 ERROR 981
9050 RETURN
9060 ERROR 981
9070 Y = 2 : GOTO 9090
9080 ERROR 981
9090 IF Y <> 2 THEN ERROR 981
9100 RETURN

10000 REM --- DEF FN ---
10010 PRINT "Testing DEF FN..."
10020 DEF FNA(Z) = Z * 2
10030 X = FNA(5)
10040 IF X <> 10 THEN ERROR 991
10050 RETURN

11000 REM --- DEFINE PROCEDURES ---
11010 PRINT "Testing DEFINE PROCEDURES..."
11020 DECLARE FUNCTION MYFUNC(A)
11030 DECLARE SUB MYSUB(B)
11040 X = MYFUNC(5)
11050 IF X <> 25 THEN ERROR 992
11060 MYSUB(10)
11070 IF G_SUB_RES <> 20 THEN ERROR 993
11080 RETURN
11090 DEFINE FUNCTION MYFUNC(A)
11100   MYFUNC = A * 5
11110 ENDDEFINE
11120 DEFINE SUB MYSUB(B)
11130   G_SUB_RES = B * 2
11140 ENDDEFINE

12000 REM --- EVENT TRIGGERS ---
12010 PRINT "Testing EVENT TRIGGERS..."
12020 ON TIMER(1) GOSUB 12100
12030 X = 0
12040 TIMER ON
12050 ' We will just let it register and turn on. Since it requires time to fire, we won't block.
12060 ' For ON BREAK etc, we just parse it to ensure it compiles and executes the statement without error.
12070 ON BREAK GOSUB 12200
12080 'TRAP ON' -> TRAP works differently, usually TRAP ON
12090 RETURN
12100 X = 1 : RETURN
12200 X = 2 : RETURN
