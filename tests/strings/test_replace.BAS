10 REM --- REPLACE$ FUNCTION TEST ---
20 OPTION STRICT OFF
30 PRINT "Testing REPLACE$"
30 IF REPLACE$("", "A", "B") <> "" THEN PRINT "REPLACE$ EMPTY SUBJ FAILED": GOTO 9999
40 IF REPLACE$("MISSISSIPPI", "IS", "XY") <> "MXYSXYSIPPI" THEN PRINT "REPLACE$ FAILED: NORMAL" : GOTO 9999
50 IF REPLACE$("MISSISSIPPI", "FOO", "XY") <> "MISSISSIPPI" THEN PRINT "REPLACE$ FAILED: NOCHANGE" : GOTO 9999
60 IF REPLACE$("MISSISSIPPI", "I", "") <> "MSSSSPP" THEN PRINT "REPLACE$ FAILED: REMOVE" : GOTO 9999
70 IF REPLACE$("", "I", "XY") <> "" THEN PRINT "REPLACE$ FAILED: EMPTY" : GOTO 9999
80 IF REPLACE$("HELLO", "", "XY") <> "HELLO" THEN PRINT "REPLACE$ FAILED: EMPTY TARGET" : GOTO 9999
90 PRINT "REPLACE$ PASSED"
100 END
9999 PRINT "TEST SUITE FAILED"
10000 END
