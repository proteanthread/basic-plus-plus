10 REM --- REVERSE$ FUNCTION TEST ---
20 OPTION STRICT OFF
30 PRINT "Testing REVERSE$"
30 IF REVERSE$("") <> "" THEN PRINT "REVERSE$ EMPTY FAILED": GOTO 9999
40 IF REVERSE$("12345") <> "54321" THEN PRINT "REVERSE$ FAILED: NORMAL" : GOTO 9999
50 IF REVERSE$("") <> "" THEN PRINT "REVERSE$ FAILED: EMPTY" : GOTO 9999
60 IF REVERSE$("A") <> "A" THEN PRINT "REVERSE$ FAILED: SINGLE" : GOTO 9999
70 PRINT "REVERSE$ PASSED"
80 END
9999 PRINT "TEST SUITE FAILED"
10000 END
