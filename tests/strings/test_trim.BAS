10 REM --- TRIM$ FUNCTION TEST ---
20 OPTION STRICT OFF
30 PRINT "Testing TRIM$"
30 IF TRIM$("") <> "" THEN PRINT "TRIM$ EMPTY FAILED": GOTO 9999
40 IF TRIM$("   ") <> "" THEN PRINT "TRIM$ SPACES ONLY FAILED": GOTO 9999
40 IF TRIM$("  Hello World  ") <> "Hello World" THEN PRINT "TRIM$ FAILED: NORMAL" : GOTO 9999
50 IF TRIM$("Hello World") <> "Hello World" THEN PRINT "TRIM$ FAILED: NOCHANGE" : GOTO 9999
60 IF TRIM$("") <> "" THEN PRINT "TRIM$ FAILED: EMPTY" : GOTO 9999
70 IF TRIM$("    ") <> "" THEN PRINT "TRIM$ FAILED: ALL SPACE" : GOTO 9999
80 PRINT "TRIM$ PASSED"
90 END
9999 PRINT "TEST SUITE FAILED"
10000 END
