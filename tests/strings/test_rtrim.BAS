10 REM --- RTRIM$ FUNCTION TEST ---
20 OPTION STRICT OFF
30 PRINT "Testing RTRIM$"
30 IF RTRIM$("") <> "" THEN PRINT "RTRIM$ EMPTY FAILED": GOTO 9999
40 IF RTRIM$("   ") <> "" THEN PRINT "RTRIM$ SPACES ONLY FAILED": GOTO 9999
40 IF RTRIM$("  Hello World  ") <> "  Hello World" THEN PRINT "RTRIM$ FAILED: NORMAL" : GOTO 9999
50 IF RTRIM$("Hello World") <> "Hello World" THEN PRINT "RTRIM$ FAILED: NOCHANGE" : GOTO 9999
60 IF RTRIM$("") <> "" THEN PRINT "RTRIM$ FAILED: EMPTY" : GOTO 9999
70 IF RTRIM$("    ") <> "" THEN PRINT "RTRIM$ FAILED: ALL SPACE" : GOTO 9999
80 PRINT "RTRIM$ PASSED"
90 END
9999 PRINT "TEST SUITE FAILED"
10000 END
