10 REM Test String Search/Replace/Trim: TRIM$, LTRIM$, RTRIM$, REPLACE$, REVERSE$, EDIT$
20 A$ = "  HELLO  "
30 IF LTRIM$(A$) <> "HELLO  " THEN PRINT "LTRIM$ FAIL 1": END
40 IF RTRIM$(A$) <> "  HELLO" THEN PRINT "RTRIM$ FAIL 1": END
50 IF TRIM$(A$) <> "HELLO" THEN PRINT "TRIM$ FAIL 1": END
60 REM Testing REPLACE$
70 IF REPLACE$("HELLO WORLD", "WORLD", "BASIC") <> "HELLO BASIC" THEN PRINT "REPLACE$ FAIL 1": END
80 IF REPLACE$("AAAA", "AA", "B") <> "BB" THEN PRINT "REPLACE$ FAIL 2": END
90 REM Testing REVERSE$
100 IF REVERSE$("BASIC") <> "CISAB" THEN PRINT "REVERSE$ FAIL 1": END
110 REM Testing EDIT$ - 2 removes spaces, 8 removes leading, 128 removes trailing, 32 uppercase
120 IF EDIT$(" hello ", 32) <> " HELLO " THEN PRINT "EDIT$ FAIL 1": END
130 PRINT "test_string_search_replace PASSED"
140 END
