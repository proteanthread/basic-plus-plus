10 PRINT "--- MID$ STATEMENT TEST ---"
20 A$ = "HELLO WORLD"
30 MID$(A$, 2, 3) = "XX"
40 IF A$ <> "HXXLO WORLD" THEN PRINT "MID$ ASSIGN 1 FAILED": PRINT A$: GOTO 9999
50 MID$(A$, 7) = "BASIC"
60 IF A$ <> "HXXLO BASIC" THEN PRINT "MID$ ASSIGN 2 FAILED": PRINT A$: GOTO 9999
70 MID$(A$, 1, 15) = "12345678901234567890"
80 IF A$ <> "12345678901" THEN PRINT "MID$ ASSIGN BOUNDS FAILED": PRINT A$: GOTO 9999
90 PRINT "ALL TESTS PASSED"
100 END
9999 PRINT "TEST SUITE FAILED"
