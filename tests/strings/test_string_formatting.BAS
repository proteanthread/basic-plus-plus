10 REM Test String Formatting Functions: CHR$, SPACE$, STRING$
20 IF CHR$(65) <> "A" THEN PRINT "CHR$ FAIL 1": END
30 IF CHR$(66) <> "B" THEN PRINT "CHR$ FAIL 2": END
40 IF SPACE$(5) <> "     " THEN PRINT "SPACE$ FAIL 1": END
50 IF SPACE$(0) <> "" THEN PRINT "SPACE$ FAIL 2": END
60 IF STRING$(3, "A") <> "AAA" THEN PRINT "STRING$ FAIL 1": END
70 IF STRING$(4, 66) <> "BBBB" THEN PRINT "STRING$ FAIL 2": END
80 PRINT "test_string_formatting PASSED"
90 END
