10 REM --- UCASE$ FUNCTION TEST ---
20 OPTION STRICT OFF
30 PRINT "Testing UCASE$"
30 IF UCASE$("") <> "" THEN PRINT "UCASE$ EMPTY FAILED": GOTO 9999
40 IF UCASE$(CHR$(0)+CHR$(255)) <> CHR$(0)+CHR$(255) THEN PRINT "UCASE$ NONALPHA FAILED": GOTO 9999
40 IF UCASE$("Hello world 123!") <> "HELLO WORLD 123!" THEN PRINT "UCASE$ FAILED: NORMAL" : GOTO 9999
50 IF UCASE$("") <> "" THEN PRINT "UCASE$ FAILED: EMPTY" : GOTO 9999
60 IF UCASE$("ALREADY UPPER") <> "ALREADY UPPER" THEN PRINT "UCASE$ FAILED: NOCHANGE" : GOTO 9999
70 PRINT "UCASE$ PASSED"
80 END
9999 PRINT "TEST SUITE FAILED"
10000 END
