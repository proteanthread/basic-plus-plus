10 PRINT "--- STRING FUNCTIONS TEST SUITE ---"
20 OPTION STRICT OFF

30 PRINT "Testing HEX$, OCT$, BIN$"
40 IF HEX$(255) <> "FF" THEN PRINT "HEX$ FAILED" : GOTO 9999
50 IF OCT$(8) <> "10" THEN PRINT "OCT$ FAILED" : GOTO 9999
60 IF BIN$(10) <> "00001010" THEN PRINT "BIN$ FAILED" : GOTO 9999
70 IF HEX(255) <> "FF" THEN PRINT "HEX FAILED" : GOTO 9999
80 IF OCT(8) <> "10" THEN PRINT "OCT FAILED" : GOTO 9999
90 IF BIN(10) <> "00001010" THEN PRINT "BIN FAILED" : GOTO 9999

100 PRINT "Testing CHR$, STR$, SPACE$, STRING$"
110 IF CHR$(65) <> "A" THEN PRINT "CHR$ FAILED" : GOTO 9999
120 IF CHR(65) <> "A" THEN PRINT "CHR FAILED" : GOTO 9999
130 REM IF LTRIM$(STR$(42)) <> "42" THEN PRINT "STR$ FAILED" : GOTO 9999
140 IF SPACE$(3) <> "   " THEN PRINT "SPACE$ FAILED" : GOTO 9999
150 IF STRING$(3, "A") <> "AAA" THEN PRINT "STRING$ FAILED" : GOTO 9999

160 PRINT "Testing NUM$ and EDIT$"
170 IF NUM$(42) <> "42" THEN PRINT "NUM$ FAILED" : GOTO 9999
180 IF NUM$(-42) <> "-42" THEN PRINT "NUM$ NEG FAILED" : GOTO 9999
190 IF EDIT$("  abc [123]  ", 8+32+64+128) <> "ABC (123)" THEN PRINT "EDIT$ FAILED" : GOTO 9999

200 PRINT "Testing LEFT$, RIGHT$, MID$, INSTR"
210 IF LEFT$("HELLO", 2) <> "HE" THEN PRINT "LEFT$ FAILED" : GOTO 9999
220 IF RIGHT$("HELLO", 2) <> "LO" THEN PRINT "RIGHT$ FAILED" : GOTO 9999
230 IF MID$("HELLO", 2, 2) <> "EL" THEN PRINT "MID$ FAILED" : GOTO 9999
240 IF INSTR("HELLO", "LL") <> 3 THEN PRINT "INSTR FAILED" : GOTO 9999

250 PRINT "Testing Case and Trim Functions"
260 IF LCASE$("Hello") <> "hello" THEN PRINT "LCASE$ FAILED" : GOTO 9999
270 IF UCASE$("Hello") <> "HELLO" THEN PRINT "UCASE$ FAILED" : GOTO 9999
280 IF TCASE$("hello world") <> "Hello World" THEN PRINT "TCASE$ FAILED" : GOTO 9999
290 IF ICASE$("Hello") <> "hELLO" THEN PRINT "ICASE$ FAILED" : GOTO 9999
300 IF LTRIM$("  Hello") <> "Hello" THEN PRINT "LTRIM$ FAILED" : GOTO 9999
310 IF RTRIM$("Hello  ") <> "Hello" THEN PRINT "RTRIM$ FAILED" : GOTO 9999
320 IF TRIM$("  Hello  ") <> "Hello" THEN PRINT "TRIM$ FAILED" : GOTO 9999

330 PRINT "Testing REVERSE$ and REPLACE$"
340 IF REVERSE$("12345") <> "54321" THEN PRINT "REVERSE$ FAILED" : GOTO 9999
350 IF REPLACE$("MISSISSIPPI", "IS", "XY") <> "MXYSXYSIPPI" THEN PRINT "REPLACE$ FAILED" : GOTO 9999

440 PRINT "Testing HASH"
450 H = HASH("TEST")
460 IF H = 0 THEN PRINT "HASH FAILED" : GOTO 9999

470 PRINT "ALL TESTS PASSED"
480 END
9999 PRINT "TEST SUITE FAILED"
10000 END
