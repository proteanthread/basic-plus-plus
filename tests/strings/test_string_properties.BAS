10 REM Test String Properties Functions: LEN, ASC, INSTR
20 A$ = "BASIC++"
30 IF LEN(A$) <> 7 THEN PRINT "LEN FAIL 1": END
40 IF LEN("") <> 0 THEN PRINT "LEN FAIL 2": END
50 IF ASC(A$) <> 66 THEN PRINT "ASC FAIL 1": END
60 IF ASC("A") <> 65 THEN PRINT "ASC FAIL 2": END
70 REM Testing INSTR
80 IF INSTR("HELLO", "LL") <> 3 THEN PRINT "INSTR FAIL 1": END
90 IF INSTR(4, "HELLO", "LL") <> 0 THEN PRINT "INSTR FAIL 2": END
100 IF INSTR("HELLO", "Z") <> 0 THEN PRINT "INSTR FAIL 3": END
110 IF INSTR(A$, "++") <> 6 THEN PRINT "INSTR FAIL 4": END
120 PRINT "test_string_properties PASSED"
130 END
