10 REM --- LTRIM$ FUNCTION TEST ---
20 OPTION STRICT OFF
30 PRINT "Testing LTRIM$"
30 IF LTRIM$("") <> "" THEN PRINT "LTRIM$ EMPTY FAILED": GOTO 9999
40 IF LTRIM$("   ") <> "" THEN PRINT "LTRIM$ SPACES ONLY FAILED": GOTO 9999
40 IF LTRIM$("  Hello World  ") <> "Hello World  " THEN PRINT "LTRIM$ FAILED: NORMAL" : GOTO 9999
50 IF LTRIM$("Hello World") <> "Hello World" THEN PRINT "LTRIM$ FAILED: NOCHANGE" : GOTO 9999
60 IF LTRIM$("") <> "" THEN PRINT "LTRIM$ FAILED: EMPTY" : GOTO 9999
70 IF LTRIM$("    ") <> "" THEN PRINT "LTRIM$ FAILED: ALL SPACE" : GOTO 9999
80 PRINT "LTRIM$ PASSED"
90 END
9999 PRINT "TEST SUITE FAILED"
10000 END
