10 REM Test String Extraction Functions: LEFT$, RIGHT$, MID$, SEG$
20 REM Testing LEFT$
30 A$ = "HELLO WORLD"
40 IF LEFT$(A$, 5) <> "HELLO" THEN PRINT "LEFT$ FAIL 1": END
50 IF LEFT$(A$, 0) <> "" THEN PRINT "LEFT$ FAIL 2": END
60 IF LEFT$(A$, 20) <> "HELLO WORLD" THEN PRINT "LEFT$ FAIL 3": END
70 REM Testing RIGHT$
80 IF RIGHT$(A$, 5) <> "WORLD" THEN PRINT "RIGHT$ FAIL 1": END
90 IF RIGHT$(A$, 0) <> "" THEN PRINT "RIGHT$ FAIL 2": END
100 IF RIGHT$(A$, 20) <> "HELLO WORLD" THEN PRINT "RIGHT$ FAIL 3": END
110 REM Testing MID$
120 IF MID$(A$, 7, 5) <> "WORLD" THEN PRINT "MID$ FAIL 1": END
130 IF MID$(A$, 7) <> "WORLD" THEN PRINT "MID$ FAIL 2": END
140 IF MID$(A$, 1, 5) <> "HELLO" THEN PRINT "MID$ FAIL 3": END
150 REM Testing SEG$ (often same as MID$ or dialect specific, we'll test basic extraction)
160 IF SEG$(A$, 7, 11) <> "WORLD" THEN PRINT "SEG$ FAIL 1": END
170 PRINT "test_string_extraction PASSED"
180 END
