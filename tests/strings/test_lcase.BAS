10 REM --- LCASE$ FUNCTION TEST ---
20 OPTION STRICT OFF
30 PRINT "Testing LCASE$"
30 IF LCASE$("") <> "" THEN PRINT "LCASE$ EMPTY FAILED": GOTO 9999
40 IF LCASE$(CHR$(0)+CHR$(255)) <> CHR$(0)+CHR$(255) THEN PRINT "LCASE$ NONALPHA FAILED": GOTO 9999
40 IF LCASE$("Hello WORLD 123!") <> "hello world 123!" THEN PRINT "LCASE$ FAILED: NORMAL" : GOTO 9999
50 IF LCASE$("") <> "" THEN PRINT "LCASE$ FAILED: EMPTY" : GOTO 9999
60 IF LCASE$("already lower") <> "already lower" THEN PRINT "LCASE$ FAILED: NOCHANGE" : GOTO 9999
70 PRINT "LCASE$ PASSED"
80 END
9999 PRINT "TEST SUITE FAILED"
10000 END
