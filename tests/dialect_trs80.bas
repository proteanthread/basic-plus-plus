1 REM === t41_dialect_trs80.bas ===
2 REM Tests: TRS-80 Level I and II BASIC
3 DIALECT "TRS1"
10 TEST "TRS1 arithmetic"
20 ASSERT 2+3=5
30 ASSERT 10/3=3
40 ENDTEST
100 TEST "TRS1 variables"
110 LET A=42
120 ASSERT A=42
130 ENDTEST
200 DIALECT "TRS2"
210 TEST "TRS2 arithmetic"
220 ASSERT 2+3=5
230 ASSERT 3.14>3.0
240 ENDTEST
300 TEST "TRS2 strings"
310 LET A$="TRS80"
320 ASSERT LEN(A$)=5
330 ENDTEST
400 TEST "TRS2 memmap"
410 MEMMAP "TRS80"
420 ASSERT PEEK(0)=243
430 ENDTEST
999 END
