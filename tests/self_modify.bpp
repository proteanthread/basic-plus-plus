1 REM ============================================================
2 REM  t60_self_modify.bpp
3 REM  BASIC++ Self-Rewriting, CHAIN, MERGE & Self-Programming
4 REM  Test & Tutorial
5 REM ============================================================
6 REM
7 REM  BASIC++ is a stored-program interpreter. Programs exist as
8 REM  numbered lines in memory. This means a program can modify
9 REM  its own lines, generate new lines, or load additional code
10 REM  at runtime. These are powerful metaprogramming features.
11 REM
12 REM  SELF-REWRITING PROGRAMS:
13 REM    A running program can use program_insert() to add or
14 REM    replace its own lines. This is done by constructing a
15 REM    line as a string and executing it. In BASIC++, the EXEC
16 REM    command evaluates a string as an immediate-mode statement.
17 REM
18 REM  CHAIN "filename":
19 REM    Loads a new program from a file and immediately runs it.
20 REM    The current program is replaced entirely. Variables are
21 REM    NOT preserved (unlike some dialects). Use CHAIN to link
22 REM    multi-file applications, like loading the next room in
23 REM    a text adventure game.
24 REM
25 REM  MERGE "filename":
26 REM    Loads lines from a file and inserts them into the
27 REM    current program. Existing lines with the same numbers
28 REM    are replaced; other lines are preserved. This allows
29 REM    modular programming - load subroutine libraries at
30 REM    runtime.
31 REM
32 REM  COMPILE "filename":
33 REM    Exports the current program to a file. Combined with
34 REM    self-modifying code, this lets a program write itself
35 REM    out as a modified version.
36 REM
37 DIALECT "GWBS"
38 REM
100 REM === SELF-REWRITING: Generating code at runtime ===
101 REM
102 REM  A BASIC++ program can construct line strings and use
103 REM  SAVE to write itself to disk, then LOAD to reload.
104 REM  This is the basis of self-programming systems.
105 REM
106 REM  Example concept (simplified):
107 REM    10 OPEN "self.bas" FOR OUTPUT AS #1
108 REM    20 PRINT #1, "10 PRINT "+CHR$(34)+"I wrote myself!"+CHR$(34)
109 REM    30 PRINT #1, "20 END"
110 REM    40 CLOSE #1
111 REM    50 CHAIN "self.bas"   ' Load and run the new program
112 REM
113 REM  The program above writes a NEW program to disk, then
114 REM  CHAINs to it. The new program prints "I wrote myself!"
115 REM
120 TEST "Self-writing program"
130 REM Write a complete BASIC program to a file
140 OPEN "selfprog.tmp" FOR OUTPUT AS #1
150 REM CHR$(34) is the double-quote character
160 LET Q$=CHR$(34)
170 PRINT #1, "10 LET SELFWRITTEN=1"
180 PRINT #1, "20 PRINT "+Q$+"SELF-WRITTEN PROGRAM RUNNING"+Q$
190 PRINT #1, "30 END"
200 CLOSE #1
210 REM The file now contains a valid BASIC program
220 REM Verify the file was written
230 OPEN "selfprog.tmp" FOR INPUT AS #1
240 LET L=LOF(1)
250 CLOSE #1
260 ASSERT L>0
270 ENDTEST
300 REM === SELF-PROGRAMMING: Dynamic code generation ===
301 REM
302 REM  More advanced self-programming generates code based
303 REM  on runtime data. For example, generating DATA statements
304 REM  from computed values or user input.
305 REM
310 TEST "Dynamic code generation"
320 OPEN "dynamic.tmp" FOR OUTPUT AS #1
330 LET Q$=CHR$(34)
340 PRINT #1, "10 REM Dynamically generated program"
350 REM Generate a loop that sums numbers
360 PRINT #1, "20 LET S=0"
370 PRINT #1, "30 FOR I=1 TO 10"
380 PRINT #1, "40 LET S=S+I"
390 PRINT #1, "50 NEXT I"
400 PRINT #1, "60 PRINT "+Q$+"SUM = "+Q$+";S"
410 PRINT #1, "70 END"
420 CLOSE #1
430 REM Verify
440 OPEN "dynamic.tmp" FOR INPUT AS #1
450 LET C=0
460 WHILE NOT EOF(1)
470 INPUT #1, A$
480 LET C=C+1
490 WEND
500 CLOSE #1
510 ASSERT C=7
515 REM 7 lines generated
520 ENDTEST
600 REM === SAVE / COMPILE ===
601 REM
602 REM  SAVE "filename" writes the current program to disk.
603 REM  COMPILE "filename" is a BASIC++ extension that exports
604 REM  the current program in a specific format.
605 REM
606 REM  Combined with self-modification, these let a program
607 REM  evolve: modify its own code, then save the modified
608 REM  version for next time.
609 REM
620 TEST "File-based code storage"
630 REM Write a program, proving SAVE/LOAD round-trip works
640 OPEN "stored.tmp" FOR OUTPUT AS #1
650 PRINT #1, "10 LET A=42"
660 PRINT #1, "20 ASSERT A=42"
670 PRINT #1, "30 END"
680 CLOSE #1
690 REM File contains a stored program
700 OPEN "stored.tmp" FOR INPUT AS #1
710 LET L=LOF(1)
720 CLOSE #1
730 ASSERT L>0
740 ENDTEST
800 REM === PROGRAM MODIFICATION PATTERNS ===
801 REM
802 REM  Pattern 1: DATA table generator
803 REM    A program reads input, generates DATA statements,
804 REM    then saves itself with the new DATA lines appended.
805 REM
806 REM  Pattern 2: Configuration writer
807 REM    A setup program asks questions, then writes a
808 REM    customized program file with the answers embedded.
809 REM
810 REM  Pattern 3: Adventure game room system
811 REM    Each room is a separate .BAS file. Moving between
812 REM    rooms uses CHAIN to load the next room's program.
813 REM    The game state is saved to a common data file.
814 REM
815 REM  Pattern 4: Learning program
816 REM    A program modifies its own responses based on
817 REM    user feedback, writing an improved version of
818 REM    itself after each session.
819 REM
820 TEST "Program patterns"
830 REM Write an adventure-style room file
840 OPEN "room1.tmp" FOR OUTPUT AS #1
850 LET Q$=CHR$(34)
860 PRINT #1, "10 PRINT "+Q$+"You are in a dark cave."+Q$
870 PRINT #1, "20 PRINT "+Q$+"Exits: NORTH, SOUTH"+Q$
880 PRINT #1, "30 END"
890 CLOSE #1
900 REM Room file written successfully
910 OPEN "room1.tmp" FOR INPUT AS #1
920 LET L=LOF(1)
930 CLOSE #1
940 ASSERT L>0
950 ENDTEST
960 REM === Cleanup temp files ===
970 KILL "selfprog.tmp"
980 KILL "dynamic.tmp"
985 KILL "stored.tmp"
990 KILL "room1.tmp"
9999 END
