10 REM QBASIC REDIM PRESERVE True Dynamic Test
15 ' $DYNAMIC
20 DIM arr(10)
30 FOR I = 1 TO 10
40   arr(I) = I * 10
50 NEXT I
60 PRINT "First 10:"
70 FOR I = 1 TO 10: PRINT arr(I);: NEXT I: PRINT
80 REM Test expanding array
90 REDIM PRESERVE arr(15)
100 FOR I = 11 TO 15
110   arr(I) = I * 10
120 NEXT I
130 PRINT "After REDIM PRESERVE 15:"
140 FOR I = 1 TO 15: PRINT arr(I);: NEXT I: PRINT
150 REM Test shrinking array
160 REDIM PRESERVE arr(5)
170 PRINT "After REDIM PRESERVE 5:"
180 FOR I = 1 TO 5: PRINT arr(I);: NEXT I: PRINT
190 END
