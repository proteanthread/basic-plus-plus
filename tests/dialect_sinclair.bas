1 REM === t44_dialect_sinclair.bas ===
2 REM Tests: Sinclair BASIC (ZX Spectrum 48K)
3 DIALECT "SINC"
10 TEST "Sinclair arithmetic"
20 ASSERT 2+3=5
30 ASSERT 3.14>3.0
40 ENDTEST
100 TEST "Sinclair variables"
110 LET A=42
120 ASSERT A=42
130 LET A$="SPECTRUM"
140 ASSERT LEN(A$)=8
150 ENDTEST
200 TEST "Sinclair FOR/NEXT"
210 LET S=0
220 FOR I=1 TO 5
230 LET S=S+I
240 NEXT I
250 ASSERT S=15
260 ENDTEST
300 TEST "Sinclair GOSUB"
310 LET R=0
320 GOSUB 360
330 ASSERT R=77
340 ENDTEST
350 GOTO 400
360 LET R=77
370 RETURN
400 TEST "Sinclair memmap"
410 MEMMAP "SPECTRUM"
420 ASSERT PEEK(22528)=56
430 ENDTEST
999 END
