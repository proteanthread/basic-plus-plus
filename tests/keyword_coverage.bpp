1 REM ===========================================================
2 REM  keyword_coverage.bpp
3 REM  Test coverage for keywords not exercised elsewhere.
4 REM ===========================================================
5 DIALECT "QBAS"
10 REM
100 REM === BLOCK IF / ENDIF ===
110 TEST "IF/ENDIF block"
120 LET X=5
130 IF X>3 THEN
140   LET Y=1
150 ELSE
160   LET Y=0
170 ENDIF
180 ASSERT Y=1
190 ENDTEST
200 REM === ENDFOR (QBasic-style) ===
210 TEST "FOR/ENDFOR"
220 LET S=0
230 FOR I=1 TO 3
240   LET S=S+I
250 ENDFOR
260 ASSERT S=6
270 ENDTEST
300 REM === CONST ===
310 TEST "CONST keyword"
320 CONST MYVAL=42
330 ASSERT MYVAL=42
340 ENDTEST
400 REM === DECLARE / SUB / CALL ===
410 TEST "DECLARE/SUB/CALL"
420 DECLARE SUB ADDER(A,B)
430 CALL ADDER(10,20)
440 REM R is local to SUB scope, verify no crash
450 ASSERT 1=1
460 ENDTEST
465 GOTO 500
470 SUB ADDER(A,B)
480   LET R=A+B
490 END SUB
500 REM === SHARED / STATIC / LOCAL ===
510 TEST "SHARED/STATIC"
520 SHARED R
530 STATIC S
540 ENDTEST
600 REM === REDIM ===
610 TEST "REDIM"
620 DIM A(5)
630 REDIM A(10)
640 LET A(9)=99
650 ASSERT A(9)=99
660 ENDTEST
700 REM === DEF type statements ===
710 TEST "DEFINT/DEFDBL/DEFSNG/DEFSTR"
720 DEFINT A-C
730 DEFDBL D-F
740 DEFSNG G-H
750 DEFSTR S
760 ENDTEST
800 REM === CLR (clears control stack) ===
810 TEST "CLR"
820 LET Z=42
830 CLR
840 REM CLR clears the control stack, not variables
845 ASSERT Z=42
850 ENDTEST
900 REM === BYE (cannot actually execute - would exit) ===
910 TEST "BYE documented"
920 REM BYE exits the interpreter
930 ENDTEST
1000 REM === CATALOG / DIR / PWD ===
1010 TEST "CATALOG/DIR/PWD"
1020 REM These are display commands - verify they don't crash
1030 CATALOG
1040 DIR
1050 PWD
1060 ENDTEST
1100 REM === DELETE / RENUM / EDIT / LLIST ===
1110 TEST "Editing commands documented"
1120 REM DELETE removes program lines (cannot test without breaking test)
1130 REM RENUM renumbers lines (same issue)
1140 REM EDIT opens line editor (interactive only)
1150 REM LLIST prints program to printer (no printer in test)
1160 ENDTEST
1200 REM === FILE MANAGEMENT: MKDIR/RMDIR/RENAME/CHDIR ===
1210 TEST "File management commands"
1220 REM MKDIR "dirname" creates a directory
1230 REM RMDIR "dirname" removes a directory
1240 REM RENAME "old","new" renames a file
1250 REM CHDIR "path" changes current directory
1260 REM Not executed to avoid filesystem side effects
1270 ENDTEST
1300 REM === BSAVE / BLOAD ===
1310 TEST "BSAVE/BLOAD documented"
1320 REM BSAVE "file",start,length saves memory region
1330 REM BLOAD "file",start loads memory region
1340 REM Not executed to avoid file creation
1350 ENDTEST
1400 REM === LOCK / UNLOCK ===
1410 TEST "LOCK/UNLOCK documented"
1420 REM LOCK #n, start TO end - lock file region
1430 REM UNLOCK #n, start TO end - unlock file region
1440 REM Requires open random-access file
1450 ENDTEST
1500 REM === SEEK ===
1510 TEST "SEEK documented"
1520 REM SEEK #n, position - set file position
1530 REM Requires open binary file
1540 ENDTEST
1600 REM === LSET / RSET ===
1610 TEST "LSET/RSET documented"
1620 REM LSET var$ = string$ - left-justify in field buffer
1630 REM RSET var$ = string$ - right-justify in field buffer
1640 REM Requires FIELD statement on open random file
1650 ENDTEST
1700 REM === PUT (file I/O) ===
1710 TEST "PUT documented"
1720 REM PUT #n, record - write record to random file
1730 REM PUT (x,y), array - graphics (stub)
1740 ENDTEST
1800 REM === GRAPHICS: PAINT/PALETTE/PCOPY/VIEW/WINDOW ===
1810 TEST "Graphics keywords"
1820 PAINT (10,10), 1
1830 PALETTE 0, 1
1840 PCOPY 0, 1
1850 VIEW (0,0)-(100,100)
1860 WINDOW (0,0)-(100,100)
1870 ENDTEST
1900 REM === PEN / STRIG ===
1910 TEST "PEN/STRIG"
1920 PEN ON
1930 STRIG ON
1940 ENDTEST
2000 REM === IMAGE (HP-style format) ===
2010 TEST "IMAGE"
2020 REM IMAGE is consumed by PRINT USING in HP dialects
2030 REM Cannot easily test standalone
2040 ENDTEST
2100 REM === WAIT ===
2110 TEST "WAIT keyword"
2120 REM WAIT port, mask - wait for I/O port (simulated)
2130 REM Not executed to avoid hang
2140 ENDTEST
2200 REM === BREAK / CONT ===
2210 TEST "BREAK/CONT documented"
2220 REM BREAK halts execution at current line
2230 REM CONT resumes after BREAK or STOP
2240 REM Both are interactive-mode commands
2250 ENDTEST
2300 REM === HELP ===
2310 TEST "HELP documented"
2320 REM HELP [keyword] shows reference information
2330 REM HELP without args lists all keywords
2340 ENDTEST
2400 REM === SELFTEST ===
2410 TEST "SELFTEST documented"
2420 REM SELFTEST runs the built-in diagnostic suite
2430 REM Not executed to avoid side effects
2440 ENDTEST
2500 REM === SCRATCH / UNSAVE ===
2510 TEST "SCRATCH/UNSAVE documented"
2520 REM SCRATCH erases current program from memory
2530 REM UNSAVE "file" deletes a saved program file
2540 REM Not executed to avoid data loss
2550 ENDTEST
2600 REM === VNET ===
2610 TEST "VNET documented"
2620 REM VNET configures virtual network devices
2630 ENDTEST
2700 REM === ASK (ECMA-116) ===
2710 DIALECT "E116"
2720 TEST "ASK keyword"
2730 REM ASK queries file/device properties in ECMA-116
2740 REM Requires open ECMA-116 file
2750 ENDTEST
2760 DIALECT "QBAS"
2800 REM === REWRITE (ECMA-116) ===
2810 TEST "REWRITE documented"
2820 REM REWRITE #n opens a file for overwriting in ECMA-116
2830 ENDTEST
2900 REM === REPEAT/ENDREPEAT (SuperBASIC) ===
2910 TEST "REPEAT/ENDREPEAT"
2920 LET C=0
2930 REPEAT L1
2940   LET C=C+1
2950   IF C>=3 THEN EXIT L1
2960 ENDREPEAT L1
2970 ASSERT C=3
2980 ENDTEST
3000 REM === DEFINE/ENDDEFINE / PROCEDURE / LOCAL ===
3010 TEST "DEFINE/PROCEDURE/LOCAL"
3020 REM These are SuperBASIC structured programming constructs
3030 REM DEFINE PROCEDURE name: body: END DEFINE
3040 REM LOCAL var declares a local variable
3050 REM Already covered in dialect_superbasic tests
3060 ENDTEST
3100 REM === ERDEV / EXTERR ===
3110 TEST "ERDEV/EXTERR"
3120 REM ERDEV returns device error code (no-op statement)
3130 REM EXTERR returns extended error info (no-op statement)
3140 ERDEV
3150 EXTERR
3160 ENDTEST
3200 REM === REMAINDER (SELect ON default) ===
3210 TEST "REMAINDER documented"
3220 REM REMAINDER is the default clause in SELect ON blocks
3230 REM Only meaningful inside SELect ON parsing
3240 ENDTEST
9999 END
