1 REM === t21_conversion.bas ===
2 REM Tests: HEX$, OCT$, BIN$, CVI, CVS, CVD
3 DIALECT "GWBS"
10 TEST "HEX$ conversion"
20 ASSERT HEX$(0)="0"
30 ASSERT HEX$(255)="FF"
40 ASSERT HEX$(16)="10"
50 ASSERT HEX$(256)="100"
60 ENDTEST
100 TEST "OCT$ conversion"
110 ASSERT OCT$(0)="0"
120 ASSERT OCT$(7)="7"
130 ASSERT OCT$(8)="10"
140 ASSERT OCT$(64)="100"
150 ENDTEST
200 TEST "BIN$ conversion"
210 LET B$=BIN$(0)
220 ASSERT LEN(B$)=8
230 LET B$=BIN$(255)
240 ASSERT B$="11111111"
250 LET B$=BIN$(10)
260 ASSERT B$="00001010"
270 ENDTEST
999 END
