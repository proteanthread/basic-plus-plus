1 REM =====================================================
2 REM  TEST_QBAS.BAS - QBasic Dialect Test
3 REM =====================================================
4 REM  Dialect: QBAS (QBasic, Microsoft 1991)
5 REM  Features: Structured BASIC - SUB/FUNCTION,
6 REM            SELECT CASE, long var names, WHILE/WEND,
7 REM            DO/LOOP, floats, strings, DIM, IF blocks,
8 REM            ELSEIF, ON ERROR, CLS, TRON/TROFF
9 REM =====================================================
10 REM  Usage: DIALECT "QBAS" : LOAD "tests/test_qbas.bas" : RUN
11 REM =====================================================
12 LET P=0
13 LET F=0

100 TEST "Arithmetic & Floats"
110 ASSERT 2 + 3 = 5
120 ASSERT 3.14 > 3.0
130 ASSERT SQR(144) = 12
140 ASSERT INT(3.7) = 3
150 ASSERT 10 MOD 3 = 1
160 ASSERT FIX(3.7) = 3
170 ASSERT FIX(-3.7) = -3
180 ENDTEST

200 TEST "String Operations"
210 A$ = "HELLO"
220 B$ = "WORLD"
230 C$ = A$ + " " + B$
240 ASSERT LEN(C$) = 11
250 ASSERT LEFT$(A$, 3) = "HEL"
260 ASSERT RIGHT$(B$, 3) = "RLD"
270 ASSERT MID$(A$, 2, 3) = "ELL"
280 ASSERT MID$(A$, 2) = "ELLO"
290 ASSERT INSTR(C$, "WORLD") = 7
295 ASSERT CHR$(65) = "A"
296 ASSERT ASC("Z") = 90
297 ASSERT VAL("42") = 42
298 ASSERT STR$(100) = "100"
299 ENDTEST

300 TEST "Long Variable Names"
310 SCORE = 100
320 PNAME$ = "ALICE"
330 TOTALPTS = SCORE * 3
340 ASSERT TOTALPTS = 300
350 ASSERT LEN(PNAME$) = 5
360 ASSERT PNAME$ = "ALICE"
370 ENDTEST

400 TEST "DIM Arrays"
410 DIM VALUES(10), NAMES$(5)
420 FOR I = 0 TO 10
430 VALUES(I) = I * I
440 NEXT I
450 ASSERT VALUES(0) = 0
460 ASSERT VALUES(3) = 9
470 ASSERT VALUES(10) = 100
480 NAMES$(0) = "FIRST"
490 NAMES$(1) = "SECOND"
500 ASSERT NAMES$(0) = "FIRST"
510 ASSERT LEN(NAMES$(1)) = 6
520 ENDTEST

600 TEST "Block IF/ELSEIF/ELSE"
610 X = 50
620 IF X > 100 THEN
630   Y = 1
640 ELSEIF X > 40 THEN
650   Y = 2
660 ELSE
670   Y = 3
680 END IF
690 ASSERT Y = 2
700 REM Test nested block IF
710 A = 10
720 IF A > 5 THEN
730   IF A > 8 THEN
740     B = 1
750   ELSE
760     B = 2
770   END IF
780 END IF
790 ASSERT B = 1
795 ENDTEST

800 TEST "WHILE/WEND"
810 S = 0
820 I = 1
830 WHILE I <= 10
840 S = S + I
850 I = I + 1
860 WEND
870 ASSERT S = 55
880 ENDTEST

900 TEST "DO/LOOP Variations"
910 REM DO...LOOP WHILE
920 S = 0
930 I = 1
940 DO
950 S = S + I
960 I = I + 1
970 LOOP WHILE I <= 5
980 ASSERT S = 15
990 ENDTEST

1000 TEST "FOR/NEXT Variations"
1010 REM Forward loop
1020 S = 0
1030 FOR I = 1 TO 5
1040 S = S + I
1050 NEXT I
1060 ASSERT S = 15
1070 REM Backward loop
1080 S = 0
1090 FOR I = 5 TO 1 STEP -1
1100 S = S + I
1110 NEXT I
1120 ASSERT S = 15
1130 REM Float step
1140 S = 0
1150 FOR I = 1 TO 10 STEP 3
1160 S = S + 1
1170 NEXT I
1180 ASSERT S = 4
1190 ENDTEST

1200 TEST "SELECT CASE"
1210 X = 3
1220 SELECT CASE X
1230 CASE 1
1240   Y = 10
1250 CASE 2
1260   Y = 20
1270 CASE 3
1280   Y = 30
1290 CASE ELSE
1300   Y = 99
1310 END SELECT
1320 ASSERT Y = 30
1330 REM Test CASE ELSE
1340 X = 99
1350 SELECT CASE X
1360 CASE 1
1370   Y = 10
1380 CASE ELSE
1390   Y = 0
1400 END SELECT
1410 ASSERT Y = 0
1420 ENDTEST

1500 TEST "DATA/READ/RESTORE"
1510 READ A, B, C
1520 ASSERT A = 100
1530 ASSERT B = 200
1540 ASSERT C = 300
1550 READ D$
1560 ASSERT D$ = "QBASIC"
1570 RESTORE
1580 READ X
1590 ASSERT X = 100
1600 ENDTEST
1610 DATA 100, 200, 300, "QBASIC"

1700 TEST "ON GOTO"
1710 X = 2
1720 ON X GOTO 1740, 1750, 1760
1730 GOTO 1770
1740 Y = 1: GOTO 1770
1750 Y = 2: GOTO 1770
1760 Y = 3: GOTO 1770
1770 ASSERT Y = 2
1780 ENDTEST

1800 TEST "DEF FN"
1810 DEF FN D(X) = X * 2
1820 ASSERT FN D(5) = 10
1830 ASSERT FN D(100) = 200
1840 ENDTEST

1900 TEST "Math Functions"
1910 ASSERT ABS(-42) = 42
1920 ASSERT SGN(-1) = -1
1930 ASSERT SGN(0) = 0
1940 ASSERT SGN(1) = 1
1950 ASSERT INT(3.9) = 3
1960 ASSERT SQR(16) = 4
1970 ENDTEST

2000 TEST "Logical Operators"
2010 ASSERT (5 > 3) AND (10 > 1)
2020 ASSERT (5 > 3) OR (1 > 10)
2030 ASSERT NOT (3 > 5)
2040 ENDTEST

2100 TEST "SPACE$ and STRING$"
2110 A$ = SPACE$(5)
2120 ASSERT LEN(A$) = 5
2130 B$ = STRING$(3, "X")
2140 ASSERT LEN(B$) = 3
2150 ASSERT B$ = "XXX"
2160 ENDTEST

9000 PRINT ""
9010 PRINT "=== QBASIC DIALECT TESTS COMPLETE ==="
9020 END
