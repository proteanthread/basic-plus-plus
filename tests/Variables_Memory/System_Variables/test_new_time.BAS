' --- NEW TIME VARIABLES TEST ---
' Test TIME, DATE, DOW

A = TIME
B = DATE
C = DOW

PRINT "TIME = "; A
PRINT "DATE = "; B
PRINT "DOW = "; C

IF C < 1 OR C > 7 THEN PRINT "DOW FAILED": GOTO 9999
IF A < 0 THEN PRINT "TIME FAILED": GOTO 9999
IF B < 1010000 THEN PRINT "DATE FAILED": GOTO 9999

PRINT "ALL TESTS PASSED"
END

9999 PRINT "TEST SUITE FAILED"
