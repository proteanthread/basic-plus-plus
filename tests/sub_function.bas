1 REM === t16_sub_function.bas ===
2 REM Tests: SUB/END SUB, CALL, FUNCTION/END FUNCTION
3 DIALECT "QBAS"
10 TEST "SUB call"
20 LET G=0
30 CALL AddTen(5)
40 ASSERT G=15
50 ENDTEST
60 GOTO 200
100 SUB AddTen(X)
110 LET G=X+10
120 END SUB
200 TEST "FUNCTION call"
210 LET R=Square(7)
220 ASSERT R=49
230 ENDTEST
240 GOTO 400
300 FUNCTION Square(X)
310 Square=X*X
320 END FUNCTION
400 TEST "SUB with string"
410 LET G$=""
420 CALL SetMsg("HELLO")
430 ASSERT G$="HELLO"
440 ENDTEST
450 GOTO 600
500 SUB SetMsg(M$)
510 LET G$=M$
520 END SUB
600 TEST "Nested CALL"
610 LET G=0
620 CALL Outer(3)
630 ASSERT G=6
640 ENDTEST
650 GOTO 999
700 SUB Outer(X)
710 CALL AddTen(X)
720 REM G is now X+10, but we override
730 LET G=X*2
740 END SUB
999 END
