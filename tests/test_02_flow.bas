10 REM Part 2: Flow Control
20 PRINT "Testing Flow Control..."
30 SUM = 0
40 FOR I = 1 TO 10 STEP 1
50   SUM = SUM + I
60 NEXT I
70 IF SUM <> 55 THEN PRINT "FOR LOOP ERROR" : END
80 X = 0
90 WHILE X < 5
100  X = X + 1
110 WEND
120 IF X <> 5 THEN PRINT "WHILE LOOP ERROR"
130 Y = 0
140 DO
150  Y = Y + 1
160 LOOP UNTIL Y = 3
170 IF Y <> 3 THEN PRINT "DO LOOP ERROR"
180 Z = 2
190 SELECT CASE Z
200  CASE 1: PRINT "BAD"
210  CASE 2: PRINT "GOOD"
220  CASE ELSE: PRINT "BAD"
230 END SELECT
240 PRINT "Flow control tests completed."
250 END
