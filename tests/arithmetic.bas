1 REM === t01_arithmetic.bas ===
2 REM Tests: + - * / ^ \ MOD negation precedence parens
3 DIALECT "GWBS"
10 TEST "Addition"
20 ASSERT 2+3=5
30 ASSERT 0+0=0
40 ASSERT -3+3=0
50 ASSERT 100+200=300
60 ENDTEST
100 TEST "Subtraction"
110 ASSERT 10-7=3
120 ASSERT 0-5=-5
130 ASSERT 100-100=0
140 ENDTEST
200 TEST "Multiplication"
210 ASSERT 6*7=42
220 ASSERT 0*999=0
230 ASSERT -3*4=-12
240 ASSERT -2*-3=6
250 ENDTEST
300 TEST "Division"
310 ASSERT 100/10=10
320 ASSERT 7/2=3
330 ASSERT -12/4=-3
340 ENDTEST
400 TEST "Negation"
410 ASSERT -(-5)=5
420 ASSERT -(0)=0
430 ASSERT -(-(-3))=-3
440 ENDTEST
500 TEST "Precedence"
510 ASSERT 2+3*4=14
520 ASSERT (2+3)*4=20
530 ASSERT 10-2*3=4
540 ASSERT 10-(2*3)=4
550 ASSERT 2*3+4*5=26
560 ENDTEST
600 TEST "Integer Division"
610 ASSERT 7\2=3
620 ASSERT 10\3=3
630 ASSERT 100\7=14
640 ENDTEST
700 TEST "Modulo"
710 ASSERT 10 MOD 3=1
720 ASSERT 7 MOD 7=0
730 ASSERT 100 MOD 10=0
740 ASSERT 17 MOD 5=2
750 ENDTEST
800 TEST "Exponentiation"
810 ASSERT 2^3=8
820 ASSERT 3^2=9
830 ASSERT 10^0=1
840 ENDTEST
900 TEST "Float Arithmetic"
910 LET A=3.14
920 ASSERT A>3.0
930 ASSERT A<4.0
940 LET B=1.5+2.5
950 ASSERT B=4.0
960 ENDTEST
999 END
