1 REM === t11_math.bas ===
2 REM Tests: All math functions
3 DIALECT "GWBS"
10 TEST "ABS"
20 ASSERT ABS(-7)=7
30 ASSERT ABS(7)=7
40 ASSERT ABS(0)=0
50 ASSERT ABS(-3.5)=3.5
60 ENDTEST
100 TEST "SGN"
110 ASSERT SGN(-5)=-1
120 ASSERT SGN(0)=0
130 ASSERT SGN(5)=1
140 ENDTEST
200 TEST "INT FIX"
210 ASSERT INT(3.7)=3
220 ASSERT INT(-3.7)=-4
230 ASSERT FIX(3.7)=3
240 ASSERT FIX(-3.7)=-3
250 ENDTEST
300 TEST "SQR"
310 ASSERT SQR(144)=12
320 ASSERT SQR(0)=0
330 ASSERT SQR(1)=1
340 ENDTEST
400 TEST "Trig Functions"
410 LET P=3.14159265
420 ASSERT ABS(SIN(0))<0.001
430 ASSERT ABS(COS(0)-1)<0.001
440 ASSERT ABS(TAN(0))<0.001
450 ASSERT ABS(ATN(1)-0.7854)<0.001
460 ENDTEST
500 TEST "LOG EXP"
510 ASSERT ABS(LOG(1))<0.001
520 ASSERT ABS(EXP(0)-1)<0.001
530 LET E=EXP(1)
540 ASSERT ABS(LOG(E)-1)<0.001
550 ENDTEST
600 TEST "CINT"
610 ASSERT CINT(3.7)=4
620 ASSERT CINT(3.2)=3
630 ASSERT CINT(-3.7)=-4
640 ENDTEST
700 TEST "RND"
710 RANDOMIZE 12345
720 LET A=RND(1)
730 ASSERT A>0
740 ASSERT A<1
750 LET B=RND(1)
760 ASSERT B>0
770 ASSERT B<1
780 ENDTEST
999 END
