1 REM =====================================================
2 REM  TEST_GWBS.BAS - GW-BASIC Dialect Test
3 REM =====================================================
4 REM  Dialect: GWBS (GW-BASIC, Microsoft 1983)
5 REM  Features: Floating point, strings, DIM arrays,
6 REM            WHILE/WEND, DO/LOOP, DATA/READ, extended
7 REM            vars, ON ERROR, CLS, TRON/TROFF, THEN,
8 REM            optional LET, colon separator
9 REM =====================================================
10 REM  Usage: DIALECT "GWBS" : LOAD "tests/test_gwbs.bas" : RUN
11 REM =====================================================
12 LET P=0
13 LET F=0

100 TEST "Integer Arithmetic"
110 ASSERT 2+3=5
120 ASSERT 10-7=3
130 ASSERT 6*7=42
140 ASSERT 100/10=10
150 ASSERT -(-5)=5
160 ASSERT 2+3*4=14
170 ASSERT (2+3)*4=20
180 ASSERT 10 MOD 3 = 1
190 ENDTEST

200 TEST "Floating Point"
210 A = 3.14
220 ASSERT A > 3.0
230 ASSERT A < 4.0
240 B = 1.5 + 2.5
250 ASSERT B = 4.0
260 C = SQR(144)
270 ASSERT C = 12
280 D = INT(3.7)
290 ASSERT D = 3
295 E = INT(-3.7)
296 ASSERT E = -4
297 ENDTEST

300 TEST "String Variables"
310 A$ = "HELLO"
320 B$ = "WORLD"
330 ASSERT LEN(A$) = 5
340 ASSERT LEN(B$) = 5
350 C$ = A$ + " " + B$
360 ASSERT LEN(C$) = 11
370 ASSERT LEFT$(A$, 3) = "HEL"
380 ASSERT RIGHT$(B$, 3) = "RLD"
390 ASSERT MID$(A$, 2, 3) = "ELL"
395 ASSERT MID$(A$, 2) = "ELLO"
396 ENDTEST

400 TEST "Named Variables"
410 SCORE = 100
420 COUNT = 5
430 RESULT = SCORE * COUNT
440 ASSERT RESULT = 500
450 NM$ = "TEST"
460 ASSERT LEN(NM$) = 4
470 ENDTEST

500 TEST "DIM Arrays"
510 DIM X(10), Y(5)
520 FOR I = 0 TO 10
530 X(I) = I * 2
540 NEXT I
550 ASSERT X(0) = 0
560 ASSERT X(5) = 10
570 ASSERT X(10) = 20
580 DIM S$(5)
590 S$(0) = "A"
600 S$(1) = "B"
610 ASSERT S$(0) = "A"
620 ASSERT S$(1) = "B"
630 ENDTEST

700 TEST "IF/THEN/ELSE"
710 X = 0
720 IF 1 > 0 THEN X = 1
730 ASSERT X = 1
740 X = 0
750 IF 0 > 1 THEN X = 1 ELSE X = 2
760 ASSERT X = 2
770 IF 5 = 5 THEN X = 99
780 ASSERT X = 99
790 ENDTEST

800 TEST "FOR/NEXT"
810 S = 0
820 FOR I = 1 TO 5
830 S = S + I
840 NEXT I
850 ASSERT S = 15
860 S = 0
870 FOR I = 10 TO 1 STEP -1
880 S = S + 1
890 NEXT I
900 ASSERT S = 10
910 S = 0
920 FOR I = 1 TO 10 STEP 3
930 S = S + 1
940 NEXT I
950 ASSERT S = 4
960 ENDTEST

1000 TEST "WHILE/WEND"
1010 S = 0
1020 I = 1
1030 WHILE I <= 5
1040 S = S + I
1050 I = I + 1
1060 WEND
1070 ASSERT S = 15
1080 REM Test WHILE with string condition
1090 K$ = ""
1100 I = 0
1110 WHILE K$ <> "DONE"
1120 I = I + 1
1130 IF I >= 3 THEN K$ = "DONE"
1140 WEND
1150 ASSERT I = 3
1160 ENDTEST

1200 TEST "DO/LOOP"
1210 S = 0
1220 I = 1
1230 DO
1240 S = S + I
1250 I = I + 1
1260 LOOP WHILE I <= 5
1270 ASSERT S = 15
1280 ENDTEST

1300 TEST "DATA/READ/RESTORE"
1310 READ A, B, C
1320 ASSERT A = 10
1330 ASSERT B = 20
1340 ASSERT C = 30
1350 READ D$
1360 ASSERT D$ = "HELLO"
1370 RESTORE
1380 READ X
1390 ASSERT X = 10
1400 ENDTEST
1410 DATA 10, 20, 30, "HELLO"

1500 TEST "GOSUB/RETURN"
1510 R = 0
1520 GOSUB 1560
1530 ASSERT R = 99
1540 ENDTEST
1550 GOTO 1600
1560 R = 99
1570 RETURN

1600 TEST "ON GOTO / ON GOSUB"
1610 X = 2
1620 ON X GOTO 1640, 1650, 1660
1630 GOTO 1670
1640 Y = 1: GOTO 1670
1650 Y = 2: GOTO 1670
1660 Y = 3: GOTO 1670
1670 ASSERT Y = 2
1680 ENDTEST

1700 TEST "String Functions"
1710 ASSERT CHR$(65) = "A"
1720 ASSERT ASC("A") = 65
1730 ASSERT STR$(42) = "42"
1740 ASSERT VAL("123") = 123
1750 A$ = "HELLO WORLD"
1760 ASSERT LEFT$(A$, 5) = "HELLO"
1770 ASSERT RIGHT$(A$, 5) = "WORLD"
1780 ASSERT MID$(A$, 7, 5) = "WORLD"
1790 ASSERT MID$(A$, 7) = "WORLD"
1800 ASSERT INSTR(A$, "WORLD") = 7
1810 ASSERT INSTR(A$, "XYZ") = 0
1820 ASSERT LEN("") = 0
1830 ASSERT LEN(SPACE$(5)) = 5
1840 ASSERT LEN(STRING$(3, "X")) = 3
1850 ENDTEST

1900 TEST "Math Functions"
1910 ASSERT ABS(-7) = 7
1920 ASSERT SGN(-5) = -1
1930 ASSERT SGN(0) = 0
1940 ASSERT SGN(5) = 1
1950 ASSERT INT(3.7) = 3
1960 ASSERT INT(-3.7) = -4
1970 ASSERT SQR(25) = 5
1980 ENDTEST

2000 TEST "RND (Float 0..1)"
2010 R = RND(1)
2020 ASSERT R >= 0
2030 ASSERT R < 1
2040 ENDTEST

2100 TEST "HEX$ and OCT$"
2110 ASSERT HEX$(255) = "FF"
2120 ASSERT HEX$(0) = "0"
2130 ASSERT OCT$(8) = "10"
2140 ASSERT OCT$(7) = "7"
2150 ENDTEST

2200 TEST "CVI / MKI$"
2210 A$ = MKI$(256)
2220 ASSERT CVI(A$) = 256
2230 A$ = MKI$(0)
2240 ASSERT CVI(A$) = 0
2250 ENDTEST

2300 TEST "FIX"
2310 ASSERT FIX(3.7) = 3
2320 ASSERT FIX(-3.7) = -3
2330 ENDTEST

2400 TEST "Multi-Statement Lines"
2410 A = 1 : B = 2 : C = A + B
2420 ASSERT C = 3
2430 ENDTEST

2500 TEST "DEF FN"
2510 DEF FN S(X) = X * X
2520 ASSERT FN S(5) = 25
2530 ASSERT FN S(3) = 9
2540 DEF FN C(X) = X * X * X
2550 ASSERT FN C(3) = 27
2560 ENDTEST

9000 PRINT ""
9010 PRINT "=== GW-BASIC DIALECT TESTS COMPLETE ==="
9020 END
