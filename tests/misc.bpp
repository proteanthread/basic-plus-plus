1 REM === t50_misc.bpp ===
2 REM Tests: SYSTEM, VER, DATE$, TIME$, CLOCK$, TIMER, CSRLIN, POS
3 DIALECT "GWBS"
10 TEST "VER"
20 VER
30 REM Should print version info
40 ENDTEST
100 TEST "SYSTEM"
110 SYSTEM
120 REM Should print platform info
130 ENDTEST
200 TEST "DATE$ and TIME$"
210 LET D$=DATE$
220 ASSERT LEN(D$)>0
230 LET T$=TIME$
240 ASSERT LEN(T$)>0
250 ENDTEST
300 TEST "TIMER"
310 LET T=TIMER
320 ASSERT T>=0
330 ENDTEST
400 TEST "CSRLIN POS"
410 LET R=CSRLIN
420 LET C=POS(0)
430 ASSERT R>=0
440 ASSERT C>=0
450 ENDTEST
500 TEST "CLOCK$"
510 LET C$=CLOCK$
520 ASSERT LEN(C$)>0
530 ENDTEST
600 TEST "DIALECT$"
610 LET D$=DIALECT$
620 ASSERT LEN(D$)>0
630 ENDTEST
700 TEST "MEMMAP$"
710 LET M$=MEMMAP$
720 ASSERT LEN(M$)>0
730 ENDTEST
999 END
