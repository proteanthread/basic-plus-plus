1 REM === t38_dialect_c64.bas ===
2 REM Tests: Commodore 64 BASIC v2 features
3 DIALECT "C64"
10 TEST "C64 arithmetic"
20 ASSERT 2+3=5
30 ASSERT 6*7=42
40 ASSERT 3.14>3.0
50 ENDTEST
100 TEST "C64 variables"
110 LET A=42
120 ASSERT A=42
130 LET A$="HELLO"
140 ASSERT LEN(A$)=5
150 ENDTEST
200 TEST "C64 FOR/NEXT"
210 LET S=0
220 FOR I=1 TO 5
230 LET S=S+I
240 NEXT I
250 ASSERT S=15
260 ENDTEST
300 TEST "C64 PEEK with C64 map"
310 MEMMAP "C64"
320 ASSERT PEEK(1)=55
330 ENDTEST
999 END
