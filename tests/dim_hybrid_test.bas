10 REM Tests for DIM hybrid array/scalar string capacity & aggregate functions
20 DIM A$[30]
30 A$ = "12345678901234567890123456789012345"
40 PRINT "A$ len="; LEN(A$)
50 IF LEN(A$) <> 30 THEN PRINT "FAILED: A$ not truncated to 30!": END

60 DIM B$(10)
70 B$(5) = "12345678901234567890123456789012345"
80 PRINT "B$(5) len="; LEN(B$(5))
90 IF LEN(B$(5)) <> 35 THEN PRINT "FAILED: B$(5) truncated!": END

100 DIM C$[10, 8]
110 C$(3) = "ABCDEFGHJKLMNOP"
120 PRINT "C$(3)="; C$(3)
130 IF C$(3) <> "ABCDEFGH" THEN PRINT "FAILED: C$(3) not truncated to 8!": END

140 DIM D$(2, 2)
150 D$(1, 1) = "HELLO WORLD"
160 PRINT "D$(1, 1)="; D$(1, 1)
170 IF D$(1, 1) <> "HELLO WORLD" THEN PRINT "FAILED: D$(1, 1) modified!": END

180 PRINT "MIN="; MIN(5, 3, 8)
190 IF MIN(5, 3, 8) <> 3 THEN PRINT "FAILED: MIN": END

200 PRINT "MAX="; MAX(5, 3, 8)
210 IF MAX(5, 3, 8) <> 8 THEN PRINT "FAILED: MAX": END

220 PRINT "AVG="; AVG(10, 20, 30)
230 IF AVG(10, 20, 30) <> 20 THEN PRINT "FAILED: AVG": END

240 PRINT "MED="; MED(1, 10, 5)
250 IF MED(1, 10, 5) <> 5 THEN PRINT "FAILED: MED": END

260 PRINT "DIM_HYBRID_TEST PASSED"
270 END
