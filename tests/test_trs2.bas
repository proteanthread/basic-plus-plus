1 REM =====================================================
2 REM  TEST_TRS2.BAS - TRS-80 Level II BASIC Dialect Test
3 REM =====================================================
4 REM  Dialect: TRS2 (TRS-80 Level II, Microsoft)
5 REM  Features: Full Microsoft BASIC - floating point,
6 REM            strings, DIM arrays, WHILE/WEND, extended
7 REM            vars, DATA/READ, ON ERROR, CLS, TRON
8 REM =====================================================
9 REM  Usage: DIALECT "TRS2" : LOAD "tests/test_trs2.bas" : RUN
10 REM =====================================================
11 LET P=0
12 LET F=0

100 TEST "Integer Arithmetic"
110 ASSERT 2+3=5
120 ASSERT 10-7=3
130 ASSERT 6*7=42
140 ASSERT 100/10=10
150 ASSERT 10 MOD 3 = 1
160 ENDTEST

200 TEST "Floating Point"
210 A=3.14
220 ASSERT A>3.0
230 ASSERT A<4.0
240 B=SQR(144)
250 ASSERT B=12
260 C=INT(3.7)
270 ASSERT C=3
280 ENDTEST

300 TEST "String Operations"
310 A$="TRS-80"
320 ASSERT LEN(A$)=6
330 B$=LEFT$(A$,3)
340 ASSERT B$="TRS"
350 C$=RIGHT$(A$,2)
360 ASSERT C$="80"
370 D$=MID$(A$,5,2)
380 ASSERT D$="80"
390 ENDTEST

400 TEST "Named Variables"
410 SCORE=100
420 LIVES=3
430 TOTAL=SCORE*LIVES
440 ASSERT TOTAL=300
450 ENDTEST

500 TEST "DIM Arrays"
510 DIM A(10), B$(5)
520 FOR I=0 TO 10
530 A(I)=I*2
540 NEXT I
550 ASSERT A(5)=10
560 B$(0)="FIRST"
570 B$(1)="SECOND"
580 ASSERT B$(0)="FIRST"
590 ASSERT LEN(B$(1))=6
595 ENDTEST

600 TEST "WHILE/WEND"
610 S=0
620 I=1
630 WHILE I<=5
640 S=S+I
650 I=I+1
660 WEND
670 ASSERT S=15
680 ENDTEST

700 TEST "IF/THEN/ELSE"
710 X=0
720 IF 1>0 THEN X=1
730 ASSERT X=1
740 IF 0>1 THEN X=99 ELSE X=42
750 ASSERT X=42
760 ENDTEST

800 TEST "FOR/NEXT with STEP"
810 S=0
820 FOR I=1 TO 10 STEP 2
830 S=S+1
840 NEXT I
850 ASSERT S=5
860 S=0
870 FOR I=10 TO 1 STEP -1
880 S=S+1
890 NEXT I
900 ASSERT S=10
910 ENDTEST

1000 TEST "DATA/READ"
1010 READ A, B, C
1020 ASSERT A=5
1030 ASSERT B=10
1040 ASSERT C=15
1050 ENDTEST
1060 DATA 5, 10, 15

1100 TEST "GOSUB/RETURN"
1110 R=0
1120 GOSUB 1160
1130 ASSERT R=55
1140 ENDTEST
1150 GOTO 1200
1160 R=55
1170 RETURN

1200 TEST "CLS and Math"
1210 CLS
1220 ASSERT ABS(-99)=99
1230 ASSERT SGN(-1)=-1
1240 ASSERT SGN(0)=0
1250 ASSERT SGN(1)=1
1260 ENDTEST

1300 TEST "ON GOTO"
1310 X=3
1320 ON X GOTO 1340, 1350, 1360
1330 GOTO 1370
1340 Y=1: GOTO 1370
1350 Y=2: GOTO 1370
1360 Y=3: GOTO 1370
1370 ASSERT Y=3
1380 ENDTEST

1400 TEST "DEF FN"
1410 DEF FN S(X) = X*X
1420 ASSERT FN S(7) = 49
1430 ASSERT FN S(0) = 0
1440 ENDTEST

9000 PRINT ""
9010 PRINT "=== TRS-80 LEVEL II TESTS COMPLETE ==="
9020 END
