' --- ARRAYS BOUNDS TEST ---
' Tests: DIM, REDIM, ERASE, LBOUND, UBOUND, OPTION BASE

OPTION BASE 1

DIM A(10)
IF LBOUND(A, 1) <> 1 THEN PRINT "OPTION BASE FAILED": GOTO 9999
IF UBOUND(A, 1) <> 10 THEN PRINT "UBOUND FAILED": GOTO 9999

A(5) = 42
REDIM PRESERVE A(20)
IF A(5) <> 42 THEN PRINT "REDIM PRESERVE FAILED": GOTO 9999
IF UBOUND(A, 1) <> 20 THEN PRINT "REDIM UBOUND FAILED": GOTO 9999

REDIM A(30)
IF A(5) = 42 THEN PRINT "REDIM (WITHOUT PRESERVE) FAILED": GOTO 9999

ERASE A
' Cannot test UBOUND after ERASE, it might crash or return 0, we'll just check execution doesn't crash

PRINT "ALL TESTS PASSED"
END
9999 PRINT "TEST SUITE FAILED"
