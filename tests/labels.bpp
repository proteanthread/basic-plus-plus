1 REM === t52_labels.bpp ===
2 REM Tests: Line labels, GOTO label, GOSUB label
3 DIALECT "GWBS"
10 TEST "GOTO label"
20 LET X=0
30 GOTO SkipThis
40 LET X=99
50 SkipThis:
60 ASSERT X=0
70 ENDTEST
100 TEST "GOSUB label"
110 LET R=0
120 GOSUB SetR
130 ASSERT R=42
140 ENDTEST
150 GOTO Done
160 SetR:
170 LET R=42
180 RETURN
190 Done:
200 TEST "Label with code"
210 LET V=0
220 GOTO HasCode
230 LET V=99
240 HasCode: LET V=1
250 ASSERT V=1
260 ENDTEST
999 END
