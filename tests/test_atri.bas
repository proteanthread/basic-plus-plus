1 REM =====================================================
2 REM  TEST_ATRI.BAS - Atari BASIC Dialect Test
3 REM =====================================================
4 REM  Dialect: ATRI (Atari/Microsoft BASIC II, 1979)
5 REM  Features: Float, strings, DIM, DATA/READ, extended
6 REM            vars, ON ERROR, TRON/TROFF, no WHILE,
7 REM            no DO/LOOP, no CLS
8 REM  Prompt: "READY"
9 REM =====================================================
10 REM  Usage: DIALECT "ATRI" : LOAD "tests/test_atri.bas" : RUN
11 REM =====================================================
12 LET P=0
13 LET F=0

100 TEST "Arithmetic"
110 ASSERT 2+3=5
120 ASSERT 10-7=3
130 ASSERT 6*7=42
140 ASSERT 100/10=10
150 ENDTEST

200 TEST "Floating Point"
210 A=3.14
220 ASSERT A>3.0
230 ASSERT A<4.0
240 B=SQR(16)
250 ASSERT B=4
260 C=INT(3.7)
270 ASSERT C=3
280 ENDTEST

300 TEST "String Operations"
310 A$="ATARI"
320 ASSERT LEN(A$)=5
330 B$=LEFT$(A$,3)
340 ASSERT B$="ATA"
350 C$=RIGHT$(A$,2)
360 ASSERT C$="RI"
370 ASSERT CHR$(65)="A"
380 ASSERT ASC("A")=65
390 ENDTEST

400 TEST "Named Variables"
410 SCORE=100
420 LIVES=3
430 ASSERT SCORE=100
440 ASSERT LIVES=3
450 ENDTEST

500 TEST "DIM Arrays"
510 DIM A(10)
520 FOR I=0 TO 10
530 A(I)=I*2
540 NEXT I
550 ASSERT A(5)=10
560 ASSERT A(10)=20
570 ENDTEST

600 TEST "FOR/NEXT"
610 S=0
620 FOR I=1 TO 5
630 S=S+I
640 NEXT I
650 ASSERT S=15
660 S=0
670 FOR I=10 TO 1 STEP -1
680 S=S+1
690 NEXT I
700 ASSERT S=10
710 ENDTEST

800 TEST "IF/THEN/ELSE"
810 X=0
820 IF 1>0 THEN X=1
830 ASSERT X=1
840 IF 0>1 THEN X=99 ELSE X=42
850 ASSERT X=42
860 ENDTEST

900 TEST "GOSUB/RETURN"
910 R=0
920 GOSUB 960
930 ASSERT R=800
940 ENDTEST
950 GOTO 1000
960 R=800
970 RETURN

1000 TEST "DATA/READ/RESTORE"
1010 READ A, B, C
1020 ASSERT A=10
1030 ASSERT B=20
1040 ASSERT C=30
1050 RESTORE
1060 READ X
1070 ASSERT X=10
1080 ENDTEST
1090 DATA 10, 20, 30

1100 TEST "Math Functions"
1110 ASSERT ABS(-7)=7
1120 ASSERT SGN(-1)=-1
1130 ASSERT SGN(0)=0
1140 ASSERT SGN(1)=1
1150 ENDTEST

9000 PRINT ""
9010 PRINT "=== ATARI BASIC TESTS COMPLETE ==="
9020 END
