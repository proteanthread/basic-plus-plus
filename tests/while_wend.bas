1 REM === t06_while_wend.bas ===
2 REM Tests: WHILE/WEND, nested, false condition
3 DIALECT "GWBS"
10 TEST "Basic WHILE"
20 LET S=0
30 LET I=1
40 WHILE I<=5
50 LET S=S+I
60 LET I=I+1
70 WEND
80 ASSERT S=15
90 ASSERT I=6
95 ENDTEST
100 TEST "WHILE false"
110 LET X=0
120 WHILE 0>1
130 LET X=99
140 WEND
150 ASSERT X=0
160 ENDTEST
200 TEST "Nested WHILE"
210 LET S=0
220 LET I=1
230 WHILE I<=3
240 LET J=1
250 WHILE J<=3
260 LET S=S+1
270 LET J=J+1
280 WEND
290 LET I=I+1
300 WEND
310 ASSERT S=9
320 ENDTEST
999 END
