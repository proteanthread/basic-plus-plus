1 REM === t46_dialect_aint.bas ===
2 REM Tests: Apple Integer BASIC
3 DIALECT "AINT"
10 TEST "Integer BASIC arithmetic"
20 ASSERT 2+3=5
30 ASSERT 10/3=3
40 ASSERT 6*7=42
50 ENDTEST
100 TEST "Integer BASIC variables"
110 LET A=42
120 ASSERT A=42
130 ENDTEST
200 TEST "Integer BASIC FOR/NEXT"
210 LET S=0
220 FOR I=1 TO 5
230 LET S=S+I
240 NEXT I
250 ASSERT S=15
260 ENDTEST
300 TEST "Integer BASIC GOSUB"
310 LET R=0
320 GOSUB 360
330 ASSERT R=33
340 ENDTEST
350 GOTO 400
360 LET R=33
370 RETURN
999 END
