10 REM ==========================================================
11 REM BASIC++ PROGRESSIVE TEST SUITE - ARITHMETIC / MATH
12 REM ==========================================================
13 REM GOAL: 
14 REM To validate and verify that math and arithmetic functions
15 REM are 100% bug-free and behave accurately across 754 float,
16 REM Decimal base-10, and MBF formats.
20 REM 
30 PRINT "[TEST] Arithmetic & Math Suite Started."
40 EPS = 0.0001
50 
60 PRINT "[TEST] Phase 1: Native IEEE-754 / Default Float Mode"
70 GOSUB 1000 : REM Standard Math
80 GOSUB 2000 : REM Advanced/Complex Math
90 GOSUB 3000 : REM Matrix Math
100 
110 PRINT "[TEST] Phase 2: OPTION ARITHMETIC DECIMAL"
120 OPTION ARITHMETIC DECIMAL
130 GOSUB 1000 : REM Re-run standard math with BCD
140 
150 PRINT "[TEST] Suite Finished Successfully."
160 END
170 
1000 REM --- Standard Math ---
1010 PRINT "   -> Testing Trigonometry..."
1020 A = SIN(PI/2) : IF ABS(A - 1) > EPS THEN PRINT "FAIL SIN": ERROR 10
1030 A = COS(PI)   : IF ABS(A - (-1)) > EPS THEN PRINT "FAIL COS": ERROR 10
1040 A = TAN(0)    : IF ABS(A - 0) > EPS THEN PRINT "FAIL TAN": ERROR 10
1050 A = ATN(1)    : IF ABS(A - (PI/4)) > EPS THEN PRINT "FAIL ATN": ERROR 10
1055 A = ASIN(1)   : IF ABS(A - (PI/2)) > EPS THEN PRINT "FAIL ASIN": ERROR 10
1056 A = ACOS(0)   : IF ABS(A - (PI/2)) > EPS THEN PRINT "FAIL ACOS": ERROR 10
1060 
1070 PRINT "   -> Testing Hyperbolic Trig..."
1080 A = SINH(0)   : IF ABS(A - 0) > EPS THEN PRINT "FAIL SINH": ERROR 10
1090 A = COSH(0)   : IF ABS(A - 1) > EPS THEN PRINT "FAIL COSH": ERROR 10
1100 A = TANH(0)   : IF ABS(A - 0) > EPS THEN PRINT "FAIL TANH": ERROR 10
1110 
1120 PRINT "   -> Testing Exponents and Logarithms..."
1130 A = EXP(1)    : IF ABS(A - 2.71828) > EPS THEN PRINT "FAIL EXP": ERROR 10
1140 A = LN(EXP(2)): IF ABS(A - 2) > EPS THEN PRINT "FAIL LN": ERROR 10
1150 A = LOG(EXP(2)): IF ABS(A - 2) > EPS THEN PRINT "FAIL LOG": ERROR 10
1160 A = LOG10(100): IF ABS(A - 2) > EPS THEN PRINT "FAIL LOG10": ERROR 10
1170 A = LGT(1000) : IF ABS(A - 3) > EPS THEN PRINT "FAIL LGT": ERROR 10
1180 A = LOG2(8)   : IF ABS(A - 3) > EPS THEN PRINT "FAIL LOG2": ERROR 10
1190 
1200 PRINT "   -> Testing Utilities..."
1210 A = ABS(-42)  : IF A <> 42 THEN PRINT "FAIL ABS": ERROR 10
1220 A = SGN(-5)   : IF A <> -1 THEN PRINT "FAIL SGN": ERROR 10
1230 A = SQR(144)  : IF A <> 12 THEN PRINT "FAIL SQR": ERROR 10
1240 A = INT(3.7)  : IF A <> 3 THEN PRINT "FAIL INT": ERROR 10
1250 A = INT(-3.7) : IF A <> -4 THEN PRINT "FAIL INT NEG": ERROR 10
1260 A = FIX(-3.7) : IF A <> -3 THEN PRINT "FAIL FIX NEG": ERROR 10
1280 A = PDIF(5, 3): IF A <> 2 THEN PRINT "FAIL PDIF": ERROR 10
1290 A = PDIF(3, 5): IF A <> 0 THEN PRINT "FAIL PDIF ZERO": ERROR 10
1300 A = COMP(5, 3): IF A <> 1 THEN PRINT "FAIL COMP 1": ERROR 10
1310 A = COMP(3, 5): IF A <> -1 THEN PRINT "FAIL COMP -1": ERROR 10
1315 A = COMP(5, 5): IF A <> 0 THEN PRINT "FAIL COMP 0": ERROR 10
1320 
1330 PRINT "   -> Testing Binary Bytes..."
1340 A = HI(258)   : IF A <> 1 THEN PRINT "FAIL HI": ERROR 10
1350 A = LO(258)   : IF A <> 2 THEN PRINT "FAIL LO": ERROR 10
1360 
1370 PRINT "   -> Testing Randomizer..."
1380 RANDOMIZE 42
1390 A = RND(1)
1400 IF A < 0 OR A >= 1 THEN PRINT "FAIL RND": ERROR 10
1410 
1420 RETURN
1430 
2000 REM --- Advanced / Complex Math ---
2010 PRINT "   -> Testing Stats..."
2020 A = MAX(10, 20): IF A <> 20 THEN PRINT "FAIL MAX": ERROR 20
2030 A = MIN(10, 20): IF A <> 10 THEN PRINT "FAIL MIN": ERROR 20
2040 A = AVG(10, 20, 30): IF A <> 20 THEN PRINT "FAIL AVG": ERROR 20
2045 A = ROUND(3.14159, 2): IF ABS(A - 3.14) > EPS THEN PRINT "FAIL ROUND": ERROR 20
2050 
2060 PRINT "   -> Testing Complex Math..."
2070 Z = COMPLEX(3, 4)
2080 A = REAL(Z)   : IF A <> 3 THEN PRINT "FAIL REAL": ERROR 20
2090 A = IMAG(Z)   : IF A <> 4 THEN PRINT "FAIL IMAG": ERROR 20
2100 A = CABS(Z)   : IF A <> 5 THEN PRINT "FAIL CABS": ERROR 20
2110 Z2 = CONJ(Z)  
2120 IF IMAG(Z2) <> -4 THEN PRINT "FAIL CONJ": ERROR 20
2130 Z3 = CSQR(COMPLEX(-4, 0))
2140 IF ABS(IMAG(Z3) - 2) > EPS THEN PRINT "FAIL CSQR": ERROR 20
2150 
2160 RETURN
2170 
3000 REM --- Matrix Math ---
3010 PRINT "   -> Testing Matrix Determinant..."
3020 DIM MATX(2, 2)
3030 MATX(1, 1) = 4 : MATX(1, 2) = 6
3040 MATX(2, 1) = 3 : MATX(2, 2) = 8
3050 A = DET(MATX)
3060 IF A <> (4*8 - 6*3) THEN PRINT "FAIL DET": ERROR 30
3070 
3080 PRINT "   -> Testing MAT IDN..."
3090 MAT MATX = IDN
3100 IF MATX(1,1) <> 1 OR MATX(1,2) <> 0 THEN PRINT "FAIL MAT IDN": ERROR 30
3110 
3120 RETURN
