' --- ADVANCED MATH TEST ---
' Tests scalar math functions

' Test basic
IF ABS(-5) <> 5 THEN PRINT "ABS FAILED": GOTO 9999
IF SGN(-5) <> -1 THEN PRINT "SGN FAILED": GOTO 9999
IF INT(3.7) <> 3 THEN PRINT "INT FAILED": GOTO 9999
IF FIX(-3.7) <> -3 THEN PRINT "FIX FAILED": GOTO 9999

' Test min/max/avg/med
IF MIN(5, 2, 9) <> 2 THEN PRINT "MIN FAILED": GOTO 9999
IF MAX(5, 2, 9) <> 9 THEN PRINT "MAX FAILED": GOTO 9999
IF AVG(2, 4, 6) <> 4 THEN PRINT "AVG FAILED": GOTO 9999
IF MED(2, 9, 4) <> 4 THEN PRINT "MED FAILED": GOTO 9999

' Test complex
C = COMPLEX(3, 4)
IF REAL(C) <> 3 THEN PRINT "REAL FAILED": GOTO 9999
IF IMAG(C) <> 4 THEN PRINT "IMAG FAILED": GOTO 9999
IF CABS(C) <> 5 THEN PRINT "CABS FAILED": GOTO 9999

PRINT "ALL TESTS PASSED"
END

9999 PRINT "TEST SUITE FAILED"
