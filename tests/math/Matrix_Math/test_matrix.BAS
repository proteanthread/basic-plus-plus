' --- MATRIX MATH TEST ---
' Tests: MAT ZER, MAT CON, MAT IDN, MAT RND, MAT TRN, MAT INV

DIM A(3, 3)
DIM B(3, 3)
DIM C(3, 3)
DIM D(3, 3)

' TEST 1: MAT ZER
MAT A = ZER
IF A(2, 2) <> 0 THEN PRINT "MAT ZER FAILED": GOTO 9999

' TEST 2: MAT CON
MAT A = CON
IF A(2, 2) <> 1 THEN PRINT "MAT CON FAILED": GOTO 9999

' TEST 3: MAT IDN
MAT A = IDN
IF A(1, 1) <> 1 THEN PRINT "MAT IDN FAILED": GOTO 9999
IF A(1, 2) <> 0 THEN PRINT "MAT IDN FAILED": GOTO 9999

' TEST 4: MAT RND
MAT A = RND
IF A(1, 1) < 0 OR A(1, 1) > 1 THEN PRINT "MAT RND FAILED": GOTO 9999

' TEST 5: MAT TRN
MAT B = IDN
B(1, 3) = 55
MAT C = TRN(B)
IF C(3, 1) <> 55 THEN PRINT "MAT TRN FAILED": GOTO 9999

' TEST 6: MAT INV
MAT B = IDN
MAT C = INV(B)
IF C(1, 1) <> 1 THEN PRINT "MAT INV FAILED": GOTO 9999

PRINT "ALL TESTS PASSED"
END

9999 PRINT "TEST SUITE FAILED"
