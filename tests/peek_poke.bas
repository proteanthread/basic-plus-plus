1 REM === t31_peek_poke.bas ===
2 REM Tests: DEF SEG, PEEK, POKE round-trip
3 DIALECT "GWBS"
10 TEST "POKE/PEEK round-trip"
20 POKE 1000, 42
30 ASSERT PEEK(1000)=42
40 POKE 1000, 0
50 ASSERT PEEK(1000)=0
60 ENDTEST
100 TEST "POKE boundary values"
110 POKE 2000, 0
120 ASSERT PEEK(2000)=0
130 POKE 2000, 255
140 ASSERT PEEK(2000)=255
150 POKE 2000, 128
160 ASSERT PEEK(2000)=128
170 ENDTEST
200 TEST "DEF SEG"
210 DEF SEG = 0
220 POKE 500, 77
230 ASSERT PEEK(500)=77
240 ENDTEST
300 TEST "POKE multiple locations"
310 POKE 3000, 10
320 POKE 3001, 20
330 POKE 3002, 30
340 ASSERT PEEK(3000)=10
350 ASSERT PEEK(3001)=20
360 ASSERT PEEK(3002)=30
370 ENDTEST
999 END
