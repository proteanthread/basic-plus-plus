1 REM === t14_select_case.bas ===
2 REM Tests: SELECT CASE, CASE, CASE IS, CASE ELSE
3 DIALECT "QBAS"
10 TEST "SELECT CASE exact"
20 LET X=3
30 LET R=0
40 SELECT CASE X
50 CASE 1
60 LET R=10
70 CASE 2
80 LET R=20
90 CASE 3
100 LET R=30
110 CASE ELSE
120 LET R=99
130 END SELECT
140 ASSERT R=30
150 ENDTEST
200 TEST "SELECT CASE ELSE"
210 LET X=99
220 LET R=0
230 SELECT CASE X
240 CASE 1
250 LET R=10
260 CASE 2
270 LET R=20
280 CASE ELSE
290 LET R=999
300 END SELECT
310 ASSERT R=999
320 ENDTEST
400 TEST "SELECT CASE range"
410 LET X=5
420 LET R=0
430 SELECT CASE X
440 CASE 1 TO 3
450 LET R=1
460 CASE 4 TO 6
470 LET R=2
480 CASE ELSE
490 LET R=3
500 END SELECT
510 ASSERT R=2
520 ENDTEST
600 TEST "SELECT CASE IS"
610 LET X=15
620 LET R=0
630 SELECT CASE X
640 CASE IS < 10
650 LET R=1
660 CASE IS < 20
670 LET R=2
680 CASE ELSE
690 LET R=3
700 END SELECT
710 ASSERT R=2
720 ENDTEST
999 END
