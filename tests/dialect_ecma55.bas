1 REM === t35_dialect_ecma55.bas ===
2 REM Tests: ECMA-55 Minimal BASIC
3 DIALECT "E55"
10 TEST "ECMA55 arithmetic"
20 ASSERT 2+3=5
30 ASSERT 10-7=3
40 ASSERT 6*7=42
50 ENDTEST
100 TEST "ECMA55 FOR"
110 LET S=0
120 FOR I=1 TO 5
130 LET S=S+I
140 NEXT I
150 ASSERT S=15
160 ENDTEST
200 TEST "ECMA55 DATA/READ"
210 READ A,B
220 ASSERT A=10
230 ASSERT B=20
240 ENDTEST
250 DATA 10,20
300 TEST "ECMA55 functions"
310 ASSERT ABS(-5)=5
320 ASSERT SGN(10)=1
330 ASSERT INT(3.7)=3
340 ENDTEST
999 END
