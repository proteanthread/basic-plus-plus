1 REM === t40_dialect_apple.bas ===
2 REM Tests: Applesoft BASIC features
3 DIALECT "ASFT"
10 TEST "Applesoft arithmetic"
20 ASSERT 2+3=5
30 ASSERT 3.14>3.0
40 ENDTEST
100 TEST "Applesoft variables"
110 LET A=42
120 ASSERT A=42
130 LET A$="APPLE"
140 ASSERT LEN(A$)=5
150 ENDTEST
200 TEST "Applesoft GOSUB"
210 LET R=0
220 GOSUB 260
230 ASSERT R=99
240 ENDTEST
250 GOTO 300
260 LET R=99
270 RETURN
300 TEST "Applesoft memmap"
310 MEMMAP "APPLE2"
320 ASSERT PEEK(64435)=6
330 ENDTEST
999 END
