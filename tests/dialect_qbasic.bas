1 REM === t37_dialect_qbasic.bas ===
2 REM Tests: QBasic features
3 DIALECT "QBAS"
10 TEST "QBASIC SELECT CASE"
20 LET X=2
30 LET R=0
40 SELECT CASE X
50 CASE 1
60 LET R=10
70 CASE 2
80 LET R=20
90 CASE ELSE
100 LET R=99
110 END SELECT
120 ASSERT R=20
130 ENDTEST
200 TEST "QBASIC Block IF"
210 LET R=0
220 IF 5>3 THEN
230 LET R=1
240 END IF
250 ASSERT R=1
260 ENDTEST
300 TEST "QBASIC SUB"
310 LET G=0
320 CALL MySub(42)
330 ASSERT G=42
340 ENDTEST
350 GOTO 500
400 SUB MySub(V)
410 LET G=V
420 END SUB
500 TEST "QBASIC CONST"
510 CONST MYVAL=100
520 ASSERT MYVAL=100
530 ENDTEST
600 TEST "QBASIC DO/LOOP"
610 LET S=0
620 LET I=1
630 DO WHILE I<=5
640 LET S=S+I
650 LET I=I+1
660 LOOP
670 ASSERT S=15
680 ENDTEST
999 END
