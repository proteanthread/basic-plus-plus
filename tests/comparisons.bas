1 REM === t02_comparisons.bas ===
2 REM Tests: = <> < > <= >= comparisons on ints/floats/strings
3 DIALECT "GWBS"
10 TEST "Equal"
20 ASSERT 5=5
30 ASSERT 0=0
40 ASSERT -3=-3
50 ENDTEST
100 TEST "Not Equal"
110 ASSERT 5<>3
120 ASSERT 0<>1
130 ASSERT -1<>1
140 ENDTEST
200 TEST "Less Than"
210 ASSERT 3<5
220 ASSERT -1<0
230 ASSERT 0<1
240 ENDTEST
300 TEST "Greater Than"
310 ASSERT 5>3
320 ASSERT 0>-1
330 ASSERT 1>0
340 ENDTEST
400 TEST "Less Than or Equal"
410 ASSERT 5<=5
420 ASSERT 3<=5
430 ASSERT -1<=0
440 ENDTEST
500 TEST "Greater Than or Equal"
510 ASSERT 5>=5
520 ASSERT 5>=3
530 ASSERT 0>=-1
540 ENDTEST
600 TEST "Float Comparisons"
610 ASSERT 3.14>3.0
620 ASSERT 2.5<3.0
630 ASSERT 1.0=1.0
640 ASSERT 1.0<>2.0
650 ENDTEST
700 TEST "String Comparisons"
710 LET A$="APPLE"
720 LET B$="BANANA"
730 ASSERT A$<B$
740 ASSERT B$>A$
750 LET C$="APPLE"
760 ASSERT A$=C$
770 ASSERT A$<>B$
780 ENDTEST
999 END
