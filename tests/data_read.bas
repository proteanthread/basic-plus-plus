1 REM === t08_data_read.bas ===
2 REM Tests: DATA, READ, RESTORE
3 DIALECT "GWBS"
10 TEST "Basic READ"
20 READ A
30 READ B
40 READ C
50 ASSERT A=10
60 ASSERT B=20
70 ASSERT C=30
80 ENDTEST
90 DATA 10, 20, 30
100 TEST "String DATA"
110 READ A$
120 READ B$
130 ASSERT A$="HELLO"
140 ASSERT B$="WORLD"
150 ENDTEST
160 DATA "HELLO", "WORLD"
200 TEST "RESTORE"
210 RESTORE
220 READ X
230 ASSERT X=10
240 READ Y
250 ASSERT Y=20
260 ENDTEST
300 TEST "Mixed DATA"
310 RESTORE
320 READ A
330 READ B
340 READ C
350 READ A$
360 READ B$
370 ASSERT A=10
380 ASSERT B=20
390 ASSERT C=30
395 ASSERT A$="HELLO"
396 ASSERT B$="WORLD"
397 ENDTEST
999 END
