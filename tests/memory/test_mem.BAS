' --- MEMORY TEST ---
' Tests: PEEK, POKE, PEEKB, POKEB, SIZE, BANK, MEMMAP, CLEAR, CLR, FRE, VARPTR, SEG

' 1. SIZE & FRE
A = SIZE
B = FRE(0)
IF A <= 0 THEN PRINT "SIZE FAILED": GOTO 9999
IF B <= 0 THEN PRINT "FRE FAILED": GOTO 9999

' 2. POKE & PEEK
POKE 1000, 42
IF PEEK(1000) <> 42 THEN PRINT "PEEK/POKE FAILED": GOTO 9999

' 3. POKEB & PEEKB
POKEB 1, 1000, 99
IF PEEKB(1, 1000) <> 99 THEN PRINT "PEEKB/POKEB FAILED": GOTO 9999

' 4. BANK & MEMMAP
MEMMAP 48
BANK 1
' Just verify it didn't crash

' 5. VARPTR & SEG
X = 5
VP = VARPTR(X)
SG = SEG(X)
IF VP <= 0 THEN PRINT "VARPTR FAILED": GOTO 9999
IF SG <= 0 THEN PRINT "SEG FAILED": GOTO 9999

' 6. CLEAR & CLR
' CLEAR and CLR erase variables, so we test them at the end.
MYVAR = 100
CLR
IF MYVAR <> 0 THEN PRINT "CLR FAILED": GOTO 9999

MYVAR = 200
CLEAR
IF MYVAR <> 0 THEN PRINT "CLEAR FAILED": GOTO 9999

PRINT "ALL TESTS PASSED"
END
9999 PRINT "TEST SUITE FAILED"
