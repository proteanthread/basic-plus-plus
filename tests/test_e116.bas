1 REM =====================================================
2 REM  TEST_E116.BAS - ECMA-116 Full BASIC Dialect Test
3 REM =====================================================
4 REM  Dialect: E116 (ECMA-116 Full BASIC, 1986)
5 REM  Features: Structured control flow, WHILE/WEND,
6 REM            DO/LOOP, floats, strings, DIM, DATA/READ,
7 REM            extended vars, MERGE/CHAIN, ON ERROR,
8 REM            optional LET, max line 99999
9 REM =====================================================
10 REM  Usage: DIALECT "E116" : LOAD "tests/test_e116.bas" : RUN
11 REM =====================================================
12 LET P=0
13 LET F=0

100 TEST "Arithmetic"
110 ASSERT 2 + 3 = 5
120 ASSERT 10 - 7 = 3
130 ASSERT 6 * 7 = 42
140 ASSERT 100 / 10 = 10
150 ASSERT 10 MOD 3 = 1
160 ENDTEST

200 TEST "Floating Point"
210 LET X = 3.14159
220 ASSERT X > 3.0
230 ASSERT X < 4.0
240 ASSERT SQR(144) = 12
250 ASSERT INT(3.7) = 3
260 ENDTEST

300 TEST "String Operations"
310 A$ = "STANDARD"
320 B$ = " BASIC"
330 C$ = A$ + B$
340 ASSERT LEN(C$) = 14
350 ASSERT LEFT$(A$, 4) = "STAN"
360 ASSERT RIGHT$(B$, 5) = "BASIC"
370 ASSERT MID$(A$, 5, 4) = "DARD"
380 ASSERT MID$(A$, 5) = "DARD"
390 ENDTEST

400 TEST "Structured IF/ELSEIF"
410 X = 75
420 IF X >= 90 THEN
430   GRADE$ = "A"
440 ELSEIF X >= 80 THEN
450   GRADE$ = "B"
460 ELSEIF X >= 70 THEN
470   GRADE$ = "C"
480 ELSE
490   GRADE$ = "F"
500 END IF
510 ASSERT GRADE$ = "C"
520 ENDTEST

600 TEST "WHILE/WEND"
610 S = 0
620 I = 1
630 WHILE I <= 10
640 S = S + I
650 I = I + 1
660 WEND
670 ASSERT S = 55
680 ENDTEST

700 TEST "DO/LOOP"
710 S = 0
720 I = 1
730 DO
740 S = S + I
750 I = I + 1
760 LOOP WHILE I <= 5
770 ASSERT S = 15
780 ENDTEST

800 TEST "FOR/NEXT"
810 S = 0
820 FOR I = 1 TO 5
830 S = S + I
840 NEXT I
850 ASSERT S = 15
860 S = 0
870 FOR I = 10 TO 1 STEP -1
880 S = S + 1
890 NEXT I
900 ASSERT S = 10
910 ENDTEST

1000 TEST "DIM Arrays"
1010 DIM A(20)
1020 FOR I = 0 TO 20
1030 A(I) = I * I
1040 NEXT I
1050 ASSERT A(0) = 0
1060 ASSERT A(5) = 25
1070 ASSERT A(10) = 100
1080 ASSERT A(20) = 400
1090 ENDTEST

1100 TEST "DATA/READ/RESTORE"
1110 READ X, Y, Z
1120 ASSERT X = 10
1130 ASSERT Y = 20
1140 ASSERT Z = 30
1150 RESTORE
1160 READ A
1170 ASSERT A = 10
1180 ENDTEST
1190 DATA 10, 20, 30

1200 TEST "Named Variables"
1210 RESULT = 0
1220 FOR K = 1 TO 5
1230 RESULT = RESULT + K
1240 NEXT K
1250 ASSERT RESULT = 15
1260 ENDTEST

1300 TEST "DEF FN"
1310 DEF FN A(R) = 3.14159 * R * R
1320 A = FN A(10)
1330 ASSERT A > 314
1340 ASSERT A < 315
1350 ENDTEST

1400 TEST "Math Functions"
1410 ASSERT ABS(-100) = 100
1420 ASSERT SGN(-1) = -1
1430 ASSERT SGN(0) = 0
1440 ASSERT SGN(1) = 1
1450 ASSERT SQR(49) = 7
1460 ENDTEST

1500 TEST "Logical Operators"
1510 ASSERT (5 > 3) AND (10 > 1)
1520 ASSERT (5 > 3) OR (1 > 10)
1530 ASSERT NOT (3 > 5)
1540 ENDTEST

9000 PRINT ""
9010 PRINT "=== ECMA-116 DIALECT TESTS COMPLETE ==="
9020 END
