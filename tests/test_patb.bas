1 REM =====================================================
2 REM  TEST_PATB.BAS - Palo Alto Tiny BASIC Dialect Test
3 REM =====================================================
4 REM  Dialect: PATB (default)
5 REM  Features: Integer-only, A-Z vars, @() array,
6 REM            semicolon stmt separator, no THEN keyword,
7 REM            # not-equal, RND(n)=1..n, SIZE, no strings
8 REM =====================================================
9 REM  Usage: LOAD "tests/test_patb.bas" : RUN
10 REM =====================================================
11 LET P=0
12 LET F=0

100 TEST "Arithmetic"
110 ASSERT 2+3=5
120 ASSERT 10-7=3
130 ASSERT 6*7=42
140 ASSERT 100/10=10
150 ASSERT -(-5)=5
160 ASSERT 2+3*4=14
170 ASSERT (2+3)*4=20
180 ENDTEST

200 TEST "Comparisons"
210 ASSERT 5>3
220 ASSERT 3<5
230 ASSERT 5>=5
240 ASSERT 5<=5
250 ASSERT 5=5
260 ASSERT 5<>3
270 ENDTEST

300 TEST "Variables A-Z"
310 A=1
320 B=2
330 C=A+B
340 ASSERT C=3
350 Z=26
360 ASSERT Z=26
370 ENDTEST

400 TEST "FOR/NEXT Loop"
410 S=0
420 FOR I=1 TO 5
430 S=S+I
440 NEXT I
450 ASSERT S=15
460 ASSERT I=6
470 S=0
480 FOR I=1 TO 10 STEP 2
490 S=S+1
500 NEXT I
510 ASSERT S=5
520 ENDTEST

600 TEST "GOSUB/RETURN"
610 R=0
620 GOSUB 660
630 ASSERT R=99
640 ENDTEST
650 GOTO 700
660 R=99
670 RETURN

700 TEST "IF Without THEN"
710 X=0
720 IF 1>0 X=1
730 ASSERT X=1
740 X=0
750 IF 0>1 X=1
760 ASSERT X=0
770 ENDTEST

800 TEST "ABS and SGN"
810 ASSERT ABS(-7)=7
820 ASSERT ABS(7)=7
830 ASSERT SGN(-5)=-1
840 ASSERT SGN(0)=0
850 ASSERT SGN(5)=1
860 ENDTEST

900 TEST "RND (Integer 1..N)"
910 R=RND(100)
920 ASSERT R>=1
930 ASSERT R<=100
940 ENDTEST

950 TEST "SIZE"
960 ASSERT SIZE>0
970 ENDTEST

980 TEST "@() Array"
985 @(0)=42
986 @(1)=99
987 @(2)=@(0)+@(1)
988 ASSERT @(0)=42
989 ASSERT @(1)=99
990 ASSERT @(2)=141
991 ENDTEST

1000 PRINT ""
1010 PRINT "=== PATB DIALECT TESTS COMPLETE ==="
1020 END
