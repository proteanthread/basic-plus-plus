1 REM === t34_dialect_gwbs.bas ===
2 REM Tests: GW-BASIC features
3 DIALECT "GWBS"
10 TEST "GWBS floats"
20 LET A=3.14
30 ASSERT A>3.0
40 ASSERT A<4.0
50 ENDTEST
100 TEST "GWBS string functions"
110 ASSERT LEN("HELLO")=5
120 ASSERT LEFT$("HELLO",3)="HEL"
130 ASSERT RIGHT$("HELLO",2)="LO"
140 ASSERT MID$("HELLO",2,3)="ELL"
150 ENDTEST
200 TEST "GWBS ELSE"
210 LET X=0
220 IF 0>1 THEN LET X=1 ELSE LET X=2
230 ASSERT X=2
240 ENDTEST
300 TEST "GWBS DEF FN"
310 DEF FNA(X)=X*X
320 ASSERT FNA(5)=25
330 ENDTEST
400 TEST "GWBS DIM"
410 DIM A(10)
420 LET A(5)=42
430 ASSERT A(5)=42
440 ENDTEST
500 TEST "GWBS DATA/READ"
510 READ A,B,C
520 ASSERT A=1
530 ASSERT B=2
540 ASSERT C=3
550 ENDTEST
560 DATA 1,2,3
999 END
