1 REM === t19_file_io.bas ===
2 REM Tests: OPEN, CLOSE, PRINT #, EOF, LOF
3 DIALECT "GWBS"
10 TEST "File Write/Read"
20 OPEN "testout.tmp" FOR OUTPUT AS #1
30 PRINT #1, "LINE1"
40 PRINT #1, "LINE2"
50 PRINT #1, "LINE3"
60 CLOSE #1
70 REM File written OK
80 ENDTEST
100 TEST "File Read Back"
110 OPEN "testout.tmp" FOR INPUT AS #1
120 LET C=0
130 WHILE NOT EOF(1)
140 INPUT #1, A$
150 LET C=C+1
160 WEND
170 CLOSE #1
180 ASSERT C=3
190 ENDTEST
200 TEST "File LOF"
210 OPEN "testout.tmp" FOR INPUT AS #1
220 LET L=LOF(1)
230 CLOSE #1
240 ASSERT L>0
250 ENDTEST
300 TEST "Cleanup"
310 KILL "testout.tmp"
320 ENDTEST
999 END
