1 REM === t45_dialect_superbasic.bas ===
2 REM Tests: SuperBASIC (Sinclair QL)
3 DIALECT "SUPA"
10 TEST "SuperBASIC arithmetic"
20 ASSERT 2+3=5
30 ASSERT 3.14>3.0
40 ENDTEST
100 TEST "SuperBASIC variables"
110 LET A=42
120 ASSERT A=42
130 LET A$="QL"
140 ASSERT LEN(A$)=2
150 ENDTEST
200 TEST "SuperBASIC FOR/NEXT"
210 LET S=0
220 FOR I=1 TO 5
230 LET S=S+I
240 NEXT I
250 ASSERT S=15
260 ENDTEST
300 TEST "SuperBASIC GOSUB"
310 LET R=0
320 GOSUB 360
330 ASSERT R=55
340 ENDTEST
350 GOTO 400
360 LET R=55
370 RETURN
400 TEST "QL memmap"
410 MEMMAP "QL"
420 ASSERT PEEK(256)=2
430 ENDTEST
999 END
