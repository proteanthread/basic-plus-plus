1 REM === t22_complex.bas ===
2 REM Tests: COMPLEX(), REAL(), IMAG(), complex arithmetic
3 DIALECT "GWBS"
10 TEST "COMPLEX constructor"
20 LET Z=COMPLEX(3,4)
30 ASSERT REAL(Z)=3
40 ASSERT IMAG(Z)=4
50 ENDTEST
100 TEST "Complex addition"
110 LET A=COMPLEX(1,2)
120 LET B=COMPLEX(3,4)
130 LET C=A+B
140 ASSERT REAL(C)=4
150 ASSERT IMAG(C)=6
160 ENDTEST
200 TEST "Complex subtraction"
210 LET A=COMPLEX(5,7)
220 LET B=COMPLEX(2,3)
230 LET C=A-B
240 ASSERT REAL(C)=3
250 ASSERT IMAG(C)=4
260 ENDTEST
300 TEST "Complex multiplication"
310 REM (1+2i)(3+4i) = (3-8)+(4+6)i = -5+10i
320 LET A=COMPLEX(1,2)
330 LET B=COMPLEX(3,4)
340 LET C=A*B
350 ASSERT REAL(C)=-5
360 ASSERT IMAG(C)=10
370 ENDTEST
400 TEST "Complex division"
410 REM (10+0i)/(2+0i) = 5+0i
420 LET A=COMPLEX(10,0)
430 LET B=COMPLEX(2,0)
440 LET C=A/B
450 ASSERT REAL(C)=5
460 ASSERT IMAG(C)=0
470 ENDTEST
500 TEST "Complex negation"
510 LET A=COMPLEX(3,-4)
520 LET B=-A
530 ASSERT REAL(B)=-3
540 ASSERT IMAG(B)=4
550 ENDTEST
600 TEST "REAL/IMAG on scalars"
610 ASSERT REAL(5)=5
620 ASSERT IMAG(5)=0
630 ASSERT REAL(3.14)=3.14
640 ASSERT IMAG(3.14)=0
650 ENDTEST
700 TEST "Mixed complex/scalar"
710 LET A=COMPLEX(2,3)
720 LET B=A+5
730 ASSERT REAL(B)=7
740 ASSERT IMAG(B)=3
750 ENDTEST
999 END
