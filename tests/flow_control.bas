1 REM === t04_flow_control.bas ===
2 REM Tests: IF/THEN/ELSE, GOTO, GOSUB/RETURN, END
3 DIALECT "GWBS"
10 TEST "IF true branch"
20 LET X=0
30 IF 1>0 THEN LET X=1
40 ASSERT X=1
50 ENDTEST
100 TEST "IF false branch"
110 LET X=0
120 IF 0>1 THEN LET X=1
130 ASSERT X=0
140 ENDTEST
200 TEST "IF/ELSE"
210 LET X=0
220 IF 5>10 THEN LET X=1 ELSE LET X=2
230 ASSERT X=2
240 ENDTEST
300 TEST "GOTO"
310 LET X=0
320 GOTO 340
330 LET X=99
340 ASSERT X=0
350 ENDTEST
400 TEST "GOSUB/RETURN"
410 LET R=0
420 GOSUB 460
430 ASSERT R=42
440 ENDTEST
450 GOTO 500
460 LET R=42
470 RETURN
500 TEST "Nested GOSUB"
510 LET A=0
520 LET B=0
530 GOSUB 570
540 ASSERT A=1
550 ASSERT B=2
560 ENDTEST
565 GOTO 600
570 LET A=1
580 GOSUB 595
590 RETURN
595 LET B=2
596 RETURN
600 TEST "IF with GOTO"
610 LET X=0
620 IF 1=1 GOTO 640
630 LET X=99
640 ASSERT X=0
650 ENDTEST
999 END
