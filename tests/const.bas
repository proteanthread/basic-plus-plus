1 REM === t20_const.bas ===
2 REM Tests: CONST named constants
3 DIALECT "QBAS"
10 TEST "CONST integer"
20 CONST MAXVAL = 100
30 ASSERT MAXVAL=100
40 ENDTEST
100 TEST "CONST in expression"
110 CONST PI = 3.14159
120 LET R=5
130 LET AREA=PI*R*R
140 ASSERT AREA>78
150 ASSERT AREA<79
160 ENDTEST
200 TEST "Multiple CONST"
210 CONST WIDTH = 80
220 CONST HEIGHT = 25
230 LET TOTAL=WIDTH*HEIGHT
240 ASSERT TOTAL=2000
250 ENDTEST
999 END
