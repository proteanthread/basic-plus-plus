1 REM ============================================================
2 REM  sbasic_math.bpp
3 REM  SUPER BASIC (Tymshare) Extended Math Function Tests
4 REM ============================================================
5 REM
6 REM  SUPER BASIC (1968) was developed by Mark Alexander and
7 REM  Dan Streng at Tymshare for the SDS 940 mainframe. It
8 REM  extended Dartmouth BASIC with a rich set of mathematical
9 REM  functions far beyond what typical microcomputer BASICs
10 REM  offered.
11 REM
12 REM  This test verifies the extended math functions that
13 REM  originate from the SUPER BASIC dialect:
14 REM
15 REM    ASIN(x)     - Arcsine (inverse sine)
16 REM    ACOS(x)     - Arccosine (inverse cosine)
17 REM    SINH(x)     - Hyperbolic sine
18 REM    COSH(x)     - Hyperbolic cosine
19 REM    TANH(x)     - Hyperbolic tangent
20 REM    LOG10(x)    - Logarithm base 10
21 REM    LOG2(x)     - Logarithm base 2
22 REM    COMP(a, b)  - Compare: returns -1, 0, or +1
23 REM    PDIF(a, b)  - Positive difference: MAX(a-b, 0)
24 REM    PI          - The constant 3.14159265...
25 REM
26 DIALECT "GWBS"
100 REM === ASIN(x) — Arcsine ===
101 REM Returns the angle (radians) whose sine is x.
102 REM Domain: -1 <= x <= 1.  Range: -PI/2 to PI/2.
103 REM ASIN(0) = 0, ASIN(1) = PI/2 ≈ 1.5708
110 TEST "ASIN"
120 ASSERT ABS(ASIN(0)) < 0.0001
130 ASSERT ABS(ASIN(1) - 1.5708) < 0.001
140 ASSERT ABS(ASIN(-1) + 1.5708) < 0.001
150 ASSERT ABS(ASIN(0.5) - 0.5236) < 0.001
160 ENDTEST
200 REM === ACOS(x) — Arccosine ===
201 REM Returns the angle (radians) whose cosine is x.
202 REM Domain: -1 <= x <= 1.  Range: 0 to PI.
203 REM ACOS(1) = 0, ACOS(0) = PI/2 ≈ 1.5708
210 TEST "ACOS"
220 ASSERT ABS(ACOS(1)) < 0.0001
230 ASSERT ABS(ACOS(0) - 1.5708) < 0.001
240 ASSERT ABS(ACOS(-1) - 3.14159) < 0.001
250 ENDTEST
300 REM === SINH(x) — Hyperbolic Sine ===
301 REM SINH(x) = (e^x - e^(-x)) / 2
302 REM SINH(0) = 0, SINH(1) ≈ 1.17520
310 TEST "SINH"
320 ASSERT ABS(SINH(0)) < 0.0001
330 ASSERT ABS(SINH(1) - 1.1752) < 0.001
340 ASSERT ABS(SINH(-1) + 1.1752) < 0.001
350 ENDTEST
400 REM === COSH(x) — Hyperbolic Cosine ===
401 REM COSH(x) = (e^x + e^(-x)) / 2
402 REM COSH(0) = 1,  COSH(1) ≈ 1.54308
410 TEST "COSH"
420 ASSERT ABS(COSH(0) - 1) < 0.0001
430 ASSERT ABS(COSH(1) - 1.5431) < 0.001
440 ENDTEST
500 REM === TANH(x) — Hyperbolic Tangent ===
501 REM TANH(x) = SINH(x) / COSH(x)
502 REM TANH(0) = 0,  TANH(1) ≈ 0.76159
510 TEST "TANH"
520 ASSERT ABS(TANH(0)) < 0.0001
530 ASSERT ABS(TANH(1) - 0.7616) < 0.001
540 ENDTEST
600 REM === LOG10(x) — Logarithm Base 10 ===
601 REM LOG10(10) = 1,  LOG10(100) = 2,  LOG10(1000) = 3
602 REM Common logarithm, used in scientific calculations.
610 TEST "LOG10"
620 ASSERT ABS(LOG10(10) - 1) < 0.0001
630 ASSERT ABS(LOG10(100) - 2) < 0.0001
640 ASSERT ABS(LOG10(1000) - 3) < 0.0001
650 ASSERT ABS(LOG10(1) - 0) < 0.0001
660 ENDTEST
700 REM === LOG2(x) — Logarithm Base 2 ===
701 REM LOG2(2) = 1,  LOG2(8) = 3,  LOG2(1024) = 10
702 REM Binary logarithm, essential in computer science.
710 TEST "LOG2"
720 ASSERT ABS(LOG2(2) - 1) < 0.0001
730 ASSERT ABS(LOG2(8) - 3) < 0.0001
740 ASSERT ABS(LOG2(1024) - 10) < 0.0001
750 ENDTEST
800 REM === COMP(a, b) — Compare ===
801 REM Returns -1 if a < b, 0 if a = b, +1 if a > b.
802 REM Like SGN(a-b) but avoids floating-point overflow
803 REM on extreme values.
810 TEST "COMP"
820 ASSERT COMP(3, 5) = -1
830 ASSERT COMP(5, 5) = 0
840 ASSERT COMP(7, 3) = 1
850 ASSERT COMP(-1, 1) = -1
860 ENDTEST
900 REM === PDIF(a, b) — Positive Difference ===
901 REM Returns MAX(a - b, 0).
902 REM If a > b, returns the difference.
903 REM If a <= b, returns 0 (never negative).
904 REM Useful for clamped subtraction in algorithms.
910 TEST "PDIF"
920 ASSERT PDIF(5, 3) = 2
930 ASSERT PDIF(3, 5) = 0
940 ASSERT PDIF(10, 10) = 0
950 ASSERT PDIF(100, 0) = 100
960 ENDTEST
1000 REM === PI — Constant ===
1001 REM Returns 3.14159265358979...
1002 REM PI takes no arguments (zero-argument function).
1003 REM Useful for angle conversions and circle math.
1010 TEST "PI constant"
1020 ASSERT ABS(PI - 3.14159) < 0.001
1030 ASSERT ABS(PI * 2 - 6.28318) < 0.001
1040 ENDTEST
1100 REM === Identities ===
1101 REM Verify mathematical identities hold:
1102 REM   SIN(ASIN(x)) = x
1103 REM   COSH^2 - SINH^2 = 1
1104 REM   LOG10(10^x) = x
1110 TEST "Math identities"
1120 ASSERT ABS(SIN(ASIN(0.5)) - 0.5) < 0.0001
1130 ASSERT ABS(COSH(1)^2 - SINH(1)^2 - 1) < 0.0001
1140 ASSERT ABS(LOG10(10^3) - 3) < 0.0001
1150 ENDTEST
9999 END
