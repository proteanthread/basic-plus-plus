1 REM =====================================================
2 REM  TEST_COCO.BAS - Color Computer BASIC Dialect Test
3 REM =====================================================
4 REM  Dialect: COCO (Tandy CoCo, Microsoft Extended BASIC)
5 REM  Features: Float, strings, DIM, DATA/READ, extended
6 REM            vars, ON ERROR, CLS, TRON/TROFF, no WHILE,
7 REM            no DO/LOOP
8 REM  Prompt: "OK"
9 REM =====================================================
10 REM  Usage: DIALECT "COCO" : LOAD "tests/test_coco.bas" : RUN
11 REM =====================================================
12 LET P=0
13 LET F=0

100 TEST "Arithmetic"
110 ASSERT 2+3=5
120 ASSERT 10-7=3
130 ASSERT 6*7=42
140 ASSERT 100/10=10
150 ASSERT -(-5)=5
160 ENDTEST

200 TEST "Floating Point"
210 A=3.14
220 ASSERT A>3.0
230 ASSERT A<4.0
240 B=SQR(144)
250 ASSERT B=12
260 C=INT(3.7)
270 ASSERT C=3
280 ENDTEST

300 TEST "String Operations"
310 A$="TANDY"
320 ASSERT LEN(A$)=5
330 B$=LEFT$(A$,3)
340 ASSERT B$="TAN"
350 C$=RIGHT$(A$,2)
360 ASSERT C$="DY"
370 D$=MID$(A$,2,3)
380 ASSERT D$="AND"
390 ASSERT CHR$(65)="A"
395 ASSERT ASC("Z")=90
396 ENDTEST

400 TEST "Named Variables"
410 SCORE=100
420 LIVES=3
430 TOTAL=SCORE*LIVES
440 ASSERT TOTAL=300
450 ENDTEST

500 TEST "DIM Arrays"
510 DIM A(10), B$(5)
520 FOR I=0 TO 10
530 A(I)=I*2
540 NEXT I
550 ASSERT A(5)=10
560 ASSERT A(10)=20
570 B$(0)="COCO"
580 ASSERT B$(0)="COCO"
590 ENDTEST

600 TEST "FOR/NEXT"
610 S=0
620 FOR I=1 TO 5
630 S=S+I
640 NEXT I
650 ASSERT S=15
660 S=0
670 FOR I=10 TO 1 STEP -1
680 S=S+1
690 NEXT I
700 ASSERT S=10
710 ENDTEST

800 TEST "IF/THEN/ELSE"
810 X=0
820 IF 1>0 THEN X=1
830 ASSERT X=1
840 IF 0>1 THEN X=99 ELSE X=42
850 ASSERT X=42
860 ENDTEST

900 TEST "CLS"
910 CLS
920 ENDTEST

1000 TEST "GOSUB/RETURN"
1010 R=0
1020 GOSUB 1060
1030 ASSERT R=42
1040 ENDTEST
1050 GOTO 1100
1060 R=42
1070 RETURN

1100 TEST "DATA/READ/RESTORE"
1110 READ A, B, C
1120 ASSERT A=10
1130 ASSERT B=20
1140 ASSERT C=30
1150 RESTORE
1160 READ X
1170 ASSERT X=10
1180 ENDTEST
1190 DATA 10, 20, 30

1200 TEST "Math Functions"
1210 ASSERT ABS(-42)=42
1220 ASSERT SGN(-1)=-1
1230 ASSERT SGN(0)=0
1240 ASSERT SGN(1)=1
1250 ASSERT INT(7.9)=7
1260 ASSERT SQR(25)=5
1270 ENDTEST

1300 TEST "ON GOTO"
1310 X=3
1320 ON X GOTO 1340, 1350, 1360
1330 GOTO 1370
1340 Y=1: GOTO 1370
1350 Y=2: GOTO 1370
1360 Y=3: GOTO 1370
1370 ASSERT Y=3
1380 ENDTEST

9000 PRINT ""
9010 PRINT "=== COCO BASIC TESTS COMPLETE ==="
9020 END
