1 REM === t39_dialect_atari.bas ===
2 REM Tests: Atari BASIC features
3 DIALECT "ATRI"
10 TEST "Atari arithmetic"
20 ASSERT 2+3=5
30 ASSERT 6*7=42
40 ENDTEST
100 TEST "Atari variables"
110 LET A=99
120 ASSERT A=99
130 LET A$="ATARI"
140 ASSERT LEN(A$)=5
150 ENDTEST
200 TEST "Atari FOR/NEXT"
210 LET S=0
220 FOR I=1 TO 5
230 LET S=S+I
240 NEXT I
250 ASSERT S=15
260 ENDTEST
300 TEST "Atari memmap"
310 MEMMAP "ATARI8"
320 ASSERT PEEK(65527)=2
330 ENDTEST
999 END
