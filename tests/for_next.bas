1 REM === t05_for_next.bas ===
2 REM Tests: FOR/NEXT/STEP, negative step, nested, EXIT FOR
3 DIALECT "GWBS"
10 TEST "Basic FOR"
20 LET S=0
30 FOR I=1 TO 5
40 LET S=S+I
50 NEXT I
60 ASSERT S=15
70 ASSERT I=6
80 ENDTEST
100 TEST "FOR with STEP"
110 LET S=0
120 FOR I=0 TO 10 STEP 2
130 LET S=S+I
140 NEXT I
150 ASSERT S=30
160 ENDTEST
200 TEST "FOR negative STEP"
210 LET S=0
220 FOR I=5 TO 1 STEP -1
230 LET S=S+I
240 NEXT I
250 ASSERT S=15
260 ENDTEST
300 TEST "Nested FOR"
310 LET S=0
320 FOR I=1 TO 3
330 FOR J=1 TO 3
340 LET S=S+1
350 NEXT J
360 NEXT I
370 ASSERT S=9
380 ENDTEST
400 TEST "FOR zero iterations"
410 LET S=0
420 FOR I=10 TO 1
430 LET S=S+1
440 NEXT I
450 ASSERT S=0
460 ENDTEST
500 TEST "EXIT FOR"
510 LET S=0
520 FOR I=1 TO 100
530 IF I>5 THEN EXIT FOR
540 LET S=S+I
550 NEXT I
560 ASSERT S=15
570 ENDTEST
999 END
