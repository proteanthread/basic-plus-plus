1 REM === t36_dialect_ecma116.bas ===
2 REM Tests: ECMA-116 Full BASIC
3 DIALECT "E116"
10 TEST "ECMA116 arithmetic"
20 ASSERT 2+3=5
30 ASSERT 3.14>3.0
40 ENDTEST
100 TEST "ECMA116 WHEN EXCEPTION"
110 LET E=0
120 WHEN EXCEPTION IN
130 REM Protected block
140 LET X=42
150 USE
160 LET E=1
170 END WHEN
180 ASSERT E=0
190 ASSERT X=42
200 ENDTEST
300 TEST "ECMA116 WHEN EXCEPTION error"
310 LET E=0
320 WHEN EXCEPTION IN
330 REM Trigger an error
340 CAUSE EXCEPTION 1
350 USE
360 LET E=1
370 END WHEN
380 ASSERT E=1
390 ENDTEST
400 TEST "ECMA116 OPTION ANGLE"
410 OPTION ANGLE DEGREES
420 LET S=SIN(90)
430 ASSERT ABS(S-1)<0.01
440 OPTION ANGLE RADIANS
450 ENDTEST
999 END
