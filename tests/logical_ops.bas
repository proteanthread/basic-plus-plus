1 REM === t12_logical_ops.bas ===
2 REM Tests: AND, OR, NOT, XOR, EQV, IMP
3 DIALECT "GWBS"
10 TEST "AND"
20 ASSERT (1 AND 1)=1
30 ASSERT (1 AND 0)=0
40 ASSERT (0 AND 0)=0
50 ASSERT (255 AND 15)=15
60 ENDTEST
100 TEST "OR"
110 ASSERT (1 OR 0)=1
120 ASSERT (0 OR 0)=0
130 ASSERT (1 OR 1)=1
140 ASSERT (240 OR 15)=255
150 ENDTEST
200 TEST "NOT"
210 ASSERT NOT 0=-1
220 ASSERT NOT -1=0
230 ENDTEST
300 TEST "XOR"
310 ASSERT (1 XOR 0)=1
320 ASSERT (1 XOR 1)=0
330 ASSERT (0 XOR 0)=0
340 ASSERT (255 XOR 255)=0
350 ENDTEST
400 TEST "EQV"
410 ASSERT (1 EQV 1)=-1
420 ASSERT (0 EQV 0)=-1
430 ENDTEST
500 TEST "IMP"
510 ASSERT (0 IMP 0)=-1
520 ASSERT (0 IMP 1)=-1
530 ENDTEST
999 END
