1 REM === t27_options.bpp ===
2 REM Tests: OPTION BASE, ANGLE, TAB, ZONE, KEYWORD case
3 DIALECT "GWBS"
10 TEST "OPTION BASE 0"
20 OPTION BASE 0
30 DIM A(5)
40 LET A(0)=99
50 ASSERT A(0)=99
60 ENDTEST
100 TEST "OPTION ANGLE DEGREES"
110 OPTION ANGLE DEGREES
120 LET S=SIN(90)
130 ASSERT ABS(S-1)<0.01
140 OPTION ANGLE RADIANS
150 ENDTEST
200 TEST "OPTION TAB SPACES"
210 OPTION TAB SPACES
220 REM Just verify no crash
230 ENDTEST
300 TEST "OPTION ZONE"
310 OPTION ZONE 20
320 REM Set PRINT zone width to 20
330 OPTION ZONE DEFAULT
340 ENDTEST
400 TEST "OPTION KEYWORD UPPER"
410 OPTION KEYWORD UPPER
420 REM All keywords forced uppercase
430 ENDTEST
500 TEST "OPTION KEYWORD MIXED"
510 OPTION KEYWORD MIXED
520 REM Mixed case allowed
530 ENDTEST
999 END
