1 REM === t32_memmaps.bas ===
2 REM Tests: MEMMAP for each platform, verify signature PEEKs
3 DIALECT "GWBS"
10 TEST "MEMMAP MSDOS"
20 MEMMAP "MSDOS"
30 ASSERT PEEK(1097)=3
40 REM $0449 = Video mode 3
50 ENDTEST
100 TEST "MEMMAP C64"
110 MEMMAP "C64"
120 ASSERT PEEK(1)=55
130 REM $0001=0x37=55 (BASIC+KERNAL+I/O)
140 ASSERT PEEK(40964)=67
150 REM $A004='C' (CBMBASIC signature)
160 ENDTEST
200 TEST "MEMMAP C128"
210 MEMMAP "C128"
220 ASSERT PEEK(65408)=7
230 REM $FF80 = Version 7
240 ENDTEST
300 TEST "MEMMAP VIC20"
310 MEMMAP "VIC20"
320 ASSERT PEEK(65408)=2
330 REM $FF80 = Version 2
340 ENDTEST
400 TEST "MEMMAP PLUS4"
410 MEMMAP "PLUS4"
420 ASSERT PEEK(65408)=53
430 REM $FF80 = 0x35 = 53
440 ENDTEST
500 TEST "MEMMAP PET"
510 MEMMAP "PET"
520 ASSERT PEEK(65408)=4
530 REM $FF80 = BASIC 4.0
540 ENDTEST
600 TEST "MEMMAP ATARI8"
610 MEMMAP "ATARI8"
620 ASSERT PEEK(65527)=2
630 REM $FFF7 = OS version 2 (XL/XE)
640 ENDTEST
700 TEST "MEMMAP APPLE2"
710 MEMMAP "APPLE2"
720 ASSERT PEEK(64435)=6
730 REM $FBB3 = Apple IIe identifier
740 ENDTEST
800 TEST "MEMMAP TRS80"
810 MEMMAP "TRS80"
820 ASSERT PEEK(0)=243
830 REM $0000 = 0xF3 = DI instruction
840 ASSERT PEEK(98)=82
850 REM $0062 = 'R' for Radio Shack
860 ENDTEST
900 TEST "MEMMAP SPECTRUM"
910 MEMMAP "SPECTRUM"
920 ASSERT PEEK(0)=243
930 REM $0000 = 0xF3 = DI
940 LET V=PEEK(22528)
950 ASSERT V=56
960 REM $5800 = 0x38 default attribute
970 ENDTEST
980 TEST "MEMMAP QL"
985 MEMMAP "QL"
986 ASSERT PEEK(256)=2
987 REM $0100 = SV.IDENT = 2
988 ENDTEST
990 TEST "MEMMAP NONE"
991 MEMMAP "NONE"
992 ASSERT PEEK(0)=0
993 ASSERT PEEK(100)=0
994 ASSERT PEEK(1000)=0
995 ENDTEST
999 END
