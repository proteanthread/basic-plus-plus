1 REM === t07_do_loop.bas ===
2 REM Tests: DO/LOOP variants, EXIT DO
3 DIALECT "GWBS"
10 TEST "DO WHILE pre-check"
20 LET S=0
30 LET I=1
40 DO WHILE I<=5
50 LET S=S+I
60 LET I=I+1
70 LOOP
80 ASSERT S=15
90 ENDTEST
100 TEST "DO UNTIL pre-check"
110 LET S=0
120 LET I=1
130 DO UNTIL I>5
140 LET S=S+I
150 LET I=I+1
160 LOOP
170 ASSERT S=15
180 ENDTEST
200 TEST "DO/LOOP WHILE post-check"
210 LET S=0
220 LET I=1
230 DO
240 LET S=S+I
250 LET I=I+1
260 LOOP WHILE I<=5
270 ASSERT S=15
280 ENDTEST
300 TEST "DO/LOOP UNTIL post-check"
310 LET S=0
320 LET I=1
330 DO
340 LET S=S+I
350 LET I=I+1
360 LOOP UNTIL I>5
370 ASSERT S=15
380 ENDTEST
400 TEST "DO false pre-check"
410 LET X=0
420 DO WHILE 0>1
430 LET X=99
440 LOOP
450 ASSERT X=0
460 ENDTEST
500 TEST "EXIT DO"
510 LET S=0
520 LET I=1
530 DO
540 IF I>5 THEN EXIT DO
550 LET S=S+I
560 LET I=I+1
570 LOOP
580 ASSERT S=15
590 ENDTEST
999 END
