1 REM === t42_dialect_coco.bas ===
2 REM Tests: Color Computer BASIC
3 DIALECT "COCO"
10 TEST "COCO arithmetic"
20 ASSERT 2+3=5
30 ASSERT 6*7=42
40 ENDTEST
100 TEST "COCO variables"
110 LET A=99
120 ASSERT A=99
130 LET A$="COCO"
140 ASSERT LEN(A$)=4
150 ENDTEST
200 TEST "COCO FOR/NEXT"
210 LET S=0
220 FOR I=1 TO 5
230 LET S=S+I
240 NEXT I
250 ASSERT S=15
260 ENDTEST
999 END
