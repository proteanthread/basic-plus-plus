1 REM === t18_print_format.bas ===
2 REM Tests: PRINT, semicolons, commas, TAB, SPC, WRITE
3 DIALECT "GWBS"
10 TEST "PRINT basic"
20 REM Just verify no crash
30 PRINT "HELLO"
40 PRINT 42
50 PRINT 3.14
60 ENDTEST
100 TEST "PRINT semicolon"
110 PRINT "A";"B";"C"
120 PRINT
130 ENDTEST
200 TEST "PRINT comma"
210 PRINT "A","B","C"
220 PRINT
230 ENDTEST
300 TEST "PRINT expressions"
310 PRINT 2+3
320 PRINT "Result:";10*10
330 ENDTEST
400 TEST "TAB and SPC"
410 PRINT TAB(10);"TAB10"
420 PRINT SPC(5);"SPC5"
430 ENDTEST
500 TEST "WRITE"
510 WRITE 1,2,3
520 WRITE "A","B"
530 ENDTEST
600 TEST "LPRINT"
610 LPRINT "STDERR OUTPUT"
620 ENDTEST
999 END
