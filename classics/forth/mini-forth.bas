5 REM =============================================
6 REM  MINI-FORTH for BASIC++ v4.4 (GWBS LOAD-safe)
7 REM  All constructs avoid:
8 REM    - String arrays (use N$ concat)
9 REM    - RETURN inside IF THEN
10 REM    - DO WHILE (use IF/GOTO)
11 REM    - FOR with LEN() bound
12 REM    - Nested IF ELSE (outer binds)
13 REM =============================================
14 REM
15 REM  WHAT CAN BE CHANGED:
16 REM   - Stack size DS(32), dictionary DL/DT/DA(64)
17 REM   - Built-in word names in DATA statements
18 REM   - Batch input filename (forth_input.txt)
19 REM
20 REM  WHAT CANNOT BE CHANGED:
21 REM   - Line number structure (GOSUB targets)
22 REM   - Avoid multi-statement IF/THEN with ELSE
23 REM     on the same line (parser limitation)
24 REM   - Variable N$ (dictionary name table)
25 REM
26 REM  WHAT TO EXPECT:
27 REM   - Interactive Forth REPL with "ok" prompt
28 REM   - Supports basic Forth primitives
29 REM   - Type BYE to exit
30 REM
31 REM  TROUBLESHOOTING:
32 REM   - WHAT? on LINE INPUT: split complex IF
33 REM     lines; do not combine THEN/ELSE with
34 REM     colon-separated statements
35 REM   - Stack underflow: check Forth word usage
36 REM =============================================
100 REM === DATA STRUCTURES ===
101 DIM DS(32)
102 LET SP = 0
103 DIM DL(64)
104 DIM DT(64)
105 DIM DA(64)
106 LET DP = 1
107 LET LATEST = 0
108 LET N$ = ""
109 LET F = 8
110 LET IPOS = 0
111 LET ILEN = 0
112 LET RUNNING = 1
200 REM === Install primitives from DATA ===
201 RESTORE
202 DO
203   READ R$
204   IF R$ = "***" THEN GOTO 220
205   READ PT
206   N$ = N$ + LEFT$(R$ + "        ", F)
207   DL(DP) = LATEST
208   DT(DP) = PT
209   DA(DP) = 0
210   LATEST = DP
211   DP = DP + 1
212 LOOP
220 PRINT ""
221 PRINT "MINI-FORTH for BASIC++"
222 PRINT "A tiny Forth. Type BYE to quit."
223 PRINT ""
224 LET BATCH = 0
225 ON ERROR GOTO 228
226 OPEN "forth_input.txt" FOR INPUT AS #1
227 BATCH = 1 : PRINT "(batch mode)" : ON ERROR GOTO 0 : GOTO 230
228 ON ERROR GOTO 0
230 IF RUNNING = 0 THEN GOTO 299
231 IF BATCH = 0 THEN PRINT "ok ";
232 IF BATCH = 1 THEN IF EOF(1) THEN CLOSE #1 : BATCH = 0 : GOTO 299
233 IF BATCH = 1 THEN LINE INPUT #1, L$ : PRINT "> "; L$ : GOTO 235
234 LINE INPUT L$
235 IF LEN(L$) = 0 THEN GOTO 230
236 LET IPOS = 1
237 LET ILEN = LEN(L$)
240 REM === Parse and dispatch loop ===
241 GOSUB 1000
242 IF W$ = "" THEN GOTO 230
244 REM --- Dictionary lookup ---
245 LET Q$ = LEFT$(W$ + "        ", F)
246 LET FI = LATEST
247 IF FI = 0 THEN GOTO 260
248 IF MID$(N$, (FI-1)*F+1, F) = Q$ THEN GOTO 270
249 FI = DL(FI) : GOTO 247
260 REM --- Try as number ---
261 GOSUB 1100
262 IF NF = 1 THEN SP = SP + 1 : DS(SP) = NV : GOTO 241
263 PRINT W$; " ?"
264 GOTO 230
270 REM --- Execute primitive ---
271 GOSUB 3000
272 IF RUNNING = 0 THEN GOTO 299
273 GOTO 241
299 PRINT "Goodbye."
300 END
1000 REM === Parse next word from L$ ===
1001 LET W$ = ""
1002 IF IPOS > ILEN THEN RETURN
1003 IF MID$(L$, IPOS, 1) = " " THEN IPOS = IPOS + 1 : GOTO 1002
1004 IF IPOS > ILEN THEN RETURN
1005 LET J = IPOS
1006 IF IPOS > ILEN THEN GOTO 1010
1007 IF MID$(L$, IPOS, 1) <> " " THEN IPOS = IPOS + 1 : GOTO 1006
1010 W$ = MID$(L$, J, IPOS - J)
1011 REM --- Uppercase (GOTO loop) ---
1012 LET U$ = ""
1013 LET WL = LEN(W$)
1014 LET WI = 1
1015 IF WI > WL THEN GOTO 1020
1016 LET C = ASC(MID$(W$, WI, 1))
1017 IF C >= 97 AND C <= 122 THEN C = C - 32
1018 U$ = U$ + CHR$(C)
1019 WI = WI + 1 : GOTO 1015
1020 W$ = U$
1021 RETURN
1100 REM === Parse W$ as integer ===
1101 LET NV = 0 : LET NS = 1 : LET NI = 1
1102 LET NL = LEN(W$) : LET NF = 0
1103 IF NL = 0 THEN RETURN
1104 IF MID$(W$, 1, 1) = "-" AND NL > 1 THEN NS = -1 : NI = 2
1110 IF NI > NL THEN GOTO 1120
1111 LET NC = ASC(MID$(W$, NI, 1))
1112 IF NC >= 48 AND NC <= 57 THEN NV = NV * 10 + (NC - 48) : NF = 1 : NI = NI + 1 : GOTO 1110
1113 NF = 0 : RETURN
1120 NV = NV * NS
1121 RETURN
3000 REM =============================================
3001 REM  EXECUTE PRIMITIVE BY FI
3002 REM  Uses IF/GOTO dispatch (no RETURN in THEN)
3003 REM =============================================
3004 LET P$ = MID$(N$, (FI-1)*F+1, F)
3005 REM --- Trim trailing spaces ---
3006 IF LEN(P$) = 0 THEN GOTO 3009
3007 IF RIGHT$(P$, 1) <> " " THEN GOTO 3009
3008 P$ = LEFT$(P$, LEN(P$)-1) : GOTO 3006
3009 REM
3010 REM ======== STACK OPS ========
3011 IF P$ <> "DUP" THEN GOTO 3013
3012 DS(SP+1) = DS(SP) : SP = SP+1 : RETURN
3013 IF P$ <> "DROP" THEN GOTO 3015
3014 SP = SP-1 : RETURN
3015 IF P$ <> "SWAP" THEN GOTO 3018
3016 LET V = DS(SP) : DS(SP) = DS(SP-1) : DS(SP-1) = V
3017 RETURN
3018 IF P$ <> "OVER" THEN GOTO 3021
3019 SP = SP+1 : DS(SP) = DS(SP-2)
3020 RETURN
3021 IF P$ <> "ROT" THEN GOTO 3100
3022 LET V = DS(SP-2) : DS(SP-2) = DS(SP-1) : DS(SP-1) = DS(SP) : DS(SP) = V
3023 RETURN
3100 REM ======== ARITHMETIC ========
3101 IF P$ <> "+" THEN GOTO 3104
3102 DS(SP-1) = DS(SP-1) + DS(SP) : SP = SP-1
3103 RETURN
3104 IF P$ <> "-" THEN GOTO 3107
3105 DS(SP-1) = DS(SP-1) - DS(SP) : SP = SP-1
3106 RETURN
3107 IF P$ <> "*" THEN GOTO 3110
3108 DS(SP-1) = DS(SP-1) * DS(SP) : SP = SP-1
3109 RETURN
3110 IF P$ <> "/" THEN GOTO 3113
3111 DS(SP-1) = INT(DS(SP-1) / DS(SP)) : SP = SP-1
3112 RETURN
3113 IF P$ <> "MOD" THEN GOTO 3116
3114 DS(SP-1) = DS(SP-1) MOD DS(SP) : SP = SP-1
3115 RETURN
3116 IF P$ <> "NEGATE" THEN GOTO 3119
3117 DS(SP) = -DS(SP)
3118 RETURN
3119 IF P$ <> "ABS" THEN GOTO 3200
3120 DS(SP) = ABS(DS(SP))
3121 RETURN
3200 REM ======== COMPARISON ========
3201 IF P$ <> "=" THEN GOTO 3210
3202 IF DS(SP-1) = DS(SP) THEN DS(SP-1) = -1 ELSE DS(SP-1) = 0
3203 SP = SP-1 : RETURN
3210 IF P$ <> "<" THEN GOTO 3220
3211 IF DS(SP-1) < DS(SP) THEN DS(SP-1) = -1 ELSE DS(SP-1) = 0
3212 SP = SP-1 : RETURN
3220 IF P$ <> ">" THEN GOTO 3230
3221 IF DS(SP-1) > DS(SP) THEN DS(SP-1) = -1 ELSE DS(SP-1) = 0
3222 SP = SP-1 : RETURN
3230 IF P$ <> "0=" THEN GOTO 3400
3231 IF DS(SP) = 0 THEN DS(SP) = -1 ELSE DS(SP) = 0
3232 RETURN
3400 REM ======== OUTPUT ========
3401 IF P$ <> "." THEN GOTO 3410
3402 PRINT DS(SP); " ";
3403 SP = SP-1
3404 RETURN
3410 IF P$ <> "CR" THEN GOTO 3420
3411 PRINT ""
3412 RETURN
3420 IF P$ <> "EMIT" THEN GOTO 3430
3421 PRINT CHR$(INT(DS(SP)));
3422 SP = SP-1
3423 RETURN
3430 IF P$ <> ".S" THEN GOTO 3450
3431 PRINT "<"; SP; "> ";
3432 IF SP = 0 THEN GOTO 3440
3433 LET SI = 1
3434 IF SI > SP THEN GOTO 3440
3435 PRINT DS(SI); " ";
3436 SI = SI + 1 : GOTO 3434
3440 RETURN
3450 IF P$ <> "SPACE" THEN GOTO 3700
3451 PRINT " ";
3452 RETURN
3700 REM ======== SYSTEM ========
3701 IF P$ <> "BYE" THEN GOTO 3710
3702 RUNNING = 0
3703 RETURN
3710 IF P$ <> "WORDS" THEN GOTO 3800
3711 GOSUB 3750
3712 RETURN
3750 REM --- WORDS ---
3751 LET K = LATEST
3752 LET M = 0
3753 IF K = 0 THEN PRINT "" : RETURN
3754 LET G$ = MID$(N$, (K-1)*F+1, F)
3755 IF LEN(G$) = 0 THEN GOTO 3759
3756 IF RIGHT$(G$, 1) <> " " THEN GOTO 3759
3757 G$ = LEFT$(G$, LEN(G$)-1) : GOTO 3755
3759 PRINT G$; " ";
3760 M = M + 1
3761 IF M MOD 10 = 0 THEN PRINT ""
3762 K = DL(K) : GOTO 3753
3800 RETURN
9000 REM === Primitive word table ===
9010 DATA "DUP", 0, "DROP", 0, "SWAP", 0, "OVER", 0, "ROT", 0
9020 DATA "+", 0, "-", 0, "*", 0, "/", 0, "MOD", 0
9030 DATA "NEGATE", 0, "ABS", 0
9040 DATA "=", 0, "<", 0, ">", 0, "0=", 0
9050 DATA ".", 0, "CR", 0, "EMIT", 0, ".S", 0, "SPACE", 0
9060 DATA "BYE", 0, "WORDS", 0
9099 DATA "***", 0
