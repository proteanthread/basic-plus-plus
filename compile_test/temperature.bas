2 REM TEMPERATURE CONVERTER
10 PRINT "TEMPERATURE TABLE"
20 PRINT ""
30 DIM F(20)
40 FOR I=1 TO 10
50 READ V
60 F(I)=V
70 NEXT I
80 FOR I=1 TO 10
90 T=F(I)
100 GOSUB 200
110 PRINT T,C,K
120 NEXT I
130 PRINT ""
140 PRINT "TABLE COMPLETE."
150 END
200 REM CONVERSION SUBROUTINE
210 C=INT((T-32)*5/9)
220 K=C+273
230 RETURN
300 DATA -40,0,32,50,72,98,100,150,200,212
