2 REM NUMBER GUESSING GAME
10 PRINT "I AM THINKING OF A NUMBER FROM 1 TO 100"
20 PRINT "TRY TO GUESS IT!"
30 PRINT ""
40 X=INT(100*RND(1))+1
50 M=0
60 PRINT "YOUR GUESS";
70 INPUT G
80 M=M+1
90 IF G=X THEN GOTO 150
100 IF G<X THEN GOTO 130
110 PRINT "TOO HIGH"
120 GOTO 60
130 PRINT "TOO LOW"
140 GOTO 60
150 PRINT "YOU GOT IT IN";M;"GUESSES!"
160 PRINT ""
170 END
