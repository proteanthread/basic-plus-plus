10 REM =============================================
REM ==================================================
REM  EXHAUSTIVE DOCUMENTATION
REM ==================================================
REM  This file is a standalone Game Engine for BASIC++.
REM  It operates strictly within the text UI (TUI) and relies on external
REM  mechanics libraries for its game loop. 
REM  Key Components:
REM  - Initialization: Sets up the visual buffer and arrays.
REM  - Main Loop: Uses a non-blocking INKEY$ loop synced with the TICKS timer.
REM  - Collision/Movement: Delegated to the imported library.
REM  - Save/Load: Invoked via GOSUB 8000 and 8100, saving to .sav files.
REM ==================================================
20 REM  ZELDA ENGINE
30 REM  Uses RPG_PROCGEN.LIB for mechanics.
40 REM  Arrow keys move, SPACE to attack, ESC quit
50 REM  Press S to Save, L to Load
60 REM =============================================
70 LOAD LIBRARY "lib\rpg_procgen.LIB"
80 RANDOMIZE TIMER
90 PRINT CHR$(27);"[?25l";
100 CONST MAP_W = 16: CONST MAP_H = 16
110 CONST VIEW_W = 16: CONST VIEW_H = 12
120 CONST MAX_MOB = 8: CONST FPS = 100
130 PX = 8: PY = 8: PDIR = 2: HP = 10: MAXHP = 10: ATK = 1
140 SC = 0: KEYS = 0: HASWORD = 0: ROOMX = 3: ROOMY = 3
150 CALL RPG_INIT_GRID(MAP_W, VIEW_H)
160 DIM MO_X(MAX_MOB), MO_Y(MAX_MOB), MO_HP(MAX_MOB), MO_A(MAX_MOB)
170 GOSUB 3000
180 CLS: GOSUB 1800: GOSUB 1900
190 REM ========== MAIN GAME LOOP ==========
200 GFT = TICKS
210 K$ = INKEY$
220 IF K$ = CHR$(27) THEN 9000
230 IF UCASE$(K$) = "S" THEN GOSUB 8000
240 IF UCASE$(K$) = "L" THEN GOSUB 8100
250 SK = 0 : IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1))
260 OX = PX: OY = PY
270 IF SK = 72 THEN PY = PY - 1: PDIR = 1
280 IF SK = 80 THEN PY = PY + 1: PDIR = 2
290 IF SK = 75 THEN PX = PX - 1: PDIR = 3
300 IF SK = 77 THEN PX = PX + 1: PDIR = 4
310 IF PX < 1 THEN PX = MAP_W: ROOMX = ROOMX - 1: GOSUB 3000: GOSUB 1900
320 IF PX > MAP_W THEN PX = 1: ROOMX = ROOMX + 1: GOSUB 3000: GOSUB 1900
330 IF PY < 1 THEN PY = VIEW_H: ROOMY = ROOMY - 1: GOSUB 3000: GOSUB 1900
340 IF PY > VIEW_H THEN PY = 1: ROOMY = ROOMY + 1: GOSUB 3000: GOSUB 1900
350 CH$ = MID$(RPG_MAP$(PY), PX, 1)
360 IF CH$ = "#" OR CH$ = "D" THEN PX = OX: PY = OY
370 IF CH$ = "D" AND KEYS > 0 THEN KEYS = KEYS - 1: TMP$ = RPG_MAP$(PY): MID$(TMP$, PX, 1) = ".": RPG_MAP$(PY) = TMP$: PX = OX: PY = OY
380 IF CH$ = "K" THEN KEYS = KEYS + 1: SC = SC + 50: TMP$ = RPG_MAP$(PY): MID$(TMP$, PX, 1) = ".": RPG_MAP$(PY) = TMP$: SOUND 1000, 1
390 IF CH$ = "H" THEN HP = HP + 3: IF HP > MAXHP THEN HP = MAXHP
400 IF CH$ = "H" THEN SC = SC + 10: TMP$ = RPG_MAP$(PY): MID$(TMP$, PX, 1) = ".": RPG_MAP$(PY) = TMP$: SOUND 800, 1
410 IF CH$ = "W" THEN HASWORD = 1: ATK = 3: SC = SC + 200: TMP$ = RPG_MAP$(PY): MID$(TMP$, PX, 1) = ".": RPG_MAP$(PY) = TMP$: SOUND 1200, 2
420 IF K$ = " " THEN GOSUB 1400
430 FOR I = 1 TO MAX_MOB
440   IF MO_A(I) = 1 THEN
450     IF RND(1) < 0.2 THEN
460       IF MO_X(I) < PX THEN MO_X(I) = MO_X(I) + 1
470       IF MO_X(I) > PX THEN MO_X(I) = MO_X(I) - 1
480       IF MO_Y(I) < PY THEN MO_Y(I) = MO_Y(I) + 1
490       IF MO_Y(I) > PY THEN MO_Y(I) = MO_Y(I) - 1
500     END IF
510     IF MO_X(I) = PX AND MO_Y(I) = PY THEN HP = HP - 1: SOUND 200, 1: IF HP <= 0 THEN 9000
520   END IF
530 NEXT I
540 GOSUB 1900
550 FOR I = 1 TO MAX_MOB
560   IF MO_A(I) = 1 THEN COLOR 12, 0: LOCATE MO_Y(I) + 3, MO_X(I) * 3 + 8: PRINT CHR$(234);
570 NEXT I
580 COLOR 14, 0: LOCATE PY + 3, PX * 3 + 8
590 IF PDIR = 1 THEN PRINT CHR$(30);
600 IF PDIR = 2 THEN PRINT CHR$(31);
610 IF PDIR = 3 THEN PRINT CHR$(17);
620 IF PDIR = 4 THEN PRINT CHR$(16);
630 GOSUB 1800
640 GT2 = TICKS: GT1 = GT2 - GFT: IF GT1 < FPS THEN DELAY FPS - GT1
650 GOTO 200
1400 REM === Attack ===
1410 AX = PX: AY = PY
1420 IF PDIR = 1 THEN AY = AY - 1
1430 IF PDIR = 2 THEN AY = AY + 1
1440 IF PDIR = 3 THEN AX = AX - 1
1450 IF PDIR = 4 THEN AX = AX + 1
1460 FOR I = 1 TO MAX_MOB
1470   IF MO_A(I) = 1 AND MO_X(I) = AX AND MO_Y(I) = AY THEN
1480     MO_HP(I) = MO_HP(I) - ATK
1490     IF MO_HP(I) <= 0 THEN MO_A(I) = 0: SC = SC + 30: SOUND 1000, 1
1500     SOUND 500, 1
1510   END IF
1520 NEXT I
1530 COLOR 15, 0: LOCATE AY + 3, AX * 3 + 8: PRINT "*";
1540 RETURN
1800 REM === Draw HUD ===
1810 COLOR 15, 1: LOCATE 1, 1: PRINT STRING$(80, " ");
1820 LOCATE 1, 2: PRINT "ZELDA";
1830 LOCATE 1, 15: PRINT "HP:";
1840 COLOR 12, 1: PRINT STRING$(HP, CHR$(3));: IF HP < MAXHP THEN COLOR 8, 1: PRINT STRING$(MAXHP - HP, CHR$(3));
1850 COLOR 15, 1: LOCATE 1, 35: PRINT "Score:"; SC;
1860 LOCATE 1, 55: PRINT "Keys:"; KEYS;
1870 IF HASWORD = 1 THEN LOCATE 1, 70: COLOR 14, 1: PRINT CHR$(24); "Sword";
1880 COLOR 7, 0: LOCATE 2, 1: PRINT STRING$(80, CHR$(196));
1890 LOCATE 3, 1: PRINT "Room ("; ROOMX; ","; ROOMY; ")";
1900 RETURN
1901 REM === Draw room ===
1910 FOR R = 1 TO VIEW_H
1920   FOR C = 1 TO MAP_W
1930     LOCATE R + 3, C * 3 + 8: CH$ = MID$(RPG_MAP$(R), C, 1)
1940     IF CH$ = "#" THEN COLOR 8, 0: PRINT CHR$(219);
1950     IF CH$ = "." THEN COLOR 0, 0: PRINT " ";
1960     IF CH$ = "K" THEN COLOR 14, 0: PRINT CHR$(12);
1970     IF CH$ = "H" THEN COLOR 12, 0: PRINT CHR$(3);
1980     IF CH$ = "W" THEN COLOR 15, 0: PRINT CHR$(24);
1990     IF CH$ = "D" THEN COLOR 6, 0: PRINT CHR$(219);
2000     IF CH$ = "T" THEN COLOR 2, 0: PRINT CHR$(6);
2010   NEXT C
2020 NEXT R
2030 RETURN
3000 REM === Generate room ===
3010 CALL RPG_GEN_GRID(0.08, 0.05)
3020 IF RND(1) < 0.3 THEN TMP$ = RPG_MAP$(6): MID$(TMP$, 8, 1) = "K": RPG_MAP$(6) = TMP$
3030 IF RND(1) < 0.2 THEN TMP$ = RPG_MAP$(4): MID$(TMP$, 12, 1) = "H": RPG_MAP$(4) = TMP$
3040 IF ROOMX = 5 AND ROOMY = 5 AND HASWORD = 0 THEN TMP$ = RPG_MAP$(6): MID$(TMP$, 8, 1) = "W": RPG_MAP$(6) = TMP$
3050 FOR I = 1 TO MAX_MOB: MO_A(I) = 0: NEXT I
3060 NE = INT(RND(1) * 4) + 1
3070 FOR I = 1 TO NE
3080   MO_X(I) = INT(RND(1) * 14) + 2: MO_Y(I) = INT(RND(1) * 10) + 2
3090   MO_HP(I) = 2: MO_A(I) = 1
3100 NEXT I
3110 RETURN
8000 REM === Save Game ===
8010 OPEN "zelda.sav" FOR OUTPUT AS #1
8020 PRINT #1, SC: PRINT #1, HP: PRINT #1, KEYS: PRINT #1, HASWORD: PRINT #1, ROOMX: PRINT #1, ROOMY
8030 CLOSE #1
8040 COLOR 14, 0: LOCATE 12, 30: PRINT "GAME SAVED!": DELAY 1000: RETURN
8100 REM === Load Game ===
8110 IF EXIST("zelda.sav") THEN
8120   OPEN "zelda.sav" FOR INPUT AS #1
8130   INPUT #1, SC: INPUT #1, HP: INPUT #1, KEYS: INPUT #1, HASWORD: INPUT #1, ROOMX: INPUT #1, ROOMY
8140   CLOSE #1
8150   GOSUB 3000: GOSUB 1900
8160 END IF
8170 RETURN
9000 REM === GAME OVER ===
9010 PRINT CHR$(27);"[?25h";: CLS: COLOR 14, 0: LOCATE 10, 25: PRINT "Y O U   D I E D"
9020 LOCATE 12, 25: PRINT "Score: "; SC
9030 LOCATE 14, 25: PRINT "Rooms Explored: "; ROOMX + ROOMY
9040 LOCATE 16, 25: PRINT "Press any key...": GOSUB 9990
9050 CLS: END

9990 K$ = INKEY$: IF K$ = "" THEN 9990 ELSE RETURN
9992 K$ = INKEY$: IF K$ <> " " THEN 9992 ELSE RETURN
9994 K$ = INKEY$: IF K$ <> "r" AND K$ <> "R" THEN 9994 ELSE RETURN
