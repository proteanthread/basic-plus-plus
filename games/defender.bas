10 REM =============================================
20 REM  DEFENDER - BASIC++ Text Game
30 REM  Arrow keys: Up/Down to fly, Left/Right scroll
40 REM  SPACE to fire laser, ESC quit
50 REM =============================================
60 RANDOMIZE TIMER
70 PRINT CHR$(27);"[?25l";
80 REM --- Constants ---
90 CONST WORLD_W = 200
100 CONST VIEW_W = 78
110 CONST MAX_EN = 12
120 CONST MAX_LASER = 6
130 CONST MAX_HUMAN = 6
140 CONST FPS = 80
150 REM --- World ---
160 DIM TERRAIN(WORLD_W)
170 FOR I = 1 TO WORLD_W
180   TERRAIN(I) = 20 + INT(SIN(I / 8) * 3)
190 NEXT I
200 REM --- Player ---
210 PY = 12: VX = 0
220 FACING = 1
230 SCROLL = 1
240 SC = 0: LV = 3: SMARTBOMB = 3
250 REM --- Enemies ---
260 DIM EN_X(MAX_EN), EN_Y(MAX_EN), EN_A(MAX_EN)
270 DIM EN_T(MAX_EN)
280 REM EN.T: 1=lander, 2=bomber, 3=baiter
290 FOR I = 1 TO 4
300   EN_X(I) = INT(RND(1) * WORLD_W) + 1
310   EN_Y(I) = INT(RND(1) * 15) + 4
320   EN_A(I) = 1: EN_T(I) = 1
330 NEXT I
340 REM --- Lasers ---
350 DIM LX(MAX_LASER), LY(MAX_LASER), LD(MAX_LASER), LA(MAX_LASER)
360 REM --- Humans ---
370 DIM HX(MAX_HUMAN), HY(MAX_HUMAN), HA(MAX_HUMAN)
380 FOR I = 1 TO MAX_HUMAN
390   HX(I) = INT(RND(1) * WORLD_W) + 1
400   HY(I) = 0: HA(I) = 1
410 NEXT I
420 REM
430 REM --- Draw HUD ---
440 CLS
450 COLOR 15, 1
460 LOCATE 1, 1: PRINT STRING$(80, " ");
470 LOCATE 1, 2: PRINT "DEFENDER";
480 LOCATE 1, 20: PRINT "Score:"; SC;
490 LOCATE 1, 40: PRINT "Lives:"; STRING$(LV, CHR$(3));
500 LOCATE 1, 60: PRINT "Bombs:"; SMARTBOMB;
510 REM Draw minimap bar
520 COLOR 8, 0
530 LOCATE 2, 1: PRINT STRING$(80, CHR$(196));
540 REM
550 REM ========== MAIN GAME LOOP ==========
560 GFT = TICKS
570 REM SCREEN LOCK (stub)
580 REM --- Clear play area ---
590 COLOR 0, 0
600 FOR R = 3 TO 24
610   LOCATE R, 1: PRINT STRING$(80, " ");
620 NEXT R
630 REM
640 REM --- Draw terrain ---
650 COLOR 6, 0
660 FOR C = 1 TO VIEW_W
670   WX = ((SCROLL + C - 2) MOD WORLD_W) + 1
680   TH = TERRAIN(WX)
690   IF TH >= 3 AND TH <= 24 THEN
700     LOCATE TH, C + 1
710     PRINT CHR$(220);
720   END IF
730 NEXT C
740 REM
750 REM --- Draw humans ---
760 COLOR 13, 0
770 FOR I = 1 TO MAX_HUMAN
780   IF HA(I) = 0 THEN 810
790   SX = HX(I) - SCROLL + 2
800   IF SX >= 2 AND SX <= 79 THEN
805     TH = TERRAIN(HX(I))
806     LOCATE TH - 1, SX: PRINT CHR$(2);
810   END IF
820 NEXT I
830 REM
840 REM --- Draw enemies ---
850 FOR I = 1 TO MAX_EN
860   IF EN_A(I) = 0 THEN 900
870   SX = EN_X(I) - SCROLL + 2
880   IF SX >= 2 AND SX <= 79 THEN
890     IF EN_T(I) = 1 THEN COLOR 10, 0
895     IF EN_T(I) = 2 THEN COLOR 12, 0
896     IF EN_T(I) = 3 THEN COLOR 14, 0
897     LOCATE EN_Y(I), SX: PRINT CHR$(15);
900   END IF
910 NEXT I
920 REM
930 REM --- Draw lasers ---
940 COLOR 15, 0
950 FOR I = 1 TO MAX_LASER
960   IF LA(I) = 0 THEN 980
970   SX = LX(I) - SCROLL + 2
975   IF SX >= 2 AND SX <= 79 THEN LOCATE LY(I), SX: PRINT "-";
980 NEXT I
990 REM
1000 REM --- Draw player ship ---
1010 COLOR 11, 0
1020 LOCATE PY, 40
1030 CH$ = CHR$(17) : IF FACING = 1 THEN CH$ = CHR$(16) : PRINT CH$;
1040 REM SCREEN UNLOCK (stub)
1050 REM
1060 REM --- Input ---
1070 K$ = INKEY$
1080 IF K$ = CHR$(27) THEN 2000
1090 SK = 0 : IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1))
1100 IF SK = 72 AND PY > 4 THEN PY = PY - 1
1110 IF SK = 80 AND PY < 22 THEN PY = PY + 1
1120 IF SK = 75 THEN FACING = -1: SCROLL = SCROLL - 3: IF SCROLL < 1 THEN SCROLL = SCROLL + WORLD_W
1130 IF SK = 77 THEN FACING = 1: SCROLL = SCROLL + 3: IF SCROLL > WORLD_W THEN SCROLL = SCROLL - WORLD_W
1140 IF K$ = " " THEN GOSUB 1300
1150 IF K$ = "b" OR K$ = "B" THEN GOSUB 1500
1160 REM
1170 REM --- Move lasers ---
1180 FOR I = 1 TO MAX_LASER
1190   IF LA(I) = 0 THEN 1240
1200   LX(I) = LX(I) + LD(I) * 3
1210   IF LX(I) < SCROLL OR LX(I) > SCROLL + VIEW_W THEN LA(I) = 0: GOTO 1240
1220   REM Check hit enemy
1230   FOR J = 1 TO MAX_EN
1231     IF EN_A(J) = 0 THEN 1235
1232     IF ABS(LX(I) - EN_X(J)) < 2 AND ABS(LY(I) - EN_Y(J)) < 2 THEN
1233       EN_A(J) = 0: LA(I) = 0: SC = SC + 50
1234       SOUND 800, 1
1235     END IF
1236   NEXT J
1240 NEXT I
1250 REM
1260 REM --- Move enemies ---
1270 FOR I = 1 TO MAX_EN
1275   IF EN_A(I) = 0 THEN 1290
1280   REM Simple AI: move toward player
1281   PW = SCROLL + 38
1282   IF EN_X(I) < PW THEN EN_X(I) = EN_X(I) + 1
1283   IF EN_X(I) > PW THEN EN_X(I) = EN_X(I) - 1
1284   IF RND(1) < 0.1 THEN
1285     IF EN_Y(I) < PY THEN EN_Y(I) = EN_Y(I) + 1
1286     IF EN_Y(I) > PY THEN EN_Y(I) = EN_Y(I) - 1
1287   END IF
1288   REM Collision with player
1289   SX = EN_X(I) - SCROLL + 2
1290   IF EN_A(I) = 1 AND ABS(SX - 40) < 2 AND EN_Y(I) = PY THEN GOSUB 1400
1291 NEXT I
1292 REM --- Spawn new enemies ---
1293 IF RND(1) < 0.02 THEN GOSUB 1600
1294 REM --- Update minimap ---
1295 COLOR 8, 0
1296 LOCATE 2, 1: PRINT STRING$(80, CHR$(196));
1297 REM Mark player on minimap
1298 COLOR 11, 0
1299 GC = INT(SCROLL * 80 / WORLD_W) + 1
1300 IF GC >= 1 AND GC <= 80 THEN LOCATE 2, GC: PRINT CHR$(30);
1301 REM Mark enemies on minimap
1302 COLOR 12, 0
1303 FOR I = 1 TO MAX_EN
1304   IF EN_A(I) = 0 THEN 1307
1305   GC = INT(EN_X(I) * 80 / WORLD_W) + 1
1306   IF GC >= 1 AND GC <= 80 THEN LOCATE 2, GC: PRINT ".";
1307 NEXT I
1308 REM --- Update HUD ---
1309 COLOR 15, 1
1310 LOCATE 1, 27: PRINT SC; "   ";
1311 REM --- Frame wait ---
1312 GT2 = TICKS: GT1 = GT2 - GFT
1313 IF GT1 < FPS THEN DELAY FPS - GT1
1314 GFT = TICKS
1315 GOTO 560
1316 REM
1300 REM === Fire laser ===
1310 FOR I = 1 TO MAX_LASER
1320   IF LA(I) = 1 THEN 1340
1330   LX(I) = SCROLL + 38: LY(I) = PY: LD(I) = FACING: LA(I) = 1
1335   BEEP: RETURN
1340 NEXT I
1350 RETURN
1400 REM === Player hit ===
1410 LV = LV - 1
1420 SOUND 200, 3
1430 COLOR 15, 4: LOCATE PY, 40: PRINT "X";
1440 DELAY 1000
1450 IF LV <= 0 THEN 2000
1460 PY = 12
1470 RETURN
1500 REM === Smart bomb ===
1510 IF SMARTBOMB <= 0 THEN RETURN
1520 SMARTBOMB = SMARTBOMB - 1
1530 REM Destroy all visible enemies
1540 FOR I = 1 TO MAX_EN
1550   IF EN_A(I) = 0 THEN 1570
1560   SX = EN_X(I) - SCROLL + 2
1565   IF SX >= 2 AND SX <= 79 THEN EN_A(I) = 0: SC = SC + 25
1570 NEXT I
1580 SOUND 500, 2
1590 RETURN
1600 REM === Spawn enemy ===
1610 FOR I = 1 TO MAX_EN
1620   IF EN_A(I) = 1 THEN 1660
1630   EN_X(I) = SCROLL + INT(RND(1) * 2) * WORLD_W / 2 + 50
1640   EN_X(I) = (EN_X(I) MOD WORLD_W) + 1
1650   EN_Y(I) = INT(RND(1) * 16) + 4
1655   EN_T(I) = INT(RND(1) * 3) + 1: EN_A(I) = 1
1660   RETURN
1670 NEXT I
1680 RETURN
2000 REM === GAME OVER ===
2010 CURSOR ON: CLS
2020 COLOR 11, 0
2030 LOCATE 10, 25: PRINT "G A M E   O V E R"
2040 LOCATE 12, 25: PRINT "Score: "; SC
2050 LOCATE 16, 25: PRINT "Press any key..."
2060 K$ = "": WHILE K$ = "": K$ = INKEY$: WEND
2070 CLS: END


