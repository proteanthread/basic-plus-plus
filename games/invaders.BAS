10 REM =============================================
REM ==================================================
REM  EXHAUSTIVE DOCUMENTATION
REM ==================================================
REM  This file is a standalone Game Engine for BASIC++.
REM  It operates strictly within the text UI (TUI) and relies on external
REM  mechanics libraries for its game loop. 
REM  Key Components:
REM  - Initialization: Sets up the visual buffer and arrays.
REM  - Main Loop: Uses a non-blocking INKEY$ loop synced with the TICKS timer.
REM  - Collision/Movement: Delegated to the imported library.
REM  - Save/Load: Invoked via GOSUB 8000 and 8100, saving to .sav files.
REM ==================================================
20 REM  SPACE INVADERS ENGINE
30 REM  Uses SWARM.LIB for mechanics.
40 REM  Arrow keys to move, SPACE to fire, ESC quit
50 REM  Press S to Save, L to Load
60 REM =============================================
70 LOAD LIBRARY "lib\swarm.LIB"
80 RANDOMIZE TIMER
90 PRINT CHR$(27);"[?25l";
100 CONST ROWS = 5: CONST COLS = 11
110 CONST MAX_BULL = 5
120 CONST MAX_BOMB = 8
130 CONST FPS_MS = 80
140 PX = 40: PY = 23
150 SC = 0: LV = 3: LVL = 1
160 GOSUB 2000
170 GOTO 3000
2000 REM --- Init Level ---
2010 CALL SWARM_INIT(ROWS, COLS, 10, 3, 5, 2)
2020 CALL PROJECTILES_INIT(MAX_BULL)
2030 DIM BX(MAX_BOMB), BY(MAX_BOMB), BA(MAX_BOMB)
2040 FOR I = 0 TO MAX_BOMB - 1: BA(I) = 0: NEXT I
2050 RETURN
3000 REM ========== MAIN GAME LOOP ==========
3010 GFT = TICKS
3020 CLS
3030 COLOR 15, 1: LOCATE 1, 1: PRINT STRING$(80, " ");
3040 LOCATE 1, 2: PRINT "SPACE INVADERS";
3050 LOCATE 1, 25: PRINT "Score:"; SC;
3060 LOCATE 1, 45: PRINT "Level:"; LVL;
3070 LOCATE 1, 60: PRINT "Lives: "; STRING$(LV, CHR$(3));
3080 COLOR 2, 0
3090 FOR I = 0 TO 3
3100   FOR C = 0 TO 5
3110     LOCATE 20, I * 18 + 8 + C
3120     PRINT CHR$(219);
3130   NEXT C
3140 NEXT I
3150 CALL SWARM_DRAW(CHR$(234), 12, 14, 10)
3160 COLOR 11, 0: LOCATE PY, PX - 1: PRINT " "; CHR$(30); " ";
3170 CALL PROJECTILES_DRAW(CHR$(179), 15)
3180 COLOR 13, 0
3190 FOR I = 0 TO MAX_BOMB - 1
3200   IF BA(I) = 1 THEN LOCATE BY(I), BX(I): PRINT CHR$(7);
3210 NEXT I
3220 K$ = INKEY$
3230 IF K$ = CHR$(27) THEN 9000
3240 IF UCASE$(K$) = "S" THEN GOSUB 8000
3250 IF UCASE$(K$) = "L" THEN GOSUB 8100
3260 SK = 0 : IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1))
3270 IF SK = 75 AND PX > 3 THEN PX = PX - 2
3280 IF SK = 77 AND PX < 78 THEN PX = PX + 2
3290 IF K$ = " " THEN CALL PROJECTILES_FIRE(PX, PY - 1): BEEP
3300 CALL PROJECTILES_MOVE(-1, 2, 25)
3310 FOR I = 0 TO PROJ_MAX - 1
3320   IF PROJ_A(I) = 1 THEN
3330     FOR J = 0 TO SWARM_MAX - 1
3340       IF SWARM_EA(J) = 1 AND PROJ_Y(I) = SWARM_EY(J) AND ABS(PROJ_X(I) - SWARM_EX(J)) < 2 THEN
3350         SWARM_EA(J) = 0: PROJ_A(I) = 0: SC = SC + 10: SWARM_ALIVE = SWARM_ALIVE - 1: SOUND 800, 1
3360       END IF
3370     NEXT J
3380   END IF
3390 NEXT I
3400 FOR I = 0 TO MAX_BOMB - 1
3410   IF BA(I) = 1 THEN
3420     BY(I) = BY(I) + 1
3430     IF BY(I) > 24 THEN BA(I) = 0
3440     IF BY(I) = PY AND ABS(BX(I) - PX) < 2 THEN
3450       LV = LV - 1: SOUND 200, 3: COLOR 15, 4: LOCATE PY, PX - 1: PRINT " * ";: DELAY 500
3460       IF LV <= 0 THEN 9000
3470     END IF
3480   END IF
3490 NEXT I
3500 CALL SWARM_MOVE(3, 76, 1)
3510 HIT_BOT = 0
3520 CALL SWARM_CHECK_BOTTOM(PY, HIT_BOT)
3530 IF HIT_BOT = 1 THEN 9000
3540 IF RND(1) < 0.15 THEN
3550   FOR GI = 1 TO 10
3560     J = INT(RND(1) * SWARM_MAX)
3570     IF SWARM_EA(J) = 1 THEN
3580       FOR I = 0 TO MAX_BOMB - 1
3590         IF BA(I) = 0 THEN BX(I) = SWARM_EX(J): BY(I) = SWARM_EY(J) + 1: BA(I) = 1: GOTO 3620
3600       NEXT I
3610     END IF
3620   NEXT GI
3630 END IF
3640 GT2 = TICKS: GT1 = GT2 - GFT
3650 IF GT1 < FPS_MS THEN DELAY FPS_MS - GT1
3660 IF SWARM_ALIVE <= 0 THEN LVL = LVL + 1: COLOR 14, 0: LOCATE 12, 30: PRINT "LEVEL "; LVL; " !": DELAY 1500: GOSUB 2000
3670 GOTO 3000
8000 REM === Save Game ===
8010 OPEN "invaders.sav" FOR OUTPUT AS #1
8020 PRINT #1, SC: PRINT #1, LV: PRINT #1, LVL
8030 CLOSE #1
8040 COLOR 14, 0: LOCATE 12, 30: PRINT "GAME SAVED!": DELAY 1000
8050 RETURN
8100 REM === Load Game ===
8110 IF EXIST("invaders.sav") THEN
8120   OPEN "invaders.sav" FOR INPUT AS #1
8130   INPUT #1, SC: INPUT #1, LV: INPUT #1, LVL
8140   CLOSE #1
8150   GOSUB 2000
8160 END IF
8170 RETURN
9000 REM === GAME OVER ===
9010 PRINT CHR$(27);"[?25h";: CLS: COLOR 15, 0: LOCATE 10, 30: PRINT "G A M E   O V E R"
9020 LOCATE 12, 30: PRINT "Final Score: "; SC
9030 LOCATE 14, 30: PRINT "Level Reached: "; LVL
9040 LOCATE 18, 25: PRINT "Press any key to exit..."
9050 GOSUB 9990
9060 CLS: END

9990 K$ = INKEY$: IF K$ = "" THEN 9990 ELSE RETURN
9992 K$ = INKEY$: IF K$ <> " " THEN 9992 ELSE RETURN
9994 K$ = INKEY$: IF K$ <> "r" AND K$ <> "R" THEN 9994 ELSE RETURN
