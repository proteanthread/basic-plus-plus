10 REM =============================================
REM ==================================================
REM  EXHAUSTIVE DOCUMENTATION
REM ==================================================
REM  This file is a standalone Game Engine for BASIC++.
REM  It operates strictly within the text UI (TUI) and relies on external
REM  mechanics libraries for its game loop. 
REM  Key Components:
REM  - Initialization: Sets up the visual buffer and arrays.
REM  - Main Loop: Uses a non-blocking INKEY$ loop synced with the TICKS timer.
REM  - Collision/Movement: Delegated to the imported library.
REM  - Save/Load: Invoked via GOSUB 8000 and 8100, saving to .sav files.
REM ==================================================
20 REM  MISSILE COMMAND ENGINE
30 REM  Uses ARCADE_SHOOTER.LIB for mechanics.
40 REM  Arrow keys move crosshair, SPACE fires
50 REM  Press S to Save, L to Load
60 REM =============================================
70 LOAD LIBRARY "lib\arcade_shooter.LIB"
80 RANDOMIZE TIMER
90 PRINT CHR$(27);"[?25l";
100 CONST MAX_MSL = 8: CONST MAX_EXP = 10
110 DIM MXS(MAX_MSL), MYS(MAX_MSL), MXE(MAX_MSL), MYE(MAX_MSL)
120 DIM MXC(MAX_MSL), MYC(MAX_MSL), MSP(MAX_MSL), MAC(MAX_MSL)
130 DIM CTY(6): FOR I = 1 TO 6: CTY(I) = 1: NEXT I
140 DIM EPX(MAX_EXP), EPY(MAX_EXP), EPR(MAX_EXP), EPA(MAX_EXP), EPT(MAX_EXP)
150 CX = 40: CY = 12
160 SC = 0: LVL = 1: WAVE = 0: AMMO = 30
170 CLS: COLOR 15, 1: LOCATE 1, 1: PRINT STRING$(80, " ");
180 LOCATE 1, 2: PRINT "MISSILE COMMAND";
190 LOCATE 1, 30: PRINT "Score:"; SC;
200 LOCATE 1, 50: PRINT "Ammo:"; AMMO;
210 LOCATE 1, 68: PRINT "Level:"; LVL;
220 COLOR 6, 0: LOCATE 24, 1: PRINT STRING$(80, CHR$(220));
230 COLOR 14, 0
240 FOR I = 1 TO 6: IF CTY(I) = 1 THEN CP = I * 11 + 2: LOCATE 23, CP: PRINT CHR$(219); CHR$(223); CHR$(219);
250 NEXT I
260 COLOR 15, 0: LOCATE 23, 39: PRINT CHR$(30);
270 REM ========== MAIN GAME LOOP ==========
280 GFT = TICKS
290 IF RND(1) < 0.04 + LVL * 0.01 THEN GOSUB 1000
300 K$ = INKEY$
310 IF K$ = CHR$(27) THEN 9000
320 IF UCASE$(K$) = "S" THEN GOSUB 8000
330 IF UCASE$(K$) = "L" THEN GOSUB 8100
340 SK = 0 : IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1))
350 IF SK = 72 AND CY > 3 THEN CY = CY - 1
360 IF SK = 80 AND CY < 22 THEN CY = CY + 1
370 IF SK = 75 AND CX > 2 THEN CX = CX - 1
380 IF SK = 77 AND CX < 79 THEN CX = CX + 1
390 IF K$ = " " AND AMMO > 0 THEN GOSUB 1100
400 FOR I = 1 TO MAX_MSL
410   IF MAC(I) = 1 THEN
420     CALL AR_MOVE_TARGET(MXC(I), MYC(I), MXE(I), MYE(I), 1, NX, NY)
430     MXC(I) = NX: MYC(I) = NY
440     IF MYC(I) >= 2 AND MYC(I) <= 23 AND MXC(I) >= 1 AND MXC(I) <= 80 THEN COLOR 12, 0: LOCATE MYC(I), MXC(I): PRINT ".";
450     IF MYC(I) >= 23 THEN GOSUB 1200: MAC(I) = 0
460     FOR J = 1 TO MAX_EXP
470       IF EPA(J) = 1 THEN CALL AR_CHECK_COLLISION(MXC(I), MYC(I), EPX(J), EPY(J), EPR(J), HIT): IF HIT = 1 THEN MAC(I) = 0: SC = SC + 25
480     NEXT J
490   END IF
500 NEXT I
510 FOR I = 1 TO MAX_EXP
520   IF EPA(I) = 1 THEN IF TICKS - EPT(I) > 300 THEN EPA(I) = 0: CALL AR_DRAW_EXPLOSION(EPX(I), EPY(I), EPR(I), " ", 0, 0)
530 NEXT I
540 COLOR 11, 0: LOCATE CY, CX: PRINT "+";
550 COLOR 15, 1: LOCATE 1, 37: PRINT SC; "   ";
560 LOCATE 1, 56: PRINT AMMO; " ";
570 CITIES = 0: FOR I = 1 TO 6: IF CTY(I) = 1 THEN CITIES = CITIES + 1
580 NEXT I: IF CITIES = 0 THEN 9000
590 GT2 = TICKS: GT1 = GT2 - GFT: IF GT1 < 80 THEN DELAY 80 - GT1
600 GOTO 280
1000 REM === Spawn a missile ===
1010 FOR I = 1 TO MAX_MSL
1020   IF MAC(I) = 0 THEN MXS(I) = INT(RND(1) * 78) + 2: MYS(I) = 2: MYC(I) = 2: MXC(I) = MXS(I): MXE(I) = INT(RND(1) * 78) + 2: MYE(I) = 23: MSP(I) = 1: MAC(I) = 1: RETURN
1030 NEXT I
1040 RETURN
1100 REM === Fire counter-missile ===
1110 AMMO = AMMO - 1: BEEP
1120 FOR I = 1 TO MAX_EXP
1130   IF EPA(I) = 0 THEN EPX(I) = CX: EPY(I) = CY: EPR(I) = 2: EPA(I) = 1: EPT(I) = TICKS: CALL AR_DRAW_EXPLOSION(EPX(I), EPY(I), EPR(I), "*", 14, 0): RETURN
1140 NEXT I
1150 RETURN
1200 REM === Missile hits ground ===
1210 FOR J = 1 TO 6
1220   IF CTY(J) = 1 THEN CP = J * 11 + 2: IF ABS(MXC(I) - CP) <= 2 THEN CTY(J) = 0: SOUND 100, 3: COLOR 0, 0: LOCATE 23, CP: PRINT "   ";
1230 NEXT J
1240 RETURN
8000 REM === Save Game ===
8010 OPEN "missile.sav" FOR OUTPUT AS #1
8020 PRINT #1, SC: PRINT #1, LVL: PRINT #1, AMMO: FOR I = 1 TO 6: PRINT #1, CTY(I): NEXT I
8030 CLOSE #1
8040 COLOR 14, 0: LOCATE 12, 30: PRINT "GAME SAVED!": DELAY 1000: RETURN
8100 REM === Load Game ===
8110 IF EXIST("missile.sav") THEN
8120   OPEN "missile.sav" FOR INPUT AS #1
8130   INPUT #1, SC: INPUT #1, LVL: INPUT #1, AMMO: FOR I = 1 TO 6: INPUT #1, CTY(I): NEXT I
8140   CLOSE #1
8150   COLOR 0, 0: LOCATE 23, 1: PRINT STRING$(80, " ");
8160   COLOR 14, 0: FOR I = 1 TO 6: IF CTY(I) = 1 THEN CP = I * 11 + 2: LOCATE 23, CP: PRINT CHR$(219); CHR$(223); CHR$(219);
8170   NEXT I
8180 END IF
8190 RETURN
9000 REM === GAME OVER ===
9010 CURSOR ON: CLS: COLOR 12, 0: LOCATE 10, 25: PRINT "T H E   E N D"
9020 LOCATE 12, 25: PRINT "Final Score: "; SC
9030 LOCATE 14, 25: PRINT "Cities Saved: "; CITIES
9040 LOCATE 18, 25: PRINT "Press any key...": GOSUB 9990
9050 CLS: END

9990 K$ = INKEY$: IF K$ = "" THEN 9990 ELSE RETURN
9992 K$ = INKEY$: IF K$ <> " " THEN 9992 ELSE RETURN
9994 K$ = INKEY$: IF K$ <> "r" AND K$ <> "R" THEN 9994 ELSE RETURN
