10 REM =============================================
REM ==================================================
REM  EXHAUSTIVE DOCUMENTATION
REM ==================================================
REM  This file is a standalone Game Engine for BASIC++.
REM  It operates strictly within the text UI (TUI) and relies on external
REM  mechanics libraries for its game loop. 
REM  Key Components:
REM  - Initialization: Sets up the visual buffer and arrays.
REM  - Main Loop: Uses a non-blocking INKEY$ loop synced with the TICKS timer.
REM  - Collision/Movement: Delegated to the imported library.
REM  - Save/Load: Invoked via GOSUB 8000 and 8100, saving to .sav files.
REM ==================================================
20 REM  DEFENDER ENGINE
30 REM  Uses ARCADE_SHOOTER.LIB for mechanics.
40 REM  Arrow keys: Up/Down to fly, Left/Right scroll
50 REM  SPACE to fire laser, B for smart bomb, ESC quit
60 REM  Press S to Save, L to Load
70 REM =============================================
80 LOAD LIBRARY "lib\arcade_shooter.LIB"
90 RANDOMIZE TIMER
100 PRINT CHR$(27);"[?25l";
110 CONST WORLD_W = 200: CONST VIEW_W = 78
120 CONST MAX_EN = 12: CONST MAX_LASER = 6: CONST MAX_HUMAN = 6
130 DIM TERRAIN(WORLD_W)
140 FOR I = 1 TO WORLD_W: TERRAIN(I) = 20 + INT(SIN(I / 8) * 3): NEXT I
150 PY = 12: VX = 0: FACING = 1: SCROLL = 1
160 SC = 0: LV = 3: SMARTBOMB = 3
170 DIM EN_X(MAX_EN), EN_Y(MAX_EN), EN_A(MAX_EN), EN_T(MAX_EN)
180 FOR I = 1 TO 4
190   EN_X(I) = INT(RND(1) * WORLD_W) + 1: EN_Y(I) = INT(RND(1) * 15) + 4
200   EN_A(I) = 1: EN_T(I) = 1
210 NEXT I
220 DIM LX(MAX_LASER), LY(MAX_LASER), LD(MAX_LASER), LA(MAX_LASER)
230 DIM HX(MAX_HUMAN), HY(MAX_HUMAN), HA(MAX_HUMAN)
240 FOR I = 1 TO MAX_HUMAN: HX(I) = INT(RND(1) * WORLD_W) + 1: HY(I) = 0: HA(I) = 1: NEXT I
250 CLS: COLOR 15, 1: LOCATE 1, 1: PRINT STRING$(80, " ");
260 LOCATE 1, 2: PRINT "DEFENDER";
270 LOCATE 1, 20: PRINT "Score:"; SC;
280 LOCATE 1, 40: PRINT "Lives:"; STRING$(LV, CHR$(3));
290 LOCATE 1, 60: PRINT "Bombs:"; SMARTBOMB;
300 REM ========== MAIN GAME LOOP ==========
310 GFT = TICKS
320 COLOR 0, 0: FOR R = 3 TO 24: LOCATE R, 1: PRINT STRING$(80, " ");: NEXT R
330 COLOR 6, 0
340 FOR C = 1 TO VIEW_W
350   WX = ((SCROLL + C - 2) MOD WORLD_W) + 1: TH = TERRAIN(WX)
360   IF TH >= 3 AND TH <= 24 THEN LOCATE TH, C + 1: PRINT CHR$(220);
370 NEXT C
380 COLOR 13, 0
390 FOR I = 1 TO MAX_HUMAN
400   IF HA(I) = 1 THEN
410     CALL AR_SCROLL_WRAP(HX(I), SCROLL, WORLD_W, SX)
420     IF SX >= 2 AND SX <= 79 THEN LOCATE TERRAIN(HX(I)) - 1, SX: PRINT CHR$(2);
430   END IF
440 NEXT I
450 FOR I = 1 TO MAX_EN
460   IF EN_A(I) = 1 THEN
470     CALL AR_SCROLL_WRAP(EN_X(I), SCROLL, WORLD_W, SX)
480     IF SX >= 2 AND SX <= 79 THEN
490       IF EN_T(I) = 1 THEN COLOR 10, 0
500       IF EN_T(I) = 2 THEN COLOR 12, 0
510       IF EN_T(I) = 3 THEN COLOR 14, 0
520       LOCATE EN_Y(I), SX: PRINT CHR$(15);
530     END IF
540   END IF
550 NEXT I
560 COLOR 15, 0
570 FOR I = 1 TO MAX_LASER
580   IF LA(I) = 1 THEN
590     CALL AR_SCROLL_WRAP(LX(I), SCROLL, WORLD_W, SX)
600     IF SX >= 2 AND SX <= 79 THEN LOCATE LY(I), SX: PRINT "-";
610   END IF
620 NEXT I
630 COLOR 11, 0: LOCATE PY, 40: CH$ = CHR$(17) : IF FACING = 1 THEN CH$ = CHR$(16)
640 PRINT CH$;
650 K$ = INKEY$
660 IF K$ = CHR$(27) THEN 9000
670 IF UCASE$(K$) = "S" THEN GOSUB 8000
680 IF UCASE$(K$) = "L" THEN GOSUB 8100
690 SK = 0 : IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1))
700 IF SK = 72 AND PY > 4 THEN PY = PY - 1
710 IF SK = 80 AND PY < 22 THEN PY = PY + 1
720 IF SK = 75 THEN FACING = -1: SCROLL = SCROLL - 3: IF SCROLL < 1 THEN SCROLL = SCROLL + WORLD_W
730 IF SK = 77 THEN FACING = 1: SCROLL = SCROLL + 3: IF SCROLL > WORLD_W THEN SCROLL = SCROLL - WORLD_W
740 IF K$ = " " THEN GOSUB 1300
750 IF K$ = "b" OR K$ = "B" THEN GOSUB 1500
760 FOR I = 1 TO MAX_LASER
770   IF LA(I) = 1 THEN
780     LX(I) = LX(I) + LD(I) * 3
790     IF LX(I) < SCROLL OR LX(I) > SCROLL + VIEW_W THEN LA(I) = 0: GOTO 840
800     FOR J = 1 TO MAX_EN
810       IF EN_A(J) = 1 THEN CALL AR_CHECK_COLLISION(LX(I), LY(I), EN_X(J), EN_Y(J), 1, HIT): IF HIT = 1 THEN EN_A(J) = 0: LA(I) = 0: SC = SC + 50: SOUND 800, 1
820     NEXT J
830   END IF
840 NEXT I
850 FOR I = 1 TO MAX_EN
860   IF EN_A(I) = 1 THEN
870     PW = SCROLL + 38
880     CALL AR_MOVE_TARGET(EN_X(I), EN_Y(I), PW, PY, 1, NX, NY)
890     EN_X(I) = NX: IF RND(1) < 0.1 THEN EN_Y(I) = NY
900     CALL AR_SCROLL_WRAP(EN_X(I), SCROLL, WORLD_W, SX)
910     IF SX >= 39 AND SX <= 41 AND EN_Y(I) = PY THEN GOSUB 1400
920   END IF
930 NEXT I
940 IF RND(1) < 0.02 THEN GOSUB 1600
950 COLOR 8, 0: LOCATE 2, 1: PRINT STRING$(80, CHR$(196));
960 COLOR 11, 0: GC = INT(SCROLL * 80 / WORLD_W) + 1
970 IF GC >= 1 AND GC <= 80 THEN LOCATE 2, GC: PRINT CHR$(30);
980 COLOR 12, 0
990 FOR I = 1 TO MAX_EN
1000   IF EN_A(I) = 1 THEN GC = INT(EN_X(I) * 80 / WORLD_W) + 1: IF GC >= 1 AND GC <= 80 THEN LOCATE 2, GC: PRINT ".";
1010 NEXT I
1020 COLOR 15, 1: LOCATE 1, 27: PRINT SC; "   ";
1030 LOCATE 1, 47: PRINT STRING$(LV, CHR$(3)); " ";
1040 LOCATE 1, 67: PRINT SMARTBOMB; " ";
1050 GT2 = TICKS: GT1 = GT2 - GFT
1060 IF GT1 < 80 THEN DELAY 80 - GT1
1070 GOTO 310
1300 REM === Fire laser ===
1310 FOR I = 1 TO MAX_LASER
1320   IF LA(I) = 0 THEN LX(I) = SCROLL + 38: LY(I) = PY: LD(I) = FACING: LA(I) = 1: BEEP: RETURN
1330 NEXT I
1340 RETURN
1400 REM === Player hit ===
1410 LV = LV - 1: SOUND 200, 3: COLOR 15, 4: LOCATE PY, 40: PRINT "X";: DELAY 1000
1420 IF LV <= 0 THEN 9000
1430 PY = 12: RETURN
1500 REM === Smart bomb ===
1510 IF SMARTBOMB <= 0 THEN RETURN
1520 SMARTBOMB = SMARTBOMB - 1
1530 FOR I = 1 TO MAX_EN
1540   IF EN_A(I) = 1 THEN CALL AR_SCROLL_WRAP(EN_X(I), SCROLL, WORLD_W, SX): IF SX >= 2 AND SX <= 79 THEN EN_A(I) = 0: SC = SC + 25
1550 NEXT I
1560 SOUND 500, 2: RETURN
1600 REM === Spawn enemy ===
1610 FOR I = 1 TO MAX_EN
1620   IF EN_A(I) = 0 THEN EN_X(I) = SCROLL + INT(RND(1) * 2) * WORLD_W / 2 + 50: EN_X(I) = (EN_X(I) MOD WORLD_W) + 1: EN_Y(I) = INT(RND(1) * 16) + 4: EN_T(I) = INT(RND(1) * 3) + 1: EN_A(I) = 1: RETURN
1630 NEXT I
1640 RETURN
8000 REM === Save Game ===
8010 OPEN "defender.sav" FOR OUTPUT AS #1
8020 PRINT #1, SC: PRINT #1, LV: PRINT #1, SMARTBOMB
8030 CLOSE #1
8040 COLOR 14, 0: LOCATE 12, 30: PRINT "GAME SAVED!": DELAY 1000: RETURN
8100 REM === Load Game ===
8110 IF EXIST("defender.sav") THEN
8120   OPEN "defender.sav" FOR INPUT AS #1
8130   INPUT #1, SC: INPUT #1, LV: INPUT #1, SMARTBOMB
8140   CLOSE #1
8150 END IF
8160 RETURN
9000 REM === GAME OVER ===
9010 CURSOR ON: CLS: COLOR 11, 0: LOCATE 10, 25: PRINT "G A M E   O V E R"
9020 LOCATE 12, 25: PRINT "Score: "; SC
9030 LOCATE 16, 25: PRINT "Press any key...": GOSUB 9990
9040 CLS: END

9990 K$ = INKEY$: IF K$ = "" THEN 9990 ELSE RETURN
9992 K$ = INKEY$: IF K$ <> " " THEN 9992 ELSE RETURN
9994 K$ = INKEY$: IF K$ <> "r" AND K$ <> "R" THEN 9994 ELSE RETURN
