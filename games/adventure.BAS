4370 OB_RM(O_SWORD) = R_GOLD_IN
4380 OB_X(O_SWORD) = 10: OB_Y(O_SWORD) = 10
4390 REM Gold Key near start
4400 OB_RM(O_GOLDKEY) = R_GOLD_OUT
