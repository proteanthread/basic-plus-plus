4760 REM
4770 REM === TITLE SCREEN ===
4780 CLS
4790 COLOR 8, 0
4800 FOR I = 1 TO 25
4810 LOCATE I, 1: PRINT STRING$(80, CHR$(176));
4820 NEXT I
4830 COLOR 14, 0
4840 LOCATE 3, 15
4850 PRINT CHR$(201); STRING$(50, CHR$(205)); CHR$(187)
4860 FOR I = 4 TO 20
4870 LOCATE I, 15: PRINT CHR$(186);
4880 LOCATE I, 66: PRINT CHR$(186);
4890 LOCATE I, 16: COLOR 0, 0: PRINT STRING$(50, " ");
4900 COLOR 14, 0
4910 NEXT I
4920 LOCATE 21, 15
4930 PRINT CHR$(200); STRING$(50, CHR$(205)); CHR$(188)
4940 REM Title
4950 COLOR 14, 0
4960 LOCATE 5, 27: PRINT "A D V E N T U R E"
4970 COLOR 6, 0
4980 LOCATE 7, 23: PRINT STRING$(34, CHR$(205))
4990 COLOR 15, 0
5000 LOCATE 9, 22: PRINT "Based on the Atari 2600 classic"
5010 LOCATE 10, 24: PRINT "by Warren Robinett (1980)"
5020 COLOR 7, 0
5030 LOCATE 12, 20: PRINT "Find the Enchanted Chalice "; CHR$(232)
5040 LOCATE 13, 20: PRINT "and return it to the Golden Castle!"
5050 COLOR 11, 0
5060 LOCATE 15, 22: PRINT "Arrow keys = Move"
5070 LOCATE 16, 22: PRINT "SPACE      = Drop item"
5080 LOCATE 17, 22: PRINT "R          = Reincarnate"
5090 LOCATE 18, 22: PRINT "ESC        = Quit"
5100 COLOR 12, 0
5110 LOCATE 20, 22: PRINT "Beware the Dragons!"
5120 COLOR 7, 0
5130 LOCATE 23, 22: PRINT "Press SPACE to begin your quest..."
5140 K$ = ""
5150 GOSUB 9992
5160 RETURN
5170 REM
5180 REM === DRAW ROOM ===
5190 REM Draw room border and name
5200 FC = RM_FG(PLAYER_RM)
5210 COLOR FC, 0
5220 REM Top wall
5230 LOCATE 2, 2
5240 PRINT CHR$(201);
5250 REM Top wall with opening in center
5260 IF RPG_UP(PLAYER_RM) > 0 THEN
5270 PRINT STRING$(8, CHR$(205));
5280 COLOR 0, 0: PRINT STRING$(4, " ");
5290 COLOR FC, 0: PRINT STRING$(8, CHR$(205));
5300 ELSE
5310 PRINT STRING$(20, CHR$(205));
5320 END IF
5330 PRINT CHR$(187);
5340 REM Castle gate visual
5350 IF PLAYER_RM = R_GOLD_OUT OR PLAYER_RM = R_BLACK_OUT OR PLAYER_RM = R_WHITE_OUT THEN
5360 GN = 0
5370 IF PLAYER_RM = R_GOLD_OUT THEN GN = 1
5380 IF PLAYER_RM = R_BLACK_OUT THEN GN = 2
5390 IF PLAYER_RM = R_WHITE_OUT THEN GN = 3
5400 IF GATE(GN) = 0 THEN
5410 COLOR FC, 0
5420 LOCATE 2, 11: PRINT CHR$(203);
5430 LOCATE 2, 14: PRINT CHR$(203);
5440 LOCATE 3, 11: PRINT CHR$(186);
5450 LOCATE 3, 14: PRINT CHR$(186);
5460 END IF
5470 END IF
5480 REM Side walls
5490 FOR R = 3 TO 21
5500 COLOR FC, 0
5510 LOCATE R, 2: PRINT CHR$(186);
5520 LOCATE R, 23: PRINT CHR$(186);
5530 NEXT R
5540 REM Left opening
5550 IF RPG_LF(PLAYER_RM) > 0 THEN
5560 COLOR 0, 0
5570 LOCATE 11, 2: PRINT " ";
5580 LOCATE 12, 2: PRINT " ";
5590 END IF
5600 REM Right opening
5610 IF RPG_RT(PLAYER_RM) > 0 THEN
5620 COLOR 0, 0
5630 LOCATE 11, 23: PRINT " ";
5640 LOCATE 12, 23: PRINT " ";
5650 END IF
5660 REM Bottom wall
5670 COLOR FC, 0
5680 LOCATE 22, 2
5690 PRINT CHR$(200);
5700 IF RPG_DN(PLAYER_RM) > 0 THEN
5710 PRINT STRING$(8, CHR$(205));
5720 COLOR 0, 0: PRINT STRING$(4, " ");
5730 COLOR FC, 0: PRINT STRING$(8, CHR$(205));
5740 ELSE
5750 PRINT STRING$(20, CHR$(205));
5760 END IF
5770 PRINT CHR$(188);
5780 REM Room-specific decorations
5790 IF PLAYER_RM >= R_CATACOMB_1 AND PLAYER_RM <= R_CATACOMB_3 THEN
5800 REM Catacombs: darkness, only see nearby
5810 COLOR 8, 0
5820 FOR R = 3 TO 21
5830 FOR C = 3 TO 22
5840 DX = ABS(C - PLAYER_X - 2): DY = ABS(R - PLAYER_Y - 2)
5850 IF DX > 4 OR DY > 4 THEN LOCATE R, C: PRINT CHR$(176);
5860 NEXT C
5870 NEXT R
5880 END IF
5890 IF PLAYER_RM = R_FOREST THEN
5900 COLOR 2, 0
5910 FOR I = 1 TO 12
5920 TX = INT(RND(1) * 18) + 3
5930 TY = INT(RND(1) * 16) + 4
5940 LOCATE TY, TX: PRINT CHR$(6);
5950 NEXT I
5960 END IF
5970 IF PLAYER_RM = R_EASTER THEN
5980 COLOR 14, 0
5990 LOCATE 8, 5: PRINT "Created by"
6000 LOCATE 10, 5: PRINT "Warren Robinett"
6010 COLOR 15, 0
6020 LOCATE 13, 5: PRINT "The first video game"
6030 LOCATE 14, 5: PRINT "Easter egg (1980)"
6040 END IF
6050 RETURN
6060 REM
6070 REM === DRAW OBJECTS IN ROOM ===
6080 FOR I = 1 TO MAX_OBJ
6090 IF OB_RM(I) <> PLAYER_RM THEN 6180
6100 REM Dragon dead = show differently
6110 IF I >= O_YORGLE AND I <= O_RHINDLE THEN
6120 D = I - O_YORGLE + 1
6130 IF DR_ST(D) = 2 THEN
6140 COLOR 8, 0
6150 LOCATE OB_Y(I) + 2, OB_X(I) + 2
6160 PRINT "x";
6170 GOTO 6180
6180 END IF
6190 END IF
6200 COLOR OB_FG(I), 0
6210 LOCATE OB_Y(I) + 2, OB_X(I) + 2
6220 PRINT OB_CH$(I);
6230 REM Show dragon name tag
6240 IF I >= O_YORGLE AND I <= O_RHINDLE THEN
6250 LOCATE OB_Y(I) + 1, OB_X(I) + 2
6260 PRINT LEFT$(OB_NM$(I), 1);
6270 END IF
6280 NEXT I
6290 RETURN
6300 REM
6310 REM === DRAW PLAYER ===
6320 COLOR 11, 0
6330 LOCATE PLAYER_Y + 2, PLAYER_X + 2
6340 PRINT CHR$(2);
6350 REM Draw carried item next to player
6360 IF PLAYER_CARRY > 0 THEN
6370 COLOR OB_FG(PLAYER_CARRY), 0
6380 LOCATE PLAYER_Y + 2, PLAYER_X + 3
6390 PRINT OB_CH$(PLAYER_CARRY);
6400 END IF
6410 RETURN
6420 REM
6430 REM === DRAW HUD ===
6440 COLOR 15, 1
6450 LOCATE 1, 1: PRINT STRING$(80, " ");
6460 LOCATE 1, 2: PRINT "ADVENTURE";
6470 COLOR 14, 1
6480 LOCATE 1, 14: PRINT RM_N$(PLAYER_RM);
6490 COLOR 15, 1
6500 IF PLAYER_CARRY > 0 THEN
6510 LOCATE 1, 55: PRINT "Carry: "; OB_NM$(PLAYER_CARRY);
6520 ELSE
6530 LOCATE 1, 55: PRINT "Carry: (nothing)";
6540 END IF
6550 REM Status line
6560 COLOR 7, 0
6570 LOCATE 24, 2
6580 IF RPG_UP(PLAYER_RM) > 0 THEN PRINT "N:"; RM_N$(RPG_UP(PLAYER_RM)); "  ";
6590 LOCATE 25, 2
6600 PRINT "SPACE=Drop R=Reincarnate ESC=Quit";
6610 RETURN

