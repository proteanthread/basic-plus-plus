8130 COLOR 7, 0
8140 LOCATE 24, 2
8150 IF RM_UP(PLAYER_RM) > 0 THEN PRINT "N:"; RM_N$(RM_UP(PLAYER_RM)); "  ";
8160 LOCATE 25, 2
