7850 IF PLAYER_CARRY > 0 THEN
7860   COLOR OB_FG(PLAYER_CARRY), 0
7870   LOCATE PLAYER_Y + 2, PLAYER_X + 3
7880   PRINT OB_CH$(PLAYER_CARRY);
7890 END IF
