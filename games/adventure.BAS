6300 REM
6000 REM === TITLE SCREEN ===
6010 CLS
6020 COLOR 8, 0
6030 FOR I = 1 TO 25
6040   LOCATE I, 1: PRINT STRING$(80, CHR$(176));
6050 NEXT I
6060 COLOR 14, 0
6070 LOCATE 3, 15
6080 PRINT CHR$(201); STRING$(50, CHR$(205)); CHR$(187)
6090 FOR I = 4 TO 20
6100   LOCATE I, 15: PRINT CHR$(186);
6110   LOCATE I, 66: PRINT CHR$(186);
6120   LOCATE I, 16: COLOR 0, 0: PRINT STRING$(50, " ");
6130   COLOR 14, 0
6140 NEXT I
6150 LOCATE 21, 15
6160 PRINT CHR$(200); STRING$(50, CHR$(205)); CHR$(188)
6170 REM Title
6180 COLOR 14, 0
6190 LOCATE 5, 27: PRINT "A D V E N T U R E"
6200 COLOR 6, 0
6210 LOCATE 7, 23: PRINT STRING$(34, CHR$(205))
6220 COLOR 15, 0
6230 LOCATE 9, 22: PRINT "Based on the Atari 2600 classic"
6240 LOCATE 10, 24: PRINT "by Warren Robinett (1980)"
6250 COLOR 7, 0
6260 LOCATE 12, 20: PRINT "Find the Enchanted Chalice "; CHR$(232)
6270 LOCATE 13, 20: PRINT "and return it to the Golden Castle!"
6280 COLOR 11, 0
6290 LOCATE 15, 22: PRINT "Arrow keys = Move"
6300 LOCATE 16, 22: PRINT "SPACE      = Drop item"
6310 LOCATE 17, 22: PRINT "R          = Reincarnate"
6320 LOCATE 18, 22: PRINT "ESC        = Quit"
6330 COLOR 12, 0
6340 LOCATE 20, 22: PRINT "Beware the Dragons!"
6350 COLOR 7, 0
6360 LOCATE 23, 22: PRINT "Press SPACE to begin your quest..."
6370 K$ = ""
6380 WHILE K$ <> " ": K$ = INKEY$: WEND
6390 RETURN
6400 REM
7000 REM === DRAW ROOM ===
7010 REM Draw room border and name
7020 FC = RM_FG(PLAYER_RM)
7030 COLOR FC, 0
7040 REM Top wall
7050 LOCATE 2, 2
7060 PRINT CHR$(201);
7070 REM Top wall with opening in center
7080 IF RM_UP(PLAYER_RM) > 0 THEN
7090   PRINT STRING$(8, CHR$(205));
7100   COLOR 0, 0: PRINT STRING$(4, " ");
7110   COLOR FC, 0: PRINT STRING$(8, CHR$(205));
7120 ELSE
7130   PRINT STRING$(20, CHR$(205));
7140 END IF
7150 PRINT CHR$(187);
7160 REM Castle gate visual
7170 IF PLAYER_RM = R_GOLD_OUT OR PLAYER_RM = R_BLACK_OUT OR PLAYER_RM = R_WHITE_OUT THEN
7180   GN = 0
7190   IF PLAYER_RM = R_GOLD_OUT THEN GN = 1
7200   IF PLAYER_RM = R_BLACK_OUT THEN GN = 2
7210   IF PLAYER_RM = R_WHITE_OUT THEN GN = 3
7220   IF GATE(GN) = 0 THEN
7230     COLOR FC, 0
7240     LOCATE 2, 11: PRINT CHR$(203);
7250     LOCATE 2, 14: PRINT CHR$(203);
7260     LOCATE 3, 11: PRINT CHR$(186);
7270     LOCATE 3, 14: PRINT CHR$(186);
7280   END IF
7290 END IF
7300 REM Side walls
7310 FOR R = 3 TO 21
7320   COLOR FC, 0
7330   LOCATE R, 2: PRINT CHR$(186);
7340   LOCATE R, 23: PRINT CHR$(186);
7350 NEXT R
7360 REM Left opening
7370 IF RM_LF(PLAYER_RM) > 0 THEN
7380   COLOR 0, 0
7390   LOCATE 11, 2: PRINT " ";
7400   LOCATE 12, 2: PRINT " ";
7410 END IF
7420 REM Right opening
7430 IF RM_RT(PLAYER_RM) > 0 THEN
7440   COLOR 0, 0
7450   LOCATE 11, 23: PRINT " ";
7460   LOCATE 12, 23: PRINT " ";
7470 END IF
7480 REM Bottom wall
7490 COLOR FC, 0
7500 LOCATE 22, 2
7510 PRINT CHR$(200);
7520 IF RM_DN(PLAYER_RM) > 0 THEN
7530   PRINT STRING$(8, CHR$(205));
7540   COLOR 0, 0: PRINT STRING$(4, " ");
7550   COLOR FC, 0: PRINT STRING$(8, CHR$(205));
7560 ELSE
7570   PRINT STRING$(20, CHR$(205));
7580 END IF
7590 PRINT CHR$(188);
7600 REM Room-specific decorations
7610 IF PLAYER_RM >= R_CATACOMB.1 AND PLAYER_RM <= R_CATACOMB.3 THEN
7620   REM Catacombs: darkness, only see nearby
7630   COLOR 8, 0
7640   FOR R = 3 TO 21
7650     FOR C = 3 TO 22
7660       DX = ABS(C - PLAYER_X - 2): DY = ABS(R - PLAYER_Y - 2)
7670       IF DX > 4 OR DY > 4 THEN LOCATE R, C: PRINT CHR$(176);
7680     NEXT C
7690   NEXT R
7700 END IF
7710 IF PLAYER_RM = R_FOREST THEN
7720   COLOR 2, 0
7730   FOR I = 1 TO 12
7740     TX = INT(RND(1) * 18) + 3
7750     TY = INT(RND(1) * 16) + 4
7760     LOCATE TY, TX: PRINT CHR$(6);
7770   NEXT I
7780 END IF
7790 IF PLAYER_RM = R_EASTER THEN
7800   COLOR 14, 0
7810   LOCATE 8, 5: PRINT "Created by"
7820   LOCATE 10, 5: PRINT "Warren Robinett"
7830   COLOR 15, 0
7840   LOCATE 13, 5: PRINT "The first video game"
7850   LOCATE 14, 5: PRINT "Easter egg (1980)"
7860 END IF
7870 RETURN
7880 REM
7500 REM === DRAW OBJECTS IN ROOM ===
7510 FOR I = 1 TO MAX_OBJ
7520   IF OB_RM(I) <> PLAYER_RM THEN 7560
7530   REM Dragon dead = show differently
7540   IF I >= O_YORGLE AND I <= O_RHINDLE THEN
7550     D = I - O_YORGLE + 1
7555     IF DR_ST(D) = 2 THEN
7556       COLOR 8, 0
7557       LOCATE OB_Y(I) + 2, OB_X(I) + 2
7558       PRINT "x";
7559       GOTO 7560
7560     END IF
7561   END IF
7562   COLOR OB_FG(I), 0
7563   LOCATE OB_Y(I) + 2, OB_X(I) + 2
7564   PRINT OB_CH$(I);
7565   REM Show dragon name tag
7566   IF I >= O_YORGLE AND I <= O_RHINDLE THEN
7567     LOCATE OB_Y(I) + 1, OB_X(I) + 2
7568     PRINT LEFT$(OB_NM$(I), 1);
7569   END IF
7570 NEXT I
7580 RETURN
7590 REM
7800 REM === DRAW PLAYER ===
7810 COLOR 11, 0
7820 LOCATE PLAYER_Y + 2, PLAYER_X + 2
7830 PRINT CHR$(2);
