6060 OB_RM(O_MAGNET) = R_BLACK_DGN
6070 OB_X(O_MAGNET) = 10: OB_Y(O_MAGNET) = 10
6080 REM Chalice in Black Castle dungeon
6090 OB_RM(O_CHALICE) = R_BLACK_DGN
6100 OB_X(O_CHALICE) = 15: OB_Y(O_CHALICE) = 15
6110 REM Bat in Catacombs
6120 OB_RM(O_BAT) = R_CATACOMB.1
6130 OB_X(O_BAT) = 8: OB_Y(O_BAT) = 8
6140 REM Dragons
6150 OB_RM(O_YORGLE) = R_OPEN.1
6160 OB_X(O_YORGLE) = 15: OB_Y(O_YORGLE) = 10
6170 OB_RM(O_GRUNDLE) = R_BLUE.3
6180 OB_X(O_GRUNDLE) = 8: OB_Y(O_GRUNDLE) = 12
6190 OB_RM(O_RHINDLE) = R_BLACK_DGN
6200 OB_X(O_RHINDLE) = 5: OB_Y(O_RHINDLE) = 5
6210 DR_ST(1) = 1: DR_TG(1) = R_OPEN.1
6220 DR_ST(2) = 1: DR_TG(2) = R_BLUE.3
6230 DR_ST(3) = 1: DR_TG(3) = R_BLACK_DGN
