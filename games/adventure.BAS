10 REM =============================================
2 REM ==================================================
3 REM  EXHAUSTIVE DOCUMENTATION
4 REM ==================================================
5 REM  This file is a standalone Game Engine for BASIC++.
6 REM  It operates strictly within the text UI (TUI) and relies on external
7 REM  mechanics libraries for its game loop. 
8 REM  Key Components:
9 REM  - Initialization: Sets up the visual buffer and arrays.
10 REM  - Main Loop: Uses a non-blocking INKEY$ loop synced with the TICKS timer.
11 REM  - Collision/Movement: Delegated to the imported library.
12 REM  - Save/Load: Invoked via GOSUB 8000 and 8100, saving to .sav files.
13 REM ==================================================
20 REM  ADVENTURE ENGINE
30 REM  Uses RPG_PROCGEN.LIB for mechanics.
40 REM  Arrow keys move, SPACE to drop item
50 REM  ESC to quit, R to reincarnate
60 REM  Press S to Save, L to Load
70 REM =============================================
80 LOAD LIBRARY "lib\rpg_procgen.LIB"
90 RANDOMIZE TIMER
100 PRINT CHR$(27);"[?25l";
110 REM
120 REM === CONSTANTS ===
130 CONST ROOMS = 30
140 CONST MAX_OBJ = 15
150 REM Room IDs
160 CONST R_GOLD_OUT = 1
170 CONST R_GOLD_IN = 2
180 CONST R_GOLD_HALL = 3
190 CONST R_BLUE_1 = 4
200 CONST R_BLUE_2 = 5
210 CONST R_BLUE_3 = 6
220 CONST R_BLUE_4 = 7
230 CONST R_OPEN_1 = 8
240 CONST R_OPEN_2 = 9
250 CONST R_BLACK_OUT = 10
260 CONST R_BLACK_IN = 11
270 CONST R_BLACK_DGN = 12
280 CONST R_WHITE_OUT = 13
290 CONST R_WHITE_IN = 14
300 CONST R_WHITE_DGN = 15
310 CONST R_CATACOMB_1 = 16
320 CONST R_CATACOMB_2 = 17
330 CONST R_CATACOMB_3 = 18
340 CONST R_FIELD_1 = 19
350 CONST R_FIELD_2 = 20
360 CONST R_VALLEY = 21
370 CONST R_PATH = 22
380 CONST R_FOREST = 23
390 CONST R_SECRET = 24
400 CONST R_EASTER = 25
410 REM Object IDs
420 CONST O_SWORD = 1
430 CONST O_GOLDKEY = 2
440 CONST O_BLACKKEY = 3
450 CONST O_WHITEKEY = 4
460 CONST O_BRIDGE = 5
470 CONST O_MAGNET = 6
480 CONST O_CHALICE = 7
490 CONST O_BAT = 8
500 CONST O_YORGLE = 9
510 CONST O_GRUNDLE = 10
520 CONST O_RHINDLE = 11
530 CONST O_DOT = 12
540 REM Dragon states: 1=alive, 2=dead, 3=eating
550 REM
560 REM === GAME STATE ===
570 DIM RM_N$(ROOMS)
580 DIM RM_UP(ROOMS), RM_DN(ROOMS)
590 DIM RM_LF(ROOMS), RM_RT(ROOMS)
600 DIM RM_FG(ROOMS), RM_BG(ROOMS)
610 DIM RM_MAP$(ROOMS)
620 DIM OB_NM$(MAX_OBJ), OB_CH$(MAX_OBJ)
630 DIM OB_RM(MAX_OBJ), OB_X(MAX_OBJ), OB_Y(MAX_OBJ)
640 DIM OB_FG(MAX_OBJ)
650 DIM DR_ST(3), DR_TG(3)
660 REM DR.ST = dragon state (1=alive,2=dead,3=eating you)
670 REM DR.TG = dragon's target room (what it guards)
680 DIM GATE(3)
690 REM GATE: 0=closed, 1=open (Gold, Black, White)
700 PLAYER_RM = R_GOLD_OUT
710 PLAYER_X = 10: PLAYER_Y = 10
720 PLAYER_CARRY = 0
730 PLAYER_DEAD = 0
740 EATEN_BY = 0
750 WON = 0
760 REM
770 REM === SETUP ROOMS ===
780 GOSUB 3550
790 REM === SETUP OBJECTS ===
800 GOSUB 3960
810 REM === TITLE SCREEN ===
820 GOSUB 4770
830 REM
840 REM ========================================
850 REM  MAIN GAME LOOP
860 REM ========================================
870 GFT = TICKS
880 REM --- Draw current room ---
890 REM SCREEN LOCK (stub)
900 CLS
910 GOSUB 5180: REM Draw room
920 GOSUB 6070: REM Draw objects in room
930 GOSUB 6310: REM Draw player
940 GOSUB 6430: REM Draw HUD
950 REM SCREEN UNLOCK (stub)
960 REM
970 REM --- Read input ---
980 K$ = INKEY$
990 IF K$ = CHR$(27) THEN 3370
1000 IF UCASE$(K$) = "S" THEN GOSUB 3410
1010 IF UCASE$(K$) = "L" THEN GOSUB 3470
1020 IF K$ = "r" OR K$ = "R" THEN GOSUB 3010: GOTO 870
1030 IF K$ = " " THEN GOSUB 1390: REM Drop item
1040 SK = 0 : IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1))
1050 OX = PLAYER_X: OY = PLAYER_Y: ORM = PLAYER_RM
1060 IF SK = 72 THEN PLAYER_Y = PLAYER_Y - 1
1070 IF SK = 80 THEN PLAYER_Y = PLAYER_Y + 1
1080 IF SK = 75 THEN PLAYER_X = PLAYER_X - 1
1090 IF SK = 77 THEN PLAYER_X = PLAYER_X + 1
1100 REM --- Room transitions ---
1110 IF PLAYER_Y < 1 THEN GOSUB 1480: REM Go up
1120 IF PLAYER_Y > 20 THEN GOSUB 1550: REM Go down
1130 IF PLAYER_X < 1 THEN GOSUB 1590: REM Go left
1140 IF PLAYER_X > 20 THEN GOSUB 1630: REM Go right
1150 REM --- Wall collision check ---
1160 IF PLAYER_RM = ORM THEN GOSUB 1680
1170 REM --- Item pickup ---
1180 GOSUB 1760
1190 REM --- Gate check ---
1200 GOSUB 1910
1210 REM --- Dragon AI ---
1220 GOSUB 2040
1230 REM --- Bat AI ---
1240 GOSUB 2520
1250 REM --- Win check ---
1260 IF PLAYER_CARRY = O_CHALICE AND PLAYER_RM = R_GOLD_IN THEN WON = 1: GOTO 3110
1270 REM --- Easter egg check ---
1280 IF PLAYER_CARRY = O_DOT AND PLAYER_RM = R_GOLD_HALL THEN
1290 IF PLAYER_X = 10 AND PLAYER_Y = 1 THEN PLAYER_RM = R_EASTER: PLAYER_Y = 18: GOTO 870
1300 END IF
1310 REM --- Death check ---
1320 IF PLAYER_DEAD = 1 THEN GOSUB 2830: GOTO 870
1330 REM --- Frame rate ---
1340 GT2 = TICKS: GT1 = GT2 - GFT
1350 IF GT1 < 100 THEN DELAY 100 - GT1
1360 GFT = TICKS
1370 GOTO 870
1380 REM
1390 REM === DROP ITEM ===
1400 IF PLAYER_CARRY = 0 THEN RETURN
1410 OB_RM(PLAYER_CARRY) = PLAYER_RM
1420 OB_X(PLAYER_CARRY) = PLAYER_X
1430 OB_Y(PLAYER_CARRY) = PLAYER_Y
1440 PLAYER_CARRY = 0
1450 SOUND 400, 1
1460 RETURN
1470 REM
1480 REM === ROOM TRANSITION: UP ===
1490 NR = RPG_UP(PLAYER_RM)
1500 IF NR = 0 THEN PLAYER_Y = 1: RETURN
1510 IF PLAYER_RM = R_GOLD_OUT AND GATE(1) = 0 THEN PLAYER_Y = 1: RETURN
1520 IF PLAYER_RM = R_BLACK_OUT AND GATE(2) = 0 THEN PLAYER_Y = 1: RETURN
1530 IF PLAYER_RM = R_WHITE_OUT AND GATE(3) = 0 THEN PLAYER_Y = 1: RETURN
1540 PLAYER_RM = NR: PLAYER_Y = 19: RETURN
1550 REM === ROOM TRANSITION: DOWN ===
1560 NR = RPG_DN(PLAYER_RM)
1570 IF NR = 0 THEN PLAYER_Y = 20: RETURN
1580 PLAYER_RM = NR: PLAYER_Y = 2: RETURN
1590 REM === ROOM TRANSITION: LEFT ===
1600 NR = RPG_LF(PLAYER_RM)
1610 IF NR = 0 THEN PLAYER_X = 1: RETURN
1620 PLAYER_RM = NR: PLAYER_X = 19: RETURN
1630 REM === ROOM TRANSITION: RIGHT ===
1640 NR = RPG_RT(PLAYER_RM)
1650 IF NR = 0 THEN PLAYER_X = 20: RETURN
1660 PLAYER_RM = NR: PLAYER_X = 2: RETURN
1670 REM
1680 REM === WALL COLLISION (simplified) ===
1690 REM Keep player in bounds
1700 IF PLAYER_X < 1 THEN PLAYER_X = 1
1710 IF PLAYER_X > 20 THEN PLAYER_X = 20
1720 IF PLAYER_Y < 1 THEN PLAYER_Y = 1
1730 IF PLAYER_Y > 20 THEN PLAYER_Y = 20
1740 RETURN
1750 REM
1760 REM === ITEM PICKUP ===
1770 IF PLAYER_CARRY > 0 THEN RETURN
1780 FOR I = 1 TO MAX_OBJ
1790 IF OB_RM(I) <> PLAYER_RM THEN 1880
1800 IF ABS(OB_X(I) - PLAYER_X) > 1 THEN 1880
1810 IF ABS(OB_Y(I) - PLAYER_Y) > 1 THEN 1880
1820 REM Can't pick up dead dragons
1830 IF I >= O_YORGLE AND I <= O_RHINDLE AND DR_ST(I - O_YORGLE + 1) = 2 THEN 1880
1840 PLAYER_CARRY = I
1850 OB_RM(I) = 0
1860 SOUND 800, 1
1870 RETURN
1880 NEXT I
1890 RETURN
1900 REM
1910 REM === GATE CHECK ===
1920 REM Gold gate
1930 IF PLAYER_CARRY = O_GOLDKEY AND PLAYER_RM = R_GOLD_OUT THEN
1940 IF PLAYER_Y <= 3 THEN GATE(1) = 1: SOUND 600, 1
1950 END IF
1960 IF PLAYER_CARRY = O_BLACKKEY AND PLAYER_RM = R_BLACK_OUT THEN
1970 IF PLAYER_Y <= 3 THEN GATE(2) = 1: SOUND 600, 1
1980 END IF
1990 IF PLAYER_CARRY = O_WHITEKEY AND PLAYER_RM = R_WHITE_OUT THEN
2000 IF PLAYER_Y <= 3 THEN GATE(3) = 1: SOUND 600, 1
2010 END IF
2020 RETURN
2030 REM
2040 REM === DRAGON AI ===
2050 FOR D = 1 TO 3
2060 IF DR_ST(D) <> 1 THEN 2230
2070 DI = O_YORGLE + D - 1
2080 IF OB_RM(DI) = 0 THEN 2230: REM being carried
2090 REM Check if player has sword
2100 IF PLAYER_CARRY = O_SWORD THEN
2110 IF OB_RM(DI) = PLAYER_RM THEN
2120 IF ABS(OB_X(DI) - PLAYER_X) < 3 AND ABS(OB_Y(DI) - PLAYER_Y) < 3 THEN
2130 DR_ST(D) = 2: SOUND 200, 3: SC = SC + 100
2140 GOTO 2230
2150 END IF
2160 END IF
2170 END IF
2180 REM Dragon movement toward player
2190 IF OB_RM(DI) = PLAYER_RM THEN
2200 IF RND(1) < 0.3 THEN
2210 IF OB_X(DI) < PLAYER_X THEN OB_X(DI) = OB_X(DI) + 1
2220 IF OB_X(DI) > PLAYER_X THEN OB_X(DI) = OB_X(DI) - 1
2230 IF OB_Y(DI) < PLAYER_Y THEN OB_Y(DI) = OB_Y(DI) + 1
2240 IF OB_Y(DI) > PLAYER_Y THEN OB_Y(DI) = OB_Y(DI) - 1
2250 END IF
2260 REM Check if dragon eats player
2270 IF ABS(OB_X(DI) - PLAYER_X) < 2 AND ABS(OB_Y(DI) - PLAYER_Y) < 2 THEN
2280 IF PLAYER_CARRY <> O_SWORD THEN
2290 PLAYER_DEAD = 1: EATEN_BY = D
2300 DR_ST(D) = 3
2310 SOUND 100, 5
2320 END IF
2330 END IF
2340 ELSE
2350 REM Dragon roams toward its guarded room
2360 IF RND(1) < 0.05 THEN
2370 OB_RM(DI) = DR_TG(D)
2380 OB_X(DI) = INT(RND(1) * 16) + 3
2390 OB_Y(DI) = INT(RND(1) * 16) + 3
2400 END IF
2410 END IF
2420 REM Yorgle fears the Gold Key
2430 IF D = 1 AND PLAYER_CARRY = O_GOLDKEY THEN
2440 IF OB_RM(DI) = PLAYER_RM THEN
2450 IF OB_X(DI) < PLAYER_X THEN OB_X(DI) = OB_X(DI) - 2
2460 IF OB_X(DI) > PLAYER_X THEN OB_X(DI) = OB_X(DI) + 2
2470 END IF
2480 END IF
2490 NEXT D
2500 RETURN
2510 REM
2520 REM === BAT AI ===
2530 IF OB_RM(O_BAT) <> PLAYER_RM THEN RETURN
2540 IF RND(1) < 0.02 THEN
2550 REM Bat tries to swap items
2560 IF PLAYER_CARRY > 0 AND PLAYER_CARRY <> O_BAT THEN
2570 REM Pick a random object to swap with
2580 SW = INT(RND(1) * MAX_OBJ) + 1
2590 IF SW <> O_BAT AND SW <> PLAYER_CARRY AND OB_RM(SW) = PLAYER_RM THEN
2600 OB_RM(PLAYER_CARRY) = PLAYER_RM
2610 OB_X(PLAYER_CARRY) = OB_X(O_BAT)
2620 OB_Y(PLAYER_CARRY) = OB_Y(O_BAT)
2630 PLAYER_CARRY = 0
2640 SOUND 300, 1
2650 END IF
2660 END IF
2670 END IF
2680 REM Bat moves randomly
2690 IF RND(1) < 0.2 THEN
2700 OB_X(O_BAT) = OB_X(O_BAT) + INT(RND(1)*5) - 2
2710 OB_Y(O_BAT) = OB_Y(O_BAT) + INT(RND(1)*5) - 2
2720 IF OB_X(O_BAT) < 2 THEN OB_X(O_BAT) = 2
2730 IF OB_X(O_BAT) > 19 THEN OB_X(O_BAT) = 19
2740 IF OB_Y(O_BAT) < 2 THEN OB_Y(O_BAT) = 2
2750 IF OB_Y(O_BAT) > 19 THEN OB_Y(O_BAT) = 19
2760 END IF
2770 REM Bat room changes
2780 IF RND(1) < 0.01 THEN
2790 OB_RM(O_BAT) = INT(RND(1) * 23) + 1
2800 END IF
2810 RETURN
2820 REM
2830 REM === PLAYER DIED (eaten by dragon) ===
2840 CLS
2850 COLOR 12, 0
2860 DN$ = "a Dragon"
2870 IF EATEN_BY = 1 THEN DN$ = "Yorgle the Yellow Dragon"
2880 IF EATEN_BY = 2 THEN DN$ = "Grundle the Green Dragon"
2890 IF EATEN_BY = 3 THEN DN$ = "Rhindle the Red Dragon"
2900 LOCATE 10, 15
2910 PRINT "You have been eaten by "; DN$; "!"
2920 LOCATE 14, 20
2930 PRINT "Press R to reincarnate..."
2940 K$ = ""
2950 GOSUB 9994 : REM 
2960 K$ = INKEY$
2970 WEND
2980 GOSUB 3010
2990 RETURN
3000 REM
3010 REM === REINCARNATE ===
3020 PLAYER_RM = R_GOLD_OUT
3030 PLAYER_X = 10: PLAYER_Y = 15
3040 PLAYER_DEAD = 0: EATEN_BY = 0
3050 REM Reincarnate all dragons too
3060 FOR D = 1 TO 3
3070 IF DR_ST(D) = 2 OR DR_ST(D) = 3 THEN DR_ST(D) = 1
3080 NEXT D
3090 RETURN
3100 REM
3110 REM === YOU WIN ===
3120 CLS
3130 COLOR 14, 0
3140 LOCATE 4, 15
3150 PRINT CHR$(201); STRING$(50, CHR$(205)); CHR$(187)
3160 FOR I = 5 TO 18
3170 LOCATE I, 15: PRINT CHR$(186);
3180 LOCATE I, 66: PRINT CHR$(186);
3190 NEXT I
3200 LOCATE 19, 15
3210 PRINT CHR$(200); STRING$(50, CHR$(205)); CHR$(188)
3220 COLOR 14, 0
3230 LOCATE 7, 25: PRINT "V I C T O R Y !"
3240 COLOR 15, 0
3250 LOCATE 9, 20: PRINT "You have returned the Enchanted"
3260 LOCATE 10, 20: PRINT "Chalice to the Golden Castle!"
3270 COLOR 6, 0
3280 LOCATE 12, 35: PRINT CHR$(232)
3290 COLOR 14, 0
3300 LOCATE 12, 33: PRINT "{ "; CHR$(232); " }"
3310 COLOR 7, 0
3320 LOCATE 15, 20: PRINT "The Kingdom is saved!"
3330 LOCATE 17, 22: PRINT "Press any key..."
3340 GOSUB 9990
3350 CLS: PRINT CHR$(27);"[?25h";: END
3360 REM
3370 REM === QUIT ===
3380 CURSOR ON: CLS
3390 PRINT "Thanks for playing Adventure!"
3400 END
3410 REM === SAVE GAME ===
3420 OPEN "adventure.sav" FOR OUTPUT AS #1
3430 PRINT #1, PLAYER_RM: PRINT #1, PLAYER_X: PRINT #1, PLAYER_Y
3440 PRINT #1, PLAYER_CARRY: PRINT #1, WON
3450 CLOSE #1
3460 COLOR 14, 0: LOCATE 12, 30: PRINT "GAME SAVED!": DELAY 1000: RETURN
3470 REM === LOAD GAME ===
3480 IF EXIST("adventure.sav") THEN
3490 OPEN "adventure.sav" FOR INPUT AS #1
3500 INPUT #1, PLAYER_RM: INPUT #1, PLAYER_X: INPUT #1, PLAYER_Y
3510 INPUT #1, PLAYER_CARRY: INPUT #1, WON
3520 CLOSE #1
3530 END IF
3540 RETURN
3550 REM === SETUP ROOMS ===
3560 FOR I = 1 TO ROOMS: RM_N$(I) = "Room " + STR$(I): NEXT I
3570 RM_N$(R_GOLD_OUT) = "Before the Golden Castle"
3580 RM_N$(R_GOLD_IN) = "Inside the Golden Castle"
3590 RM_N$(R_GOLD_HALL) = "Golden Castle Great Hall"
3600 RM_N$(R_BLACK_OUT) = "Before the Black Castle"
3610 RM_N$(R_BLACK_IN) = "Inside the Black Castle"
3620 RM_N$(R_BLACK_DGN) = "Black Castle Dungeon"
3630 RM_N$(R_WHITE_OUT) = "Before the White Castle"
3640 RM_N$(R_WHITE_IN) = "Inside the White Castle"
3650 RM_N$(R_WHITE_DGN) = "Red Dungeon"
3660 RM_N$(R_SECRET) = "Secret Room"
3670 RM_N$(R_EASTER) = "Created by Warren Robinett"
3680 CALL RPG_INIT_MAZE(ROOMS)
3690 CALL RPG_GEN_MAZE()
3700 REM Force critical paths to ensure game is playable
3710 RPG_UP(R_GOLD_OUT) = R_GOLD_IN: RPG_DN(R_GOLD_IN) = R_GOLD_OUT
3720 RPG_UP(R_GOLD_IN) = R_GOLD_HALL: RPG_DN(R_GOLD_HALL) = R_GOLD_IN
3730 RPG_UP(R_BLACK_OUT) = R_BLACK_IN: RPG_DN(R_BLACK_IN) = R_BLACK_OUT
3740 RPG_UP(R_BLACK_IN) = R_BLACK_DGN: RPG_DN(R_BLACK_DGN) = R_BLACK_IN
3750 RPG_UP(R_WHITE_OUT) = R_WHITE_IN: RPG_DN(R_WHITE_IN) = R_WHITE_OUT
3760 RPG_UP(R_WHITE_IN) = R_WHITE_DGN: RPG_DN(R_WHITE_DGN) = R_WHITE_IN
3770 RPG_RT(R_WHITE_DGN) = R_SECRET: RPG_LF(R_SECRET) = R_WHITE_DGN
3780 RPG_DN(R_EASTER) = R_GOLD_HALL
3790 REM Room colors
3800 FOR I = 1 TO ROOMS: RM_FG(I) = 7: RM_BG(I) = 0: NEXT I
3810 RM_FG(R_GOLD_OUT) = 14: RM_FG(R_GOLD_IN) = 14
3820 RM_FG(R_GOLD_HALL) = 14
3830 RM_FG(R_BLUE_1) = 9: RM_FG(R_BLUE_2) = 9
3840 RM_FG(R_BLUE_3) = 9: RM_FG(R_BLUE_4) = 9
3850 RM_FG(R_BLACK_OUT) = 8: RM_FG(R_BLACK_IN) = 8
3860 RM_FG(R_BLACK_DGN) = 8
3870 RM_FG(R_WHITE_OUT) = 15: RM_FG(R_WHITE_IN) = 15
3880 RM_FG(R_WHITE_DGN) = 12
3890 RM_FG(R_CATACOMB_1) = 8: RM_FG(R_CATACOMB_2) = 8
3900 RM_FG(R_CATACOMB_3) = 8
3910 RM_FG(R_FOREST) = 2
3920 RM_FG(R_SECRET) = 5
3930 RM_FG(R_EASTER) = 14
3940 RETURN
3950 REM
3960 REM === SETUP OBJECTS ===
3970 REM Object names, characters, colors
3980 OB_NM$(O_SWORD) = "Sword"
3990 OB_CH$(O_SWORD) = CHR$(24)
4000 OB_FG(O_SWORD) = 15
4010 OB_NM$(O_GOLDKEY) = "Gold Key"
4020 OB_CH$(O_GOLDKEY) = CHR$(12)
4030 OB_FG(O_GOLDKEY) = 14
4040 OB_NM$(O_BLACKKEY) = "Black Key"
4050 OB_CH$(O_BLACKKEY) = CHR$(12)
4060 OB_FG(O_BLACKKEY) = 8
4070 OB_NM$(O_WHITEKEY) = "White Key"
4080 OB_CH$(O_WHITEKEY) = CHR$(12)
4090 OB_FG(O_WHITEKEY) = 15
4100 OB_NM$(O_BRIDGE) = "Bridge"
4110 OB_CH$(O_BRIDGE) = CHR$(205)
4120 OB_FG(O_BRIDGE) = 6
4130 OB_NM$(O_MAGNET) = "Magnet"
4140 OB_CH$(O_MAGNET) = "U"
4150 OB_FG(O_MAGNET) = 12
4160 OB_NM$(O_CHALICE) = "Enchanted Chalice"
4170 OB_CH$(O_CHALICE) = CHR$(232)
4180 OB_FG(O_CHALICE) = 14
4190 OB_NM$(O_BAT) = "Black Bat"
4200 OB_CH$(O_BAT) = "W"
4210 OB_FG(O_BAT) = 5
4220 OB_NM$(O_YORGLE) = "Yorgle"
4230 OB_CH$(O_YORGLE) = CHR$(234)
4240 OB_FG(O_YORGLE) = 14
4250 OB_NM$(O_GRUNDLE) = "Grundle"
4260 OB_CH$(O_GRUNDLE) = CHR$(234)
4270 OB_FG(O_GRUNDLE) = 10
4280 OB_NM$(O_RHINDLE) = "Rhindle"
4290 OB_CH$(O_RHINDLE) = CHR$(234)
4300 OB_FG(O_RHINDLE) = 12
4310 OB_NM$(O_DOT) = "."
