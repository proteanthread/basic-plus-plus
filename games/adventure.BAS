8010 COLOR 15, 1
8020 LOCATE 1, 1: PRINT STRING$(80, " ");
8030 LOCATE 1, 2: PRINT "ADVENTURE";
8040 COLOR 14, 1
8050 LOCATE 1, 14: PRINT RM_N$(PLAYER_RM);
