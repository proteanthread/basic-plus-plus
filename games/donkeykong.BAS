10 REM =============================================
REM ==================================================
REM  EXHAUSTIVE DOCUMENTATION
REM ==================================================
REM  This file is a standalone Game Engine for BASIC++.
REM  It operates strictly within the text UI (TUI) and relies on external
REM  mechanics libraries for its game loop. 
REM  Key Components:
REM  - Initialization: Sets up the visual buffer and arrays.
REM  - Main Loop: Uses a non-blocking INKEY$ loop synced with the TICKS timer.
REM  - Collision/Movement: Delegated to the imported library.
REM  - Save/Load: Invoked via GOSUB 8000 and 8100, saving to .sav files.
REM ==================================================
20 REM  DONKEY KONG ENGINE
30 REM  Uses PLATFORMER.LIB for mechanics.
40 REM  Arrow keys move, SPACE to jump, ESC quit
50 REM  Press S to Save, L to Load
60 REM =============================================
70 LOAD LIBRARY "lib\platformer.LIB"
80 RANDOMIZE TIMER
90 PRINT CHR$(27);"[?25l";
100 CONST MAX_BARRELS = 6
110 CALL PLAT_INIT(6, 5)
120 CALL PLAT_ADD(22, 1, 78)
130 CALL PLAT_ADD(18, 5, 78)
140 CALL PLAT_ADD(14, 1, 74)
150 CALL PLAT_ADD(10, 5, 78)
160 CALL PLAT_ADD(6, 1, 74)
170 CALL PLAT_ADD(3, 30, 50)
180 CALL PLAT_ADD_LADDER(72, 18, 22)
190 CALL PLAT_ADD_LADDER(10, 14, 18)
200 CALL PLAT_ADD_LADDER(68, 10, 14)
210 CALL PLAT_ADD_LADDER(12, 6, 10)
220 CALL PLAT_ADD_LADDER(40, 3, 6)
230 DIM BR_X(MAX_BARRELS), BR_Y(MAX_BARRELS), BR_D(MAX_BARRELS), BR_A(MAX_BARRELS)
240 PX = 5: PY = 21: VY = 0: JUMPING = 0: ON_LADDER = 0
250 SC = 0: LV = 3: LVL = 1
260 CLS: COLOR 15, 1: LOCATE 1, 1: PRINT STRING$(80, " ");
270 LOCATE 1, 2: PRINT "DONKEY KONG"
280 LOCATE 1, 25: PRINT "Score:"; SC
290 LOCATE 1, 55: PRINT "Lives: "; STRING$(LV, CHR$(3))
300 CALL PLAT_DRAW_PLATS(6, 0)
310 CALL PLAT_DRAW_LADDERS(3, 0)
320 COLOR 4, 0: LOCATE 2, 5: PRINT "DK";
330 COLOR 13, 0: LOCATE 2, 40: PRINT CHR$(2);
340 REM ========== MAIN GAME LOOP ==========
350 GFT = TICKS
360 K$ = INKEY$
370 IF K$ = CHR$(27) THEN 9000
380 IF UCASE$(K$) = "S" THEN GOSUB 8000
390 IF UCASE$(K$) = "L" THEN GOSUB 8100
400 SK = 0 : IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1))
410 IF SK = 75 AND PX > 2 THEN COLOR 0, 0: LOCATE PY, PX: PRINT " ";: PX = PX - 1
420 IF SK = 77 AND PX < 78 THEN COLOR 0, 0: LOCATE PY, PX: PRINT " ";: PX = PX + 1
430 IF SK = 72 THEN COLOR 0, 0: LOCATE PY, PX: PRINT " ";: CALL PLAT_CHECK_LADDER_UP(PX, PY, ON_LADDER)
440 IF SK = 80 THEN COLOR 0, 0: LOCATE PY, PX: PRINT " ";: CALL PLAT_CHECK_LADDER_DOWN(PX, PY, ON_LADDER)
450 IF K$ = " " AND JUMPING = 0 AND ON_LADDER = 0 THEN VY = -3: JUMPING = 1
460 IF JUMPING = 1 AND ON_LADDER = 0 THEN
470   COLOR 0, 0: LOCATE PY, PX: PRINT " ";
480   CALL PLAT_PHYSICS(PX, PY, VY, JUMPING, 1)
490   IF PY > 23 THEN PY = 21: VY = 0: JUMPING = 0
500 END IF
510 COLOR 11, 0: LOCATE PY, PX: PRINT CHR$(2);
520 IF RND(1) < 0.03 THEN GOSUB 1300
530 FOR I = 1 TO MAX_BARRELS
540   IF BR_A(I) = 1 THEN
550     COLOR 0, 0: LOCATE BR_Y(I), BR_X(I): PRINT " ";
560     BR_X(I) = BR_X(I) + BR_D(I)
570     ONPLAT = 0
580     FOR P = 1 TO 5
590       IF BR_Y(I) = PL_Y(P) - 1 AND BR_X(I) >= PL_X1(P) AND BR_X(I) <= PL_X2(P) THEN ONPLAT = 1
600     NEXT P
610     IF ONPLAT = 0 THEN BR_Y(I) = BR_Y(I) + 1: BR_D(I) = -BR_D(I)
620     IF BR_Y(I) > 23 THEN BR_A(I) = 0
630     IF BR_A(I) = 1 THEN COLOR 4, 0: LOCATE BR_Y(I), BR_X(I): PRINT "o";
640     IF BR_A(I) = 1 AND BR_Y(I) = PY AND ABS(BR_X(I) - PX) < 2 THEN GOSUB 1400
650   END IF
660 NEXT I
670 IF PY <= 3 AND PX >= 30 AND PX <= 50 THEN SC = SC + 500: LVL = LVL + 1: COLOR 14, 0: LOCATE 12, 30: PRINT "LEVEL "; LVL; " !": SOUND 800, 2: DELAY 2000: PX = 5: PY = 21: FOR I = 1 TO MAX_BARRELS: BR_A(I) = 0: NEXT I
680 COLOR 15, 1: LOCATE 1, 32: PRINT SC; "   ";
690 GT2 = TICKS: GT1 = GT2 - GFT
700 IF GT1 < 100 THEN DELAY 100 - GT1
710 GOTO 350
1300 REM === Spawn barrel ===
1310 FOR I = 1 TO MAX_BARRELS
1320   IF BR_A(I) = 0 THEN BR_X(I) = 7: BR_Y(I) = 5: BR_D(I) = 1: BR_A(I) = 1: RETURN
1330 NEXT I
1340 RETURN
1400 REM === Player hit ===
1410 LV = LV - 1: SOUND 200, 3: COLOR 15, 4: LOCATE PY, PX: PRINT "X";: DELAY 1000
1420 IF LV <= 0 THEN 9000
1430 PX = 5: PY = 21: VY = 0: JUMPING = 0: RETURN
8000 REM === Save Game ===
8010 OPEN "donkeykong.sav" FOR OUTPUT AS #1
8020 PRINT #1, SC: PRINT #1, LV: PRINT #1, LVL
8030 CLOSE #1
8040 COLOR 14, 0: LOCATE 12, 30: PRINT "GAME SAVED!": DELAY 1000: RETURN
8100 REM === Load Game ===
8110 IF EXIST("donkeykong.sav") THEN
8120   OPEN "donkeykong.sav" FOR INPUT AS #1
8130   INPUT #1, SC: INPUT #1, LV: INPUT #1, LVL
8140   CLOSE #1
8150 END IF
8160 RETURN
9000 REM === GAME OVER ===
9010 CURSOR ON: CLS: COLOR 14, 0: LOCATE 10, 25: PRINT "G A M E   O V E R"
9020 LOCATE 12, 25: PRINT "Score: "; SC
9030 LOCATE 16, 25: PRINT "Press any key...": GOSUB 9990
9040 CLS: END

9990 K$ = INKEY$: IF K$ = "" THEN 9990 ELSE RETURN
9992 K$ = INKEY$: IF K$ <> " " THEN 9992 ELSE RETURN
9994 K$ = INKEY$: IF K$ <> "r" AND K$ <> "R" THEN 9994 ELSE RETURN
