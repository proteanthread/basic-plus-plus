10 REM =============================================
20 REM  SPACE INVADERS - BASIC++ Text Game
30 REM  Arrow keys to move, SPACE to fire, ESC quit
40 REM =============================================
50 RANDOMIZE TIMER
60 PRINT CHR$(27);"[?25l";
70 REM --- Game constants ---
80 CONST ROWS = 5: CONST COLS = 11
90 CONST ECOUNT = ROWS * COLS
100 CONST MAX_BULL = 5
110 CONST MAX_BOMB = 8
120 CONST FPS_MS = 80
130 REM --- Game state ---
140 DIM EX(ECOUNT), EY(ECOUNT), EA(ECOUNT)
150 DIM BX(MAX_BULL), BY(MAX_BULL), BA(MAX_BULL)
160 DIM MX(MAX_BOMB), MY(MAX_BOMB), MA(MAX_BOMB)
170 PX = 40: PY = 23
180 SC = 0: LV = 3: LVL = 1
190 DIR = 1: ALIVE = ECOUNT
200 REM --- Initialize enemies ---
210 FOR R = 0 TO ROWS - 1
220   FOR C = 0 TO COLS - 1
230     I = R * COLS + C
240     EX(I) = C * 5 + 10
250     EY(I) = R * 2 + 3
260     EA(I) = 1
270   NEXT C
280 NEXT R
290 REM
300 REM ========== MAIN GAME LOOP ==========
310 GFT = TICKS
320 REM SCREEN LOCK (stub)
330 CLS
340 REM --- Draw HUD ---
350 COLOR 15, 1
360 LOCATE 1, 1
370 PRINT STRING$(80, " ");
380 LOCATE 1, 2
390 PRINT "SPACE INVADERS";
400 LOCATE 1, 25
410 PRINT "Score:"; SC;
420 LOCATE 1, 45
430 PRINT "Level:"; LVL;
440 LOCATE 1, 60
450 PRINT "Lives: "; STRING$(LV, CHR$(3));
460 REM --- Draw shields ---
470 COLOR 2, 0
480 FOR I = 0 TO 3
490   FOR C = 0 TO 5
500     LOCATE 20, I * 18 + 8 + C
510     PRINT CHR$(219);
520   NEXT C
530 NEXT I
540 REM --- Draw enemies ---
550 FOR I = 0 TO ECOUNT - 1
560   IF EA(I) = 0 THEN 610
570   R = I \ COLS
580   IF R < 2 THEN COLOR 12, 0
590   IF R >= 2 AND R < 4 THEN COLOR 14, 0
600   IF R >= 4 THEN COLOR 10, 0
610   IF EA(I) = 0 THEN 640
620   LOCATE EY(I), EX(I)
630   PRINT CHR$(234);
640 NEXT I
650 REM --- Draw player ---
660 COLOR 11, 0
670 LOCATE PY, PX - 1
680 PRINT " "; CHR$(30); " ";
690 REM --- Draw bullets ---
700 COLOR 15, 0
710 FOR I = 0 TO MAX_BULL - 1
720   IF BA(I) = 0 THEN 750
730   LOCATE BY(I), BX(I)
740   PRINT CHR$(179);
750 NEXT I
760 REM --- Draw bombs ---
770 COLOR 13, 0
780 FOR I = 0 TO MAX_BOMB - 1
790   IF MA(I) = 0 THEN 820
800   LOCATE MY(I), MX(I)
810   PRINT CHR$(7);
820 NEXT I
830 REM SCREEN UNLOCK (stub)
840 REM
850 REM --- Read input ---
860 K$ = INKEY$
870 IF K$ = "" THEN 950
880 IF K$ = CHR$(27) THEN 2000
890 SK = 0 : IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1))
900 IF SK = 75 AND PX > 3 THEN PX = PX - 2
910 IF SK = 77 AND PX < 78 THEN PX = PX + 2
920 IF K$ = " " THEN GOSUB 1200
930 REM
940 REM --- Move bullets upward ---
950 FOR I = 0 TO MAX_BULL - 1
960   IF BA(I) = 0 THEN 1020
970   BY(I) = BY(I) - 1
980   IF BY(I) < 2 THEN BA(I) = 0: GOTO 1020
990   REM Check hit enemy
1000  GOSUB 1300
1010  REM
1020 NEXT I
1030 REM
1040 REM --- Move bombs downward ---
1050 FOR I = 0 TO MAX_BOMB - 1
1060   IF MA(I) = 0 THEN 1100
1070   MY(I) = MY(I) + 1
1080   IF MY(I) > 24 THEN MA(I) = 0: GOTO 1100
1090   IF MY(I) = PY AND ABS(MX(I) - PX) < 2 THEN GOSUB 1500
1100 NEXT I
1110 REM
1120 REM --- Move enemies ---
1130 EDGE = 0
1140 FOR I = 0 TO ECOUNT - 1
1150   IF EA(I) = 0 THEN 1180
1160   IF EX(I) + DIR > 76 OR EX(I) + DIR < 3 THEN EDGE = 1
1170   REM
1180 NEXT I
1190 IF EDGE = 1 THEN DIR = -DIR: GOSUB 1400
1195 FOR I = 0 TO ECOUNT - 1
1196   IF EA(I) = 1 THEN EX(I) = EX(I) + DIR
1197 NEXT I
1198 REM --- Enemy fire ---
1199 IF RND(1) < 0.15 THEN GOSUB 1600
1200 REM
1201 REM --- Frame wait ---
1202 GT2 = TICKS
1203 GT1 = GT2 - GFT
1204 IF GT1 < FPS_MS THEN DELAY FPS_MS - GT1
1205 GFT = TICKS
1206 REM --- Check win ---
1207 IF ALIVE <= 0 THEN GOSUB 1700: GOTO 200
1208 GOTO 310
1209 REM
1200 REM === Fire bullet ===
1210 FOR I = 0 TO MAX_BULL - 1
1220   IF BA(I) = 1 THEN 1250
1230   BX(I) = PX: BY(I) = PY - 1: BA(I) = 1
1240   BEEP
1250   RETURN
1260 NEXT I
1270 RETURN
1280 REM
1300 REM === Check bullet-enemy collision ===
1310 FOR J = 0 TO ECOUNT - 1
1320   IF EA(J) = 0 THEN 1360
1330   IF BY(I) = EY(J) AND ABS(BX(I) - EX(J)) < 2 THEN
1340     EA(J) = 0: BA(I) = 0: SC = SC + 10
1350     ALIVE = ALIVE - 1
1355     SOUND 800, 1
1360   END IF
1370 NEXT J
1380 RETURN
1390 REM
1400 REM === Drop enemies one row ===
1410 FOR I = 0 TO ECOUNT - 1
1420   IF EA(I) = 1 THEN EY(I) = EY(I) + 1
1430   IF EA(I) = 1 AND EY(I) >= PY THEN 2000
1440 NEXT I
1450 RETURN
1460 REM
1500 REM === Player hit by bomb ===
1510 LV = LV - 1
1520 SOUND 200, 3
1530 COLOR 15, 4
1540 LOCATE PY, PX - 1
1550 PRINT " * ";
1560 DELAY 500
1570 IF LV <= 0 THEN 2000
1580 RETURN
1590 REM
1600 REM === Enemy fires a bomb ===
1610 REM Pick a random alive enemy
1620 FOR GI = 1 TO 10
1630   J = INT(RND(1) * ECOUNT)
1640   IF EA(J) = 1 THEN 1660
1650 NEXT GI
1655 RETURN
1660 REM Find free bomb slot
1670 FOR I = 0 TO MAX_BOMB - 1
1680   IF MA(I) = 0 THEN MX(I) = EX(J): MY(I) = EY(J) + 1: MA(I) = 1: RETURN
1690 NEXT I
1695 RETURN
1700 REM === Level complete ===
1710 LVL = LVL + 1
1720 COLOR 14, 0
1730 LOCATE 12, 30
1740 PRINT "LEVEL "; LVL; " !"
1750 DELAY 1500
1760 ALIVE = ECOUNT
1770 RETURN
1780 REM
2000 REM === GAME OVER ===
2010 PRINT CHR$(27);"[?25h";
2020 CLS
2030 COLOR 15, 0
2040 LOCATE 10, 30
2050 PRINT "G A M E   O V E R"
2060 LOCATE 12, 30
2070 PRINT "Final Score: "; SC
2080 LOCATE 14, 30
2090 PRINT "Level Reached: "; LVL
2100 LOCATE 18, 25
2110 PRINT "Press any key to exit..."
2120 K$ = ""
2130 WHILE K$ = ""
2140   K$ = INKEY$
2150 WEND
2160 CLS
2170 END


