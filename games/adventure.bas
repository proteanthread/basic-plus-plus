10 REM =============================================
20 REM  ADVENTURE - BASIC++ Text Game
30 REM  Based on Atari 2600 Adventure (1980)
40 REM  by Warren Robinett
50 REM
60 REM  Arrow keys move, SPACE to drop item
70 REM  ESC to quit, R to reincarnate
80 REM
90 REM  Objective: Find the Enchanted Chalice
91 REM  and return it to the Golden Castle.
92 REM
93 REM  Features Warren Robinett's Easter Egg!
94 REM =============================================
95 RANDOMIZE TIMER
96 CURSOR OFF
97 REM
98 REM === CONSTANTS ===
99 CONST ROOMS = 30
100 CONST MAX.OBJ = 15
110 REM Room IDs
120 CONST R.GOLD.OUT = 1
130 CONST R.GOLD.IN = 2
140 CONST R.GOLD.HALL = 3
150 CONST R.BLUE.1 = 4
160 CONST R.BLUE.2 = 5
170 CONST R.BLUE.3 = 6
180 CONST R.BLUE.4 = 7
190 CONST R.OPEN.1 = 8
200 CONST R.OPEN.2 = 9
210 CONST R.BLACK.OUT = 10
220 CONST R.BLACK.IN = 11
230 CONST R.BLACK.DGN = 12
240 CONST R.WHITE.OUT = 13
250 CONST R.WHITE.IN = 14
260 CONST R.WHITE.DGN = 15
270 CONST R.CATACOMB.1 = 16
280 CONST R.CATACOMB.2 = 17
290 CONST R.CATACOMB.3 = 18
300 CONST R.FIELD.1 = 19
310 CONST R.FIELD.2 = 20
320 CONST R.VALLEY = 21
330 CONST R.PATH = 22
340 CONST R.FOREST = 23
350 CONST R.SECRET = 24
360 CONST R.EASTER = 25
370 REM Object IDs
380 CONST O.SWORD = 1
390 CONST O.GOLDKEY = 2
400 CONST O.BLACKKEY = 3
410 CONST O.WHITEKEY = 4
420 CONST O.BRIDGE = 5
430 CONST O.MAGNET = 6
440 CONST O.CHALICE = 7
450 CONST O.BAT = 8
460 CONST O.YORGLE = 9
470 CONST O.GRUNDLE = 10
480 CONST O.RHINDLE = 11
490 CONST O.DOT = 12
500 REM Dragon states: 1=alive, 2=dead, 3=eating
510 REM
520 REM === GAME STATE ===
530 DIM RM.N$(ROOMS)
540 DIM RM.UP(ROOMS), RM.DN(ROOMS)
550 DIM RM.LF(ROOMS), RM.RT(ROOMS)
560 DIM RM.FG(ROOMS), RM.BG(ROOMS)
570 DIM RM.MAP$(ROOMS)
580 DIM OB.NM$(MAX.OBJ), OB.CH$(MAX.OBJ)
590 DIM OB.RM(MAX.OBJ), OB.X(MAX.OBJ), OB.Y(MAX.OBJ)
600 DIM OB.FG(MAX.OBJ)
610 DIM DR.ST(3), DR.TG(3)
620 REM DR.ST = dragon state (1=alive,2=dead,3=eating you)
630 REM DR.TG = dragon's target room (what it guards)
640 DIM GATE(3)
650 REM GATE: 0=closed, 1=open (Gold, Black, White)
660 PLAYER.RM = R.GOLD.OUT
670 PLAYER.X = 10: PLAYER.Y = 10
680 PLAYER.CARRY = 0
690 PLAYER.DEAD = 0
700 EATEN.BY = 0
710 WON = 0
720 REM
730 REM === SETUP ROOMS ===
740 GOSUB 5000
750 REM === SETUP OBJECTS ===
760 GOSUB 5500
770 REM === TITLE SCREEN ===
780 GOSUB 6000
790 REM
800 REM ========================================
810 REM  MAIN GAME LOOP
820 REM ========================================
830 GFT = TICKS
840 REM --- Draw current room ---
850 SCREEN LOCK
860 CLS
870 GOSUB 7000: REM Draw room
880 GOSUB 7500: REM Draw objects in room
890 GOSUB 7800: REM Draw player
900 GOSUB 8000: REM Draw HUD
910 SCREEN UNLOCK
920 REM
930 REM --- Read input ---
940 K$ = INKEY$
950 IF K$ = CHR$(27) THEN 4000
960 IF K$ = "r" OR K$ = "R" THEN GOSUB 3500: GOTO 830
970 IF K$ = " " THEN GOSUB 2000: REM Drop item
980 IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1)) ELSE SK = 0
990 OX = PLAYER.X: OY = PLAYER.Y: ORM = PLAYER.RM
1000 IF SK = 72 THEN PLAYER.Y = PLAYER.Y - 1
1010 IF SK = 80 THEN PLAYER.Y = PLAYER.Y + 1
1020 IF SK = 75 THEN PLAYER.X = PLAYER.X - 1
1030 IF SK = 77 THEN PLAYER.X = PLAYER.X + 1
1040 REM --- Room transitions ---
1050 IF PLAYER.Y < 1 THEN GOSUB 2100: REM Go up
1060 IF PLAYER.Y > 20 THEN GOSUB 2200: REM Go down
1070 IF PLAYER.X < 1 THEN GOSUB 2300: REM Go left
1080 IF PLAYER.X > 20 THEN GOSUB 2400: REM Go right
1090 REM --- Wall collision check ---
1100 IF PLAYER.RM = ORM THEN GOSUB 2500
1110 REM --- Item pickup ---
1120 GOSUB 2600
1130 REM --- Gate check ---
1140 GOSUB 2700
1150 REM --- Dragon AI ---
1160 GOSUB 2800
1170 REM --- Bat AI ---
1180 GOSUB 2900
1190 REM --- Win check ---
1200 IF PLAYER.CARRY = O.CHALICE AND PLAYER.RM = R.GOLD.IN THEN WON = 1: GOTO 3800
1210 REM --- Easter egg check ---
1220 IF PLAYER.CARRY = O.DOT AND PLAYER.RM = R.GOLD.HALL THEN
1230   IF PLAYER.X = 10 AND PLAYER.Y = 1 THEN PLAYER.RM = R.EASTER: PLAYER.Y = 18: GOTO 830
1240 END IF
1250 REM --- Death check ---
1260 IF PLAYER.DEAD = 1 THEN GOSUB 3000: GOTO 830
1270 REM --- Frame rate ---
1280 GT2 = TICKS: GT1 = GT2 - GFT
1290 IF GT1 < 100 THEN DELAY 100 - GT1
1300 GFT = TICKS
1310 GOTO 830
1320 REM
2000 REM === DROP ITEM ===
2010 IF PLAYER.CARRY = 0 THEN RETURN
2020 OB.RM(PLAYER.CARRY) = PLAYER.RM
2030 OB.X(PLAYER.CARRY) = PLAYER.X
2040 OB.Y(PLAYER.CARRY) = PLAYER.Y
2050 PLAYER.CARRY = 0
2060 SOUND 400, 1
2070 RETURN
2080 REM
2100 REM === ROOM TRANSITION: UP ===
2110 NR = RM.UP(PLAYER.RM)
2120 IF NR = 0 THEN PLAYER.Y = 1: RETURN
2130 REM Check castle gate
2140 IF PLAYER.RM = R.GOLD.OUT AND GATE(1) = 0 THEN PLAYER.Y = 1: RETURN
2150 IF PLAYER.RM = R.BLACK.OUT AND GATE(2) = 0 THEN PLAYER.Y = 1: RETURN
2160 IF PLAYER.RM = R.WHITE.OUT AND GATE(3) = 0 THEN PLAYER.Y = 1: RETURN
2170 PLAYER.RM = NR: PLAYER.Y = 19
2180 RETURN
2190 REM
2200 REM === ROOM TRANSITION: DOWN ===
2210 NR = RM.DN(PLAYER.RM)
2220 IF NR = 0 THEN PLAYER.Y = 20: RETURN
2230 PLAYER.RM = NR: PLAYER.Y = 2
2240 RETURN
2250 REM
2300 REM === ROOM TRANSITION: LEFT ===
2310 NR = RM.LF(PLAYER.RM)
2320 IF NR = 0 THEN PLAYER.X = 1: RETURN
2330 PLAYER.RM = NR: PLAYER.X = 19
2340 RETURN
2350 REM
2400 REM === ROOM TRANSITION: RIGHT ===
2410 NR = RM.RT(PLAYER.RM)
2420 IF NR = 0 THEN PLAYER.X = 20: RETURN
2430 PLAYER.RM = NR: PLAYER.X = 2
2440 RETURN
2450 REM
2500 REM === WALL COLLISION (simplified) ===
2510 REM Keep player in bounds
2520 IF PLAYER.X < 1 THEN PLAYER.X = 1
2530 IF PLAYER.X > 20 THEN PLAYER.X = 20
2540 IF PLAYER.Y < 1 THEN PLAYER.Y = 1
2550 IF PLAYER.Y > 20 THEN PLAYER.Y = 20
2560 RETURN
2570 REM
2600 REM === ITEM PICKUP ===
2610 IF PLAYER.CARRY > 0 THEN RETURN
2620 FOR I = 1 TO MAX.OBJ
2630   IF OB.RM(I) <> PLAYER.RM THEN 2670
2640   IF ABS(OB.X(I) - PLAYER.X) > 1 THEN 2670
2650   IF ABS(OB.Y(I) - PLAYER.Y) > 1 THEN 2670
2660   REM Can't pick up dead dragons
2665   IF I >= O.YORGLE AND I <= O.RHINDLE AND DR.ST(I - O.YORGLE + 1) = 2 THEN 2670
2666   PLAYER.CARRY = I
2667   OB.RM(I) = 0
2668   SOUND 800, 1
2669   RETURN
2670 NEXT I
2680 RETURN
2690 REM
2700 REM === GATE CHECK ===
2710 REM Gold gate
2720 IF PLAYER.CARRY = O.GOLDKEY AND PLAYER.RM = R.GOLD.OUT THEN
2730   IF PLAYER.Y <= 3 THEN GATE(1) = 1: SOUND 600, 1
2740 END IF
2750 IF PLAYER.CARRY = O.BLACKKEY AND PLAYER.RM = R.BLACK.OUT THEN
2760   IF PLAYER.Y <= 3 THEN GATE(2) = 1: SOUND 600, 1
2770 END IF
2780 IF PLAYER.CARRY = O.WHITEKEY AND PLAYER.RM = R.WHITE.OUT THEN
2790   IF PLAYER.Y <= 3 THEN GATE(3) = 1: SOUND 600, 1
2800 END IF
2810 RETURN
2820 REM
2800 REM === DRAGON AI ===
2810 FOR D = 1 TO 3
2820   IF DR.ST(D) <> 1 THEN 2895
2830   DI = O.YORGLE + D - 1
2840   IF OB.RM(DI) = 0 THEN 2895: REM being carried
2850   REM Check if player has sword
2860   IF PLAYER.CARRY = O.SWORD THEN
2870     IF OB.RM(DI) = PLAYER.RM THEN
2880       IF ABS(OB.X(DI) - PLAYER.X) < 3 AND ABS(OB.Y(DI) - PLAYER.Y) < 3 THEN
2885         DR.ST(D) = 2: SOUND 200, 3: SC = SC + 100
2886         GOTO 2895
2887       END IF
2888     END IF
2889   END IF
2890   REM Dragon movement toward player
2891   IF OB.RM(DI) = PLAYER.RM THEN
2892     IF RND(1) < 0.3 THEN
2893       IF OB.X(DI) < PLAYER.X THEN OB.X(DI) = OB.X(DI) + 1
2894       IF OB.X(DI) > PLAYER.X THEN OB.X(DI) = OB.X(DI) - 1
2895       IF OB.Y(DI) < PLAYER.Y THEN OB.Y(DI) = OB.Y(DI) + 1
2896       IF OB.Y(DI) > PLAYER.Y THEN OB.Y(DI) = OB.Y(DI) - 1
2897     END IF
2898     REM Check if dragon eats player
2899     IF ABS(OB.X(DI) - PLAYER.X) < 2 AND ABS(OB.Y(DI) - PLAYER.Y) < 2 THEN
2900       IF PLAYER.CARRY <> O.SWORD THEN
2901         PLAYER.DEAD = 1: EATEN.BY = D
2902         DR.ST(D) = 3
2903         SOUND 100, 5
2904       END IF
2905     END IF
2906   ELSE
2907     REM Dragon roams toward its guarded room
2908     IF RND(1) < 0.05 THEN
2909       OB.RM(DI) = DR.TG(D)
2910       OB.X(DI) = INT(RND(1) * 16) + 3
2911       OB.Y(DI) = INT(RND(1) * 16) + 3
2912     END IF
2913   END IF
2914   REM Yorgle fears the Gold Key
2915   IF D = 1 AND PLAYER.CARRY = O.GOLDKEY THEN
2916     IF OB.RM(DI) = PLAYER.RM THEN
2917       IF OB.X(DI) < PLAYER.X THEN OB.X(DI) = OB.X(DI) - 2
2918       IF OB.X(DI) > PLAYER.X THEN OB.X(DI) = OB.X(DI) + 2
2919     END IF
2920   END IF
2921 NEXT D
2930 RETURN
2940 REM
2900 REM === BAT AI ===
2910 IF OB.RM(O.BAT) <> PLAYER.RM THEN RETURN
2920 IF RND(1) < 0.02 THEN
2930   REM Bat tries to swap items
2940   IF PLAYER.CARRY > 0 AND PLAYER.CARRY <> O.BAT THEN
2950     REM Pick a random object to swap with
2960     SW = INT(RND(1) * MAX.OBJ) + 1
2970     IF SW <> O.BAT AND SW <> PLAYER.CARRY AND OB.RM(SW) = PLAYER.RM THEN
2980       OB.RM(PLAYER.CARRY) = PLAYER.RM
2990       OB.X(PLAYER.CARRY) = OB.X(O.BAT)
2991       OB.Y(PLAYER.CARRY) = OB.Y(O.BAT)
2992       PLAYER.CARRY = 0
2993       SOUND 300, 1
2994     END IF
2995   END IF
2996 END IF
2997 REM Bat moves randomly
2998 IF RND(1) < 0.2 THEN
2999   OB.X(O.BAT) = OB.X(O.BAT) + INT(RND(1)*5) - 2
3000   OB.Y(O.BAT) = OB.Y(O.BAT) + INT(RND(1)*5) - 2
3001   IF OB.X(O.BAT) < 2 THEN OB.X(O.BAT) = 2
3002   IF OB.X(O.BAT) > 19 THEN OB.X(O.BAT) = 19
3003   IF OB.Y(O.BAT) < 2 THEN OB.Y(O.BAT) = 2
3004   IF OB.Y(O.BAT) > 19 THEN OB.Y(O.BAT) = 19
3005 END IF
3006 REM Bat room changes
3007 IF RND(1) < 0.01 THEN
3008   OB.RM(O.BAT) = INT(RND(1) * 23) + 1
3009 END IF
3010 RETURN
3020 REM
3000 REM === PLAYER DIED (eaten by dragon) ===
3010 CLS
3020 COLOR 12, 0
3030 DN$ = "a Dragon"
3040 IF EATEN.BY = 1 THEN DN$ = "Yorgle the Yellow Dragon"
3050 IF EATEN.BY = 2 THEN DN$ = "Grundle the Green Dragon"
3060 IF EATEN.BY = 3 THEN DN$ = "Rhindle the Red Dragon"
3070 LOCATE 10, 15
3080 PRINT "You have been eaten by "; DN$; "!"
3090 LOCATE 14, 20
3100 PRINT "Press R to reincarnate..."
3110 K$ = ""
3120 WHILE K$ <> "r" AND K$ <> "R"
3130   K$ = INKEY$
3140 WEND
3150 GOSUB 3500
3160 RETURN
3170 REM
3500 REM === REINCARNATE ===
3510 PLAYER.RM = R.GOLD.OUT
3520 PLAYER.X = 10: PLAYER.Y = 15
3530 PLAYER.DEAD = 0: EATEN.BY = 0
3540 REM Reincarnate all dragons too
3550 FOR D = 1 TO 3
3560   IF DR.ST(D) = 2 OR DR.ST(D) = 3 THEN DR.ST(D) = 1
3570 NEXT D
3580 RETURN
3590 REM
3800 REM === YOU WIN ===
3810 CLS
3820 COLOR 14, 0
3830 LOCATE 4, 15
3840 PRINT CHR$(201); STRING$(50, CHR$(205)); CHR$(187)
3850 FOR I = 5 TO 18
3860   LOCATE I, 15: PRINT CHR$(186);
3870   LOCATE I, 66: PRINT CHR$(186);
3880 NEXT I
3890 LOCATE 19, 15
3900 PRINT CHR$(200); STRING$(50, CHR$(205)); CHR$(188)
3910 COLOR 14, 0
3920 LOCATE 7, 25: PRINT "V I C T O R Y !"
3930 COLOR 15, 0
3940 LOCATE 9, 20: PRINT "You have returned the Enchanted"
3950 LOCATE 10, 20: PRINT "Chalice to the Golden Castle!"
3960 COLOR 6, 0
3970 LOCATE 12, 35: PRINT CHR$(232)
3980 COLOR 14, 0
3990 LOCATE 12, 33: PRINT "{ "; CHR$(232); " }"
3991 COLOR 7, 0
3992 LOCATE 15, 20: PRINT "The Kingdom is saved!"
3993 LOCATE 17, 22: PRINT "Press any key..."
3994 K$ = "": WHILE K$ = "": K$ = INKEY$: WEND
3995 CLS: CURSOR ON: END
3996 REM
4000 REM === QUIT ===
4010 CURSOR ON: CLS
4020 PRINT "Thanks for playing Adventure!"
4030 END
4040 REM
