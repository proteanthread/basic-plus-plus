10 REM =============================================
REM ==================================================
REM  EXHAUSTIVE DOCUMENTATION
REM ==================================================
REM  This file is a standalone Game Engine for BASIC++.
REM  It operates strictly within the text UI (TUI) and relies on external
REM  mechanics libraries for its game loop. 
REM  Key Components:
REM  - Initialization: Sets up the visual buffer and arrays.
REM  - Main Loop: Uses a non-blocking INKEY$ loop synced with the TICKS timer.
REM  - Collision/Movement: Delegated to the imported library.
REM  - Save/Load: Invoked via GOSUB 8000 and 8100, saving to .sav files.
REM ==================================================
20 REM  SOLITAIRE (KLONDIKE) ENGINE
30 REM  Uses BOARDGAME.LIB for mechanics.
40 REM  Arrow keys navigate, SPACE select/place
50 REM  D to draw from deck, ESC quit
60 REM  Press S to Save, L to Load
70 REM =============================================
80 LOAD LIBRARY "lib\boardgame.LIB"
90 RANDOMIZE TIMER
100 PRINT CHR$(27);"[?25l";
110 DIM TBL(7, 20), TABSZ(7), TABFACE(7)
120 DIM FOUND(4), WASTE(24), STOCK(24)
130 CUR_X = 1: CUR_Y = 1: SEL_C = -1: SEL_R = -1: MOVES = 0
140 CALL BG_INIT_DECK(52)
150 CALL BG_SHUFFLE_DECK()
160 DI = 0
170 FOR C = 1 TO 7
180   TABSZ(C) = C: TABFACE(C) = C
190   FOR R = 1 TO C: TBL(C, R) = BG_ARRAY(DI): DI = DI + 1: NEXT R
200 NEXT C
210 STOCKSZ = 0: FOR I = DI TO 51: STOCKSZ = STOCKSZ + 1: STOCK(STOCKSZ) = BG_ARRAY(I): NEXT I
220 WASTESZ = 0: FOR I = 1 TO 4: FOUND(I) = -1: NEXT I
230 CLS: COLOR 15, 0: LOCATE 1, 1: PRINT "KLONDIKE SOLITAIRE";
240 LOCATE 1, 40: PRINT "Moves:"; MOVES;
250 LOCATE 1, 60: PRINT "ESC=Quit D=Draw";
260 COLOR 8, 0: LOCATE 2, 1: PRINT STRING$(80, CHR$(196));
270 GOSUB 1000
280 REM ========== MAIN GAME LOOP ==========
290 K$ = INKEY$: IF K$ = "" THEN 290
300 IF K$ = CHR$(27) THEN 2000
310 IF UCASE$(K$) = "S" THEN GOSUB 8200: GOTO 290
320 IF UCASE$(K$) = "L" THEN GOSUB 8300: GOTO 290
330 SK = 0 : IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1))
340 CX = CUR_X: CY = CUR_Y: CALL BG_MOVE_CURSOR(SK, 1, 7, 1, 13): CUR_X = CX: CUR_Y = CY
350 IF UCASE$(K$) = "D" THEN GOSUB 1500
360 IF K$ = " " THEN GOSUB 1600
370 IF UCASE$(K$) = "F" THEN GOSUB 1700
380 GOSUB 1000
390 WIN = 1: FOR I = 1 TO 4: IF FOUND(I) < 12 THEN WIN = 0
400 NEXT I: IF WIN = 1 THEN 1900
410 GOTO 290
1000 REM === Draw everything ===
1010 COLOR 7, 0: LOCATE 3, 2
1020 CH$ = "[  ]" : IF STOCKSZ > 0 THEN COLOR 2, 0: CH$ = "[##]"
1030 PRINT CH$;
1040 LOCATE 3, 8: PRINT "[  ]"; : IF WASTESZ > 0 THEN GOSUB 1300
1050 FOR I = 1 TO 4
1060   LOCATE 3, 20 + I * 7
1070   IF FOUND(I) >= 0 THEN CV = I * 13 + FOUND(I): GOSUB 1400 ELSE COLOR 8, 0: PRINT "[  ]";
1080 NEXT I
1090 FOR C = 1 TO 7
1100   FOR R = 1 TO TABSZ(C)
1110     LOCATE 5 + R, C * 9 - 4
1120     IF R < TABFACE(C) THEN COLOR 2, 0: PRINT "## "; ELSE CV = TBL(C, R): GOSUB 1400
1130   NEXT R
1140   FOR R = TABSZ(C) + 1 TO 15: LOCATE 5 + R, C * 9 - 4: PRINT "   ";: NEXT R
1150   IF TABSZ(C) = 0 THEN LOCATE 6, C * 9 - 4: COLOR 8, 0: PRINT "[ ]";
1160 NEXT C
1170 COLOR 15, 0: IF CUR_Y = 1 THEN LOCATE 3, CUR_X * 9 - 4 ELSE LOCATE 5 + CUR_Y - 1, CUR_X * 9 - 4
1180 PRINT ">";
1190 LOCATE 1, 47: COLOR 15, 0: PRINT MOVES; "   ";
1200 RETURN
1300 REM === Draw waste top ===
1310 CV = WASTE(WASTESZ): GOSUB 1400: RETURN
1400 REM === Draw a card ===
1410 CALL BG_GET_CARD_STR(CV)
1420 COLOR BG_RET_COL(1), 0: PRINT BG_RET_STR$(1); " ";: RETURN
1500 REM === Draw from stock ===
1510 IF STOCKSZ = 0 THEN FOR I = WASTESZ TO 1 STEP -1: STOCKSZ = STOCKSZ + 1: STOCK(STOCKSZ) = WASTE(I): NEXT I: WASTESZ = 0: RETURN
1520 WASTESZ = WASTESZ + 1: WASTE(WASTESZ) = STOCK(STOCKSZ): STOCKSZ = STOCKSZ - 1: MOVES = MOVES + 1: RETURN
1600 REM === Select / Place card ===
1610 IF SEL_C = -1 THEN SEL_C = CUR_X: SEL_R = CUR_Y: RETURN
1620 MOVES = MOVES + 1: SEL_C = -1: SEL_R = -1: RETURN
1700 REM === Auto-move to foundation ===
1710 FOR C = 1 TO 7
1720   IF TABSZ(C) = 0 THEN 1780
1730   CV = TBL(C, TABSZ(C)): SU = CV \ 13: RK = CV MOD 13
1740   IF FOUND(SU + 1) = RK - 1 OR (RK = 0 AND FOUND(SU + 1) = -1) THEN
1750     FOUND(SU + 1) = RK: TABSZ(C) = TABSZ(C) - 1
1760     IF TABFACE(C) > TABSZ(C) AND TABSZ(C) > 0 THEN TABFACE(C) = TABSZ(C)
1770     MOVES = MOVES + 1
1780   END IF
1790 NEXT C: RETURN
1900 REM === YOU WIN ===
1910 CLS: COLOR 14, 0: LOCATE 10, 25: PRINT "C O N G R A T U L A T I O N S !"
1920 LOCATE 12, 25: PRINT "You won in"; MOVES; "moves!"
1930 LOCATE 16, 25: PRINT "Press any key...": GOSUB 9990: CLS: END
2000 REM === QUIT ===
2010 CURSOR ON: CLS: PRINT "Thanks for playing Solitaire!": PRINT "Moves:"; MOVES: END
8200 REM === SAVE GAME ===
8210 OPEN "solitaire.sav" FOR OUTPUT AS #1
8220 PRINT #1, MOVES: PRINT #1, STOCKSZ: PRINT #1, WASTESZ
8230 FOR I = 1 TO 4: PRINT #1, FOUND(I): NEXT I
8240 FOR C = 1 TO 7: PRINT #1, TABSZ(C): PRINT #1, TABFACE(C)
8250 FOR R = 1 TO 20: PRINT #1, TBL(C, R): NEXT R: NEXT C
8260 FOR I = 1 TO 24: PRINT #1, STOCK(I): PRINT #1, WASTE(I): NEXT I
8270 CLOSE #1: COLOR 14, 0: LOCATE 12, 30: PRINT "GAME SAVED!": DELAY 1000: CLS: GOSUB 1000: RETURN
8300 REM === LOAD GAME ===
8310 IF EXIST("solitaire.sav") THEN
8320   OPEN "solitaire.sav" FOR INPUT AS #1
8330   INPUT #1, MOVES: INPUT #1, STOCKSZ: INPUT #1, WASTESZ
8340   FOR I = 1 TO 4: INPUT #1, FOUND(I): NEXT I
8350   FOR C = 1 TO 7: INPUT #1, TABSZ(C): INPUT #1, TABFACE(C)
8360   FOR R = 1 TO 20: INPUT #1, TBL(C, R): NEXT R: NEXT C
8370   FOR I = 1 TO 24: INPUT #1, STOCK(I): INPUT #1, WASTE(I): NEXT I
8380   CLOSE #1: CLS: GOSUB 1000
8390 END IF
8400 RETURN

9990 K$ = INKEY$: IF K$ = "" THEN 9990 ELSE RETURN
9992 K$ = INKEY$: IF K$ <> " " THEN 9992 ELSE RETURN
9994 K$ = INKEY$: IF K$ <> "r" AND K$ <> "R" THEN 9994 ELSE RETURN
