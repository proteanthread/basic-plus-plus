10 REM =============================================
20 REM  DONKEY KONG - BASIC++ Text Game
30 REM  Arrow keys move, SPACE to jump, ESC quit
40 REM =============================================
50 RANDOMIZE TIMER
60 CURSOR OFF
70 REM --- Constants ---
80 CONST MAX.BARRELS = 6
90 CONST GRAVITY = 1
100 CONST JUMP.VEL = -3
110 REM --- Platform layout (row positions) ---
120 DIM PL.Y(6), PL.X1(6), PL.X2(6), PL.DIR(6)
130 PL.Y(1) = 22: PL.X1(1) = 1: PL.X2(1) = 78: PL.DIR(1) = 1
140 PL.Y(2) = 18: PL.X1(2) = 5: PL.X2(2) = 78: PL.DIR(2) = -1
150 PL.Y(3) = 14: PL.X1(3) = 1: PL.X2(3) = 74: PL.DIR(3) = 1
160 PL.Y(4) = 10: PL.X1(4) = 5: PL.X2(4) = 78: PL.DIR(4) = -1
170 PL.Y(5) = 6: PL.X1(5) = 1: PL.X2(5) = 74: PL.DIR(5) = 1
180 PL.Y(6) = 3: PL.X1(6) = 30: PL.X2(6) = 50: PL.DIR(6) = 0
190 REM --- Ladder positions (col, top_row, bot_row) ---
200 DIM LD.X(8), LD.Y1(8), LD.Y2(8)
210 LD.X(1) = 72: LD.Y1(1) = 18: LD.Y2(1) = 22
220 LD.X(2) = 10: LD.Y1(2) = 14: LD.Y2(2) = 18
230 LD.X(3) = 68: LD.Y1(3) = 10: LD.Y2(3) = 14
240 LD.X(4) = 12: LD.Y1(4) = 6: LD.Y2(4) = 10
250 LD.X(5) = 40: LD.Y1(5) = 3: LD.Y2(5) = 6
260 NLADDERS = 5
270 REM --- Barrel state ---
280 DIM BR.X(MAX.BARRELS), BR.Y(MAX.BARRELS)
290 DIM BR.D(MAX.BARRELS), BR.A(MAX.BARRELS)
300 REM --- Player state ---
310 PX = 5: PY = 21: VY = 0: JUMPING = 0
320 ON.LADDER = 0
330 SC = 0: LV = 3: LVL = 1
340 REM
350 REM --- Draw screen ---
360 CLS
370 COLOR 15, 1
380 LOCATE 1, 1: PRINT STRING$(80, " ");
390 LOCATE 1, 2: PRINT "DONKEY KONG";
400 LOCATE 1, 25: PRINT "Score:"; SC;
410 LOCATE 1, 55: PRINT "Lives: "; STRING$(LV, CHR$(3));
420 REM Draw platforms
430 FOR P = 1 TO 6
440   COLOR 6, 0
450   LOCATE PL.Y(P), PL.X1(P)
460   FOR C = PL.X1(P) TO PL.X2(P)
470     PRINT CHR$(205);
480   NEXT C
490 NEXT P
500 REM Draw ladders
510 COLOR 3, 0
520 FOR L = 1 TO NLADDERS
530   FOR R = LD.Y1(L) TO LD.Y2(L) - 1
540     LOCATE R, LD.X(L)
550     PRINT "H";
560   NEXT R
570 NEXT L
580 REM Draw DK
590 COLOR 4, 0
600 LOCATE 2, 5
610 PRINT "DK";
620 REM Draw princess
630 COLOR 13, 0
640 LOCATE 2, 40
650 PRINT CHR$(2);
660 REM
670 REM ========== MAIN GAME LOOP ==========
680 GFT = TICKS
690 REM --- Read input ---
700 K$ = INKEY$
710 IF K$ = CHR$(27) THEN 2000
720 IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1)) ELSE SK = 0
730 REM Left/Right
740 IF SK = 75 AND PX > 2 THEN GOSUB 1100
750 IF SK = 77 AND PX < 78 THEN GOSUB 1150
760 REM Up/Down ladder
770 IF SK = 72 THEN GOSUB 1200
780 IF SK = 80 THEN GOSUB 1250
790 REM Jump
800 IF K$ = " " AND JUMPING = 0 AND ON.LADDER = 0 THEN VY = JUMP.VEL: JUMPING = 1
810 REM
820 REM --- Apply gravity ---
830 IF JUMPING = 1 AND ON.LADDER = 0 THEN
840   COLOR 0, 0: LOCATE PY, PX: PRINT " ";
850   PY = PY + VY
860   VY = VY + GRAVITY
870   REM Check landing
880   FOR P = 1 TO 6
890     IF PY >= PL.Y(P) - 1 AND PY <= PL.Y(P) THEN
900       IF PX >= PL.X1(P) AND PX <= PL.X2(P) THEN
910         PY = PL.Y(P) - 1: VY = 0: JUMPING = 0
920       END IF
930     END IF
940   NEXT P
950   IF PY > 23 THEN PY = 21: VY = 0: JUMPING = 0
960 END IF
970 REM
980 REM --- Draw player ---
990 COLOR 11, 0
1000 LOCATE PY, PX
1010 PRINT CHR$(2);
1020 REM
1030 REM --- Spawn barrels ---
1040 IF RND(1) < 0.03 THEN GOSUB 1300
1050 REM --- Move barrels ---
1060 FOR I = 1 TO MAX.BARRELS
1070   IF BR.A(I) = 0 THEN 1095
1080   COLOR 0, 0: LOCATE BR.Y(I), BR.X(I): PRINT " ";
1085   BR.X(I) = BR.X(I) + BR.D(I)
1086   REM Check barrel off platform
1087   ONPLAT = 0
1088   FOR P = 1 TO 5
1089     IF BR.Y(I) = PL.Y(P) - 1 AND BR.X(I) >= PL.X1(P) AND BR.X(I) <= PL.X2(P) THEN ONPLAT = 1
1090   NEXT P
1091   IF ONPLAT = 0 THEN BR.Y(I) = BR.Y(I) + 1: BR.D(I) = -BR.D(I)
1092   IF BR.Y(I) > 23 THEN BR.A(I) = 0
1093   IF BR.A(I) = 1 THEN COLOR 4, 0: LOCATE BR.Y(I), BR.X(I): PRINT "o";
1094   REM Collision with player
1095   IF BR.A(I) = 1 AND BR.Y(I) = PY AND ABS(BR.X(I) - PX) < 2 THEN GOSUB 1400
1096 NEXT I
1097 REM
1098 REM --- Check win (reach top) ---
1099 IF PY <= 3 AND PX >= 30 AND PX <= 50 THEN GOSUB 1500: GOTO 350
1100 REM --- Update HUD ---
1101 COLOR 15, 1
1102 LOCATE 1, 32: PRINT SC; "   ";
1103 REM --- Frame wait ---
1104 GT2 = TICKS: GT1 = GT2 - GFT
1105 IF GT1 < 100 THEN DELAY 100 - GT1
1106 GFT = TICKS
1107 GOTO 680
1108 REM
1100 REM === Move left ===
1110 COLOR 0, 0: LOCATE PY, PX: PRINT " ";
1120 PX = PX - 1
1130 RETURN
1140 REM
1150 REM === Move right ===
1160 COLOR 0, 0: LOCATE PY, PX: PRINT " ";
1170 PX = PX + 1
1180 RETURN
1190 REM
1200 REM === Climb up ===
1210 REM Check if on ladder
1220 FOR L = 1 TO NLADDERS
1230   IF PX = LD.X(L) AND PY > LD.Y1(L) AND PY <= LD.Y2(L) THEN
1240     COLOR 0, 0: LOCATE PY, PX: PRINT " ";
1245     PY = PY - 1: ON.LADDER = 1: RETURN
1250   END IF
1260 NEXT L
1265 RETURN
1270 REM
1250 REM === Climb down ===
1260 FOR L = 1 TO NLADDERS
1270   IF PX = LD.X(L) AND PY >= LD.Y1(L) AND PY < LD.Y2(L) THEN
1280     COLOR 0, 0: LOCATE PY, PX: PRINT " ";
1285     PY = PY + 1: ON.LADDER = 1: RETURN
1290   END IF
1295 NEXT L
1296 ON.LADDER = 0
1297 RETURN
1300 REM === Spawn barrel ===
1310 FOR I = 1 TO MAX.BARRELS
1320   IF BR.A(I) = 1 THEN 1350
1330   BR.X(I) = 7: BR.Y(I) = 5: BR.D(I) = 1: BR.A(I) = 1
1340   RETURN
1350 NEXT I
1360 RETURN
1400 REM === Player hit ===
1410 LV = LV - 1
1420 SOUND 200, 3
1430 COLOR 15, 4: LOCATE PY, PX: PRINT "X";
1440 DELAY 1000
1450 IF LV <= 0 THEN 2000
1460 PX = 5: PY = 21: VY = 0: JUMPING = 0
1470 RETURN
1500 REM === Level complete ===
1510 SC = SC + 500
1520 LVL = LVL + 1
1530 COLOR 14, 0
1540 LOCATE 12, 30: PRINT "LEVEL "; LVL; " !"
1550 SOUND 800, 2
1560 DELAY 2000
1570 PX = 5: PY = 21
1580 FOR I = 1 TO MAX.BARRELS: BR.A(I) = 0: NEXT I
1590 RETURN
2000 REM === GAME OVER ===
2010 CURSOR ON: CLS
2020 COLOR 14, 0
2030 LOCATE 10, 25: PRINT "G A M E   O V E R"
2040 LOCATE 12, 25: PRINT "Score: "; SC
2050 LOCATE 16, 25: PRINT "Press any key..."
2060 K$ = "": WHILE K$ = "": K$ = INKEY$: WEND
2070 CLS: END
