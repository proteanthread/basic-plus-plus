10 REM =============================================
REM ==================================================
REM  EXHAUSTIVE DOCUMENTATION
REM ==================================================
REM  This file is a standalone Game Engine for BASIC++.
REM  It operates strictly within the text UI (TUI) and relies on external
REM  mechanics libraries for its game loop. 
REM  Key Components:
REM  - Initialization: Sets up the visual buffer and arrays.
REM  - Main Loop: Uses a non-blocking INKEY$ loop synced with the TICKS timer.
REM  - Collision/Movement: Delegated to the imported library.
REM  - Save/Load: Invoked via GOSUB 8000 and 8100, saving to .sav files.
REM ==================================================
20 REM  MARIO BROTHERS ENGINE
30 REM  Uses PLATFORMER.LIB for mechanics.
40 REM  Arrow keys move, SPACE to jump, ESC quit
50 REM  Press S to Save, L to Load
60 REM =============================================
70 LOAD LIBRARY "lib\platformer.LIB"
80 RANDOMIZE TIMER
90 PRINT CHR$(27);"[?25l";
100 CONST MAX_ENEMY = 8
110 CALL PLAT_INIT(3, 0)
120 CALL PLAT_ADD(22, 1, 80)
130 CALL PLAT_ADD(15, 10, 70)
140 CALL PLAT_ADD(8, 20, 60)
150 PX = 10: PY = 21: VY = 0: JUMPING = 0
160 SC = 0: LV = 3: LVL = 1: PHASE = 0
170 POW_X = 40: POW_Y = 14: POW_CT = 3
180 DIM EN_X(MAX_ENEMY), EN_Y(MAX_ENEMY), EN_D(MAX_ENEMY), EN_A(MAX_ENEMY)
190 DIM EN_T(MAX_ENEMY), EN_F(MAX_ENEMY)
200 ESPAWN = 0
210 CLS
220 COLOR 15, 1: LOCATE 1, 1: PRINT STRING$(80, " ");
230 LOCATE 1, 2: PRINT "MARIO BROS";
240 LOCATE 1, 25: PRINT "Score:"; SC;
250 LOCATE 1, 45: PRINT "Phase:"; LVL;
260 LOCATE 1, 60: PRINT "Lives: "; STRING$(LV, CHR$(3));
270 CALL PLAT_DRAW_PLATS(6, 0)
280 COLOR 2, 0: LOCATE 21, 1: PRINT CHR$(186);: LOCATE 20, 1: PRINT CHR$(186);
290 LOCATE 21, 80: PRINT CHR$(186);: LOCATE 20, 80: PRINT CHR$(186);
300 IF POW_CT > 0 THEN COLOR 15, 4: LOCATE POW_Y, POW_X - 1: PRINT "POW";
310 REM ========== MAIN GAME LOOP ==========
320 GFT = TICKS
330 K$ = INKEY$
340 IF K$ = CHR$(27) THEN 9000
350 IF UCASE$(K$) = "S" THEN GOSUB 8000
360 IF UCASE$(K$) = "L" THEN GOSUB 8100
370 SK = 0 : IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1))
380 IF SK = 75 THEN COLOR 0, 0: LOCATE PY, PX: PRINT " ";: PX = PX - 2: IF PX < 1 THEN PX = 80
390 IF SK = 77 THEN COLOR 0, 0: LOCATE PY, PX: PRINT " ";: PX = PX + 2: IF PX > 80 THEN PX = 1
400 IF K$ = " " AND JUMPING = 0 THEN VY = -3: JUMPING = 1
410 IF JUMPING = 1 THEN COLOR 0, 0: LOCATE PY, PX: PRINT " ";
420 HIT_PLAT = 0
430 CALL PLAT_PHYSICS_MARIO(PX, PY, VY, JUMPING, 1, HIT_PLAT)
440 IF HIT_PLAT > 0 THEN GOSUB 1200
450 COLOR 12, 0: LOCATE PY, PX: PRINT CHR$(2);
460 ESPAWN = ESPAWN + 1
470 IF ESPAWN > 60 - LVL * 5 THEN GOSUB 1300: ESPAWN = 0
480 FOR I = 1 TO MAX_ENEMY
490   IF EN_A(I) = 1 THEN
500     COLOR 0, 0: LOCATE EN_Y(I), EN_X(I): PRINT " ";
510     EN_X(I) = EN_X(I) + EN_D(I)
520     IF EN_X(I) < 1 THEN EN_X(I) = 80
530     IF EN_X(I) > 80 THEN EN_X(I) = 1
540     COLOR 13, 0 : IF EN_T(I) = 1 THEN COLOR 10, 0
550     IF EN_F(I) = 1 THEN COLOR 9, 0
560     LOCATE EN_Y(I), EN_X(I): CH$ = CHR$(234) : IF EN_F(I) = 1 THEN CH$ = CHR$(15)
570     PRINT CH$;
580     IF ABS(EN_X(I) - PX) < 2 AND EN_Y(I) = PY THEN
590       IF EN_F(I) = 1 THEN
600         EN_A(I) = 0: SC = SC + 100: SOUND 1000, 1
610       ELSE
620         GOSUB 1400
630       END IF
640     END IF
650   END IF
660 NEXT I
670 IF JUMPING = 1 AND VY < 0 AND PY = POW_Y + 1 THEN IF ABS(PX - POW_X) < 3 AND POW_CT > 0 THEN GOSUB 1500
680 COLOR 15, 1: LOCATE 1, 32: PRINT SC; "   ";
690 GT2 = TICKS: GT1 = GT2 - GFT
700 IF GT1 < 100 THEN DELAY 100 - GT1
710 GOTO 320
1200 REM === Bump from below ===
1210 FOR I = 1 TO MAX_ENEMY
1220   IF EN_A(I) = 1 AND EN_Y(I) = PY - 1 AND ABS(EN_X(I) - PX) < 5 THEN EN_F(I) = 1: SC = SC + 10
1230 NEXT I
1240 RETURN
1300 REM === Spawn enemy ===
1310 FOR I = 1 TO MAX_ENEMY
1320   IF EN_A(I) = 0 THEN
1330     EN_X(I) = 80: EN_D(I) = -1 : IF RND(1) < 0.5 THEN EN_X(I) = 1: EN_D(I) = 1
1340     EN_Y(I) = 21: EN_T(I) = INT(RND(1) * 2) + 1: EN_F(I) = 0: EN_A(I) = 1: RETURN
1350   END IF
1360 NEXT I
1370 RETURN
1400 REM === Mario hit ===
1410 LV = LV - 1: SOUND 200, 3: COLOR 15, 4: LOCATE PY, PX: PRINT "X";: DELAY 1000
1420 IF LV <= 0 THEN 9000
1430 PX = 10: PY = 21: VY = 0: JUMPING = 0: RETURN
1500 REM === POW block ===
1510 POW_CT = POW_CT - 1: SOUND 300, 2
1520 FOR I = 1 TO MAX_ENEMY
1530   IF EN_A(I) = 1 THEN EN_F(I) = 1
1540 NEXT I
1550 IF POW_CT = 0 THEN COLOR 0, 0: LOCATE POW_Y, POW_X - 1: PRINT "   ";
1560 RETURN
8000 REM === Save Game ===
8010 OPEN "mario.sav" FOR OUTPUT AS #1
8020 PRINT #1, SC: PRINT #1, LV: PRINT #1, LVL
8030 CLOSE #1
8040 COLOR 14, 0: LOCATE 12, 30: PRINT "GAME SAVED!": DELAY 1000: RETURN
8100 REM === Load Game ===
8110 IF EXIST("mario.sav") THEN
8120   OPEN "mario.sav" FOR INPUT AS #1
8130   INPUT #1, SC: INPUT #1, LV: INPUT #1, LVL
8140   CLOSE #1
8150 END IF
8160 RETURN
9000 REM === GAME OVER ===
9010 CURSOR ON: CLS: COLOR 12, 0: LOCATE 10, 25: PRINT "G A M E   O V E R"
9020 LOCATE 12, 25: PRINT "Score: "; SC
9030 LOCATE 16, 25: PRINT "Press any key...": GOSUB 9990
9040 CLS: END

9990 K$ = INKEY$: IF K$ = "" THEN 9990 ELSE RETURN
9992 K$ = INKEY$: IF K$ <> " " THEN 9992 ELSE RETURN
9994 K$ = INKEY$: IF K$ <> "r" AND K$ <> "R" THEN 9994 ELSE RETURN
