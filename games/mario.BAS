10 REM =============================================
20 REM  MARIO BROTHERS - BASIC++ Text Game
30 REM  Arrow keys move, SPACE to jump, ESC quit
40 REM  Bump enemies from below to flip them,
50 REM  then kick them off the platform!
60 REM =============================================
70 RANDOMIZE TIMER
80 PRINT CHR$(27);"[?25l";
90 REM --- Constants ---
100 CONST MAX_ENEMY = 8
110 CONST PLAT1 = 22
120 CONST PLAT2 = 15
130 CONST PLAT3 = 8
140 REM --- Platform layout ---
150 REM Platform 1: ground level
160 REM Platform 2: middle tier
170 REM Platform 3: top tier
180 REM Pipes at edges spawn enemies
190 REM --- Player state ---
200 PX = 10: PY = PLAT1 - 1
210 VY = 0: JUMPING = 0
220 SC = 0: LV = 3: LVL = 1
230 PHASE = 0
240 REM --- POW block ---
250 POW_X = 40: POW_Y = PLAT2 - 1: POW_CT = 3
260 REM --- Enemy state ---
270 DIM EN_X(MAX_ENEMY), EN_Y(MAX_ENEMY)
280 DIM EN_D(MAX_ENEMY), EN_A(MAX_ENEMY)
290 DIM EN_T(MAX_ENEMY), EN_F(MAX_ENEMY)
300 REM EN.T = type: 1=turtle, 2=crab, 3=fly
310 REM EN.F = flipped (0=normal, 1=flipped)
320 ESPAWN = 0
330 REM
340 REM --- Draw screen ---
350 CLS
360 REM HUD
370 COLOR 15, 1
380 LOCATE 1, 1: PRINT STRING$(80, " ");
390 LOCATE 1, 2: PRINT "MARIO BROS";
400 LOCATE 1, 25: PRINT "Score:"; SC;
410 LOCATE 1, 45: PRINT "Phase:"; LVL;
420 LOCATE 1, 60: PRINT "Lives: "; STRING$(LV, CHR$(3));
430 REM Draw platforms
440 COLOR 6, 0
450 LOCATE PLAT1, 1
460 FOR I = 1 TO 80: PRINT CHR$(205);: NEXT I
470 LOCATE PLAT2, 10
480 FOR I = 10 TO 70: PRINT CHR$(205);: NEXT I
490 LOCATE PLAT3, 20
500 FOR I = 20 TO 60: PRINT CHR$(205);: NEXT I
510 REM Draw pipes
520 COLOR 2, 0
530 LOCATE PLAT1 - 1, 1: PRINT CHR$(186);
540 LOCATE PLAT1 - 2, 1: PRINT CHR$(186);
550 LOCATE PLAT1 - 1, 80: PRINT CHR$(186);
560 LOCATE PLAT1 - 2, 80: PRINT CHR$(186);
570 REM Draw POW block
580 IF POW_CT > 0 THEN
590   COLOR 15, 4
600   LOCATE POW_Y, POW_X - 1
610   PRINT "POW";
620 END IF
630 REM
640 REM ========== MAIN GAME LOOP ==========
650 GFT = TICKS
660 REM --- Input ---
670 K$ = INKEY$
680 IF K$ = CHR$(27) THEN 2000
690 SK = 0 : IF LEN(K$) = 2 THEN SK = ASC(MID$(K$, 2, 1))
700 IF SK = 75 THEN GOSUB 1000
710 IF SK = 77 THEN GOSUB 1050
720 IF K$ = " " AND JUMPING = 0 THEN VY = -3: JUMPING = 1
730 REM
740 REM --- Gravity ---
750 IF JUMPING = 1 THEN
760   COLOR 0, 0: LOCATE PY, PX: PRINT " ";
770   PY = PY + VY: VY = VY + 1
780   REM Check platform landing
790   IF PY >= PLAT1 - 1 THEN PY = PLAT1 - 1: VY = 0: JUMPING = 0: GOTO 870
800   IF PY >= PLAT2 - 1 AND PX >= 10 AND PX <= 70 THEN
810     REM Check if hitting from below
820     IF VY < 0 THEN GOSUB 1200: GOTO 870
830     PY = PLAT2 - 1: VY = 0: JUMPING = 0: GOTO 870
840   END IF
850   IF PY >= PLAT3 - 1 AND PX >= 20 AND PX <= 60 THEN
860     IF VY < 0 THEN GOSUB 1200: GOTO 870
865     PY = PLAT3 - 1: VY = 0: JUMPING = 0
870   END IF
880 END IF
890 REM
900 REM --- Draw Mario ---
910 COLOR 12, 0
920 LOCATE PY, PX
930 PRINT CHR$(2);
940 REM
950 REM --- Spawn enemies ---
960 ESPAWN = ESPAWN + 1
970 IF ESPAWN > 60 - LVL * 5 THEN GOSUB 1300: ESPAWN = 0
980 REM --- Move enemies ---
990 FOR I = 1 TO MAX_ENEMY
991   IF EN_A(I) = 0 THEN 998
992   COLOR 0, 0: LOCATE EN_Y(I), EN_X(I): PRINT " ";
993   EN_X(I) = EN_X(I) + EN_D(I)
994   REM Wrap
995   IF EN_X(I) < 1 THEN EN_X(I) = 80
996   IF EN_X(I) > 80 THEN EN_X(I) = 1
997   REM Draw
998   IF EN_A(I) = 0 THEN 999
999   COLOR 13, 0 : IF EN_T(I) = 1 THEN COLOR 10, 0 : IF EN_F(I) = 1 THEN COLOR 9, 0
1000  LOCATE EN_Y(I), EN_X(I)
1001  CH$ = CHR$(234) : IF EN_F(I) = 1 THEN CH$ = CHR$(15) : PRINT CH$;
1002  REM Check collision with Mario
1003  IF ABS(EN_X(I) - PX) < 2 AND EN_Y(I) = PY THEN
1004    IF EN_F(I) = 1 THEN
1005      REM Kick flipped enemy
1006      EN_A(I) = 0: SC = SC + 100
1007      SOUND 1000, 1
1008    ELSE
1009      GOSUB 1400
1010    END IF
1011  END IF
1012 NEXT I
1013 REM
1014 REM --- Check POW ---
1015 IF JUMPING = 1 AND VY < 0 AND PY = POW_Y + 1 THEN
1016   IF ABS(PX - POW_X) < 3 AND POW_CT > 0 THEN GOSUB 1500
1017 END IF
1018 REM --- Update HUD ---
1019 COLOR 15, 1: LOCATE 1, 32: PRINT SC; "   ";
1020 REM --- Frame wait ---
1021 GT2 = TICKS: GT1 = GT2 - GFT
1022 IF GT1 < 100 THEN DELAY 100 - GT1
1023 GFT = TICKS
1024 GOTO 650
1025 REM
1000 REM === Move left ===
1010 COLOR 0, 0: LOCATE PY, PX: PRINT " ";
1020 PX = PX - 2
1030 IF PX < 1 THEN PX = 80
1040 RETURN
1050 REM === Move right ===
1060 COLOR 0, 0: LOCATE PY, PX: PRINT " ";
1070 PX = PX + 2
1080 IF PX > 80 THEN PX = 1
1090 RETURN
1100 REM
1200 REM === Bump from below ===
1210 REM Flip enemies on platform above
1220 FOR I = 1 TO MAX_ENEMY
1230   IF EN_A(I) = 0 THEN 1260
1240   IF EN_Y(I) = PY - 1 AND ABS(EN_X(I) - PX) < 5 THEN
1250     EN_F(I) = 1: SC = SC + 10
1260   END IF
1270 NEXT I
1280 RETURN
1300 REM === Spawn enemy ===
1310 FOR I = 1 TO MAX_ENEMY
1320   IF EN_A(I) = 1 THEN 1370
1330   EN_X(I) = 80: EN_D(I) = -1 : IF RND(1) < 0.5 THEN EN_X(I) = 1: EN_D(I) = 1
1340   EN_Y(I) = PLAT1 - 1
1350   EN_T(I) = INT(RND(1) * 2) + 1: EN_F(I) = 0
1360   EN_A(I) = 1: RETURN
1370 NEXT I
1380 RETURN
1400 REM === Mario hit ===
1410 LV = LV - 1
1420 SOUND 200, 3
1430 COLOR 15, 4: LOCATE PY, PX: PRINT "X";
1440 DELAY 1000
1450 IF LV <= 0 THEN 2000
1460 PX = 10: PY = PLAT1 - 1: VY = 0: JUMPING = 0
1470 RETURN
1500 REM === POW block ===
1510 POW_CT = POW_CT - 1
1520 SOUND 300, 2
1530 REM Flip ALL enemies
1540 FOR I = 1 TO MAX_ENEMY
1550   IF EN_A(I) = 1 THEN EN_F(I) = 1
1560 NEXT I
1570 IF POW_CT = 0 THEN COLOR 0, 0: LOCATE POW_Y, POW_X - 1: PRINT "   ";
1580 RETURN
2000 REM === GAME OVER ===
2010 CURSOR ON: CLS
2020 COLOR 12, 0
2030 LOCATE 10, 25: PRINT "G A M E   O V E R"
2040 LOCATE 12, 25: PRINT "Score: "; SC
2050 LOCATE 16, 25: PRINT "Press any key..."
2060 K$ = "": WHILE K$ = "": K$ = INKEY$: WEND
2070 CLS: END

