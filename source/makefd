#
# =====================================================================
# makefd -- OpenWatcom Makefile for BASIC++ on FreeDOS
# =====================================================================
#
# USAGE (from the source\ directory):
#   wmake -f makefd              Build 16-bit (default)
#   wmake -f makefd BITS=32      Build 32-bit (DOS/4GW)
#   wmake -f makefd clean        Remove .obj files
#
# Or use build-fd.bat from the project root.
#
# CUSTOMIZATION:
#   Edit the sections below to select dialects, modules, and
#   memory pools. See docs\FreeDOS_Compilation_Guide.md.
#
# =====================================================================

# =====================================================================
# BUILD MODE: 16 or 32
# =====================================================================
# 16 = 16-bit real mode (8086+, large memory model)
#      Runs directly on FreeDOS, limited to 640K conventional memory.
#
# 32 = 32-bit protected mode (386+, flat model, DOS/4GW extender)
#      Access to extended memory beyond 640K. Requires 386 or better.
#
!ifndef BITS
BITS = 16
!endif

# =====================================================================
# DIALECT SELECTION
# =====================================================================
# Uncomment lines below to include additional dialects.
# Each dialect adds approximately 8-12 KB to the binary.
# The default FreeDOS build includes ONLY Palo Alto Tiny BASIC (PATB).
#
# To change the startup dialect, edit config.h:
#   #define BASICPP_DEFAULT_DIALECT DIALECT_GW_BASIC
#
INCLUDE_PATB = yes
# INCLUDE_GWBS = yes
# INCLUDE_TRS1 = yes
# INCLUDE_TRS2 = yes
# INCLUDE_E55  = yes
# INCLUDE_E116 = yes
# INCLUDE_QBAS = yes
# INCLUDE_AINT = yes
# INCLUDE_ASFT = yes
# INCLUDE_ATAR = yes
# INCLUDE_C64  = yes
# INCLUDE_COCO = yes
# INCLUDE_MBAS = yes
# INCLUDE_SINC = yes
# INCLUDE_SUPB = yes
# INCLUDE_SBAS = yes

# =====================================================================
# MODULE SELECTION
# =====================================================================
# STDLIB is always included. Uncomment to add optional modules.
# Each module adds 4-16 KB to the binary.
#
# JIT is NOT available on FreeDOS (requires Windows or Linux).
#
INCLUDE_STDLIB = yes
# INCLUDE_USB     = yes
# INCLUDE_FUJINET = yes
# INCLUDE_UPNP    = yes

# =====================================================================
# SECTION SELECTION (Feature Stripping)
# =====================================================================
# Comment out any section to EXCLUDE it from the build.
# This lets you create a minimal binary for tight memory systems.
#
# WARNING: Removing a section removes ALL keywords in that group.
# Programs using those keywords will get "WHAT?" errors.
#
INCLUDE_GRAPHICS = yes
INCLUDE_SOUND    = yes
INCLUDE_STRUCT   = yes
INCLUDE_FILEIO   = yes
INCLUDE_BLOCKIO  = yes
INCLUDE_STREAMIO = yes
INCLUDE_SHELL    = yes
INCLUDE_DEBUG    = yes
INCLUDE_HELP     = yes
INCLUDE_PCODE    = yes

# =====================================================================
# COMPILER SETTINGS (normally do not change)
# =====================================================================
!ifeq BITS 32
CC      = wcc386
CFLAGS  = -mf -za -wx -ox -i=. -dBPP_FREEDOS
SYSTEM  = dos4g
!else
CC      = wcc
CFLAGS  = -ml -0 -za -wx -ox -i=. -dBPP_FREEDOS
SYSTEM  = dos
!endif

OUTDIR  = ..
TARGET  = $(OUTDIR)\bpp.exe

# =====================================================================
# CORE SOURCES (always included)
# =====================================================================
CORE_OBJS = &
    main.obj memory.obj errors.obj value.obj stringpool.obj &
    platform.obj security.obj ldisdbl.obj config_file.obj &
    stdlib_core.obj stdlib_dialect.obj error_registry.obj &
    boot.obj rpn.obj &
    lexer.obj keyword_props.obj alias_lang.obj &
    parser.obj parser_expr.obj spec.obj &
    parser_flow.obj parser_loops.obj &
    parser_io.obj &
    format_using.obj format_input.obj &
    parser_vars.obj parser_assign.obj &
    parser_mat.obj &
    builtins_string.obj &
    builtins_math.obj &
    funcreg.obj parser_deffn.obj builtins.obj &
    parser_errhand.obj &
    parser_config.obj override.obj scope.obj scope_stack.obj &
    parser_progmgmt.obj parser_cmds.obj compiler.obj &
    parser_virtual.obj vdev.obj vm.obj &
    memmap.obj builtins_memory.obj &
    builtins_system.obj builtins_io.obj &
    dialect.obj &
    ast.obj codegen.obj target.obj bytecode.obj detok.obj &
    module.obj &
    runtime.obj exec.obj &
    parser_misc.obj

# =====================================================================
# CONDITIONAL: Dialects
# =====================================================================
!ifdef INCLUDE_PATB
DIALECT_OBJS = $(DIALECT_OBJS) dialect_patb.obj
!endif
!ifdef INCLUDE_GWBS
DIALECT_OBJS = $(DIALECT_OBJS) dialect_gwbs.obj
!endif
!ifdef INCLUDE_TRS1
DIALECT_OBJS = $(DIALECT_OBJS) dialect_trs1.obj
!endif
!ifdef INCLUDE_TRS2
DIALECT_OBJS = $(DIALECT_OBJS) dialect_trs2.obj
!endif
!ifdef INCLUDE_E55
DIALECT_OBJS = $(DIALECT_OBJS) dialect_ecma55.obj
!endif
!ifdef INCLUDE_E116
DIALECT_OBJS = $(DIALECT_OBJS) dialect_ecma116.obj
!endif
!ifdef INCLUDE_QBAS
DIALECT_OBJS = $(DIALECT_OBJS) dialect_qbasic.obj
!endif
!ifdef INCLUDE_AINT
DIALECT_OBJS = $(DIALECT_OBJS) dialect_aint.obj
!endif
!ifdef INCLUDE_ASFT
DIALECT_OBJS = $(DIALECT_OBJS) dialect_asft.obj
!endif
!ifdef INCLUDE_ATAR
DIALECT_OBJS = $(DIALECT_OBJS) dialect_atari.obj
!endif
!ifdef INCLUDE_C64
DIALECT_OBJS = $(DIALECT_OBJS) dialect_c64.obj
!endif
!ifdef INCLUDE_COCO
DIALECT_OBJS = $(DIALECT_OBJS) dialect_coco.obj
!endif
!ifdef INCLUDE_MBAS
DIALECT_OBJS = $(DIALECT_OBJS) dialect_mbasic.obj
!endif
!ifdef INCLUDE_SINC
DIALECT_OBJS = $(DIALECT_OBJS) dialect_sinclair.obj
!endif
!ifdef INCLUDE_SUPB
DIALECT_OBJS = $(DIALECT_OBJS) dialect_superbasic.obj
!endif
!ifdef INCLUDE_SBAS
DIALECT_OBJS = $(DIALECT_OBJS) dialect_sbasic.obj
!endif

# =====================================================================
# CONDITIONAL: Modules
# =====================================================================
!ifdef INCLUDE_STDLIB
MODULE_OBJS = $(MODULE_OBJS) mod_stdlib.obj
!endif
!ifdef INCLUDE_USB
MODULE_OBJS = $(MODULE_OBJS) mod_usb.obj
!endif
!ifdef INCLUDE_FUJINET
MODULE_OBJS = $(MODULE_OBJS) mod_fujinet.obj
!endif
!ifdef INCLUDE_UPNP
MODULE_OBJS = $(MODULE_OBJS) mod_upnp.obj
!endif
# JIT stub (always included -- compiles to no-op on FreeDOS)
MODULE_OBJS = $(MODULE_OBJS) mod_jit.obj

# =====================================================================
# CONDITIONAL: Sections (Feature Groups)
# =====================================================================
!ifdef INCLUDE_FILEIO
SECTION_OBJS = $(SECTION_OBJS) parser_fileio.obj parser_net.obj fileio.obj &
    builtins_fileio.obj parser_filemgmt.obj &
    device_alias.obj builtins_sio.obj builtins_bio.obj &
    builtins_txn.obj builtins_net.obj txn.obj parser_txn.obj &
    vdev_net.obj
!endif
!ifdef INCLUDE_BLOCKIO
SECTION_OBJS = $(SECTION_OBJS) parser_blockio.obj
!endif
!ifdef INCLUDE_STREAMIO
SECTION_OBJS = $(SECTION_OBJS) parser_streamio.obj
!endif
!ifdef INCLUDE_GRAPHICS
SECTION_OBJS = $(SECTION_OBJS) parser_graphics.obj gfxbuf.obj &
    builtins_graphics.obj parser_display.obj
!endif
!ifdef INCLUDE_SOUND
SECTION_OBJS = $(SECTION_OBJS) parser_sound.obj
!endif
!ifdef INCLUDE_STRUCT
SECTION_OBJS = $(SECTION_OBJS) parser_struct.obj
!endif
!ifdef INCLUDE_SHELL
SECTION_OBJS = $(SECTION_OBJS) parser_shell.obj
!endif
!ifdef INCLUDE_DEBUG
SECTION_OBJS = $(SECTION_OBJS) parser_debug.obj selftest.obj check.obj
!endif
!ifdef INCLUDE_HELP
SECTION_OBJS = $(SECTION_OBJS) parser_help.obj help.obj
!endif
!ifdef INCLUDE_PCODE
SECTION_OBJS = $(SECTION_OBJS) pcode_compiler.obj pcode_emit.obj &
    vm_exec.obj
!endif

# =====================================================================
# Combined object list
# =====================================================================
ALL_OBJS = $(CORE_OBJS) $(DIALECT_OBJS) $(MODULE_OBJS) $(SECTION_OBJS)

# =====================================================================
# BUILD TARGETS
# =====================================================================
all: $(TARGET) .SYMBOLIC

$(TARGET): $(ALL_OBJS)
    @echo system $(SYSTEM) > _link.lnk
    @echo name $(TARGET) >> _link.lnk
    @for %o in ($(ALL_OBJS)) do @echo file %o >> _link.lnk
    wlink @_link.lnk
    @del _link.lnk
!ifeq BITS 32
    @echo === bpp.exe built (32-bit FreeDOS, DOS/4GW) ===
!else
    @echo === bpp.exe built (16-bit FreeDOS) ===
!endif

